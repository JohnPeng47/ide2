{
  "name": "new-diagram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check:browser": "node browser-check.mjs",
    "check:canvas": "node browser-diagram-canvas-check.mjs",
    "check:mapping": "node browser-mapping-poc-check.mjs",
    "check:local-chat": "node browser-local-chat-check.mjs",
    "check:domain-profiles": "node browser-domain-profiles-check.mjs",
    "check:markdown": "tsx browser-markdown-check.mjs",
    "check:aux-views": "node browser-aux-views-check.mjs",
    "dev": "vite --host 127.0.0.1",
    "diagram": "tsx cli.ts",
    "migrate:plans": "tsx migrate-plans.ts",
    "experiment": "tsx experiments/cli.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@vitejs/plugin-react": "^5.1.1",
    "markdown-it": "^15.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@new-diagram/ui-test-framework": "file:packages/ui-test-framework",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "vitest": "^4.1.10"
  }
}
