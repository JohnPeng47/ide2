{
  "name": "new-diagram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:perf:f02": "npm run build && playwright test --config tests/perf/playwright.config.ts && node tests/perf/summarize.mjs",
    "typecheck:perf": "tsc --project tests/perf/tsconfig.json",
    "benchmark": "node benchmarks/runner.mjs",
    "test:benchmarks": "node --test benchmarks/tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "check:browser": "npm run check:mapping",
    "check:canvas": "node tests/browser/core/browser-diagram-canvas-check.mjs",
    "check:source-performance": "npm run build && node tests/performance/browser-source-pane-performance.mjs",
    "check:mapping": "node tests/browser/mapping/browser-mapping-poc-check.mjs",
    "check:line-grid": "node tests/browser/mapping/browser-line-grid-check.mjs",
    "check:canvas-paste": "npm run build && node tests/browser/mapping/browser-canvas-paste-check.mjs",
    "check:unmapped-selection": "npm run build && node tests/browser/mapping/browser-unmapped-selection-check.mjs",
    "check:local-chat": "node tests/browser/mapping/browser-local-chat-check.mjs",
    "check:domain-profiles": "node tests/browser/core/browser-domain-profiles-check.mjs",
    "check:markdown": "tsx tests/browser/core/browser-markdown-check.mjs",
    "dev": "node scripts/dev/start-server.mjs --host 127.0.0.1",
    "preview": "node scripts/dev/start-server.mjs preview --host 127.0.0.1",
    "test": "vitest run",
    "parse:diagram": "tsx scripts/diagrams/parse-diagram.ts",
    "typecheck": "tsc --noEmit",
    "check:source-navigation": "npm run build && SOURCE_PERF_TRIALS=0 SOURCE_NAVIGATION=1 node tests/performance/browser-source-pane-performance.mjs",
    "start": "node scripts/dev/start-server.mjs --host 127.0.0.1",
    "mcp:mapping": "tsx scripts/mapping/mcp.ts",
    "check:agent-diagramming": "npm run build && node tests/browser/mapping/browser-agent-diagramming-check.mjs",
    "check:live-canvas": "npm run build && node --import tsx tests/browser/mapping/browser-live-canvas-check.mjs",
    "check:change-acceptance": "npm run build && node --import tsx tests/browser/mapping/browser-change-acceptance-check.mjs",
    "check:diagram-search": "npm run build && node --import tsx tests/browser/mapping/browser-diagram-search-check.mjs",
    "check:diagram-edit-ui": "npm run build && node --import tsx tests/browser/mapping/browser-diagram-edit-ui-check.mjs",
    "check:diagram-edit": "npm run build && node tests/browser/mapping/browser-diagram-edit-check.mjs",
    "check:diagram-delete": "npm run build && node --import tsx tests/browser/mapping/browser-diagram-delete-check.mjs",
    "check:diagram-transfer": "npm run build && node --import tsx tests/browser/mapping/browser-diagram-transfer-check.mjs",
    "check:tldraw": "npm run build && node --import tsx tests/browser/mapping/browser-tldraw-check.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vitejs/plugin-react": "^5.1.1",
    "markdown-it": "^15.0.1",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shiki": "^4.4.3",
    "tldraw": "5.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0",
    "vite": "^7.2.7",
    "vscode-jsonrpc": "^8.2.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@new-diagram/ui-test-framework": "file:packages/ui-test-framework",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "vitest": "^4.1.10"
  }
}
