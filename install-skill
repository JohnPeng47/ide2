#!/bin/sh
set -eu

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
source_directory="$script_directory/skills/new-diagram"
codex_directory=${CODEX_HOME:-"${HOME}/.codex"}
skills_directory="$codex_directory/skills"
target_directory="$skills_directory/new-diagram"

if [ ! -f "$source_directory/SKILL.md" ] || [ ! -f "$source_directory/agents/openai.yaml" ]; then
  echo "new-diagram skill source is incomplete: $source_directory" >&2
  exit 1
fi
if [ -L "$target_directory" ]; then
  echo "refusing to replace symlinked skill path: $target_directory" >&2
  exit 1
fi
if [ -e "$target_directory" ] && [ ! -d "$target_directory" ]; then
  echo "skill destination is not a directory: $target_directory" >&2
  exit 1
fi

mkdir -p "$skills_directory"
staging_directory=$(mktemp -d "$skills_directory/.new-diagram.install.XXXXXX")
backup_directory="$skills_directory/.new-diagram.backup.$$"

cleanup() {
  if [ -n "${staging_directory:-}" ] && [ -d "$staging_directory" ]; then
    rm -rf -- "$staging_directory"
  fi
  if [ -d "$backup_directory" ]; then
    if [ ! -e "$target_directory" ]; then
      mv -- "$backup_directory" "$target_directory"
    else
      rm -rf -- "$backup_directory"
    fi
  fi
}
trap cleanup EXIT HUP INT TERM

cp -R "$source_directory/." "$staging_directory/"
chmod 755 "$staging_directory"

if [ -d "$target_directory" ] && diff -qr "$staging_directory" "$target_directory" >/dev/null; then
  echo "unchanged: $target_directory"
  exit 0
fi

status=installed
if [ -d "$target_directory" ]; then
  if [ -e "$backup_directory" ]; then
    echo "backup path already exists: $backup_directory" >&2
    exit 1
  fi
  mv -- "$target_directory" "$backup_directory"
  status=updated
fi

mv -- "$staging_directory" "$target_directory"
staging_directory=
if [ -d "$backup_directory" ]; then
  rm -rf -- "$backup_directory"
fi

echo "$status: $target_directory"
