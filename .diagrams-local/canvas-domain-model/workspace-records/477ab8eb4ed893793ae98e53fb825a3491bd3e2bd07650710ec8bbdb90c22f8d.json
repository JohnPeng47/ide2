ows: lines.length };","}"],"symbol":"measureContent"}]},"baseline-71c3c3cdf50d485c0ddb":{"id":"baseline-71c3c3cdf50d485c0ddb","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"layoutScene","label":"layoutScene","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-71c3c3cdf50d485c0ddb-range","path":"domain/core/diagrams/lineGrid.ts","startLine":126,"endLine":160,"originalLines":["export function layoutScene(scene: LineGridScene, changedId: string): LineGridScene {","  function visit(box: GridBox): { box: GridBox; changed: boolean } {","    if (box.kind === \"diagram\") return { box, changed: box.id === changedId };","    const descendants = box.children.map(visit);","    let children = descendants.map((child) => child.box);","    const anchoredId = descendants.find((child) => child.changed)?.box.id;","    if (!box.collapsed) {","      const measure = (child: GridBox) => resolveScene({ ...scene, root: child }).bounds;","      const ordered = children.map((child, index) => ({ child, index })).sort((a, b) =>","        Number(b.child.id === anchoredId) - Number(a.child.id === anchoredId)","        || a.child.position.column - b.child.position.column","        || a.child.position.row - b.child.position.row || a.index - b.index);","      const settled: GridBounds[] = [];","      const replacements = new Map<string, GridBox>();","      for (const { child } of ordered) {","        const bounds = { ...measure(child) };","        let collisions = settled.filter((other) => boxesOverlap(bounds, other, box.layout.gap));","        while (collisions.length) {","          bounds.column = Math.max(...collisions.map((other) => other.column + other.columns + box.layout.gap));","          collisions = settled.filter((other) => boxesOverlap(bounds, other, box.layout.gap));","        }","        settled.push(bounds);","        replacements.set(child.id, { ...child, position: { column: bounds.column, row: bounds.row } });","      }","      children = children.map((child) => replacements.get(child.id)!);","    }","    return { box: { ...box, children }, changed: box.id === changedId || descendants.some((child) => child.changed) };","  }","  const result = visit(scene.root);","  if (!result.changed) throw new Error(`Unknown GridBox: ${changedId}`);","  const next = { ...scene, root: result.box };","  // Check all final bounds before publishing a transaction.","  composeScene(next);","  return next;","}"],"symbol":"layoutScene"}]},"baseline-map-419aa921c7773e4e1e1b":{"id":"baseline-map-419aa921c7773e4e1e1b","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"GridBox.position","label":"GridBox.position","category":"interface-data-struct","summary":"Verified source at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-map-419aa921c7773e4e1e1b-range","path":"domain/core/diagrams/lineGrid.ts","startLine":13,"endLine":13,"originalLines":["  position: GridPoint;"],"symbol":"GridBox.position"}]},"baseline-map-0fc86d42568577def401":{"id":"baseline-map-0fc86d42568577def401","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"GridPoint","label":"GridPoint","category":"interface-data-struct","summary":"Verified source at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-map-0fc86d42568577def401-range","path":"domain/core/diagrams/lineGrid.ts","startLine":4,"endLine":4,"originalLines":["export interface GridPoint { column: number; row: number }"],"symbol":"GridPoint"}]},"baseline-map-c9f1a6acaf224d02ae40":{"id":"baseline-map-c9f1a6acaf224d02ae40","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"GridBox.minimumSize","label":"GridBox.minimumSize","category":"interface-data-struct","summary":"Verified source at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-map-c9f1a6acaf224d02ae40-range","path":"domain/core/diagrams/lineGrid.ts","startLine":14,"endLine":14,"originalLines":["  minimumSize?: GridSize;"],"symbol":"GridBox.minimumSize"}]},"baseline-map-733