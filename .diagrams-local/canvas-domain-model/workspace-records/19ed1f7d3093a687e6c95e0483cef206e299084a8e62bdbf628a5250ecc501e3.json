,","  panels: z.record(id, diagramSidePanelSchema) }).strict();","export type DiagramAlternatives = z.infer<typeof diagramAlternativesSchema>;","export const emptyDiagramAlternatives = (): DiagramAlternatives => ({ schemaVersion: 1, items: {}, selected: {}, panels: {} });","export const scopeOwner = (scope: DiagramScope) => scope.kind === 'diagram' ? 'root' : scope.nodeRef;","export const ownerScope = (owner: string): DiagramScope => owner === 'root' ? { kind: 'diagram' } : { kind: 'subtree', nodeRef: owner };","export const alternativeRevisionIds = (state?: DiagramAlternatives) => [...new Set(Object.values(state?.items ?? {}).flatMap(item => item.parts.flatMap(part => [part.baseRevisionId, part.source.revisionId])))];","const stableId = (...parts: string[]) => `alternative-${sha256(JSON.stringify(parts)).slice(0, 32)}`;"]}]}},"binding":{"sourceId":"source-proposal1-current-worktree","repositoryIdentity":"/home/john/drone-interception/scripts/new-diagram/.git","domainProfileId":"source-code","corpus":{"kind":"git-worktree","root":"/home/john/.herdr/worktrees/new-diagram/claude-diagram-ai-modal-design-6xhqax"}}}},"nodeRefs":{"diagram-43cb3423-470f-4cc3-97bc-145a94530941:0:c32b431a4904ccf5939c4d528593cc3b0242b6d29e60bb5c271d2a2ee83843da:line-1":"node-0631bb97-91ef-4e78-a51a-5d5772132eef","diagram-43cb3423-470f-4cc3-97bc-145a94530941:0:c32b431a4904ccf5939c4d528593cc3b0242b6d29e60bb5c271d2a2ee83843da:line-3":"node-f5916fc3-91f1-4c19-b699-f69bda5f50cb","diagram-43cb3423-470f-4cc3-97bc-145a94530941:0:c32b431a4904ccf5939c4d528593cc3b0242b6d29e60bb5c271d2a2ee83843da:line-4":"node-6d9df78b-5734-44b3-9a7d-4e8392ee2a28","diagram-43cb3423-470f-4cc3-97bc-145a94530941:0:c32b431a4904ccf5939c4d528593cc3b0242b6d29e60bb5c271d2a2ee83843da:line-5":"node-27f2974a-249d-442e-a269-bce0fd3d319d","diagram-43cb3423-470f-4cc3-97bc-145a94530941:0:c32b431a4904ccf5939c4d528593cc3b0242b6d29e60bb5c271d2a2ee83843da:line-7":"node-b5f3084f-f310-4cb7-ab88-77cda749f595","diagram-43cb3423-470f-4cc3-97bc-