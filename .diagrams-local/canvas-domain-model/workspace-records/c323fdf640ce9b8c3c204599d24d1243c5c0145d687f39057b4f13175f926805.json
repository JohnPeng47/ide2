 './asciiSha256';","import { parseAsciiTree } from './asciiTree';","","export type DiagramContentNode = DeepReadonly<{","  id: string; label: string; line: number; branchColumn: number; startColumn: number; endColumn: number;","  parentId?: string; childIds: string[]; foldRanges: { startLine: number; endLine: number }[];","}>;","export type DiagramContent = DeepReadonly<{","  revisionId: string; ascii: string; asciiSha256: string;","  structure: { kind: 'diagram' } | { kind: 'tree'; parserVersion: 'ascii-tree-1' | 'ascii-tree-2'; rootIds: string[]; nodes: Record<string, DiagramContentNode> };","}>;","export function buildDiagramContent(ascii: string, revisionId: string, kind: 'diagram' | 'tree' = 'diagram', parserVersion: 'ascii-tree-1' | 'ascii-tree-2' = 'ascii-tree-2'): DiagramContent {","  if (!['ascii-tree-1', 'ascii-tree-2'].includes(parserVersion)) throw new Error('Unknown tree parser version');","  // A blank rectangular diagram reserves editable canvas space (e.g. a generated-diagram placeholder).","  const lines = ascii.split('\\n');"]}]},"proposal1-evidence-diagram":{"id":"proposal1-evidence-diagram","sourceId":"source-proposal1-current-worktree","handle":"diagram","label":"sourceContext: DiagramSourceContext","category":"interface-data-struct","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-diagram-range","path":"domain/core/diagrams/diagram.ts","startLine":12,"endLine":36,"originalLines":["export interface DiagramSourceBinding {","  sourceId: string;","  repositoryIdentity: string;","  corpus: CorpusBinding;","  domainProfileId: BuiltInDomainProfileId;","}","export type DiagramSourceContext = DeepReadonly<{","  binding?: DiagramSourceBinding;","  contentHash: string;","  mappings: readonly DiagramElementMapping[];","  evidence: Record<string, ProjectRepresentationEvidenceRecord>;","}>;","/** Repository-independent diagram, shared by canvas, persistence, and agents. */","export interface Diagram {","  /** Stable service identity; id remains the local canvas content key. */","  readonly diagramId: string;","  readonly revisionId: string;","  readonly id: string;","  readonly revision: number;","  readonly content: DeepReadonly<DiagramContent>;","  readonly sourceContext: DeepReadonly<DiagramSourceContext>;","  readonly highlights?: DeepReadonly<DiagramHighlight[]>;","  readonly jumps?: DeepReadonly<DiagramJump[]>;","}","export interface DiagramInput {"]}]},"proposal1-evidence-node":{"id":"proposal1-evidence-node","sourceId":"source-proposal1-current-worktree","handle":"node","label":"DiagramPresentation","category":"interface-data-struct","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-node-range","path":"domain/core/diagrams/diagramNode.ts","startLine":1,"endLine":22,"originalLines":["import type { Node, NodePresentation } from '../nodes/node';","import type { Diagram } from './diagram';","import type { DiagramHighlight } from './diagramHighlight';","","export type DiagramNode = Node<'diagram', { readonly diagramId: string; readonly revisionId: string }>;","","export interface DiagramPresentationState {","  readonly alternativeIds?: readonly string[];","  readonly selectedAlternativeIds?: readonly string[];","  readonly sidePanelIds?: readonly string[];","  readonly display: 'regular' | 'diff';","  readonly collapsed: boolean;","  readonly collapsedNodeRefs: readonly string[];","  readonly baseRevisionId?: string;","  readonly highlights: readonly DiagramHighlight[];","}","export type DiagramPresentation = NodePresentation<DiagramPresentationState>;","","/** Adapt existing placements without duplicating immutable content in canvas state. */","export function diagramNode(id: string, diagram: Diagram): DiagramNode {","  return { id, kind: 'diagram', content: { diagramId: diagram.diagramId, revisionId: diagram.revisionId } };","}"]}]},"proposal1-evidence-settings":{"id":"proposal1-evidence-settings","sourceId":"source-proposal1-current-worktree","handle":"settings","label":"document.diagramPresentations","category":"interface-data-struct","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-settings-range","path":"domain/core/presentation/diagramPresentation.ts","startLine":8,"endLine":26,"originalLines":["export interface MarkerStyle { color?: string; underline?: boolean }","/** Persisted presentation settings. Changing these never changes a content revision. */","export interface DiagramPresentationSettings {","  highlights?: readonly DiagramHighlight[];","  markerRules?: readonly DiagramMarkerRule[];","  markerStyles?: Readonly<Record<string, MarkerStyle>>;","}","export type DiagramPresentations = Record<string, DiagramPresentationSettings>;","","/** Legacy revision annotations are a read fallback until a presentation is edited. */","export function presentationHighlights(diagram: Diagram, settings?: DiagramPresentationSettings,","  nodeRefs: Readonly<Record<string, string>> = {}): readonly DiagramHighlight[] {","  const items = settings?.highlights ?? diagram.highlights ?? [];","  if (!items.some(item => item.nodeRefs?.length)) return items;","  const parsed = new Map(Object.entries(nodeRefs).map(([id, ref]) => [ref, id]));","  return items.map(item => {","    if (!item.nodeRefs?.length) return item;","    const ids = item.nodeRefs.map(ref => parsed.get(ref) ?? `stale:${ref}`);","    return item.contentNodeIds ? { ...item, contentNodeIds: ids } : { ...item, contentNodeId: ids[0] };"]}]}}}},"nodeRefs":{"diagram-content-58ceaa1a-6930-4333-b60f-0d2b5ef2eb88:1:767e626f12bfe6e6afe7a79f8989d4ed5d3dbdaf8f8e19ae2cea318a7084426b:line-1":"node-9adaad95-6057-4b85-92de-3ac7dd9d48b1","diagram-content-58ceaa1a-6930-4333-b60f-0d2b5ef2eb88:1:767e626f12bfe6e6afe7a79f8989d4ed5d3dbdaf8f8e19ae2cea318a7084426b:line-3":"node-085c3940-29c0-454d-9d82-c9af12c6371e","diagram-content-58ceaa1a-6930-4333-b60f-0d2b5ef2eb88:1:767e626f12bfe6e6afe7a79f8989d4ed