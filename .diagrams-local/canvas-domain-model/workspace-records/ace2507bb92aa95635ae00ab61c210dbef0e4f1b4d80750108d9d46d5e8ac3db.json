{"baseline-e9c274730c1ce46cf3c2":{"id":"baseline-e9c274730c1ce46cf3c2","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"Diagram","label":"Diagram","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-e9c274730c1ce46cf3c2-range","path":"domain/core/diagrams/diagram.ts","startLine":24,"endLine":33,"originalLines":["export interface Diagram {","  /** Stable service identity; id remains the local canvas content key. */","  readonly diagramId: string;","  readonly revisionId: string;","  readonly id: string;","  readonly revision: number;","  readonly content: DeepReadonly<DiagramContent>;","  readonly sourceContext: DeepReadonly<DiagramSourceContext>;","  readonly jumps?: DeepReadonly<DiagramJump[]>;","}"],"symbol":"Diagram"}]},"baseline-e13381d4e0737dbf20aa":{"id":"baseline-e13381d4e0737dbf20aa","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"AgentContext","label":"AgentContext","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-e13381d4e0737dbf20aa-range","path":"domain/core/agents/agentContext.ts","startLine":62,"endLine":113,"originalLines":["export class AgentContext {","  readonly #snapshot: AgentContextSnapshot;","  private constructor(snapshot: AgentContextSnapshot) { this.#snapshot = structuredClone(snapshot); }","  get contentHash() { return this.#snapshot.contentHash; }","","  static fromTrajectory(raw: unknown): AgentContext {","    bounded(raw);","    const input = agentTrajectorySchema.parse(raw);","    const entries = new Map(input.entries.map(entry => [entry.id, entry]));","    if (entries.size !== input.entries.length) throw Error('INVALID_AGENT_CONTEXT: duplicate entry ID');","    const selected: AgentContextMessage[] = [], visited = new Set<string>();","    let cursor: string | null = input.throughEntryId;","    while (cursor !== null) {","      if (visited.has(cursor)) throw Error('INVALID_AGENT_CONTEXT: cyclic trajectory');","      visited.add(cursor);","      const entry = entries.get(cursor);","      if (!entry) throw Error('INVALID_AGENT_CONTEXT: missing entry on selected branch');","      selected.push(entry.message);","      if (cursor === input.fromEntryId) break;","      cursor = entry.parentId;","    }","    if (cursor !== input.fromEntryId) throw Error('INVALID_AGENT_CONTEXT: range is not on one branch');","    const messages = selected.reverse();","    validateMessages(messages);","    const data = snapshotDataSchema.parse({ version: 1,","      source: { agentType: input.agentType, sourceSessionId: input.sourceSessionId, format: input.format },","      range: { fromEntryId: input.fromEntryId, throughEntryId: input.throughEntryId }, messages });","    return new AgentContext({ ...data, contentHash: sha256(canonical(data)) });","  }","","  static fromSnapshot(raw: unknown): AgentContext {","    bounded(raw);","    const snapshot = agentContextSnapshotSchema.parse(raw);","    const { contentHash, ...data } = snapshot;","    if (contentHash !== sha256(canonical(data))) throw Error('INVALID_AGENT_CONTEXT: content hash mismatch');","    validateMessages(snapshot.messages);","    return new AgentContext(snapshot);","  }","","  toSnapshot(): AgentContextSnapshot { return structuredClone(this.#snapshot); }","","  toPiMessages() {","    return this.toSnapshot().messages.map(message => {","      if (message.role !== 'assistant') return message;","      // Synthetic provenance marks imported history; it never selects the run's model.","      return { ...message, api: 'openai-responses' as const, provider: 'agent-context', model: this.#snapshot.source.agentType,","        stopReason: message.content.some(block => block.type === 'toolCall') ? 'toolUse' as const : 'stop' as const,","        usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0,","          cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } } };","    });","  }","}"],"symbol":"AgentContext"}]}},"binding":{"sourceId":"source-3fe4f45713dca806c6aa1ba8","repositoryIdentity":"/home/john/drone-interception/scripts/new-diagram/.git","domainProfileId":"source-code","corpus":{"kind":"git-worktree","root":"/home/john/.herdr/worktrees/new-diagram/worktree-perf-debug","revision":"03f2168deba364103c2450ca9b8168cd1fc9ddc5"}}}},"nodeRefs":{"diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-1":"node-2fe19157-c54e-45af-8fb5-1b240829befd","diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-2":"node-ddb29959-28f8-4958-a1ad-f675aa532056","diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-3":"node-df15c4a9-dfad-4788-99e7-5ea75e805073","diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-4":"node-2fbaad46-e7eb-4528-89cd-6275173b894a","diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-5":"node-41c73f64-f434-4146-9435-70224d96db50","diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-6":"node-b7aacd51-0613-4fa0-a9d1-5d728abef4b5","diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-7":"node-240e47e5-f216-4d11-8d69-be946971f5f4","diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-8":"node-cab118d9-382e-491f-be75-8339d1edfb5b","diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-9":"node-260e3df1-2fd2-4571-b897-5dd593a8ec13","diagram-42ee05f7-8b65-4c99-9776-4ddbd09c6487:2:453544fa94acc805408ce5d3fba525d1519d6fa1f81818a8b79975f804277577:line-10":"node-b64e16