ernative","label":"panels[id]","category":"interface-data-struct","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-alternative-range","path":"domain/core/presentation/diagramAlternative.ts","startLine":9,"endLine":33,"originalLines":["const id = z.string().min(1).max(500).refine(s => !['__proto__', 'constructor', 'prototype'].includes(s));","export const alternativeScopeSchema = z.discriminatedUnion('kind', [z.object({ kind: z.literal('diagram') }).strict(),","  z.object({ kind: z.literal('subtree'), nodeRef: id }).strict()]);","export type DiagramScope = z.infer<typeof alternativeScopeSchema>;","export const alternativePartSchema = z.object({ target: alternativeScopeSchema,","  source: z.object({ revisionId: id, scope: alternativeScopeSchema }).strict(), baseRevisionId: id }).strict();","export const diagramAlternativeSchema = z.object({ id, name: z.string().trim().min(1).max(120), diagramId: id,","  presentationId: id, display: z.enum(['regular', 'diff']).optional(), parentAlternativeId: id.optional(), reviewId: id.optional(),","  parts: z.array(alternativePartSchema).min(1).max(100) }).strict();","export type DiagramAlternative = z.infer<typeof diagramAlternativeSchema>;","export type DiagramAlternativePart = z.infer<typeof alternativePartSchema>;","export const diagramSidePanelSchema = z.object({ id, kind: z.literal('diagram-side-panel'),","  attachment: z.object({ diagramPresentationId: id, nodeRef: id }).strict(), alternativeId: id,","  partIndex: z.number().int().nonnegative(), placement: z.enum(['flow', 'overlay']),","  display: z.enum(['regular', 'diff']), side: z.enum(['left', 'right']) }).strict();","export type DiagramSidePanel = z.infer<typeof diagramSidePanelSchema>;","export const diagramAlternativesSchema = z.object({ schemaVersion: z.literal(1),","  items: z.record(id, diagramAlternativeSchema), selected: z.record(id, z.array(id).max(1000)),","  panels: z.record(id, diagramSidePanelSchema) }).strict();","export type DiagramAlternatives = z.infer<typeof diagramAlternativesSchema>;","export const emptyDiagramAlternatives = (): DiagramAlternatives => ({ schemaVersion: 1, items: {}, selected: {}, panels: {} });","export const scopeOwner = (scope: DiagramScope) => scope.kind === 'diagram' ? 'root' : scope.nodeRef;","export const ownerScope = (owner: string): DiagramScope => owner === 'root' ? { kind: 'diagram' } : { kind: 'subtree', nodeRef: owner };","export const alternativeRevisionIds = (state?: DiagramAlternatives) => [...new Set(Object.values(state?.items ?? {}).flatMap(item => item.parts.flatMap(part => [part.baseRevisionId, part.source.revisionId])))];","const stableId = (...parts: string[]) => `alternative-${sha256(JSON.stringify(parts)).slice(0, 32)}`;"]}]},"proposal1-evidence-compose":{"id":"proposal1-evidence-compose","sourceId":"source-proposal1-current-worktree","handle":"compose","label":"Project","category":"operation","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-compose-range","path":"domain/core/presentation/diagramAlternative.ts","startLine":100,"endLine":145,"originalLines":["    if (base && !item.parentAlternativeId && item.parts.some(part => part.target.kind === 'subtree' && !Object.values(base.nodeRefs).includes(part.target.nodeRef))) return false;","    return active.has(item.id) && (!item.parentAlternativeId || !!state.items[item.parentAlternativeId] && enabled(state.items[item.parentAlternativeId], seen));","  };","  for (const item of Object.values(state.items)) if (item.presentationId === presentationId && enabled(item)) {","    for (const part of item.parts) {","      const ownerNodeId = scopeOwner(part.target);","      const contextRevisionId = item.parentAlternativeId ? part.baseRevisionId : null;","      selections[revisionSelectionKey(contentId, ownerNodeId, contextRevisionId)] = { contentId, ownerNodeId, contextRevisionId,","        revisionId: part.source.revisionId, sourceOwnerNodeId: scopeOwner(part.source.scope), baseRevisionId: part.baseRevisionId };","    }","  }","  return { revisionSelections: selections };","}","","export function validateDiagramAlternatives(state: DiagramAlternatives, get: (id: string) => DiagramRevision) {","  diagramAlternativesSchema.parse(state);","  for (const [key, item] of Object.entries(state.items)) {","    if (key !== item.id) throw Error('Invalid alternative identity');","    if (item.display === 'diff' && (item.parentAlternativeId || item.parts.length !== 1 || item.parts[0].target.kind !== 'diagram' || item.parts[0].source.scope.kind !== 'diagram'))","      throw Error('Diff alternatives require one whole-Diagram part');","    const ancestors = new Set([key]);","    for (let parent = item.parentAlternativeId; parent; parent = state.items[parent]?.parentAlternativeId) {","      if (ancestors.has(parent) || state.items[parent]?.presentationId !== item.presentationId) throw Error('Invalid alternative parent');","      ancestors.add(parent);","    }","    const ranges = item.parts.map(part => {","      const base = get(part.baseRevisionId), source = get(part.source.revisionId);","      if (base.diagramId !== item.diagramId || source.diagramId !== item.diagramId) throw Error('Alternative belongs to another diagram');","      revisionScope(source, scopeOwner(part.source.scope));","      const target = revisionScope(base, scopeOwner(part.target));","      if (item.parentAlternativeId && !state.items[item.parentAlternativeId].parts.some(parent => {","        if (parent.source.revisionId !== base.id) return false;","        const scope = revisionScope(base, scopeOwner(parent.source.scope));","        return target.startLine >= scope.startLine && target.endLine <= scope.endLine;","      })) throw Error('Nested alternative is outside its parent source scope');","      return { revisionId: base.id, ...target };","    });","    if (ranges.some((a, i) => ranges.slice(i + 1).some(b => a.revisionId !== b.revisionId || a.startLine <= b.endLine && b.startLine <= a.endLine)))","      throw Error('Alternative parts require one base revision and disjoint targets');","  }","  for (const [owner, ids] of Object.entries(state.selected)) {","    if (new Set(ids).size !== ids.length || ids.some(id => state.items[id]?.presentationId !== owner)) throw Error('Invalid selected alternative');","    const selected = ids.map(id => state.items[id]);","    for (let i = 0; i < selected.length; i++) for (const other of selected.slice(i + 1))","      if (alternativesOverlap(selected[i], other, get)) throw Error('ALTERNATIVE_CONFLICT: deselect the overlapping alternative first');","  }"]}]}}}},"nodeRefs":{"diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:2:2b58fa451fac51dac6bdae4d19e93c3a452e3dd0ea56fda50164f274968ab79b:line-1":"node-5e9124d7-4db7-4aba-b332-7bef0b5808d7","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:2:2b58fa451fac51dac6bdae4d19e93c3a452e3dd0ea56fda50164f274968ab79b:line-3":"node-5ab4b1d6-d711-4d9f-b32b-90ef8979782e","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:2:2b58fa451fac51dac6bdae4d19e93c3a452e3dd0ea56fda50164f274968ab79b:line-4":"node-077184a5-0692-453e-8c3d-1ec3ffce62ed","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:2:2b58fa451fac51dac6bdae4d19e93c3a452e3dd0ea56fda50164f274968ab79b:line-7":"node-d77c58b6-3b0f-4a04-b66d-48f64dde95b0","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:2:2b58fa451fac51dac6bdae4d19e93c3a452e3dd0ea56fda50164f274968ab79b:line-8":"node-a681da1d-1787-401b-9733-79156a9e95e3","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:2:2b58fa451fac51dac6bdae4d19e93c3a452e3dd0ea56fda50164f274968ab79b:line-10":"node-b5a92d75-3a90-4143-8f5a-03154f4de36c","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:2:2b58fa451fac51dac6bdae4d19e93c3a452e3dd0ea56fda50164f274968ab79b:line-11":"node-c592390f-dd79-497b-b20a-1f1c8a995a52","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:2:2b58fa451fac51dac6bdae4d19e93c3a452e3dd0ea56fda50164f274968ab79b:line-13":"node-0647187d-5c31-40e9-a88d-3c02a10a84a2