ceRangeId":"proposal1-store-range","line":11,"startColumn":5,"endColumn":26},{"id":"proposal1-map-1-2","entityId":"proposal1-evidence-generate","sourceRangeIndex":0,"sourceRangeId":"proposal1-generate-range","line":18,"startColumn":5,"endColumn":28},{"id":"proposal1-map-1-3","entityId":"proposal1-evidence-store","sourceRangeIndex":0,"sourceRangeId":"proposal1-store-range","line":24,"startColumn":5,"endColumn":18},{"id":"proposal1-map-1-4","entityId":"proposal1-evidence-history","sourceRangeIndex":0,"sourceRangeId":"proposal1-history-range","line":28,"startColumn":5,"endColumn":22}],"evidence":{"proposal1-evidence-ops":{"id":"proposal1-evidence-ops","sourceId":"source-proposal1-current-worktree","handle":"ops","label":"Immutable operations","category":"operation","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-ops-range","path":"domain/core/diagrams/diagramRevision.ts","startLine":1,"endLine":48,"originalLines":["import { deepFreeze } from '../immutability';","import { validateDiagram, type DiagramInput } from './diagram';","import { DiagramRevisionEditor, type DiagramRevision, type DiagramEdit, type PreparedDiagramEdit } from './diagramRevisionEditor';","import { diagramContentNodes } from './diagramContentNodes';","import type { SubtreeRange } from './diagramSubtreeEdit';","export type { DiagramRevision, DiagramEdit, DiagramRevisionId } from './diagramRevisionEditor';","export interface DiagramRevisionResult extends PreparedDiagramEdit { readonly revision: DiagramRevision; replacementRanges?: SubtreeRange[] }","export type DiagramRevisionSummary = Readonly<Pick<DiagramRevision, 'id' | 'diagramId' | 'parentId'>>;","","// Domain operations return immutable revisions. Persistence/publication is explicit.","export function createDiagram(input: DiagramInput): DiagramRevisionResult {","  const prepared = new DiagramRevisionEditor({}, () => ({})).prepareCreate(input);","  return issueDiagramRevision(prepared);","}","export function reviseDiagram(base: DiagramRevision, edit: DiagramEdit): DiagramRevisionResult {","  const prepared = new DiagramRevisionEditor({ [base.id]: base }, () => ({ [base.diagram.id]: base.id }))","    .prepareEdit('edit', base.diagram.id, edit);","  if (prepared.diagram === base.diagram) return { ...prepared, revision: base };","  return issueDiagramRevision({ ...prepared, diagram: { ...prepared.diagram, diagramId: base.diagramId, revisionId: `diagram-revision-${crypto.randomUUID()}` } }, base);","}","export function deriveDiagram(base: DiagramRevision, input: Omit<DiagramInput, 'id' | 'revision'>, refs: Record<string, number>, sources: readonly DiagramRevision[]) {","  const allowed = new Set<string>();","  for (const source of sources) {","    if (source.diagramId !== base.diagramId) throw Error('Identity source belongs to another diagram');","    Object.values(source.nodeRefs).forEach(ref => allowed.add(ref));","  }","  const editor = new DiagramRevisionEditor({ [base.id]: base }, () => ({ [base.diagram.id]: base.id }));","  const prepared = editor.prepareEdit('derive', base.diagram.id, { kind: 'replace', input,","    nodeCorrespondence: Object.fromEntries(Object.entries(refs).filter(([ref]) => Object.values(base.nodeRefs).includes(ref))) });","  const nodes = diagramContentNodes(prepared.diagram.content), identities = new Map<string, string>();","  for (const [ref, line] of Object.entries(refs)) {","    const matching = nodes.filter(node => node.line === line);","    if (!allowed.has(ref) || matching.length !== 1 || identities.has(matching[0].id)) throw Error('Invalid derived node identity');","    identities.set(matching[0].id, ref);","  }","  return issueDiagramRevision({ ...prepared, diagram: { ...prepared.diagram, diagramId: base.diagramId, revisionId: `diagram-revision-${crypto.randomUUID()}` } }, base, identities);","}","function issueDiagramRevision(prepared: PreparedDiagramEdit, base?: DiagramRevision, identities = new Map<string, string>()): DiagramRevisionResult {","  const reverse = new Map([...prepared.nodeIds].map(([old, next]) => [next, old]));","  const record = deepFreeze({ id: prepared.diagram.revisionId, diagramId: prepared.diagram.diagramId,","    ...(base ? { parentId: base.id } : {}), diagram: prepared.diagram,","    nodeRefs: Object.fromEntries(diagramContentNodes(prepared.diagram.content).map(node => {","      const old = reverse.get(node.id);","      return [node.id, identities.get(node.id) || old && base?.nodeRefs[old] || `node-${crypto.randomUUID()}`];","    })) });","  validateDiagram(record.diagram);","  return { ...prepared, diagram: record.diagram, revision: record };","}"]}]},"proposal1-evidence-store":{"id":"proposal1-evidence-store","sourceId":"source-proposal1-current-worktree","handle":"store","label":"Supplied edits","category":"operation","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-store-range","path":"domain/core/diagrams/diagramRevisionStore.ts","startLine":1,"endLine":33,"originalLines":["import { diagramRevisions } from './internal/revisionRegistry';","import { diagramContentNodes } from './diagramContentNodes';","import { createDiagram, reviseDiagram, deriveDiagram, type DiagramRevision, type DiagramRevisionResult, type DiagramRevisionSummary } from './diagramRevision';","import { submitDiagramEdit } from './submitDiagramEdit';","import type { DiagramInput } from './diagram';","import type { DiagramEdit } from './diagramRevisionEditor';","import type { DiagramGenerationRequest } from './diagramGeneration';","import type { GeneratedDiagramEdit } from './generatedDiagramEdit';","","/** Runtime storage API. Durable adapters flush retained revisions before publishing bindings. */","export function getDiagramRevision(id: string): DiagramRevision { return diagramRevisions.get(id); }","export function listDiagramRevisions(diagramId: string): readonly DiagramRevisionSummary[] {","  return Object.freeze(diagramRevisions.list(diagramId).map(({ id, diagramId, parentId }) => Object.freeze({ id, diagramId, parentId })));","}","export function importDiagramRevision(revision: DiagramRevision): void {","  const refs = diagramContentNodes(revision.diagram.content).map(node => revision.nodeRefs?.[node.id]);","  if (refs.some(ref => typeof ref !== 'string' || !ref) || new Set(refs).size !== refs.length) throw Error('Invalid logical node identities');","  diagramRevisions.register(revision);","}","export function retainDiagramRevision(result: DiagramRevisionResult): DiagramRevisionResult {","  importDiagramRevision(result.revision);","  const revision = getDiagramRevision(result.revision.id);","  return { ...result, diagram: revision.diagram, revision };","}","// Convenience commands for existing synchronous callers; the domain operations above work without this store.","export function createStoredDiagram(input: DiagramInput) { return retainDiagramRevision(createDiagram(input)); }","export function reviseStoredDiagram(baseId: string, edit: DiagramEdit) { return retainDiagramRevision(reviseDiagram(getDiagramRevision(baseId), edit)); }","export function deriveStoredDiagram(baseId: string, input: Omit<DiagramInput, 'id' | 'revision'>, refs: Record<string, number>, sources: readonly string[]) {","  return retainDiagramRevision(deriveDiagram(getDiagramRevision(baseId), input, refs, sources.map(getDiagramRevision)));","}","export function submitStoredDiagramEdit(request: DiagramGenerationRequest, candidate: GeneratedDiagramEdit, correspondence?: Record<string, number>) {","  return retainDiagramRevision(submitDiagramEdit(request, candidate, request.baseRevisionId ? getDiagramRevision(request.baseRevisionId) : undefined, correspondence));","}"]}]},"proposal1-evidence-generate":{"id":"proposal1-evidence-generate","sourceId":"source-proposal1-current-worktree","handle":"generate","label":"Generation orchestration","category":"operation","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-generate-range","path":"application/core/diagrams/generateDiagram.ts","startLine":1,"endLine":13,"originalLines":["import type { DiagramGenerationRequest, DiagramGenerator, GenerationOptions } from '../../../domain/core/diagrams/diagramGeneration';","import { getDiagramRevision, submitStoredDiagramEdit } from '../../../domain/core/diagrams/diagramRevisionStore';","","/** Runs an agent; domain validation and revision publication happen only after success. */","export async function generateDiagram(generator: DiagramGenerator, request: DiagramGenerationRequest, options: GenerationOptions = {}) {","  options.signal?.throwIfAborted();","  const base = request.baseRevisionId ? getDiagramRevision(request.baseRevisionId) : undefined;","  if (base && base.diagram.id !== request.input.id) throw Error('Generation base belongs to another diagram');","  const raw = await generator.generate(structuredClone({ ...request, nodeRefs: base?.nodeRefs ?? {} }), options);","  options.signal?.throwIfAborted();","  return submitStoredDiagramEdit(request, { ascii: raw.ascii, structureKind: raw.structureKind ?? request.input.structureKind ?? 'diagram',","    mappings: raw.mappings ? [...raw.mappings] : undefined, replacementRanges: raw.replacementRanges }, raw.nodeCorrespondence);","}"]}]},"proposal1-evidence-history":{"id":"proposal1-evidence-history","sourceId":"source-proposal1-current-worktree","handle":"history","label":"Canvas publication","category":"operation","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-history-range","path":"domain/core/diagrams/canvasHistory.ts","startLine":184,"endLine":215,"originalLines":["  append(document: ResolvedCanvasDocument, view: unknown, correspondence: ReadonlyMap<string, string> = new Map()): StoredCanvasSnapshot {","    projectCanvasSnapshot(document.scene);","    validateConnections(document.scene, document.edges);","    if (document.jumps) validateCanvasJumps(document.scene, document.jumps);","    for (const [diagramId, context] of Object.entries(document.diagramContexts ?? {})) {","      if (diagramId !== context.diagramId || !Object.values(document.scene.contents).some(diagram => diagram.diagramId === diagramId))","        throw Error('Diagram agent context has no owning diagram');","      validateDiagramAgentContext(context);","    }","    for (const settings of Object.values(document.diagramPresentations ?? {})) diagramPresentationSettingsSchema.parse(settings);","    const previous = this.record.snapshots[this.record.headId];","    const bindings: Record<string, string> = {}, additions: Record<string, DiagramRevision> = {}, origins: Record<string, string> = {};","    for (const [diagramId, diagram] of Object.entries(document.scene.contents)) {","      validateDiagram(diagram);","      const prior = previous && this.record.diagramRevisions[previous.diagramBindings[diagramId]];","      const same = prior && equal(prior.diagram, diagram);","      const map = prior ? new Map([...correspondingNodes(prior.diagram, diagram), ...correspondence]) : new Map<string, string>();","      const reverse = new Map([...map].map(([a, b]) => [b, a]));","      for (const node of diagramContentNodes(diagram.content)) {","        const old = same ? node.id : reverse.get(node.id);","        if (!previous) origins[node.id] = node.id;","        else if (old && previous.nodeOrigins[old]) origins[node.id] = previous.nodeOrigins[old];","      }","      const issued = diagramRevisions.assert(diagram);","      bindings[diagramId] = issued.id;","      const include = (revision: DiagramRevision) => {","        if (this.record.diagramRevisions[revision.id] || additions[revision.id]) return;","        if (revision.parentId) {","          if (previous) include(diagramRevisions.get(revision.parentId));","          else (this.record.revisionBoundary ??= {})[revision.parentId] = revision.diagramId;","        }","        additions[revision.id] = revision;"]}]}}},"jumps":[{"id":"baseline-link-0-7-14-39","source":{"revisionId":"diagram-content-873399e8-b5a5-4c1b-b9c9-e58322083f87:0","contentHash":"ce436f28c022ee51324a235c74f2fb7766dee810f058eff0dc1be122e4fa974d","line":14,"startColumn":39,"endColumn":65},"target":{"representationId":"representation-b697fd11-5c8d-49e7-a6b5-b12030f2f79a","displayNodeId":"grid:diagram-86e0b6e9-64e6-43d8-8466-51fb8a696f9c","contentNodeId":"diagram-86e0b6e9-64e6-43d8-8466-51fb8a696f9c:8:47a00378dc43e9fa5233cb32191906bc80ae433602a358ba5d6e0befd7834bdc:line-3"}},{"id":"baseline-link-0-7-15-36","source":{"revisionId":"diagram-content-873399e8-b5a5-4c1b-b9c9-e58322083f87:0","contentHash":"ce436f28c022ee51324a235c74f2fb7766dee810f058eff0dc1be122e4fa974d","line":15,"startColumn":36,"endColumn":72},"target":{"representationId":"representation-c7177725-a7dd-4caa-9ac5-a1c702f3350d","displayNodeId":"grid:overview","contentNodeId":"overview:31:eb180220db4d3379a056ff084b0a216a84662e42257f2d2db7288cdfd68ea104:line-9"}}]},"nodeRefs":{"diagram-content-873399e8-b5a5-4c1b-b9c9-e58322083f87:1:2d102910540e4071679af9a8db18a2834bc7e013bb0738d231934e5b44be2544:line-1":"node-981319f9-49a2-45da-ad42-9a0d61c98f6b","diagram-content-873399e8-b5a5-4c1b-b9c9-e58322083f87:1:2d102910540e4071679af9a8db18a2834bc7e013bb0738d231934e5b44be2544:line-3":"node-61a3d337-80ca-4316-82a9-f816ee870979","diagram-content-873399e8-b5a5-4c1b-b9c9-e58322083f87:1:2d102910540e4071679af9a8db18a2834bc7e013bb0738d231934e5b44be2544:line-4":"node-e47fcbf7-3c7b-4c1f-a9fa-b9056da046e7","diagram-content-873399e8-b5a5-4c1b-b9c9-e58322083f87:1:2d102910540e4071679af9a8db18a2834bc7e013bb0738d231934e5b44be2544:line-5":"node-402d08be-438c-42aa-aac9-f50cc05cf010","diagram-content-873399e8-b5a5-4c1b-b9c9-e58322083f87:1:2d102910540e4071679af9a8db18a2834bc7e013bb0738d231934e5b44be2544:line-6":"node-a5167ce3-06f4-4900-b120-943a66ec3026","diagram-content-873399e8-b5a5-4c1b-b9c9-e58322083f87:1:2d102910540e4071679af9a8db18a2834bc7e013bb0738d231934e5b44be2544:line-7":