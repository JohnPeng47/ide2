ain/core/presentation/diagramAlternative.ts","startLine":9,"endLine":33,"originalLines":["const id = z.string().min(1).max(500).refine(s => !['__proto__', 'constructor', 'prototype'].includes(s));","export const alternativeScopeSchema = z.discriminatedUnion('kind', [z.object({ kind: z.literal('diagram') }).strict(),","  z.object({ kind: z.literal('subtree'), nodeRef: id }).strict()]);","export type DiagramScope = z.infer<typeof alternativeScopeSchema>;","export const alternativePartSchema = z.object({ target: alternativeScopeSchema,","  source: z.object({ revisionId: id, scope: alternativeScopeSchema }).strict(), baseRevisionId: id }).strict();","export const diagramAlternativeSchema = z.object({ id, name: z.string().trim().min(1).max(120), diagramId: id,","  presentationId: id, display: z.enum(['regular', 'diff']).optional(), parentAlternativeId: id.optional(), reviewId: id.optional(),","  parts: z.array(alternativePartSchema).min(1).max(100) }).strict();","export type DiagramAlternative = z.infer<typeof diagramAlternativeSchema>;","export type DiagramAlternativePart = z.infer<typeof alternativePartSchema>;","export const diagramSidePanelSchema = z.object({ id, kind: z.literal('diagram-side-panel'),","  attachment: z.object({ diagramPresentationId: id, nodeRef: id }).strict(), alternativeId: id,","  partIndex: z.number().int().nonnegative(), placement: z.enum(['flow', 'overlay']),","  display: z.enum(['regular', 'diff']), side: z.enum(['left', 'right']) }).strict();","export type DiagramSidePanel = z.infer<typeof diagramSidePanelSchema>;","export const diagramAlternativesSchema = z.object({ schemaVersion: z.literal(1),","  items: z.record(id, diagramAlternativeSchema), selected: z.record(id, z.array(id).max(1000)),","  panels: z.record(id, diagramSidePanelSchema) }).strict();","export type DiagramAlternatives = z.infer<typeof diagramAlternativesSchema>;","export const emptyDiagramAlternatives = (): DiagramAlternatives => ({ schemaVersion: 1, items: {}, selected: {}, panels: {} });","export const scopeOwner = (scope: DiagramScope) => scope.kind === 'diagram' ? 'root' : scope.nodeRef;","export const ownerScope = (owner: string): DiagramScope => owner === 'root' ? { kind: 'diagram' } : { kind: 'subtree', nodeRef: owner };","export const alternativeRevisionIds = (state?: DiagramAlternatives) => [...new Set(Object.values(state?.items ?? {}).flatMap(item => item.parts.flatMap(part => [part.baseRevisionId, part.source.revisionId])))];","const stableId = (...parts: string[]) => `alternative-${sha256(JSON.stringify(parts)).slice(0, 32)}`;"]}]},"proposal1-evidence-compose":{"id":"proposal1-evidence-compose","sourceId":"source-proposal1-current-worktree","handle":"compose","label":"Project","category":"operation","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-compose-range","path":"domain/core/presentation/diagramAlternative.ts","startLine":100,"endLine":145,"originalLines":["    if (base && !item.parentAlternativeId && item.parts.some(part => part.target.kind === 'subtree' && !Object.values(base.nodeRefs).includes(part.target.nodeRef))) return false;","    return active.has(item.id) && (!item.parentAlternativeId || !!state.items[item.parentAlternativeId] && enabled(state.items[item.parentAlternativeId], seen));","  };","  for (const item of Object.values(state.items)) if (item.presentationId === presentationId && enabled(item)) {","    for (const part of item.parts) {","      const ownerNodeId = scopeOwner(part.target);","      const contextRevisionId = item.parentAlternativeId ? part.baseRevisionId : null;","      selections[revisionSelectionKey(contentId, ownerNodeId, contextRevisionId)] = { contentId, ownerNodeId, contextRevisionId,","        revisionId: part.source.revisionId, sourceOwnerNodeId: scopeOwner(part.source.scope), baseRevisionId: part.baseRevisionId };","    }","  }","  return { revisionSelections: selections };","}","","export function validateDiagramAlternatives(state: DiagramAlternatives, get: (id: string) => DiagramRevision) {","  diagramAlternativesSchema.parse(state);","  for (const [key, item] of Object.entries(state.items)) {","    if (key !== item.id) throw Error('Invalid alternative identity');","    if (item.display === 'diff' && (item.parentAlternativeId || item.parts.length !== 1 || item.parts[0].target.kind !== 'diagram' || item.parts[0].source.scope.kind !== 'diagram'))","      throw Error('Diff alternatives require one whole-Diagram part');","    const ancestors = new Set([key]);","    for (let parent = item.parentAlternativeId; parent; parent = state.items[parent]?.parentAlternativeId) {","      if (ancestors.has(parent) || state.items[parent]?.presentationId !== item.presentationId) throw Error('Invalid alternative parent');","      ancestors.add(parent);","    }","    const ranges = item.parts.map(part => {","      const base = get(part.baseRevisionId), source = get(part.source.revisionId);","      if (base.diagramId !== item.diagramId || source.diagramId !== item.diagramId) throw Error('Alternative belongs to another diagram');","      revisionScope(source, scopeOwner(part.source.scope));","      const target = revisionScope(base, scopeOwner(part.target));","      if (item.parentAlternativeId && !state.items[item.parentAlternativeId].parts.some(parent => {","        if (parent.source.revisionId !== base.id) return false;","        const scope = revisionScope(base, scopeOwner(parent.source.scope));","        return target.startLine >= scope.startLine && target.endLine <= scope.endLine;","      })) throw Error('Nested alternative is outside its parent source scope');","      return { revisionId: base.id, ...target };","    });","    if (ranges.some((a, i) => ranges.slice(i + 1).some(b => a.revisionId !== b.revisionId || a.startLine <= b.endLine && b.startLine <= a.endLine)))","      throw Error('Alternative parts require one base revision and disjoint targets');","  }","  for (const [owner, ids] of Object.entries(state.selected)) {","    if (new Set(ids).size !== ids.length || ids.some(id => state.items[id]?.presentationId !== owner)) throw Error('Invalid selected alternative');","    const selected = ids.map(id => state.items[id]);","    for (let i = 0; i < selected.length; i++) for (const other of selected.slice(i + 1))","      if (alternativesOverlap(selected[i], other, get)) throw Error('ALTERNATIVE_CONFLICT: deselect the overlapping alternative first');","  }"]}]}}}},"nodeRefs":{"diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:dc5fc89080415d3e5ea27c09ed8547ce4c97eab95d040465d171c61fda48e1fb:line-1":"node-ba72ef7b-0be0-4d56-bc6d-e1931845d48c","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:dc5fc89080415d3e5ea27c09ed8547ce4c97eab95d040465d171c61fda48e1fb:line-3":"node-765a7768-ff87-405b-98b8-43fa90778f33","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:dc5fc89080415d3e5ea27c09ed8547ce4c97eab95d040465d171c61fda48e1fb:line-4":"node-92f2babe-01cf-48a7-a2cc-51bc0a9db6ee","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:dc5fc89080415d3e5ea27c09ed8547ce4c97eab95d040465d171c61fda48e1fb:line-5":"node-e5775881-56ff-44eb-94f9-9e3c6b2cd9ea","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:dc5fc89080415d3e5ea27c09ed8547ce4c97eab95d040465d171c61fda48e1fb:line-6":"node-b01041cc-dd41-4726-bb2c-706ca1c70032","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:dc5fc89080415d3e5ea27c09ed8547ce4c97eab95d040465d171c61fda48e1fb:line-7":"node-67242e7c-db34-424c-bfef-763784bfa6c4","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:dc5fc89080415d3e5ea27c09ed8547ce4c97eab95d040465d171c61fda48e1fb:line-8":"node-a38465e7-daf1-4dc9-b39e-db231c2ef48f","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:dc5fc89080415d3e5ea27c09ed8547ce4c97eab95d040465d171c61fda48e1fb:line-9":"node-e0532453-a6a1-4ec7-9aac-afb4296ba808","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:dc5fc89080415d3e5ea27c09ed8547ce4c97eab95d040465d171c61fda48e1fb:line-10":"node-70582e7d-2f67-48b0-8c5b-973573917ca2","diagram-eafd5d87-8fa3-4f7b-90d