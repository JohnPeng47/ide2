urce captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-00427314a0c724655011-range","path":"domain/core/diagrams/diagramService.ts","startLine":38,"endLine":41,"originalLines":["  create(input: DiagramInput): DiagramRevisionResult {","    const prepared = new DiagramRevisionEditor({}, () => ({})).prepareCreate(input);","    return this.issue(prepared);","  }"],"symbol":"RevisionedDiagramService.create"}]},"baseline-166eb3723e41c4b5b70f":{"id":"baseline-166eb3723e41c4b5b70f","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"RevisionedDiagramService.getRevision","label":"RevisionedDiagramService.getRevision","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-166eb3723e41c4b5b70f-range","path":"domain/core/diagrams/diagramService.ts","startLine":42,"endLine":42,"originalLines":["  getRevision(revisionId: string) { return diagramRevisions.get(revisionId); }"],"symbol":"RevisionedDiagramService.getRevision"}]},"baseline-9d987a2c0dfc94463b04":{"id":"baseline-9d987a2c0dfc94463b04","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"RevisionedDiagramService.listRevisions","label":"RevisionedDiagramService.listRevisions","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-9d987a2c0dfc94463b04-range","path":"domain/core/diagrams/diagramService.ts","startLine":43,"endLine":45,"originalLines":["  listRevisions(diagramId: string): readonly DiagramRevisionSummary[] {","    return Object.freeze(diagramRevisions.list(diagramId).map(({id, diagramId, parentId}) => Object.freeze({id, diagramId, parentId})));","  }"],"symbol":"RevisionedDiagramService.listRevisions"}]},"baseline-dfccc82af83de1b7960c":{"id":"baseline-dfccc82af83de1b7960c","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"RevisionedDiagramService.revise","label":"RevisionedDiagramService.revise","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-dfccc82af83de1b7960c-range","path":"domain/core/diagrams/diagramService.ts","startLine":46,"endLine":52,"originalLines":["  revise(baseRevisionId: string, edit: DiagramEdit): DiagramRevisionResult {","    const base = this.getRevision(baseRevisionId);","    const prepared = new DiagramRevisionEditor({ [base.id]: base }, () => ({ [base.diagram.id]: base.id }))","      .prepareEdit('edit', base.diagram.id, edit);","    if (prepared.diagram === base.diagram) return { ...prepared, revision: base };","    return this.issue({ ...prepared, diagram: { ...prepared.diagram, diagramId: base.diagramId, revisionId: `diagram-revision-${crypto.randomUUID()}` } }, base);","  }"],"symbol":"RevisionedDiagramService.revise"}]},"baseline-7c181c2568951a339389":{"id":"baseline-7c181c2568951a339389","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"DiagramRevisionEditor","label":"DiagramRevisionEditor","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-7c181c2568951a339389-range","path":"domain/core/diagrams/diagramRevisionEditor.ts","startLine":46,"endLine":102,"originalLines":["export class DiagramRevisionEditor implements DiagramRevisionOperations {","  constructor(private readonly revisions: Record<string, DiagramRevision>,","    private readonly bindings: (contextId: ContextId) => Readonly<Record<string, DiagramRevisionId>>) {}","","  private revision(contextId: ContextId, diagramId: string): DiagramRevision {","    const id = this.bindings(contextId)[diagramId], revision = id && this.revisions[id];","    if (!revision || revision.diagram.id !== diagramId) throw new Error(`Unknown diagram: ${diagramId}`);","    return revision;","  }","  resolve(contextId: ContextId, diagramId: string): DiagramView {","    const { diagram, nodeRefs } = this.revision(contextId, diagramId);","    const nodes = diagramContentNodes(diagram.content).map(node => ({ ...node, id: nodeRefs[node.id],","      parentId: node.parentId ? nodeRefs[node.parentId] : undefined, childIds: node.childIds.map(id => nodeRefs[id]) }));","    return structuredClone({ id: diagramId, ascii: diagram.content.ascii, asciiSha256: diagram.content.asciiSha256,","      structureKind: diagram.content.structure.kind, nodes, sourceContext: diagram.sourceContext,","      jumps: activeDiagramJumps(diagram.content, diagram.jumps).map(jump => {","        const { revisionId: _, contentHash: __, ...source } = jump.source;","        return { id: jump.id, source: { ...source, contentNodeId: source.contentNodeId ? nodeRefs[source.contentNodeId] : undefined }, target: jump.target };","      }) });","  }","  prepareCreate(input: DiagramInput): PreparedDiagramEdit {","    return { diagram: constructDiagram(input), nodeIds: new Map() };","  }","  prepareEdit(contextId: ContextId, diagramId: string, edit: DiagramEdit): PreparedDiagramEdit {","    const before = this.revision(contextId, diagramId).diagram;","    if (edit.kind === 'source-mappings') {","      if (edit.expectedContentHash !== before.content.asciiSha256) throw new Error('CONTENT_HASH_CONFLICT: read the diagram again');","      const diagram = { ...before, sourceContext: { ...before.sourceContext, mappings: structuredClone(edit.mappings), evidence: structuredClone(edit.evidence),","        ...(edit.source ? { binding: structuredClone(edit.source) } : {}) } };","      validateDiagram(diagram);","      return { diagram, nodeIds: correspondingNodes(before, diagram) };","    }","    if (edit.kind === 'patch') {","      const prepared = patchDiagram(before, edit.start, edit.end, edit.patch);","      if (edit.mappings) {","        const sourceContext = constructDiagram({ id: diagramId, revision: prepared.diagram.revision,","          ascii: prepared.diagram.content.ascii, structureKind: prepared.diagram.content.structure.kind,","          source: before.sourceContext.binding, evidence: before.sourceContext.evidence, mappings: edit.mappings }).sourceContext;","        return { ...prepared, diagram: { ...prepared.diagram, sourceContext } };","      }","      return prepared;","    }","    const diagram = edit.kind === 'jumps'","      ? { ...structuredClone(before), jumps: validateDiagramJumps(before.content, edit.jumps, false) }","      : constructDiagram({ ...edit.input, id: diagramId, revision: before.revision + 1 });","    const next = edit.kind === 'replace' && before.jumps ? { ...diagram, jumps: rebaseDiagramJumps(before.content, diagram.content, before.jumps) } : diagram;","    validateDiagram(next);","    return { diagram: next, nodeIds: correspondingNodes(before, next) };","  }","  /** Deliberately conservative until three-way merge is implemented. */","  merge(baseline: Readonly<Record<string, string>>, current: Readonly<Record<string, string>>, proposed: Readonly<Record<string, string>>) {","    for (const id of new Set([...Object.keys(baseline), ...Object.keys(current)])) {","      if (baseline[id] !== current[id]) throw new Error(`MERGE_REQUIRED: diagram ${id} advanced; automatic merge is not implemented`);","    }","    return { ...proposed };","  }","}"],"symbol":"DiagramRevisionEditor"}]},"baseline-de7e8a967acc555b8c2d":{"id":"baseline-de7e8a967acc555b8c2d","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"RevisionedDiagramService.generate","label":"RevisionedDiagramService.generate","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-de7e8a967acc555b8c2d-range","path":"domain/core/diagrams/diagramService.ts","startLine":63,"endLine":73,"originalLines":["  async generate(request: DiagramGenerationRequest, options: GenerationOptions = {}) {","    if (!this.generator) throw Error('Diagram generation is unavailable in this runtime');","    options.signal?.throwIfAborted();","    if (request.baseRevisionId && this.getRevision(request.baseRevisionId).diagram.id !== request.input.id)","      throw Error('Generation base belongs to another diagram');","    const generated = await this.generator.generate(structuredClone(request), options);","    options.signal?.throwIfAborted();","    return request.baseRevisionId","      ? this.revise(request.baseRevisionId, { kind: 'replace', input: generated })","      : this.create({ ...request.input, ...generated, id: request.input.id, revision: 0 });","  }"],"symbol":"RevisionedDiagramService.generate"}]},"baseline-ab366226411d56b1b0fe":{"id":"baseline-ab366226411d56b1b0fe","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"DiagramGenerator","label":"DiagramGenerator","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-ab366226411d56b1b0fe-range","path":"domain/core/diagrams/diagramService.ts","startLine":23,"endLine":25,"originalLines":["export interface DiagramGenerator {","  generate(request: DiagramGenerationRequest, options: GenerationOptions): Promise<Omit<DiagramInput, 'id' | 'revision'>>;","}"],"symbol":"DiagramGenerator"}]},"baseline-437491f29f35bddb4287":{"id":"baseline-437491f29f35bddb4287","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"DiagramRevisionResult","label":"DiagramRevisionResult","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-437491f29f35bddb4287-range","path":"domain/core/diagrams/diagramService.ts","startLine":8,"endLine":8,"originalLines":["export interface DiagramRevisionResult extends PreparedDiagramEdit { readonly revision: DiagramRevision }"],"symbol":"DiagramRevisionResult"}]},"baseline-0e61b57a9c167a386d13":{"id":"baseline-0e61b57a9c167a386d13","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"RevisionedDiagramService","label":"RevisionedDiagramService","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-0e61b57a9c167a386d13-range","path":"domain/core/diagrams/diagramService.ts","startLine":36,"endLine":74,"originalLines":["export class RevisionedDiagramService implements DiagramService {","  constructor(private readonly generator?: DiagramGenerator) {}","  create(input: DiagramInput): DiagramRevisionResult {","    const prepared = new DiagramRevisionEditor({}, () => ({})).prepareCreate(input);","    return this.issue(prepared);","  }","  getRevision(revisionId: string) { return diagramRevisions.get(revisionId); }","  listRevisions(diagramId: string): readonly DiagramRevisionSummary[] {","    return Object.freeze(diagramRevisions.list(diagramId).map(({id, diagramId, parentId}) => Object.freeze({id, diagramId, parentId})));","  }","  revise(baseRevisionId: string, edit: DiagramEdit): DiagramRevisionResult {","    const base = this.getRevision(baseRevisionId);","    const prepared = new DiagramRevisionEditor({ [base.id]: base }, () => ({ [base.diagram.id]: base.id }))","      .prepareEdit('edit', base.diagram.id, edit);","    if (prepared.diagram === base.diagram) return { ...prepared, revision: base };","    return this.issue({ ...prepared, diagram: { ...prepared.diagram, diagramId: base.diagramId, revisionId: `diagram-revision-${crypto.randomUUID()}` } }, base);","  }","  private issue(prepared: PreparedDiagramEdit, base?: DiagramRevision): DiagramRevisionResult {","    const reverse = new Map([...prepared.nodeIds].map(([old, next]) => [next, old]));","    const record = diagramRevisions.register({ id: prepared.diagram.revisionId, diagramId: prepared.diagram.diagramId,","      ...(base ? { parentId: base.id } : {}), diagram: prepared.diagram,","      nodeRefs: Object.fromEntries(diagramContentNodes(prepared.diagram.content).map(node => {","        const old = reverse.get(node.id);","        return [node.id, old && base?.nodeRefs[old] || `node-${crypto.randomUUID()}`];","      })) });","    return { ...prepared, diagram: record.diagram, revision: record };","  }","  async generate(request: DiagramGenerationRequest, options: GenerationOptions = {}) {","    if (!this.generator) throw Error('Diagram generation is unavailable in this runtime');","    options.signal?.throwIfAborted();","    if (request.baseRevisionId && this.getRevision(request.baseRevisionId).diagram.id !== request.input.id)","      throw Error('Generation base belongs to another diagram');","    const generated = await this.generator.generate(structuredClone(request), options);","    options.signal?.throwIfAborted();","    return request.baseRevisionId","      ? this.revise(request.baseRevisionId, { kind: 'replace', input: generated })","      : this.create({ ...request.input, ...generated, id: request.input.id, revision: 0 });","  }","}"],"symbol":"RevisionedDiagramService"}]},"baseline-b486450fa6bb16363f32":{"id":"baseline-b486450fa6bb16363f32","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"CanvasHistoryService","label":"CanvasHistoryService","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-b486450fa6bb16363f32-range","path":"domain/core/diagrams/canvasHistoryService.ts","startLine":17,"endLine":34,"originalLines":["export interface CanvasHistoryService {","  prepareTransfer(context: CanvasEditingContext, input: TransferInput, destination?: CanvasEditingContext): PreparedCanvasTransfer;","  transferBoundary(context: CanvasEditingContext, transaction: CanvasTransfer, canvasId: string, redo?: boolean): boolean;","  prepareTransferNavigation(source: CanvasEditingContext, destination: CanvasEditingContext, transaction: CanvasTransfer, redo?: boolean): { source: TransferState; destination: TransferState; transaction: CanvasTransfer };","  openContext(document: ResolvedCanvasDocument, view: unknown, history?: CanvasHistoryRecord): CanvasEditingContext;","  state(context: CanvasEditingContext): CanvasContextState;","  resolve(context: CanvasEditingContext, diagramId: string): DiagramView;","  document(context: CanvasEditingContext): ResolvedCanvasDocument;","  append(context: CanvasEditingContext, document: ResolvedCanvasDocument, view: unknown, correspondence?: ReadonlyMap<string, string>): void;","  navigate(context: CanvasEditingContext, redo?: boolean): boolean;","  reset(context: CanvasEditingContext): void;","  /** Portable transport adapters; callers must not interpret diagram revision tables. */","  exportContext(context: CanvasEditingContext): CanvasHistoryRecord;","  persistenceChanges(context: CanvasEditingContext, since?: number): import(\"./canvasHistory\").HistoryChanges;","  retireTransactions(context: CanvasEditingContext, ids: ReadonlySet<string>): void;","  forkContext(context: CanvasEditingContext, view: unknown): CanvasHistoryRecord;","  adopt(context: CanvasEditingContext, proposed: CanvasHistoryRecord): void;","}"],"symbol":"CanvasHistoryService"}]},"baseline-9a6a0ed51a9eb0fcc14d":{"id":"baseline-9a6a0ed51a9eb0fcc14d","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"DiagramPersistence","label":"DiagramPersistence","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-9a6a0ed51a9eb0fcc14d-range","path":"domain/core/diagrams/diagramPersistence.ts","startLine":123,"endLine":127,"originalLines":["export class DiagramPersistence {","  constructor(private readonly store: DiagramRecordStore) {}","  persist(value: unknown) { return persistDiagramData(value, this.store); }","  async restore<T>(value: unknown, historyValidation: HistoryValidation = 'all'): Promise<T> { return restoreDiagramData(value, this.store, historyValidation) as Promise<T>; }","}"],"symbol":"DiagramPersistence"}]},"baseline-map-5c0a7e8431452eaac954":{"id":"baseline-map-5c0a7e8431452eaac954","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"RevisionedDiagramService.issue","label":"RevisionedDiagramService.issue","category":"operation","summary":"Verified source at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-map-5c0a7e84314