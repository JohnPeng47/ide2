.slice(i + 1))","      if (alternativesOverlap(selected[i], other, get)) throw Error('ALTERNATIVE_CONFLICT: deselect the overlapping alternative first');","  }"]}]}}}},"nodeRefs":{"diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-1":"node-fc2b8807-480b-4a40-8b43-15bffc71a082","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-3":"node-fe1b265e-91d6-4508-a709-72f4e4db3ed4","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-4":"node-246cfbc5-35da-45d6-b238-618c5337af8d","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-5":"node-85437d17-b144-44ae-b2f9-820244106242","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-6":"node-32034841-0296-40e3-9ef2-5061d103e3c1","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-7":"node-8709ee94-4218-44c1-a78d-c5bebd1a4ce7","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-8":"node-0b63fbf1-62b2-4cbb-8e8e-c2487e3d24d4","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-9":"node-42ac6653-64da-4450-a553-ddd908a0b8b5","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-11":"node-4e0a0e40-0b76-46e2-86b3-8af21cf71ac7","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-12":"node-70431feb-caf6-46db-a0e7-a11a21c93522","diagram-eafd5d87-8fa3-4f7b-90df-a139db91cd50:1:d53a91fa9dc215b7dd2b688d52bab1116160dd8e88298ad6dfe7e1de115aca4a:line-13":"node-a8a2cdc1-86a1-4e9f-a71e-0e1e795519db","d