ce captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-75631f93c5eca90d6035-range","path":"application/mapping/changes/changeSessionService.ts","startLine":295,"endLine":316,"originalLines":["  private validateReady(s: DiagramChangeSession) {","    if (!s.changes.length) throw new Error('Session has no changes');","    const visited = new Set<string>(), visiting = new Set<string>();","    const visit = (id: string) => {","      if (visiting.has(id)) throw new Error('Cyclic change dependency');","      if (visited.has(id)) return;","      const change = s.changes.find(c => c.id === id); if (!change) throw new Error('Unknown change dependency');","      visiting.add(id); change.dependsOn.forEach(visit); visiting.delete(id); visited.add(id);","    };","    s.changes.forEach(c => visit(c.id));","    for (const doc of s.documents) for (const edge of doc.proposed.document.edges) {","      validateConnectionAnchor(doc.proposed.document.scene, edge.source); validateConnectionAnchor(doc.proposed.document.scene, edge.target);","    }","    for (const change of s.changes.filter(c => c.type === 2)) {","      const doc = this.document(s, change.documentId);","      const connected = doc.proposed.document.edges.some(edge => edge.target.displayNodeId === change.nodeId","        && !!doc.baseline && !!connectionBox(doc.baseline.document.scene, edge.source.displayNodeId)","        && (doc.proposed.nodeOrigins ? !!doc.proposed.nodeOrigins[edge.source.contentNodeId]","          : Object.values(doc.baseline.document.scene.contents).some(d => diagramContentNodes(d.content).some(n => n.id === edge.source.contentNodeId))));","      if (!connected) throw new Error(`Added diagram needs an edge from an existing diagram: ${change.title}`);","    }","  }"],"symbol":"ChangeSessionService.validateReady"}]},"baseline-3c20e74847ec1c210996":{"id":"baseline-3c20e74847ec1c210996","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"ChangeSessionService.accept","label":"ChangeSessionService.accept","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-3c20e74847ec1c210996-range","path":"application/mapping/changes/changeSessionService.ts","startLine":79,"endLine":108,"originalLines":["  async accept(input: { changeSessionId: string; requestId: string; expectedVersion: number }) {","    return this.serialize(input.changeSessionId, async () => {","      const session = await this.get(input.changeSessionId);","      if (session.acceptance) {","        if (session.acceptance.requestId !== input.requestId || session.acceptance.sessionVersion !== input.expectedVersion)","          throw new Error('REQUEST_ID_CONFLICT: proposal already accepted');","        return summarizeChangeSession(session);","      }","      if (session.version !== input.expectedVersion) throw new Error('VERSION_CONFLICT: reread change session');","      if (session.status !== 'ready') throw new Error('Only a ready change session can be accepted');","      this.validateReady(session);","      const affected = session.documents.filter(d => session.changes.some(c => c.documentId === d.id));","      // Captured drafts must not silently replace newer edits in any live workspace.","      for (const canvas of this.bridge.list().filter(c => c.projectId === session.projectId)) for (const live of canvas.documents) {","        const doc = affected.find(d => d.id === live.documentId || !!d.representationId && d.representationId === live.representationId);","        if (!doc?.baseline) continue;","        const current = await this.bridge.dispatch(canvas.canvasId, { method: 'document-state', documentId: live.documentId }) as LiveDocumentState;","        if (stateKey(current.document) !== stateKey(doc.baseline.document) || current.name !== doc.name)","          throw new Error('VERSION_CONFLICT: live canvas changed since capture; create a new proposal');","      }","      const acceptance = await this.source.projectCatalogs.acceptCanvasChanges(session.projectId, {","        changeSessionId: session.id, sessionVersion: session.version, requestId: input.requestId, changeIds: session.changes.map(c => c.id),","        documents: affected.map(doc => ({ documentId: doc.id, representationId: doc.representationId, expectedRevisionId: doc.savedRevisionId,","          name: doc.name, document: doc.proposed.document, history: this.controller(doc).exportHistory() }))","      });","      // The catalog receipt recovers this step after a crash or a failed session write.","      await this.finishAcceptance(session, acceptance);","      return summarizeChangeSession(session);","    });","  }"],"symbol":"ChangeSessionService.accept"}]},"baseline-cbf06a6de986bcc147fd":{"id":"baseline-cbf06a6de986bcc147fd","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"CanvasCatalogStore","label":"CanvasCatalogStore","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-cbf06a6de986bcc147fd-range","path":"infrastructure/core/persistence/canvasCatalogStore.ts","startLine":16,"endLine":145,"originalLines":["export class CanvasCatalogStore {","  private readonly historyService = new DefaultCanvasHistoryService();","  constructor(readonly storeRoot: string,","    protected readonly diagramPersistence: DiagramPersistence = new DiagramPersistence(new DiagramRevisionStore(storeRoot))) {}","","  private representationWrite: Promise<unknown> = Promise.resolve();","  private serialize<T>(write: () => Promise<T>): Promise<T> {","    const result = this.representationWrite.then(write);","    this.representationWrite = result.catch(() => undefined);","    return result;","  }","","  saveProjection(projectId: string, projection: ProjectProjectionRecord) {","    return this.serialize(async () => {","      const catalog = await this.loadRepresentationCatalog(projectId);","      const result = rules.saveProjection(catalog, projectId, projection, catalogEnvironment());","      if (result.catalog !== catalog) await this.saveRepresentationCatalog(result.catalog);","      return result;","    });","  }","","  /** Persist the generated tree and its relationship in one catalog write. */","  saveProjectedTree(projectId: string, input: SaveProjectedTreeInput) {","    return this.serialize(async () => {","      const catalog = await this.loadRepresentationCatalog(projectId);","      const result = rules.saveProjectedTree(catalog, projectId, input, catalogEnvironment());","      if (result.catalog !== catalog) await this.saveRepresentationCatalog(result.catalog);","      return result;","    });","  }","","  saveMappingDiagram(projectId: string, input: SaveProjectDiagramInput) {","    return this.serialize(async () => {","      const catalog = await this.loadRepresentationCatalog(projectId);","      const result = rules.saveMappingDiagram(catalog, projectId, input, catalogEnvironment());","      if (result.catalog !== catalog) await this.saveRepresentationCatalog(result.catalog);","      return result;","    });","  }","","  acceptCanvasChanges(projectId: string, input: AcceptCanvasChangesInput): Promise<ChangeSessionAcceptance> {","    return this.serialize(async () => {","      let catalog = await this.loadRepresentationCatalog(projectId);","      const prior = catalog.changeSessionAcceptances?.[input.changeSessionId];","      if (prior) {","        if (prior.requestId !== input.requestId || prior.sessionVersion !== input.sessionVersion)","          throw new Error('REQUEST_ID_CONFLICT: proposal already accepted');","        return prior;","      }","      if (!input.documents.length || new Set(input.documents.map(d => d.documentId)).size !== input.documents.length)","        throw new Error('Acceptance requires distinct changed documents');","      const targets = input.documents.flatMap(d => d.representationId ? [d.representationId] : []);","      if (new Set(targets).size !== targets.length) throw new Error('Duplicate acceptance target');","      const acceptance: ChangeSessionAcceptance = { changeSessionId: input.changeSessionId, sessionVersion: input.sessionVersion,","        requestId: input.requestId, acceptedAt: new Date().toISOString(), changeIds: [...input.changeIds], documents: [] };","      for (const doc of input.documents) {","        const current = doc.representationId ? catalog.representations[doc.representationId] : undefined;","        if (doc.representationId && (!current || current.status !== 'settled' || current.currentRevisionId !== doc.expectedRevisionId))","          throw new Error('VERSION_CONFLICT: original canvas changed; create a new proposal');","        const proposed = this.historyService.openContext(doc.document, doc.history.snapshots[doc.history.headId].view, doc.history);","        let history = this.historyService.forkContext(proposed, doc.history.snapshots[doc.history.headId].view);","        let before: ChangeSessionAcceptance['documents'][number]['before'] = null;","        if (current) {","          const revision = catalog.revisions[current.currentRevisionId], saved = historyFromRevision(revision);","          const context = this.historyService.openContext(documentFromRevision(revision), saved?.snapshots[saved.headId].view ?? {}, saved);","          before = { revisionId: revision.id, checkpointId: this.historyService.state(context).checkpointId };","          this.historyService.adopt(context, doc.history);","          history = this.historyService.exportContext(context);","        }","        const result = rules.saveMappingDiagram(catalog, projectId, { name: doc.name, representationId: doc.representationId,","          expectedRevisionId: doc.expectedRevisionId, scene: doc.document.scene, edges: doc.document.edges, history }, catalogEnvironment());","        catalog = result.catalog;","        acceptance.documents.push({ documentId: doc.documentId, representationId: result.representation.id, before,","          after: { revisionId: result.representation.currentRevisionId, checkpointId: history.headId }, proposedCheckpointId: doc.history.headId });","      }","      catalog = { ...catalog, changeSessionAcceptances: { ...catalog.changeSessionAcceptances, [input.changeSessionId]: acceptance } };","      // A failure before this write publishes none of the canvases. The receipt and","      // all new heads become visible in the same atomic catalog replacement.","      await this.saveRepresentationCatalog(catalog);","      return acceptance;","    });","  }","","  private representationCatalogPath(): string {","    return path.join(this.storeRoot, 'canvases', 'catalog.json');","  }","","  private async readStoredCatalog(projectId: string) {","    const raw = await readJsonIfExists<ProjectRepresentationCatalogRecord>(this.representationCatalogPath())","      ?? await readJsonIfExists<ProjectRepresentationCatalogRecord>(path.join(this.storeRoot, 'representations', 'catalog.json'));","    if (raw && raw.projectId !== projectId) throw new Error('representation catalog belongs to another Project');","    return raw;","  }","","  /** Publication receipts contain no diagram references; listing proposals needs no restored catalog. */","  async loadChangeSessionAcceptances(projectId: string) {","    return (await this.readStoredCatalog(projectId))?.changeSessionAcceptances ?? {};","  }","","  async loadRepresentationCatalog(projectId: string, historyValidation: import('../../../domain/core/diagrams/canvasHistory').HistoryValidation = 'all'): Promise<ProjectRepresentationCatalogRecord> {","    await assertDiagramStorageFormat(this.storeRoot);","    const raw = await this.readStoredCatalog(projectId);","    const stored = raw == null ? null : await this.diagramPersistence.restore<ProjectRepresentationCatalogRecord>(raw, historyValidation);","    if (!stored) return emptyRepresentationCatalog(projectId);","    if (stored.projectId !== projectId) {","      throw new Error(\"representation catalog belongs to another Project\");","    }","    for (const revision of Object.values(stored.revisions)) if (revision.content?.kind !== 'canvas-history')","      throw new Error('Unsupported legacy diagram content: canvas history is required');","    return stored;","  }","","  async saveRepresentationCatalog(catalog: ProjectRepresentationCatalogRecord): Promise<void> {","    await writeJsonAtomic(this.representationCatalogPath(), await this.diagramPersistence.persist(catalog));","  }","","  archiveRepresentation(projectId: string, representationId: string) {","    return this.serialize(() => this.archiveRepresentationUnlocked(projectId, representationId));","  }","","  private async archiveRepresentationUnlocked(","    projectId: string,","    representationId: string","  ): Promise<ProjectRepresentationCatalogRecord> {","    const catalog = await this.loadRepresentationCatalog(projectId);","    const result = rules.archiveRepresentation(catalog, projectId, representationId, catalogEnvironment());","    if (result !== catalog) await this.saveRepresentationCatalog(result);","    return result;","  }","}"],"symbol":"CanvasCatalogStore"}]},"baseline-13aa1d4013dde3780e28":{"id":"baseline-13aa1d4013dde3780e28","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"AcceptCanvasChangesInput","label":"AcceptCanvasChangesInput","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-13aa1d4013dde3780e28-range","path":"domain/core/representations/changeAcceptance.ts","startLine":23,"endLine":36,"originalLines":["export interface AcceptCanvasChangesInput {","  changeSessionId: string;","  sessionVersion: number;","  requestId: string;","  changeIds: string[];","  documents: {","    documentId: string;","    representationId?: string;","    expectedRevisionId?: string;","    name: string;","    document: ResolvedCanvasDocument;","    history: CanvasHistoryRecord;","  }[];","}"],"symbol":"AcceptCanvasChangesInput"}]},"baseline-78462ac54d900430d01e":{"id":"baseline-78462ac54d900430d01e","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"ChangeSessionAcceptance","label":"ChangeSessionAcceptance","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-78462ac54d900430d01e-range","path":"domain/core/representations/changeAcceptance.ts","startLine":15,"endLine":22,"originalLines":["export interface ChangeSessionAcceptance {","  changeSessionId: string;","  sessionVersion: number;","  requestId: string;","  acceptedAt: string;","  changeIds: string[];","  documents: AcceptedCanvasChange[];","}"],"symbol":"ChangeSessionAcceptance"}]},"baseline-2ee416b66a0d86041bd1":{"id":"baseline-2ee416b66a0d86041bd1","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"AcceptedCanvasChange","label":"AcceptedCanvasChange","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-2ee416b66a0d86041bd1-range","path":"domain/core/representations/changeAcceptance.ts","startLine":8,"endLine":14,"originalLines":["export interface AcceptedCanvasChange {","  documentId: string;","  representationId: string;","  before: AcceptedCanvasRevision | null;","  after: AcceptedCanvasRevision;","  proposedCheckpointId: string;","}"],"symbol":"AcceptedCanvasChange"}]},"baseline-844e00a68ff32ec1c696":{"id":"baseline-844e00a68ff32ec1c696","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"ChangeSessionService.finishAcceptance","label":"ChangeSessionService.finishAcceptance","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-844e00a68ff32ec1c696-range","path":"application/mapping/changes/changeSessionService.ts","startLine":73,"endLine":78,"originalLines":["  private async finishAcceptance(session: DiagramChangeSession, acceptance: ChangeSessionAcceptance) {","    if (session.version !== acceptance.sessionVersion) throw new Error('Acceptance does not match saved proposal version');","    session.status = 'accepted'; session.acceptance = acceptance;","    session.version = acceptance.sessionVersion + 1; session.updatedAt = acceptance.acceptedAt;","    await this.repository.write(session, { documents: [], receipts: [] });","  }"],"symbol":"ChangeSessionService.finishAcceptance"}]}}},"diagramId":"diagram-1026a780d58c10907898f42615b5ff37a8f42544a9a2963c403a63e108768894","revisionId":"diagram-revision-16ef7ba9-d532-4703-aa27-b6870691845d"},"nodeRefs":{"diagram-081b7a35-6ffa-4104-883c-62510ff0859b:0:ccbf08afbdd2b64d415d5b4130a3c4631ecd80dbcf95d8505085dca470ac3c9d:line-2":"node-acaf4539-013e-481c-a040-b3d6682fe851","diagram-081b7a35-6ffa-4104-883c-62510ff0859b:0:ccbf08afbdd2b64d415d5b4130a3c4631ecd80dbcf95d8505085dca470ac3c9d:line-3":"node-2d287e6a-f740-431a-a2b2-6fec868de9a3","diagram-081b7a35-6ffa-4104-883c-62510ff0859b:0:ccbf08afbdd2b64d415d5b4130a3c4631ecd80dbcf95d8505085dca470ac3c9d:line-4":"node-11f40ba4-7f6b-4fdc-9e05-b6bc352a0492","diagram-081b7a35-6ffa-4104-883c-62510ff0859b:0:ccbf08afbdd2b64d415d5b4130a3c4631ecd80dbcf95d8505085dca470ac3c9d:line-5":"node-c8336c87-4444-487c-96fc-b34a264de6e9","diagram-081b7a35-6ffa-4104-883c-62510ff0859b:0:ccbf08afbdd2b64d415d5b4130a3c4631ecd80dbcf95d8505085dca470ac3c9d:line-6":"node-c5d1fdf5-1b23-4851-acea-1e07891fddf9","diagram-081b7a35-6ffa-4104-883c-62510ff0859b:0:ccbf08afbdd2b64d415d5b4130a3c4631ecd80dbcf95d8505085dca470ac3c9d:line-7":"node-9355fdaf-bf79-4773-b587-964d81a82750","diagram-081b7a35-6ffa-4104-883c-62510ff0859b:0:ccbf08afbdd2b64d415d5b4130a3c4631ecd80dbcf95d8505085dca470ac3c9d:line-8":"node-46b414d5-b51b-4bbc-a6d6-0f5b8b76b218","diagram-081b7a35-6ffa-4104-883c-62510ff0859b:0:ccbf08afbdd2b64d415d5b4130a3c4631ecd80dbcf95d8505085dca470ac3c9d:line-9":"node-936292d3-2ae4-4257-af6e-c6be5ea04686","diagram-081b7a35-6ffa-4104-883c-62510ff0859b:0:ccbf08afbdd2b64d415d5b4130a3c4631ecd80dbcf95d8505085dca470ac3c9d:line-10":"node-411656eb-8c69-4b05-9f91-245