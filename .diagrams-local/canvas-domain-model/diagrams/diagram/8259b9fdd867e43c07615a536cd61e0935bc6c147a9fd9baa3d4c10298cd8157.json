alidators are called when records are created or updated."," *"," * @example"," * ```ts"," * const bookValidator: StoreValidator<Book> = {"," *   validate(record: unknown): Book {"," *     // Validate and return the record"," *     if (typeof record !== 'object' || !record.title) {"," *       throw new Error('Invalid book')"," *     }"," *     return record as Book"," *   }"," * }"," * ```"," *"," * @public"," */","export interface StoreValidator<R extends UnknownRecord> {","\t/**","\t * Validate a record.","\t *","\t * @param record - The record to validate","\t * @returns The validated record","\t * @throws When validation fails","\t */","\tvalidate(record: unknown): R","\t/**","\t * Validate a record using a known good version for reference.","\t *","\t * @param knownGoodVersion - A known valid version of the record","\t * @param record - The record to validate","\t * @returns The validated record","\t */","\tvalidateUsingKnownGoodVersion?(knownGoodVersion: R, record: unknown): R","}","","/**"," * A map of validators for each record type in the store."," *"," * @example"," * ```ts"," * const validators: StoreValidators<Book | Author> = {"," *   book: bookValidator,"," *   author: authorValidator"," * }"," * ```"," *"," * @public"," */","export type StoreValidators<R extends UnknownRecord> = {","\t[K in R['typeName']]: StoreValidator<Extract<R, { typeName: K }>>","}","","/**"," * Information about an error that occurred in the store."," *"," * @example"," * ```ts"," * const error: StoreError = {"," *   error: new Error('Validation failed'),"," *   phase: 'updateRecord',"," *   recordBefore: oldRecord,"," *   recordAfter: newRecord,"," *   isExistingValidationIssue: false"," * }"," * ```"," *"," * @public"," */","export interface StoreError {","\t/** The error that occurred */","\terror: Error","\t/** The phase during which the error occurred */","\tphase: 'initialize' | 'createRecord' | 'updateRecord' | 'tests'","\t/** The record state before the operation (if applicable) */","\trecordBefore?: unknown","\t/** The record state after the operation */","\trecordAfter: unknown","\t/** Whether this is an existing validation issue */","\tisExistingValidationIssue: boolean","}","","/**"," * Extract the record type from a Store type."," * Used internally for type inference."," *"," * @internal"]}]},"T1a-source-1":{"id":"T1a-source-1","handle":"packages/store/src/lib/StoreSchema.ts","label":"Store.schema","category":"interface-data-struct","summary":"Source for Store.schema","sourceRanges":[{"id":"T1a-source-1-range","path":"packages/store/src/lib/StoreSchema.ts","startLine":199,"endLine":257,"originalLines":[" *"," * @public"," */","export interface StoreValidationFailure<R extends UnknownRecord> {","\terror: unknown","\tstore: Store<R>","\trecord: R","\tphase: 'initialize' | 'createRecord' | 'updateRecord' | 'tests'","\trecordBefore: R | null","}","","/**"," * Configuration options for creating a StoreSchema."," *"," * These options control migration behavior, validation error handling,"," * and integrity checking for the store schema."," *"," * @example"," * ```ts"," * const options: StoreSchemaOptions<MyRecord, MyProps> = {"," *   migrations: [bookMigrations, authorMigrations],"," *   onValidationFailure: (failure) => {"," *     // Log the error and return a corrected record"," *     console.error('Validation failed:', failure.error)"," *     return sanitizeRecord(failure.record)"," *   },"," *   createIntegrityChecker: (store) => {"," *     // Set up integrity checking logic"," *     return setupIntegrityChecks(store)"," *   }"," * }"," * ```"," *"," * @public"," */","export interface StoreSchemaOptions<R extends UnknownRecord, P> {","\tmigrations?: MigrationSequence[]","\t/** @public */","\tonValidationFailure?(data: StoreValidationFailure<R>): R","\t/** @internal */","\tcreateIntegrityChecker?(store: Store<R, P>): void","}","","/**"," * Manages the schema definition, validation, and migration system for a Store."," *"," * StoreSchema coordinates record types, handles data migrations between schema"," * versions, validates records, and provides the foundational structure for"," * reactive stores. It acts as the central authority for data consistency"," * and evolution within the store system."," *"," * @example"," * ```ts"," * // Define record types"," * const Book = createRecordType<Book>('book', { scope: 'document' })"," * const Author = createRecordType<Author>('author', { scope: 'document' })"," *"," * // Create schema with migrations"," * const schema = StoreSchema.create("]}]},"T1a-source-2":{"id":"T1a-source-2","handle":"packages/store/src/lib/Store.ts","label":"put()","category":"operation","summary":"Source for put()","sourceRanges":[{"id":"T1a-source-2-range","path":"packages/store/src/lib/Store.ts","startLine":600,"endLine":693,"originalLines":["\t *","\t * @param records - The records to add or update","\t * @param phaseOverride - Override the validation phase (used internally)","\t * @public","\t */","\tput(records: R[], phaseOverride?: 'initialize'): void {","\t\tthis.atomic(() => {","\t\t\tconst updates: Record<IdOf<UnknownRecord>, [from: R, to: R]> = {}","\t\t\tconst additions: Record<IdOf<UnknownRecord>, R> = {}","","\t\t\t// Iterate through all records, creating, updating or removing as needed","\t\t\tlet record: R","","\t\t\t// There's a chance that, despite having records, all of the values are","\t\t\t// identical to what they were before; and so we'd end up with an \"empty\"","\t\t\t// history entry. Let's keep track of whether we've actually made any","\t\t\t// changes (e.g. additions, deletions, or updates that produce a new value).","\t\t\tlet didChange = false","","\t\t\tconst source = this.isMergingRemoteChanges ? 'remote' : 'user'","","\t\t\tfor (let i = 0, n = records.length; i < n; i++) {","\t\t\t\trecord = records[i]","","\t\t\t\tconst initialValue = this.records.__unsafe__getWithoutCapture(record.id)","\t\t\t\t// If we already have an atom for this record, update its value.","\t\t\t\tif (initialValue) {","\t\t\t\t\t// If we have a beforeUpdate callback, run it against the initial and next records","\t\t\t\t\trecord = this.sideEffects.handleBeforeChange(initialValue, record, source)","","\t\t\t\t\t// Validate the record","\t\t\t\t\tconst validated = this.schema.validateRecord(","\t\t\t\t\t\tthis,","\t\t\t\t\t\trecord,","\t\t\t\t\t\tphaseOverride ?? 'updateRecord',","\t\t\t\t\t\tinitialValue","\t\t\t\t\t)","","\t\t\t\t\tif (validated === initialValue) continue","","\t\t\t\t\trecord = devFreeze(validated)","\t\t\t\t\tthis.records.set(record.id, record)","","\t\t\t\t\tdidChange = true","\t\t\t\t\tupdates[record.id] = [initialValue, record]","\t\t\t\t\tthis.addDiffForAfterEvent(initialValue, record)","\t\t\t\t} else {","\t\t\t\t\trecord = this.sideEffects.handleBeforeCreate(record, source)","","\t\t\t\t\tdidChange = true","","\t\t\t\t\t// If we don't have an atom, create one.","","\t\t\t\t\t// Validate the record","\t\t\t\t\trecord = this.schema.validateRecord(","\t\t\t\t\t\tthis,","\t\t\t\t\t\trecord as R,","\t\t\t\t\t\tphaseOverride ?? 'createRecord',","\t\t\t\t\t\tnull","\t\t\t\t\t)","","\t\t\t\t\t// freeze it","\t\t\t\t\trecord = devFreeze(record)","","\t\t\t\t\t// Mark the change as a new addition.","\t\t\t\t\tadditions[record.id] = record","\t\t\t\t\tthis.addDiffForAfterEvent(null, record)","","\t\t\t\t\tthis.records.set(record.id, record)","\t\t\t\t}","\t\t\t}","","\t\t\t// If we did change, update the history","\t\t\tif (!didChange) return","\t\t\tthis.updateHistory({","\t\t\t\tadded: additions,","\t\t\t\tupdated: updates,","\t\t\t\tremoved: {} as Record<IdOf<R>, R>,","\t\t\t})","\t\t})","\t}","","\t/**","\t * Remove records from the store by their IDs.","\t *","\t * @example","\t * ```ts","\t * // Remove a single record","\t * store.remove([book.id])","\t *","\t * // Remove multiple records","\t * store.remove([book1.id, book2.id, book3.id])","\t * ```","\t *"]}]},"T1a-source-3":{"id":"T1a-source-3","handle":"packages/store/src/lib/Store.ts","label":"listen()","category":"operation","summary":"Source for listen()","sourceRanges":[{"id":"T1a-source-3-range","path":"packages/store/src/lib/Store.ts","startLine":979,"endLine":1020,"originalLines":["\tlisten(onHistory: StoreListener<R>, filters?: Partial<StoreListenerFilters>) {","\t\t// flush history so that this listener's history starts from exactly now","\t\tthis._flushHistory()","","\t\tconst listener = {","\t\t\tonHistory,","\t\t\tfilters: {","\t\t\t\tsource: filters?.source ?? 'all',","\t\t\t\tscope: filters?.scope ?? 'all',","\t\t\t},","\t\t}","","\t\tif (!this.historyReactor.scheduler.isActivelyListening) {","\t\t\tthis.historyReactor.start()","\t\t\tthis.historyReactor.scheduler.execute()","\t\t}","","\t\tthis.listeners.add(listener)","","\t\treturn () => {","\t\t\tthis.listeners.delete(listener)","","\t\t\tif (this.listeners.size === 0) {","\t\t\t\tthis.historyReactor.stop()","\t\t\t}","\t\t}","\t}","","\tprivate isMergingRemoteChanges = false","","\t/**","\t * Merge changes from a remote source. Changes made within the provided function","\t * will be marked with source 'remote' instead of 'user'.","\t *","\t * @example","\t * ```ts","\t * // Changes from sync/collaboration","\t * store.mergeRemoteChanges(() => {","\t *   store.put(remoteRecords)","\t *   store.remove(deletedIds)","\t * })","\t * ```"]}]}}}}