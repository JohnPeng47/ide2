ines":["/** Review workflow metadata over revisions; presentation does not require this record. */","export const diagramRevisionReviewSchema = z.object({","  id, name: z.string().trim().min(1).max(120), diagramId: id, contentId: id,","  /** 'root' is the synthetic owner of the complete diagram. */","  contextVariantId: id.optional(),","  replacementScope: z.object({ mode: z.enum(['multi-contiguous', 'multi-disjoint']),","    ranges: z.array(z.object({ startLine: z.number().int().positive(), endLine: z.number().int().nonnegative() }).strict()).min(1).max(100) }).strict().optional(),","  ownerNodeId: id, baseRevisionId: id, headRevisionId: id,","  revisionIds: z.array(id).min(1).max(1000),","  prompt: z.string().max(20000).optional(),","  decisions: z.record(id, z.enum(['accept', 'reject'])),","  /** Last installation, used as the three-way base when changing review decisions. */","  appliedRevisionId: id.optional(),","  appliedReview: z.object({ headRevisionId: id, decisions: z.record(id, z.enum(['accept', 'reject'])) }).strict().optional()","}).strict();","export type DiagramRevisionReview = z.infer<typeof diagramRevisionReviewSchema>;","export type RevisionDecision = 'accept' | 'reject';","interface NodeState { label: string; parentId?: string; childIds: string[] }"]}]},"proposal1-evidence-controller":{"id":"proposal1-evidence-controller","sourceId":"source-proposal1-current-worktree","handle":"controller","label":"nodes.reviewVariant(..., decisions)","category":"operation","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-controller-range","path":"domain/mapping/workspace/mappingDocumentController.ts","startLine":362,"endLine":397,"originalLines":["      } else if (op.method === 'variant-review') {","        const previous = document.revisionReviews?.[op.variantId];","        if (!previous) throw Error('Variant not found');","        if (op.nodeId) {","          const box = findBox(document.scene.root, this.gridId(op.nodeId));","          if (box?.kind !== 'diagram' || box.contentId !== previous.contentId) throw Error('Variant belongs to another diagram');","        }","        const variant = structuredClone(previous);","        if (op.name !== undefined) variant.name = op.name.trim();","        if (op.decisions) {","          const changes = revisionChanges(getDiagramRevision(variant.baseRevisionId), getDiagramRevision(variant.headRevisionId), variant.ownerNodeId);","          for (const [id, decision] of Object.entries(op.decisions)) {","            if (!changes.some(c => c.id === id) || !['accept', 'reject'].includes(decision)) throw Error('Invalid review decision');","            variant.decisions[id] = decision;","          }","        }","        validateRevisionReview(variant, id => getDiagramRevision(id));","        if (op.apply) {","          const box = op.nodeId && findBox(document.scene.root, this.gridId(op.nodeId));","          if (!box || box.kind !== 'diagram' || box.contentId !== variant.contentId) throw Error('Select a placement of this variant’s diagram');","          const before = document.scene.contents[box.contentId];","          const prepared = retainDiagramRevision(applyRevisionReview(variant, getDiagramRevision(before.revisionId), getDiagramRevision));","          this.trackNodes(prepared.nodeIds);","          const scene = layoutScene({ ...document.scene, contents: { ...document.scene.contents, [before.id]: prepared.diagram } }, box.id);","          document = { ...document, scene, edges: reconcileConnections(document.scene, scene, document.edges, prepared.nodeIds) };","          for (const [id, view] of Object.entries(canvas.diagramViews ?? {})) {","            const owner = connectionBox(scene, id);","            if (owner?.kind === 'diagram' && owner.contentId === before.id && view.contentRevisionId === before.content.revisionId)","              canvas.diagramViews![id] = { contentRevisionId: prepared.diagram.content.revisionId,","                collapsedContentNodeIds: view.collapsedContentNodeIds.flatMap(id => prepared.nodeIds.has(id) ? [prepared.nodeIds.get(id)!] : []) };","          }","          variant.appliedRevisionId = prepared.revision.id;","          variant.appliedReview = { headRevisionId: variant.headRevisionId, decisions: { ...variant.decisions } };","        }","        document.revisionReviews = { ...document.revisionReviews, [variant.id]: variant };","        if (op.remove) {"]}]},"proposal1-evidence-apply":{"id":"proposal1-evidence-apply","sourceId":"source-proposal1-current-worktree","handle":"apply","label":"nodes.reviewVariant(..., apply: true)","category":"operation","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-apply-range","path":"domain/core/diagrams/diagramRevisionReview.ts","startLine":115,"endLine":149,"originalLines":["export function applyRevisionReview(variant: DiagramRevisionReview, current: DiagramRevision, get: (id: string) => DiagramRevision) {","  validateRevisionReview(variant, id => get(id));","  if (current.diagramId !== variant.diagramId || current.diagram.id !== variant.contentId) throw Error('Variant belongs to another diagram');","  const base = get(variant.baseRevisionId), candidate = get(variant.headRevisionId);","  const desired = approvedTree(variant, base, candidate);","  const before = variant.appliedReview ? approvedTree({ ...variant, ...variant.appliedReview }, base, get(variant.appliedReview.headRevisionId)) : scopedTree(base, variant.ownerNodeId);","  const live = scopedTree(current, variant.ownerNodeId), merged = structuredClone(live);","  for (const id of new Set([...Object.keys(before), ...Object.keys(desired)])) {","    if (same(before[id], desired[id])) continue;","    // Fields merge separately, so a label review does not overwrite newly added children.","    const from = before[id], to = desired[id], now = live[id];","    if (from && to && now) {","      for (const field of ['label', 'parentId', 'childIds'] as const) if (!same(from[field], to[field])) {","        if (!same(now[field], from[field]) && !same(now[field], to[field])) throw Error(`VARIANT_CONFLICT: ${now.label} changed since this review`);","        (merged[id] as any)[field] = structuredClone(to[field]);","      }","    } else {","      if (!same(now, from) && !same(now, to)) throw Error(`VARIANT_CONFLICT: ${to?.label ?? from?.label ?? id} changed since this review`);","      if (to) merged[id] = structuredClone(to); else delete merged[id];","    }","  }","  checkTree(merged);","  if (same(merged, live)) return { diagram: current.diagram, revision: current, nodeIds: new Map(Object.keys(current.nodeRefs).map(id => [id, id])) };","  const range = revisionScope(current, variant.ownerNodeId), oldLines = current.diagram.content.ascii.split('\\n');","  const lines: string[] = [], refs: Record<string, number> = {};","  const sameTopology = Object.keys(merged).length === Object.keys(live).length && Object.entries(merged).every(([id, node]) =>","    live[id] && node.parentId === live[id].parentId && same(node.childIds, live[id].childIds));","  if (current.diagram.content.structure.kind === 'diagram' || merged[rootId].label) lines.push(...merged[rootId].label.split('\\n'));","  else if (sameTopology) {","    lines.push(...oldLines.slice(range.startLine - 1, range.endLine));","    for (const node of diagramContentNodes(current.diagram.content)) {","      const ref = current.nodeRefs[node.id];","      if (!merged[ref]) continue;","      const index = node.line - range.startLine;","      lines[index] = lines[index].slice(0, node.startColumn - 1) + merged[ref].label + lines[index].slice(node.endColumn);"]}]},"proposal1-evidence-alternative":{"id":"proposal1-evidence-alternative","sourceId":"source-proposal1-current-worktree","handle":"alternative","label":"alternative.reviewId","category":"interface-data-struct","summary":"Captured from the current working tree for Proposal 1.","sourceRanges":[{"id":"proposal1-alternative-range","path":"domain/core/presentation/diagramAlternative.ts","startLine":9,"endLine":33,"originalLines":["const id = z.string().min(1).max(500).refine(s => !['__proto__', 'constructor', 'prototype'].includes(s));","export const alternativeScopeSchema = z.discriminatedUnion('kind', [z.object({ kind: z.literal('diagram') }).strict(),","  z.object({ kind: z.literal('subtree'), nodeRef: id }).strict()]);","export type DiagramScope = z.infer<typeof alternativeScopeSchema>;","export const alternativePartSchema = z.object({ target: alternativeScopeSchema,","  source: z.object({ revisionId: id, scope: alternativeScopeSchema }).strict(), baseRevisionId: id }).strict();","export const diagramAlternativeSchema = z.object({ id, name: z.string().trim().min(1).max(120), diagramId: id,","  presentationId: id, display: z.enum(['regular', 'diff']).optional(), parentAlternativeId: id.optional(), reviewId: id.optional(),","  parts: z.array(alternativePartSchema).min(1).max(100) }).strict();","export type DiagramAlternative = z.infer<typeof diagramAlternativeSchema>;","export type DiagramAlternativePart = z.infer<typeof alternativePartSchema>;","export const diagramSidePanelSchema = z.object({ id, kind: z.literal('diagram-side-panel'),","  attachment: z.object({ diagramPresentationId: id, nodeRef: id }).strict(), alternativeId: id,","  partIndex: z.number().int().nonnegative(), placement: z.enum(['flow', 'overlay']),","  display: z.enum(['regular', 'diff']), side: z.enum(['left', 'right']) }).strict();","export type DiagramSidePanel = z.infer<typeof diagramSidePanelSchema>;","export const diagramAlternativesSchema = z.object({ schemaVersion: z.literal(1),","  items: z.record(id, diagramAlternativeSchema), selected: z.record(id, z.array(id).max(1000)),","  panels: z.record(id, diagramSidePanelSchema) }).strict();","export type DiagramAlternatives = z.infer<typeof diagramAlternativesSchema>;","export const emptyDiagramAlternatives = (): DiagramAlternatives => ({ schemaVersion: 1, items: {}, selected: {}, panels: {} });","export const scopeOwner = (scope: DiagramScope) => scope.kind === 'diagram' ? 'root' : scope.nodeRef;","export const ownerScope = (owner: string): DiagramScope => owner === 'root' ? { kind: 'diagram' } : { kind: 'subtree', nodeRef: owner };","export const alternativeRevisionIds = (state?: DiagramAlternatives) => [...new Set(Object.values(state?.items ?? {}).flatMap(item => item.parts.flatMap(part => [part.baseRevisionId, part.source.revisionId])))];","const stableId = (...parts: string[]) => `alternative-${sha256(JSON.stringify(parts)).slice(0, 32)}`;"]}]}}}}