nager.ts","startLine":96,"endLine":123,"originalLines":["","\tbatch(fn: () => void, opts?: TLHistoryBatchOptions) {","\t\tconst previousState = this.state","","\t\t// we move to the new state only if we haven't explicitly paused","\t\tif (previousState !== HistoryRecorderState.Paused && opts?.history) {","\t\t\tthis.state = modeToState[opts.history]","\t\t}","","\t\ttry {","\t\t\tif (this._isInBatch) {","\t\t\t\ttransact(fn)","\t\t\t\treturn this","\t\t\t}","","\t\t\tthis._isInBatch = true","\t\t\ttry {","\t\t\t\ttransact(fn)","\t\t\t} catch (error) {","\t\t\t\tthis.annotateError(error)","\t\t\t\tthrow error","\t\t\t} finally {","\t\t\t\tthis._isInBatch = false","\t\t\t}","","\t\t\treturn this","\t\t} finally {","\t\t\tthis.state = previousState"]}]},"T2b-source-2":{"id":"T2b-source-2","handle":"packages/editor/src/lib/editor/managers/HistoryManager/HistoryManager.ts","label":"markHistoryStoppingPoint()","category":"operation","summary":"Source for markHistoryStoppingPoint()","sourceRanges":[{"id":"T2b-source-2-range","path":"packages/editor/src/lib/editor/managers/HistoryManager/HistoryManager.ts","startLine":300,"endLine":325,"originalLines":["\t\treturn this","\t}","","\t/** @internal */","\t_mark(id: string) {","\t\ttransact(() => {","\t\t\tthis.flushPendingDiff()","\t\t\tthis.stacks.update(({ undos, redos }) => ({ undos: undos.push({ type: 'stop', id }), redos }))","\t\t})","\t}","","\tclear() {","\t\tthis.stacks.set({ undos: stack(), redos: stack() })","\t\tthis.pendingDiff.clear()","\t}","","\t/** @internal */","\tgetMarkIdMatching(idSubstring: string) {","\t\tlet top = this.stacks.get().undos","\t\twhile (top.head) {","\t\t\tif (top.head.type === 'stop' && top.head.id.includes(idSubstring)) {","\t\t\t\treturn top.head.id","\t\t\t}","\t\t\ttop = top.tail","\t\t}","\t\treturn null"]}]},"T2b-source-3":{"id":"T2b-source-3","handle":"packages/editor/src/lib/editor/managers/HistoryManager/HistoryManager.ts","label":"squashToMark","category":"interface-data-struct","summary":"Source for squashToMark","sourceRanges":[{"id":"T2b-source-3-range","path":"packages/editor/src/lib/editor/managers/HistoryManager/HistoryManager.ts","startLine":268,"endLine":301,"originalLines":["\tsquashToMark(id: string) {","\t\t// remove marks between head and the mark","","\t\tlet top = this.stacks.get().undos","\t\tconst popped: Array<RecordsDiff<R>> = []","","\t\twhile (top.head && !(top.head.type === 'stop' && top.head.id === id)) {","\t\t\tif (top.head.type === 'diff') {","\t\t\t\tpopped.push(top.head.diff)","\t\t\t}","\t\t\ttop = top.tail","\t\t}","","\t\tif (!top.head || top.head?.id !== id) {","\t\t\tconsole.error('Could not find mark to squash to: ', id)","\t\t\treturn this","\t\t}","\t\tif (popped.length === 0) {","\t\t\treturn this","\t\t}","","\t\tconst diff = createEmptyRecordsDiff<R>()","\t\tsquashRecordDiffsMutable(diff, popped.reverse())","","\t\tthis.stacks.update(({ redos }) => ({","\t\t\tundos: top.push({","\t\t\t\ttype: 'diff',","\t\t\t\tdiff,","\t\t\t}),","\t\t\tredos,","\t\t}))","","\t\treturn this","\t}"]}]}}}}