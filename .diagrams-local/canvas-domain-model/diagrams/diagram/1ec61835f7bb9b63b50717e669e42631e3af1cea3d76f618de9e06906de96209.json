3fe4f45713dca806c6aa1ba8","handle":"measureContent","label":"measureContent","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-43a69015a580443e95e3-range","path":"domain/core/diagrams/lineGrid.ts","startLine":45,"endLine":49,"originalLines":["export function measureContent(ascii: string): GridSize {","  if (/[^\\x20-\\x7e\\n]/.test(ascii)) throw new Error(\"Grid content must be printable ASCII with LF newlines\");","  const lines = ascii.split(\"\\n\");","  return { columns: Math.max(1, ...lines.map((line) => line.length)), rows: lines.length };","}"],"symbol":"measureContent"}]},"baseline-71c3c3cdf50d485c0ddb":{"id":"baseline-71c3c3cdf50d485c0ddb","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"layoutScene","label":"layoutScene","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-71c3c3cdf50d485c0ddb-range","path":"domain/core/diagrams/lineGrid.ts","startLine":126,"endLine":160,"originalLines":["export function layoutScene(scene: LineGridScene, changedId: string): LineGridScene {","  function visit(box: GridBox): { box: GridBox; changed: boolean } {","    if (box.kind === \"diagram\") return { box, changed: box.id === changedId };","    const descendants = box.children.map(visit);","    let children = descendants.map((child) => child.box);","    const anchoredId = descendants.find((child) => child.changed)?.box.id;","    if (!box.collapsed) {","      const measure = (child: GridBox) => resolveScene({ ...scene, root: child }).bounds;","      const ordered = children.map((child, index) => ({ child, index })).sort((a, b) =>","        Number(b.child.id === anchoredId) - Number(a.child.id === anchoredId)","        || a.child.position.column - b.child.position.column","        || a.child.position.row - b.child.position.row || a.index - b.index);","      const settled: GridBounds[] = [];","      const replacements = new Map<string, GridBox>();","      for (const { child } of ordered) {","        const bounds = { ...measure(child) };","        let collisions = settled.filter((other) => boxesOverlap(bounds, other, box.layout.gap));","        while (collisions.length) {","          bounds.column = Math.max(...collisions.map((other) => other.column + other.columns + box.layout.gap));","          collisions = settled.filter((other) => boxesOverlap(bounds, other, box.layout.gap));","        }","        settled.push(bounds);","        replacements.set(child.id, { ...child, position: { column: bounds.column, row: bounds.row } });","      }","      children = children.map((child) => replacements.get(child.id)!);","    }","    return { box: { ...box, children }, changed: box.id === changedId || descendants.some((child) => child.changed) };","  }","  const result = visit(scene.root);","  if (!result.changed) throw new Error(`Unknown GridBox: ${changedId}`);","  const next = { ...scene, root: result.box };","  // Check all final bounds before publishing a transaction.","  composeScene(next);","  return next;","}"],"symbol":"layoutScene"}]}}},"diagramId":"diagram-c378b08d8c361244438637f3b803fc45a85d753f98e7be2461b1111b51f034de","revisionId":"diagram-revision-1b3bf54f-7e06-4109-8156-b0498fdc3fd7"}