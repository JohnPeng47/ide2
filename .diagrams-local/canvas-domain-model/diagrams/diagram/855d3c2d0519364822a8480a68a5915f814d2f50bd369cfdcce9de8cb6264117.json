\t\t\t\t\t}","","\t\t\t\t\tswitch (undo.type) {","\t\t\t\t\t\tcase 'diff':","\t\t\t\t\t\t\tsquashRecordDiffsMutable(diffToUndo, [reverseRecordsDiff(undo.diff)])","\t\t\t\t\t\t\tbreak","\t\t\t\t\t\tcase 'stop':","\t\t\t\t\t\t\tif (!toMark) break loop","\t\t\t\t\t\t\tif (undo.id === toMark) {","\t\t\t\t\t\t\t\tdidFindMark = true","\t\t\t\t\t\t\t\tbreak loop","\t\t\t\t\t\t\t}","\t\t\t\t\t\t\tbreak","\t\t\t\t\t\tdefault:","\t\t\t\t\t\t\texhaustiveSwitchError(undo)","\t\t\t\t\t}","\t\t\t\t}","\t\t\t}","","\t\t\tif (!didFindMark && toMark) {","\t\t\t\t// we didn't find the mark we were looking for — restore state and bail","\t\t\t\tthis.pendingDiff.restore(pendingDiff)","\t\t\t\treturn this","\t\t\t}","\t\t\tthis.store.applyDiff(diffToUndo, { ignoreEphemeralKeys: true })","\t\t\tthis.store.ensureStoreIsUsable()","\t\t\tthis.stacks.set({ undos, redos })","\t\t} finally {","\t\t\tthis._isReplaying = previousIsReplaying","\t\t\tthis.state = previousState","\t\t}","","\t\treturn this","\t}","","\tundo() {","\t\tthis._undo({ pushToRedoStack: true })","","\t\treturn this","\t}","","\tredo() {","\t\tconst previousState = this.state"]}]},"T2a-source-3":{"id":"T2a-source-3","handle":"packages/editor/src/lib/config/TLEditorSnapshot.ts","label":"TLEditorSnapshot","category":"interface-data-struct","summary":"Source for TLEditorSnapshot","sourceRanges":[{"id":"T2a-source-3-range","path":"packages/editor/src/lib/config/TLEditorSnapshot.ts","startLine":11,"endLine":15,"originalLines":["export interface TLEditorSnapshot {","\tdocument: TLStoreSnapshot","\tsession: TLSessionStateSnapshot","}",""]}]}}}}