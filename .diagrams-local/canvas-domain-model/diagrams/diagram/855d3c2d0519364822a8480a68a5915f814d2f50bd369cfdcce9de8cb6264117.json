\t\t\t\tthis.pendingDiff.apply(entry.changes)","\t\t\t\t\t// this interceptor runs for every store change, so skip the update when the","\t\t\t\t\t// redo stack is already empty","\t\t\t\t\tif (this.stacks.get().redos.length > 0) {","\t\t\t\t\t\tthis.stacks.update(({ undos }) => ({ undos, redos: stack() }))","\t\t\t\t\t}","\t\t\t\t\tbreak","\t\t\t\tcase HistoryRecorderState.RecordingPreserveRedoStack:","\t\t\t\t\tthis.pendingDiff.apply(entry.changes)","\t\t\t\t\tbreak","\t\t\t\tcase HistoryRecorderState.Paused:","\t\t\t\t\tbreak","\t\t\t\tdefault:","\t\t\t\t\texhaustiveSwitchError(this.state)","\t\t\t}","\t\t})","\t}","","\tprivate flushPendingDiff() {","\t\tif (this.pendingDiff.isEmpty()) return","","\t\tconst diff = this.pendingDiff.clear()","\t\tthis.stacks.update(({ undos, redos }) => ({","\t\t\tundos: undos.push({ type: 'diff', diff }),","\t\t\tredos,","\t\t}))","\t}","","\tgetNumUndos() {","\t\treturn this.stacks.get().undos.length + (this.pendingDiff.isEmpty() ? 0 : 1)","\t}","","\tgetNumRedos() {"]}]},"T2a-source-1":{"id":"T2a-source-1","handle":"packages/editor/src/lib/editor/managers/HistoryManager/HistoryManager.ts","label":"run()","category":"operation","summary":"Source for run()","sourceRanges":[{"id":"T2a-source-1-range","path":"packages/editor/src/lib/editor/managers/HistoryManager/HistoryManager.ts","startLine":96,"endLine":123,"originalLines":["","\tbatch(fn: () => void, opts?: TLHistoryBatchOptions) {","\t\tconst previousState = this.state","","\t\t// we move to the new state only if we haven't explicitly paused","\t\tif (previousState !== HistoryRecorderState.Paused && opts?.history) {","\t\t\tthis.state = modeToState[opts.history]","\t\t}","","\t\ttry {","\t\t\tif (this._isInBatch) {","\t\t\t\ttransact(fn)","\t\t\t\treturn this","\t\t\t}","","\t\t\tthis._isInBatch = true","\t\t\ttry {","\t\t\t\ttransact(fn)","\t\t\t} catch (error) {","\t\t\t\tthis.annotateError(error)","\t\t\t\tthrow error","\t\t\t} finally {","\t\t\t\tthis._isInBatch = false","