: string; ascii: string; sectionId?: string;","}"],"symbol":"DetailPane"}]},"baseline-fb333aba33b63691cafc":{"id":"baseline-fb333aba33b63691cafc","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"layoutFloatingSelections","label":"layoutFloatingSelections","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-fb333aba33b63691cafc-range","path":"domain/mapping/workspace/floatingBoxLayout.ts","startLine":7,"endLine":28,"originalLines":["export function layoutFloatingSelections(state: DisplayState, boxes: readonly ResolvedGridBox[], scene: LineGridScene, cell: { width: number; height: number }, views?: DiagramViews): DisplayState {","  if (!cell.width || !cell.height) return state;","  let next = state;","  for (const id of state.rootIds) {","    const root = next.nodes[id]; if (root?.kind !== 'selection') continue;","    const box = boxes.find(box => box.box.id === root.sourceBoxId);","    if (box && !box.box.collapsed && scene.contents[root.sourceContentId]?.content.ascii === root.sourceAscii) {","      const rect = diagramProjection(scene, root.sourceBoxId, root.sourceContentId, views).rect(root.rect);","      if (!rect) continue;","      next = updateDisplayGeometry(next, id, {","        ...(root.geometryPolicy.placement === 'automatic' ? { position: {","          x: (box.bounds.column + root.rect.startColumn - 1) * cell.width,","          y: (box.bounds.row + rect.startLine - 1) * cell.height } } : {}),","        ...(root.geometryPolicy.sizing === 'content' ? { bounds: {","          width: (root.rect.endColumn - root.rect.startColumn + 1) * cell.width,","          height: (rect.endLine - rect.startLine + 1) * cell.height } } : {})","      });","    }","    next = layoutProjectedPanes(next, next.nodes[id] as typeof root).state;","  }","  return next;","}"],"symbol":"layoutFloatingSelections"}]}}},"diagramId":"diagram-ea9c032bfbc9997c78af431beeea6651667178c4c2e53428cbba479839de166e","revisionId":"diag