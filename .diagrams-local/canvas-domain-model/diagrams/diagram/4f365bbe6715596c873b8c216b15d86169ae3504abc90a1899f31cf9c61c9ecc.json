LStoreOptions = {}): TLStore {","\tconst resolvedThemes = resolveThemes(themes)","\tregisterColorsFromThemes(resolvedThemes)","\tregisterFontsFromThemes(resolvedThemes)","\tconst schema = createTLSchemaFromUtils(rest)","","\tconst store = new Store({","\t\tid,","\t\tschema,","\t\tinitialData,","\t\tprops: {","\t\t\tdefaultName,","\t\t\tassets: {","\t\t\t\tupload: assets.upload,","\t\t\t\tresolve: assets.resolve ?? defaultAssetResolve,","\t\t\t\tremove: assets.remove ?? (() => Promise.resolve()),","\t\t\t},","\t\t\tusers: {","\t\t\t\tcurrentUser: users.currentUser,","\t\t\t\tresolve:","\t\t\t\t\tusers.resolve ??","\t\t\t\t\tcreateCachedUserResolve((userId) => {","\t\t\t\t\t\tconst current = users.currentUser.get()","\t\t\t\t\t\treturn current && current.id === createUserId(userId) ? current : null","\t\t\t\t\t}),","\t\t\t},","\t\t\tonMount: (editor) => {","\t\t\t\tassert(editor instanceof Editor)","\t\t\t\treturn onMount?.(editor)","\t\t\t},","\t\t\tcollaboration,","\t\t},","\t})","","\tif (rest.snapshot) {","\t\tif (initialData) throw new Error('Cannot provide both initialData and snapshot')","\t\tloadSnapshot(store, rest.snapshot, { forceOverwriteSessionState: true })","\t}","","\treturn store","}","","function utilsToMap<T extends SchemaPropsInfo & { type: string }>(utils: T[]) {","\treturn Object.fromEntries(","\t\tutils.map((s): [string, SchemaPropsInfo] => [","\t\t\ts.type,","\t\t\t{","\t\t\t\tprops: s.props,","\t\t\t\tmigrations: s.migrations,","\t\t\t},","\t\t])","\t)","}"]}]},"T7b-source-1":{"id":"T7b-source-1","handle":"packages/store/src/lib/StoreSchema.ts","label":"StoreSchema.migrateStoreSnapshot","category":"interface-data-struct","summary":"Source for StoreSchema.migrateStoreSnapshot","sourceRanges":[{"id":"T7b-source-1-range","path":"packages/store/src/lib/StoreSchema.ts","startLine":672,"endLine":735,"originalLines":["\tmigrateStoreSnapshot(","\t\tsnapshot: StoreSnapshot<R>,","\t\topts?: { mutateInputStore?: boolean }","\t): MigrationResult<SerializedStore<R>> {","\t\tconst migrations = this.getMigrationsSince(snapshot.schema)","\t\tif (!migrations.ok) {","\t\t\t// TODO: better error","\t\t\tconsole.error('Error migrating store', migrations.error)","\t\t\treturn { type: 'error', reason: MigrationFailureReason.MigrationError }","\t\t}","\t\tconst migrationsToApply = migrations.value","\t\tif (migrationsToApply.length === 0) {","\t\t\treturn { type: 'success', value: snapshot.store }","\t\t}","\t\tconst store = Object.assign(","\t\t\tnew Map<string, R>(objectMapEntries(snapshot.store).map(devFreeze)),","\t\t\t{","\t\t\t\tgetSchema: () => snapshot.schema,","\t\t\t\tsetSchema: (_: SerializedSchema) => {},","\t\t\t}","\t\t)","\t\ttry {","\t\t\tthis.migrateStorage(store)","\t\t\tif (opts?.mutateInputStore) {","\t\t\t\tfor (const [id, record] of store.entries()) {","\t\t\t\t\tsnapshot.store[id as keyof typeof snapshot.store] = record","\t\t\t\t}","\t\t\t\tfor (const id of Object.keys(snapshot.store)) {","\t\t\t\t\tif (!store.has(id)) {","\t\t\t\t\t\tdelete snapshot.store[id as keyof typeof snapshot.store]","\t\t\t\t\t}","\t\t\t\t}","\t\t\t\treturn { type: 'success', value: snapshot.store }","\t\t\t} else {","\t\t\t\treturn {","\t\t\t\t\ttype: 'success',","\t\t\t\t\tvalue: Object.fromEntries(store.entries()) as SerializedStore<R>,","\t\t\t\t}","\t\t\t}","\t\t} catch (e) {","\t\t\tconsole.error('Error migrating store', e)","\t\t\treturn { type: 'error', reason: MigrationFailureReason.MigrationError }","\t\t}","\t}","","\t/**","\t * Creates an integrity checker function for the given store.","\t *","\t * This method calls the createIntegrityChecker option if provided, allowing","\t * custom integrity checking logic to be set up for the store. The integrity","\t * checker is used to validate store consistency and catch data corruption.","\t *","\t * @param store - The store instance to create an integrity checker for","\t * @returns An integrity checker function, or undefined if none is configured","\t *","\t * @internal","\t */","\tcreateIntegrityChecker(store: Store<R, P>): (() => void) | undefined {","\t\treturn this.options.createIntegrityChecker?.(store) ?? undefined","\t}","","\t/**","\t * Serializes the current schema to a SerializedSchemaV2 format.","\t *"]}]},"T7b-source-2":{"id":"T7b-source-2","handle":"packages/store/src/lib/Store.ts","label":"loadStoreSnapshot()","category":"operation","summary":"Source for loadStoreSnapshot()","sourceRanges":[{"id":"T7b-source-2-range","path":"packages/store/src/lib/Store.ts","startLine":850,"endLine":895,"originalLines":["\t * const snapshot = JSON.parse(localStorage.getItem('myApp'))","\t * store.loadStoreSnapshot(snapshot)","\t * ```","\t *","\t * @param snapshot - The snapshot to load","\t * @throws Error if migration fails or snapshot is invalid","\t * @public","\t */","\tloadStoreSnapshot(snapshot: StoreSnapshot<R>): void {","\t\tconst migrationResult = this.schema.migrateStoreSnapshot(snapshot)","","\t\tif (migrationResult.type === 'error') {","\t\t\tthrow new Error(`Failed to migrate snapshot: ${migrationResult.reason}`)","\t\t}","","\t\tconst prevSideEffectsEnabled = this.sideEffects.isEnabled()","\t\ttry {","\t\t\tthis.sideEffects.setIsEnabled(false)","\t\t\tthis.atomic(() => {","\t\t\t\tthis.clear()","\t\t\t\tthis.put(Object.values(migrationResult.value))","\t\t\t\tthis.ensureStoreIsUsable()","\t\t\t}, false)","\t\t} finally {","\t\t\tthis.sideEffects.setIsEnabled(prevSideEffectsEnabled)","\t\t}","\t}","","\t/**","\t * Get an array of all records in the store.","\t *","\t * @example","\t * ```ts","\t * const allRecords = store.allRecords()","\t * const books = allRecords.filter(r => r.typeName === 'book')","\t * ```","\t *","\t * @returns An array containing all records in the store","\t * @public","\t */","\tallRecords(): R[] {","\t\treturn Array.from(this.records.values())","\t}","","\t/**","\t * Remove all records from the store."]}]}}}}