":0,"sourceRangeId":"T7c-source-1-range","line":10,"startColumn":5,"endColumn":25},{"id":"T7c-source-2-map","entityId":"T7c-source-2","sourceRangeIndex":0,"sourceRangeId":"T7c-source-2-range","line":15,"startColumn":35,"endColumn":61},{"id":"T7c-source-3-map","entityId":"T7c-source-3","sourceRangeIndex":0,"sourceRangeId":"T7c-source-3-range","line":24,"startColumn":5,"endColumn":18}],"evidence":{"T7c-source-0":{"id":"T7c-source-0","handle":"packages/editor/src/lib/config/TLEditorSnapshot.ts","label":"Capture: getSnapshot(store)","category":"operation","summary":"Source for Capture: getSnapshot(store)","sourceRanges":[{"id":"T7c-source-0-range","path":"packages/editor/src/lib/config/TLEditorSnapshot.ts","startLine":97,"endLine":107,"originalLines":["\tconst sessionState$ = sessionStateCache.get(store, createSessionStateSnapshotSignal)","\tconst session = sessionState$.get()","\tif (!session) {","\t\tthrow new Error('Session state is not ready yet')","\t}","","\treturn {","\t\tdocument: store.getStoreSnapshot(),","\t\tsession,","\t}","}"]}]},"T7c-source-1":{"id":"T7c-source-1","handle":"packages/editor/src/lib/config/TLEditorSnapshot.ts","label":"Restore: loadSnapshot","category":"interface-data-struct","summary":"Source for Restore: loadSnapshot","sourceRanges":[{"id":"T7c-source-1-range","path":"packages/editor/src/lib/config/TLEditorSnapshot.ts","startLine":33,"endLine":90,"originalLines":["export function loadSnapshot(","\tstore: TLStore,","\t_snapshot: Partial<TLEditorSnapshot> | TLStoreSnapshot,","\topts?: TLLoadSnapshotOptions",") {","\tlet snapshot: Partial<TLEditorSnapshot> = {}","\tif ('store' in _snapshot) {","\t\t// regular old TLStoreSnapshot","\t\t// let's migrate it and then filter out the non-doc state to help folks out","\t\tconst migrationResult = store.schema.migrateStoreSnapshot(_snapshot)","\t\tif (migrationResult.type !== 'success') {","\t\t\tthrow new Error('Failed to migrate store snapshot: ' + migrationResult.reason)","\t\t}","","\t\tsnapshot.document = {","\t\t\tschema: store.schema.serialize(),","\t\t\tstore: filterEntries(migrationResult.value, (_, { typeName }) =>","\t\t\t\tstore.scopedTypes.document.has(typeName)","\t\t\t),","\t\t}","\t} else {","\t\t// TLEditorSnapshot","\t\tsnapshot = _snapshot","\t}","","\t// We need to preserve a bunch of instance state properties that the Editor sets","\t// to avoid breaking the editor or causing jarring changes when loading a snapshot.","\tconst preservingInstanceState = pluckPreservingValues(store.get(TLINSTANCE_ID))","\tconst preservingSessionState = sessionStateCache","\t\t.get(store, createSessionStateSnapshotSignal)","\t\t.get()","","\tstore.atomic(() => {","\t\t// first load the document state (this will wipe the store if it happens)","\t\tif (snapshot.document) {","\t\t\tstore.loadStoreSnapshot(snapshot.document)","\t\t}","","\t\t// then make sure we preserve those instance state properties that must be preserved","\t\t// this is a noop if the document state wasn't loaded above","\t\tif (preservingInstanceState) {","\t\t\tstore.update(TLINSTANCE_ID, (r) => ({ ...r, ...preservingInstanceState }))","\t\t}","\t\tif (preservingSessionState) {","\t\t\t// there's some duplication here with the instanceState but it's fine","\t\t\tloadSessionStateSnapshotIntoStore(store, preservingSessionState)","\t\t}","","\t\t// finally reinstate the UI state","\t\tif (snapshot.session) {","\t\t\tloadSessionStateSnapshotIntoStore(store, snapshot.session, {","\t\t\t\tforceOverwrite: opts?.forceOverwriteSessionState,","\t\t\t})","\t\t}","\t})","}","","const sessionStateCache = new WeakCache<"]}]},"T7c-source-2":{"id":"T7c-source-2","handle":"packages/store/src/lib/Store.ts","label":"loadStoreSnapshot(document)","category":"operation","summary":"Source for loadStoreSnapshot(document)","sourceRanges":[{"id":"T7c-source-2-range","path":"packages/store/src/lib/Store.ts","startLine":858,"endLine":888,"originalLines":["\tloadStoreSnapshot(snapshot: StoreSnapshot<R>): void {","\t\tconst migrationResult = this.schema.migrateStoreSnapshot(snapshot)","","\t\tif (migrationResult.type === 'error') {","\t\t\tthrow new Error(`Failed to migrate snapshot: ${migrationResult.reason}`)","\t\t}","","\t\tconst prevSideEffectsEnabled = this.sideEffects.isEnabled()","\t\ttry {","\t\t\tthis.sideEffects.setIsEnabled(false)","\t\t\tthis.atomic(() => {","\t\t\t\tthis.clear()","\t\t\t\tthis.put(Object.values(migrationResult.value))","\t\t\t\tthis.ensureStoreIsUsable()","\t\t\t}, false)","\t\t} finally {","\t\t\tthis.sideEffects.setIsEnabled(prevSideEffectsEnabled)","\t\t}","\t}","","\t/**","\t * Get an array of all records in the store.","\t *","\t * @example","\t * ```ts","\t * const allRecords = store.allRecords()","\t * const books = allRecords.filter(r => r.typeName === 'book')","\t * ```","\t *","\t * @returns An array containing all records in the store","\t * @public"]}]},"T7c-source-3":{"id":"T7c-source-3","handle":"packages/editor/src/lib/config/TLSessionStateSnapshot.ts","label":"Session loader","category":"interface-data-struct","summary":"Source for Session loader","sourceRanges":[{"id":"T7c-source-3-range","path":"packages/editor/src/lib/config/TLSessionStateSnapshot.ts","startLine":225,"endLine":329,"originalLines":[" * @param snapshot - The instance state snapshot to load"," * @returns"," */","export function loadSessionStateSnapshotIntoStore(","\tstore: TLStore,","\tsnapshot: TLSessionStateSnapshot,","\topts?: TLLoadSessionStateSnapshotOptions",") {","\tconst res = migrateAndValidateSessionStateSnapshot(snapshot)","\tif (!res) return","","\tconst existingInstance = store.get(TLINSTANCE_ID)","\tconst preserved = pluckPreservingValues(existingInstance)","\tconst primary = opts?.forceOverwrite ? res : preserved","\tconst secondary = opts?.forceOverwrite ? preserved : res","","\tconst instanceState = store.schema.types.instance.create({","\t\tid: TLINSTANCE_ID,","\t\t...preserved,","\t\t// the integrity checker will ensure that the currentPageId is valid","\t\tcurrentPageId: res.currentPageId ?? existingInstance?.currentPageId,","\t\tisDebugMode: primary?.isDebugMode ?? secondary?.isDebugMode,","\t\tisFocusMode: primary?.isFocusMode ?? secondary?.isFocusMode,","\t\tisToolLocked: primary?.isToolLocked ?? secondary?.isToolLocked,","\t\tisGridMode: primary?.isGridMode ?? secondary?.isGridMode,","\t\texportBackground: primary?.exportBackground ?? secondary?.exportBackground,","\t})","","\tstore.atomic(() => {","\t\tfor (const ps of res.pageStates ?? []) {","\t\t\tif (!store.has(ps.pageId)) continue","\t\t\tconst cameraId = CameraRecordType.createId(ps.pageId)","\t\t\tconst instancePageState = InstancePageStateRecordType.createId(ps.pageId)","\t\t\tconst previousCamera = store.get(cameraId)","\t\t\tconst previousInstanceState = store.get(instancePageState)","\t\t\tstore.put([","\t\t\t\tCameraRecordType.create({","\t\t\t\t\tid: cameraId,","\t\t\t\t\tx: ps.camera?.x ?? previousCamera?.x,","\t\t\t\t\ty: ps.camera?.y ?? previousCamera?.y,","\t\t\t\t\tz: ps.camera?.z ?? previousCamera?.z,","\t\t\t\t}),","\t\t\t\tInstancePageStateRecordType.create({","\t\t\t\t\tid: instancePageState,","\t\t\t\t\tpageId: ps.pageId,","\t\t\t\t\tselectedShapeIds: ps.selectedShapeIds ?? previousInstanceState?.selectedShapeIds,","\t\t\t\t\tfocusedGroupId: ps.focusedGroupId ?? previousInstanceState?.focusedGroupId,","\t\t\t\t}),","\t\t\t])","\t\t}","","\t\tstore.put([instanceState])","\t\tstore.ensureStoreIsUsable()","\t})","}","","/**"," * @internal"," */","export function extractSessionStateFromLegacySnapshot(","\tstore: Record<string, UnknownRecord>","): TLSessionStateSnapshot | null {","\tconst instanceRecords = []","\tfor (const record of Object.values(store)) {","\t\tif (record.typeName?.match(/^(instance.*|pointer|camera)$/)) {","\t\t\tinstanceRecords.push(record)","\t\t}","\t}","","\t// for scratch documents, we need to extract the most recently-used instance and it's associated page states","\t// but oops we don't have the concept of \"most recently-used\" so we'll just take the first one","\tconst oldInstance = instanceRecords.filter(","\t\t(r) => r.typeName === 'instance' && r.id !== TLINSTANCE_ID","\t)[0] as any","\tif (!oldInstance) return null","","\tconst result: TLSessionStateSnapshot = {","\t\tversion: CURRENT_SESSION_STATE_SNAPSHOT_VERSION,","\t\tcurrentPageId: oldInstance.currentPageId,","\t\texportBackground: !!oldInstance.exportBackground,","\t\tisFocusMode: !!oldInstance.isFocusMode,","\t\tisDebugMode: !!oldInstance.isDebugMode,","\t\tisToolLocked: !!oldInstance.isToolLocked,","\t\tisGridMode: false,","\t\tpageStates: instanceRecords","\t\t\t.filter((r: any) => r.typeName === 'instance_page_state' && r.instanceId === oldInstance.id)","\t\t\t.map((ps: any) => {","\t\t\t\tconst camera = (store[ps.cameraId] as any) ?? { x: 0, y: 0, z: 1 }","\t\t\t\treturn {","\t\t\t\t\tpageId: ps.pageId,","\t\t\t\t\tcamera: {","\t\t\t\t\t\tx: camera.x,","\t\t\t\t\t\ty: camera.y,","\t\t\t\t\t\tz: camera.z,","\t\t\t\t\t},","\t\t\t\t\tselectedShapeIds: ps.selectedShapeIds,","\t\t\t\t\tfocusedGroupId: ps.focusedGroupId,","\t\t\t\t} satisfies NonNullable<TLSessionStateSnapshot['pageStates']>[0]","\t\t\t}),","\t}","","\ttry {","\t\tsessionStateSnapshotValidator.validate(result)","\t\treturn result","\t} catch {"]}]}}}}