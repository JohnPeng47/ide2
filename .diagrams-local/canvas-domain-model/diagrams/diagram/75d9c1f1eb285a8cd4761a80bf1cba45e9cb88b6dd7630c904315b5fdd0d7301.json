sourceRangeIndex":0,"sourceRangeId":"baseline-3d0bdca471964020f52d-range","line":7,"startColumn":14,"endColumn":27},{"id":"mapping-0-2-15","entityId":"baseline-a8d854d05c6940333ea7","sourceRangeIndex":0,"sourceRangeId":"baseline-a8d854d05c6940333ea7-range","line":15,"startColumn":28,"endColumn":45},{"id":"mapping-0-2-21","entityId":"baseline-cd14c9300ebd82bafdd5","sourceRangeIndex":0,"sourceRangeId":"baseline-cd14c9300ebd82bafdd5-range","line":21,"startColumn":20,"endColumn":39},{"id":"mapping-0-2-30","entityId":"baseline-786b7d67f812c58a9e25","sourceRangeIndex":0,"sourceRangeId":"baseline-786b7d67f812c58a9e25-range","line":30,"startColumn":1,"endColumn":21},{"id":"mapping-0-2-33","entityId":"baseline-68f4341c78c1ca5d5a80","sourceRangeIndex":0,"sourceRangeId":"baseline-68f4341c78c1ca5d5a80-range","line":33,"startColumn":1,"endColumn":20},{"id":"mapping-0-2-37","entityId":"baseline-cd14c9300ebd82bafdd5","sourceRangeIndex":0,"sourceRangeId":"baseline-cd14c9300ebd82bafdd5-range","line":37,"startColumn":21,"endColumn":40}],"evidence":{"baseline-e9c274730c1ce46cf3c2":{"id":"baseline-e9c274730c1ce46cf3c2","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"Diagram","label":"Diagram","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-e9c274730c1ce46cf3c2-range","path":"domain/core/diagrams/diagram.ts","startLine":24,"endLine":33,"originalLines":["export interface Diagram {","  /** Stable service identity; id remains the local canvas content key. */","  readonly diagramId: string;","  readonly revisionId: string;","  readonly id: string;","  readonly revision: number;","  readonly content: DeepReadonly<DiagramContent>;","  readonly sourceContext: DeepReadonly<DiagramSourceContext>;","  readonly jumps?: DeepReadonly<DiagramJump[]>;","}"],"symbol":"Diagram"}]},"baseline-7356d6d6d1bca4c859a2":{"id":"baseline-7356d6d6d1bca4c859a2","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"DiagramRevision","label":"DiagramRevision","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-7356d6d6d1bca4c859a2-range","path":"domain/core/diagrams/diagramRevisionEditor.ts","startLine":9,"endLine":16,"originalLines":["export interface DiagramRevision {","  readonly id: DiagramRevisionId;","  readonly diagramId: string;","  readonly parentId?: DiagramRevisionId;","  /** Immutable diagram payload. Never returned by resolve(). */","  readonly diagram: Diagram;","  readonly nodeRefs: Readonly<Record<string, string>>;","}"],"symbol":"DiagramRevision"}]},"baseline-3d0bdca471964020f52d":{"id":"baseline-3d0bdca471964020f52d","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"DiagramContent","label":"DiagramContent","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-3d0bdca471964020f52d-range","path":"domain/core/diagrams/diagramContent.ts","startLine":9,"endLine":12,"originalLines":["export type DiagramContent = DeepReadonly<{","  revisionId: string; ascii: string; asciiSha256: string;","  structure: { kind: 'diagram' } | { kind: 'tree'; parserVersion: 'ascii-tree-1' | 'ascii-tree-2'; rootIds: string[]; nodes: Record<string, DiagramContentNode> };","}>;"],"symbol":"DiagramContent"}]},"baseline-a8d854d05c6940333ea7":{"id":"baseline-a8d854d05c6940333ea7","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"DiagramContentNode","label":"DiagramContentNode","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-a8d854d05c6940333ea7-range","path":"domain/core/diagrams/diagramContent.ts","startLine":5,"endLine":8,"originalLines":["export type DiagramContentNode = DeepReadonly<{","  id: string; label: string; line: number; branchColumn: number; startColumn: number; endColumn: number;","  parentId?: string; childIds: string[]; foldRanges: { startLine: number; endLine: number }[];","}>;"],"symbol":"DiagramContentNode"}]},"baseline-cd14c9300ebd82bafdd5":{"id":"baseline-cd14c9300ebd82bafdd5","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"DiagramSourceContext","label":"DiagramSourceContext","category":"interface-data-struct","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-cd14c9300ebd82bafdd5-range","path":"domain/core/diagrams/diagram.ts","startLine":17,"endLine":22,"originalLines":["export type DiagramSourceContext = DeepReadonly<{","  binding?: DiagramSourceBinding;","  contentHash: string;","  mappings: readonly DiagramElementMapping[];","  evidence: Record<string, ProjectRepresentationEvidenceRecord>;","}>;"],"symbol":"DiagramSourceContext"}]},"baseline-786b7d67f812c58a9e25":{"id":"baseline-786b7d67f812c58a9e25","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"resolveDiagramContent","label":"resolveDiagramContent","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-786b7d67f812c58a9e25-range","path":"domain/mapping/workspace/diagramViewState.ts","startLine":11,"endLine":11,"originalLines":["export function resolveDiagramContent(diagram: Diagram): DiagramContent { return diagram.content; }"],"symbol":"resolveDiagramContent"}]},"baseline-68f4341c78c1ca5d5a80":{"id":"baseline-68f4341c78c1ca5d5a80","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"resolveDiagramSource","label":"resolveDiagramSource","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-68f4341c78c1ca5d5a80-range","path":"application/core/source/diagramSource.ts","startLine":9,"endLine":54,"originalLines":["export async function resolveDiagramSource(store: Pick<DiagramRepository,'loadProject'|'projectCatalogs'>, ref: DiagramSourceReference, corpus?: CorpusAccess, liveDiagram?: Diagram) {","  const project = await store.loadProject();","  if (!project || project.id !== ref.projectId) throw new ApplicationError('conflict','Diagram belongs to another project');","  const catalog = await store.projectCatalogs.loadRepresentationCatalog(project.id);","  let diagram: Diagram | undefined;","  const representation = ref.representationId ? catalog.representations[ref.representationId] : undefined;","  const revisionId = ref.revisionId ?? representation?.currentRevisionId;","  if (ref.representationId && (!representation || !revisionId || !representation.revisionIds.includes(revisionId))) throw new Error('Unknown diagram revision');","  if (liveDiagram) {","    validateDiagram(liveDiagram);","    if (ref.contentId && liveDiagram.id !== ref.contentId) throw new Error('Live diagram identity does not match selection');","    diagram = liveDiagram;","  } else if (ref.representationId) {","    const scene = sceneFromRevision(catalog.revisions[revisionId!]);","    const candidates = Object.values(scene.contents).filter(d => ref.contentId ? d.id === ref.contentId : !!d.sourceContext.binding);","    if (candidates.length !== 1) throw new Error('Select an individual diagram with contentId');","    diagram = candidates[0];","  } else {","    const bindings = new Map<string,DiagramSourceBinding>();","    const register = (binding: DiagramSourceBinding) => {","      const old = bindings.get(binding.sourceId);","      if (old && (old.corpus.root !== binding.corpus.root || old.corpus.kind !== binding.corpus.kind || old.repositoryIdentity !== binding.repositoryIdentity)) throw new Error('Conflicting diagram source identity');","      bindings.set(binding.sourceId,binding);","    };","    for (const revision of Object.values(catalog.revisions)) for (const d of Object.values(sceneFromRevision(revision).contents)) {","      const binding = d.sourceContext.binding;","      if (binding && (!ref.sourceId || binding.sourceId === ref.sourceId)) register(binding);","    }","    for (const binding of project.sources ?? []) {","      if (binding && (!ref.sourceId || binding.sourceId === ref.sourceId)) register(binding);","    }","    if (bindings.size !== 1) throw new Error('A valid diagram sourceId is required; the project has no single repository');","    diagram = new RevisionedDiagramService().create({id:'source-query',revision:0,ascii:'Source',source:[...bindings.values()][0]}).diagram;","  }","  if (ref.sourceId && diagram.sourceContext.binding?.sourceId !== ref.sourceId) throw new Error('Source does not belong to diagram');","  const query = diagramSource(diagram);","  const binding = () => {","    const result = query.context.binding;","    if (!result) throw new Error('This diagram has no source repository');","    return result;","  };","  return { ...query, diagram, binding,","    readText: (file: string) => { const source=binding(); if (!corpus) throw new Error('Source access unavailable'); return corpus.provider(source.corpus).readDocumentText(source.corpus,file); },","    listFiles: (directory: string) => { const source=binding(); if (!corpus) throw new Error('Source access unavailable'); return corpus.provider(source.corpus).listDirectory(source.corpus,directory); }","  };","}"],"symbol":"resolveDiagramSource"}]}}},"diagramId":"diagram-4d0d2c58629231300578486c2b1281976d59910a8bc90b341817edf8a9d90b4d","revisionId":"diagram-revision-c6f38300-3f84-40f1-a794-951e87024357"}