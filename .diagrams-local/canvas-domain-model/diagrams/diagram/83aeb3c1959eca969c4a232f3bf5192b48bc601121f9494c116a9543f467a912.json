   source: { agentType: input.agentType, sourceSessionId: input.sourceSessionId, format: input.format },","      range: { fromEntryId: input.fromEntryId, throughEntryId: input.throughEntryId }, messages });","    return new AgentContext({ ...data, contentHash: sha256(canonical(data)) });","  }","","  static fromSnapshot(raw: unknown): AgentContext {","    bounded(raw);","    const snapshot = agentContextSnapshotSchema.parse(raw);","    const { contentHash, ...data } = snapshot;","    if (contentHash !== sha256(canonical(data))) throw Error('INVALID_AGENT_CONTEXT: content hash mismatch');","    validateMessages(snapshot.messages);","    return new AgentContext(snapshot);","  }","","  toSnapshot(): AgentContextSnapshot { return structuredClone(this.#snapshot); }","","  toPiMessages() {","    return this.toSnapshot().messages.map(message => {","      if (message.role !== 'assistant') return message;","      // Synthetic provenance marks imported history; it never selects the run's model.","      return { ...message, api: 'openai-responses' as const, provider: 'agent-context', model: this.#snapshot.source.agentType,","        stopReason: message.content.some(block => block.type === 'toolCall') ? 'toolUse' as const : 'stop' as const,","        usage: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, totalTokens: 0,","          cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } } };","    });","  }","}"],"symbol":"AgentContext"}]},"baseline-1f80d27bcbaa0a92d2f7":{"id":"baseline-1f80d27bcbaa0a92d2f7","sourceId":"source-3fe4f45713dca806c6aa1ba8","handle":"AgentContext.fromTrajectory","label":"AgentContext.fromTrajectory","category":"operation","summary":"Source captured at pre-tldraw baseline 03f2168.","sourceRanges":[{"id":"baseline-1f80d27bcbaa0a92d2f7-range","path":"domain/core/agents/agentContext.ts","startLine":67,"endLine":90,"originalLines":["  static fromTrajectory(raw: unknown): AgentContext {","    bounded(raw);","    const input = agentTraject