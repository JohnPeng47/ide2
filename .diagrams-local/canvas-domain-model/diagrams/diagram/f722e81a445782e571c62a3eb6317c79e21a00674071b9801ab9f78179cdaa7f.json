:"diagram-f7a93e62-baa4-4133-bf8b-5d3ee5c496a2:0:d7f6d39f07ec33bae372b80b7fc6a6d74ecd149b5c099a93cb21bfa7e66b1d91:line-31","label":"Store change stream is not the user undo stack","line":31,"branchColumn":4,"startColumn":9,"endColumn":54,"parentId":"diagram-f7a93e62-baa4-4133-bf8b-5d3ee5c496a2:0:d7f6d39f07ec33bae372b80b7fc6a6d74ecd149b5c099a93cb21bfa7e66b1d91:line-28","childIds":[],"foldRanges":[]}}}},"sourceContext":{"binding":{"sourceId":"tldraw-local","repositoryIdentity":"https://github.com/tldraw/tldraw","domainProfileId":"source-code","corpus":{"kind":"git-worktree","root":"/home/john/.herdr/worktrees/new-diagram/worktree-perf-debug/softwarez/tldraw","revision":"c68097bed7805d076541cd5d562ac3fcde248180"}},"contentHash":"d7f6d39f07ec33bae372b80b7fc6a6d74ecd149b5c099a93cb21bfa7e66b1d91","mappings":[{"id":"T1b-source-0-map","entityId":"T1b-source-0","sourceRangeIndex":0,"sourceRangeId":"T1b-source-0-range","line":5,"startColumn":8,"endColumn":12},{"id":"T1b-source-1-map","entityId":"T1b-source-1","sourceRangeIndex":0,"sourceRangeId":"T1b-source-1-range","line":15,"startColumn":9,"endColumn":28},{"id":"T1b-source-2-map","entityId":"T1b-source-2","sourceRangeIndex":0,"sourceRangeId":"T1b-source-2-range","line":20,"startColumn":9,"endColumn":22},{"id":"T1b-source-3-map","entityId":"T1b-source-3","sourceRangeIndex":0,"sourceRangeId":"T1b-source-3-range","line":23,"startColumn":8,"endColumn":29}],"evidence":{"T1b-source-0":{"id":"T1b-source-0","handle":"packages/store/src/lib/Store.ts","label":"put()","category":"operation","summary":"Source for put()","sourceRanges":[{"id":"T1b-source-0-range","path":"packages/store/src/lib/Store.ts","startLine":600,"endLine":693,"originalLines":["\t *","\t * @param records - The records to add or update","\t * @param phaseOverride - Override the validation phase (used internally)","\t * @public","\t */","\tput(records: R[], phaseOverride?: 'initialize'): void {","\t\tthis.atomic(() => {","\t\t\tconst updates: Record<IdOf<UnknownRecord>, [from: R, to: R]> = {}","\t\t\tconst additions: Record<IdOf<UnknownRecord>, R> = {}","","\t\t\t// Iterate through all records, creating, updating or removing as needed","\t\t\tlet record: R","","\t\t\t// There's a chance that, despite having records, all of the values are","\t\t\t// identical to what they were before; and so we'd end up with an \"empty\"","\t\t\t// history entry. Let's keep track of whether we've actually made any","\t\t\t// changes (e.g. additions, deletions, or updates that produce a new value).","\t\t\tlet didChange = false","","\t\t\tconst source = this.isMergingRemoteChanges ? 'remote' : 'user'","","\t\t\tfor (let i = 0, n = records.length; i < n; i++) {","\t\t\t\trecord = records[i]","","\t\t\t\tconst initialValue = this.records.__unsafe__getWithoutCapture(record.id)","\t\t\t\t// If we already have an atom for this record, update its value.","\t\t\t\tif (initialValue) {","\t\t\t\t\t// If we have a beforeUpdate callback, run it against the initial and next records","\t\t\t\t\trecord = this.sideEffects.handleBeforeChange(initialValue, record, source)","","\t\t\t\t\t// Validate the record","\t\t\t\t\tconst validated = this.schema.validateRecord(","\t\t\t\t\t\tthis,","\t\t\t\t\t\trecord,","\t\t\t\t\t\tphaseOverride ?? 'updateRecord',","\t\t\t\t\t\tinitialValue","\t\t\t\t\t)","","\t\t\t\t\tif (validated === initialValue) continue","","\t\t\t\t\trecord = devFreeze(validated)","\t\t\t\t\tthis.records.set(record.id, record)","","\t\t\t\t\tdidChange = true","\t\t\t\t\tupdates[record.id] = [initialValue, record]","\t\t\t\t\tthis.addDiffForAfterEvent(initialValue, record)","\t\t\t\t} else {","\t\t\t\t\trecord = this.sideEffects.handleBeforeCreate(record, source)","","\t\t\t\t\tdidChange = true","","\t\t\t\t\t// If we don't have an atom, create one.","","\t\t\t\t\t// Validate the record","\t\t\t\t\trecord = this.schema.validateRecord(","\t\t\t\t\t\tthis,","\t\t\t\t\t\trecord as R,","\t\t\t\t\t\tphaseOverride ?? 'createRecord',","\t\t\t\t\t\tnull","\t\t\t\t\t)","","\t\t\t\t\t// freeze it","\t\t\t\t\trecord = devFreeze(record)","","\t\t\t\t\t// Mark the change as a new addition.","\t\t\t\t\tadditions[record.id] = record","\t\t\t\t\tthis.addDiffForAfterEvent(null, record)","","\t\t\t\t\tthis.records.set(record.id, record)","\t\t\t\t}","\t\t\t}","","\t\t\t// If we did change, update the history","\t\t\tif (!didChange) return","\t\t\tthis.updateHistory({","\t\t\t\tadded: additions,","\t\t\t\tupdated: updates,","\t\t\t\tremoved: {} as Record<IdOf<R>, R>,","\t\t\t})","\t\t})","\t}","","\t/**","\t * Remove records from the store by their IDs.","\t *","\t * @example","\t * ```ts","\t * // Remove a single record","\t * store.remove([book.id])","\t *","\t * // Remove multiple records","\t * store.remove([book1.id, book2.id, book3.id])","\t * ```","\t *"]}]},"T1b-source-1":{"id":"T1b-source-1","handle":"packages/store/src/lib/Store.ts","label":"History interceptors","category":"interface-data-struct","summary":"Source for History interceptors","sourceRanges":[{"id":"T1b-source-1-range","path":"packages/store/src/lib/Store.ts","startLine":1266,"endLine":1286,"originalLines":["\taddHistoryInterceptor(fn: (entry: HistoryEntry<R>, source: ChangeSource) => void) {","\t\treturn this.historyAccumulator.addInterceptor((entry) =>","\t\t\tfn(entry, this.isMergingRemoteChanges ? 'remote' : 'user')","\t\t)","\t}","}","","/**"," * Collect and squash history entries by their adjacent sources."," * Adjacent entries from the same source are combined into a single entry."," *"," * For example: [user, user, remote, remote, user] becomes [user, remote, user]"," *"," * @example"," * ```ts"," * const entries = ["," *   { source: 'user', changes: userChanges1 },"," *   { source: 'user', changes: userChanges2 },"," *   { source: 'remote', changes: remoteChanges }"," * ]"," *"]}]},"T1b-source-2":{"id":"T1b-source-2","handle":"packages/store/src/lib/Store.ts","label":"Store.listen()","category":"operation","summary":"Source for Store.listen()","sourceRanges":[{"id":"T1b-source-2-range","path":"packages/store/src/lib/Store.ts","startLine":979,"endLine":1020,"originalLines":["\tlisten(onHistory: StoreListener<R>, filters?: Partial<StoreListenerFilters>) {","\t\t// flush history so that this listener's history starts from exactly now","\t\tthis._flushHistory()","","\t\tconst listener = {","\t\t\tonHistory,","\t\t\tfilters: {","\t\t\t\tsource: filters?.source ?? 'all',","\t\t\t\tscope: filters?.scope ?? 'all',","\t\t\t},","\t\t}","","\t\tif (!this.historyReactor.scheduler.isActivelyListening) {","\t\t\tthis.historyReactor.start()","\t\t\tthis.historyReactor.scheduler.execute()","\t\t}","","\t\tthis.listeners.add(listener)","","\t\treturn () => {","\t\t\tthis.listeners.delete(listener)","","\t\t\tif (this.listeners.size === 0) {","\t\t\t\tthis.historyReactor.stop()","\t\t\t}","\t\t}","\t}","","\tprivate isMergingRemoteChanges = false","","\t/**","\t * Merge changes from a remote source. Changes made within the provided function","\t * will be marked with source 'remote' instead of 'user'.","\t *","\t * @example","\t * ```ts","\t * // Changes from sync/collaboration","\t * store.mergeRemoteChanges(() => {","\t *   store.put(remoteRecords)","\t *   store.remove(deletedIds)","\t * })","\t * ```"]}]},"T1b-source-3":{"id":"T1b-source-3","handle":"packages/store/src/lib/Store.ts","label":"Flush atomic callbacks","category":"interface-data-struct","summary":"Source for Flush atomic callbacks","sourceRanges":[{"id":"T1b-source-3-range","path":"packages/store/src/lib/Store.ts","startLine":1179,"endLine":1259,"originalLines":["\t\tconst id = (before || after)!.id","\t\tconst existing = this.pendingAfterEvents.get(id)","\t\tif (existing) {","\t\t\texisting.after = after","\t\t} else {","\t\t\tthis.pendingAfterEvents.set(id, { before, after })","\t\t}","\t}","\tprivate flushAtomicCallbacks(isMergingRemoteChanges: boolean) {","\t\tlet updateDepth = 0","\t\tlet source: ChangeSource = isMergingRemoteChanges ? 'remote' : 'user'","\t\twhile (this.pendingAfterEvents) {","\t\t\tconst events = this.pendingAfterEvents","\t\t\tthis.pendingAfterEvents = null","","\t\t\tif (!this.sideEffects.isEnabled()) continue","","\t\t\tupdateDepth++","\t\t\tif (updateDepth > 100) {","\t\t\t\tthrow new Error('Maximum store update depth exceeded, bailing out')","\t\t\t}","","\t\t\tfor (const { before, after } of events.values()) {","\t\t\t\tif (before && after && before !== after && !isEqual(before, after)) {","\t\t\t\t\tthis.sideEffects.handleAfterChange(before, after, source)","\t\t\t\t} else if (before && !after) {","\t\t\t\t\tthis.sideEffects.handleAfterDelete(before, source)","\t\t\t\t} else if (!before && after) {","\t\t\t\t\tthis.sideEffects.handleAfterCreate(after, source)","\t\t\t\t}","\t\t\t}","","\t\t\tif (!this.pendingAfterEvents) {","\t\t\t\tthis.sideEffects.handleOperationComplete(source)","\t\t\t}","\t\t\t// Whatever the after-handlers or the operation-complete handlers changed in response to","\t\t\t// a remote operation is not itself remote: later rounds are attributed to 'user'.","\t\t\tsource = 'user'","\t\t}","\t}","\tprivate _isInAtomicOp = false","\t/** @internal */","\tatomic<T>(fn: () => T, runCallbacks = true, isMergingRemoteChanges = false): T {","\t\treturn transact(() => {","\t\t\tif (this._isInAtomicOp) {","\t\t\t\tif (!this.pendingAfterEvents) this.pendingAfterEvents = new Map()","\t\t\t\tconst prevSideEffectsEnabled = this.sideEffects.isEnabled()","\t\t\t\tassert(!isMergingRemoteChanges, 'cannot call mergeRemoteChanges while in atomic operation')","\t\t\t\ttry {","\t\t\t\t\t// if we are in an atomic context with side effects ON allow switching before* callbacks OFF.","\t\t\t\t\t// but don't allow switching them ON if they had been marked OFF before.","\t\t\t\t\tif (prevSideEffectsEnabled && !runCallbacks) {","\t\t\t\t\t\tthis.sideEffects.setIsEnabled(false)","\t\t\t\t\t}","\t\t\t\t\treturn fn()","\t\t\t\t} finally {","\t\t\t\t\tthis.sideEffects.setIsEnabled(prevSideEffectsEnabled)","\t\t\t\t}","\t\t\t}","","\t\t\tthis.pendingAfterEvents = new Map()","\t\t\tconst prevSideEffectsEnabled = this.sideEffects.isEnabled()","\t\t\t// an operation may switch side effects off, but never on while they are disabled","\t\t\tthis.sideEffects.setIsEnabled(runCallbacks && prevSideEffectsEnabled)","\t\t\tthis._isInAtomicOp = true","","\t\t\tif (isMergingRemoteChanges) {","\t\t\t\tthis.isMergingRemoteChanges = true","\t\t\t}","","\t\t\ttry {","\t\t\t\tconst result = fn()","\t\t\t\tthis.isMergingRemoteChanges = false","","\t\t\t\tthis.flushAtomicCallbacks(isMergingRemoteChanges)","","\t\t\t\treturn result","\t\t\t} finally {","\t\t\t\tthis.pendingAfterEvents = null","\t\t\t\tthis.sideEffects.setIsEnabled(prevSideEffectsEnabled)","\t\t\t\tthis._isInAtomicOp = false"]}]}}}}