src/termio/stream_handler.zig:1107:             },
src/termio/stream_handler.zig:1108:         }) orelse return;
src/termio/stream_handler.zig:1109: 
src/termio/stream_handler.zig:1110:         switch (meta.op) {
src/termio/stream_handler.zig:1111:             .read => try self.kittyClipboardRead(
src/termio/stream_handler.zig:1112:                 &meta,
src/termio/stream_handler.zig:1113:                 v.payload orelse "",
src/termio/stream_handler.zig:1114:                 v.terminator,
src/termio/stream_handler.zig:1115:             ),
src/termio/stream_handler.zig:1116: 
src/termio/stream_handler.zig:1117:             .write => try self.kittyClipboardWriteBegin(
src/termio/stream_handler.zig:1118:                 &meta,
src/termio/stream_handler.zig:1119:                 v.terminator,
src/termio/stream_handler.zig:1120:             ),
src/termio/stream_handler.zig:1121: 
src/termio/stream_handler.zig:1122:             .wdata => try self.kittyClipboardWriteData(
src/termio/stream_handler.zig:1123:                 &meta,
src/termio/stream_handler.zig:1124:                 v.payload orelse "",
src/termio/stream_handler.zig:1125:                 v.terminator,
src/termio/stream_handler.zig:1126:             ),
src/termio/stream_handler.zig:1127: 
src/termio/stream_handler.zig:1128:             .walias => try self.kittyClipboardWriteAlias(
src/termio/stream_handler.zig:1129:                 &meta,
src/termio/stream_handler.zig:1130:                 v.payload orelse "",
src/termio/stream_handler.zig:1131:                 v.terminator,
src/termio/stream_handler.zig:1132:             ),
