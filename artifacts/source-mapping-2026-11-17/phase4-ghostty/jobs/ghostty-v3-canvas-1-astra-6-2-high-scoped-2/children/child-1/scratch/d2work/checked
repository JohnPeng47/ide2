src/termio/stream_handler.zig:1101:                         .EINVAL,
src/termio/stream_handler.zig:1102:                         v.terminator,
src/termio/stream_handler.zig:1103:                     ),
src/termio/stream_handler.zig:1104:                     .read, .write => {},
src/termio/stream_handler.zig:1105:                 }
