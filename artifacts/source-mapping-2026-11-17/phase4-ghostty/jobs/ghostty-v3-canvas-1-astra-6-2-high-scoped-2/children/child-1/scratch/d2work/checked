src/termio/stream_handler.zig:1153:         // matching kitty.
src/termio/stream_handler.zig:1154:         const decoded = kitty_clipboard.Payload.init(
src/termio/stream_handler.zig:1155:             alloc,
src/termio/stream_handler.zig:1156:             payload,
src/termio/stream_handler.zig:1157:         ) catch |err| switch (err) {
src/termio/stream_handler.zig:1158:             error.OutOfMemory => return error.OutOfMemory,
src/termio/stream_handler.zig:1159:             error.Invalid => {
