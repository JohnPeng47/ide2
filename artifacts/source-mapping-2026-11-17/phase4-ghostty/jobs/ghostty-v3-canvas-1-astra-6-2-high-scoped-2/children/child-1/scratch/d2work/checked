src/termio/stream_handler.zig:1145:         // itself, lives in a single arena that crosses to the surface
src/termio/stream_handler.zig:1146:         // thread, which owns it from the moment the message is sent.
src/termio/stream_handler.zig:1147:         var arena: std.heap.ArenaAllocator = .init(self.alloc);
