33	/// The state of one in-flight write transaction: a single `type=write`
34	/// plus all the `wdata` chunks and `walias` aliases until completion
35	/// or error.
36	pub const WriteState = struct {
37	    arena: std.heap.ArenaAllocator,
38	    loc: clipboard.Location,
39	    id: []const u8,
40	    pw: []const u8,
41	    name: []const u8,
42	    spool: std.ArrayList(u8) = .empty,
43	    entries: std.ArrayList(Entry) = .empty,
44	    aliases: std.ArrayList(Alias) = .empty,
45	
46	    /// Maximum total decoded bytes this transaction will accumulate.
47	    /// Captured at init so a change to the configured limit doesn't
48	    /// apply to a transaction already in flight.
49	    max_size: usize,
50	
51	    /// Index into entries currently receiving data.
52	    current: ?usize = null,
53	
54	    /// Decodes the concatenated payload stream of the entry currently
55	    /// receiving data. Per the spec's "Encoding of payloads" section,
56	    /// individual wdata packet payloads split one base64 stream at
57	    /// arbitrary boundaries; only the concatenation per MIME type must
58	    /// be valid, correctly padded base64.
59	    decoder: simd.base64.Streaming = .{},

