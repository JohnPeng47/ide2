938	    pub fn fullReset(
939	        self: *StreamHandler,
940	    ) !void {
941	        self.terminal.fullReset();
942	        try self.setMouseShape(.text);
943	
944	        // Full reset clears Kitty clipboard session grants.
945	        self.kitty_clipboard_grants.deinit(self.alloc);
946	        self.kitty_clipboard_grants = .{};
947	
948	        // Reset resets our palette so we report it for mode 2031.
949	        self.messageWriter(.{ .color_scheme_report = .{ .force = false } });
950	
951	        // Clear the progress bar
952	        self.progressReport(.{ .state = .remove });
953	    }
