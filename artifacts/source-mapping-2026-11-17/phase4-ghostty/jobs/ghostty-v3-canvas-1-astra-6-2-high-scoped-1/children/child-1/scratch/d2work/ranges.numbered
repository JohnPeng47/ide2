src/termio/stream_handler.zig
1080	    fn kittyClipboard(
1081	        self: *StreamHandler,
1082	        v: terminal.osc.Command.KittyClipboardProtocol,
1083	    ) error{ OutOfMemory, WriteFailed }!void {
1084	        const kitty_clipboard = terminal.kitty.clipboard;
1085	
1086	        // Decode and validate the metadata. Malformed structure drops
1087	        // the packet without a response. Invalid decoded text on a write
1088	        // data or alias packet aborts an in-flight transaction.
1089	        var arena: std.heap.ArenaAllocator = .init(self.alloc);
1090	        defer arena.deinit();
1091	        const meta = (kitty_clipboard.Metadata.parse(
1092	            arena.allocator(),
1093	            v.metadata,
1094	        ) catch |err| switch (err) {
1095	            error.OutOfMemory => return error.OutOfMemory,
1096	            error.InvalidValue => {
1097	                const state = self.kitty_clipboard_write orelse return;
1098	                switch (kitty_clipboard.Metadata.operation(v.metadata) orelse return) {
1099	                    .wdata, .walias => try self.kittyClipboardWriteFinish(
1100	                        state,
1101	                        .EINVAL,
1102	                        v.terminator,
1103	                    ),
1104	                    .read, .write => {},
1105	                }
1106	                return;
1107	            },
1108	        }) orelse return;
1109	
1110	        switch (meta.op) {
1111	            .read => try self.kittyClipboardRead(
1112	                &meta,
1113	                v.payload orelse "",
1114	                v.terminator,
1115	            ),
1116	
1117	            .write => try self.kittyClipboardWriteBegin(
1118	                &meta,
1119	                v.terminator,
1120	            ),
1121	
1122	            .wdata => try self.kittyClipboardWriteData(
1123	                &meta,
1124	                v.payload orelse "",
1125	                v.terminator,
1126	            ),
1127	
1128	            .walias => try self.kittyClipboardWriteAlias(
1129	                &meta,
1130	                v.payload orelse "",
1131	                v.terminator,
1132	            ),
1133	        }
1134	    }

src/termio/stream_handler.zig
1235	    fn kittyClipboardWriteBegin(
1236	        self: *StreamHandler,
1237	        meta: *const terminal.kitty.clipboard.Metadata,
1238	        terminator: terminal.osc.Terminator,
1239	    ) error{ OutOfMemory, WriteFailed }!void {
1240	        // A new write silently replaces any in-flight transaction.
1241	        self.kittyClipboardWriteAbort();
1242	
1243	        // A write denied by policy can never succeed, so fail the
1244	        // transaction up front instead of spooling data we'd only
1245	        // throw away. Later wdata packets are ignored.
1246	        if (self.clipboard_write == .deny) {
1247	            log.info("application attempted to write clipboard, but 'clipboard-write' is set to deny", .{});
1248	            try self.kittyClipboardWriteStatus(
1249	                .EPERM,
1250	                meta.id,
1251	                terminator,
1252	            );
1253	            return;
1254	        }
1255	
1256	        const state = try self.alloc.create(terminal.kitty.clipboard.WriteState);
1257	        errdefer self.alloc.destroy(state);
1258	        state.* = try .init(self.alloc, meta, .{
1259	            .max_size = self.clipboard_write_limit,
1260	        });
1261	        self.kitty_clipboard_write = state;
1262	    }
1263	
1264	    /// Accumulate one wdata chunk, or commit the transaction when the
1265	    /// chunk carries no MIME type.
1266	    fn kittyClipboardWriteData(
1267	        self: *StreamHandler,
1268	        meta: *const terminal.kitty.clipboard.Metadata,
1269	        payload: []const u8,
1270	        terminator: terminal.osc.Terminator,
1271	    ) error{ OutOfMemory, WriteFailed }!void {
1272	        // Data without a transaction is silently ignored, matching
1273	        // kitty.
1274	        const state = self.kitty_clipboard_write orelse return;
1275	
1276	        // A wdata packet without a MIME type commits the transaction.
1277	        if (meta.mime.len == 0) return self.kittyClipboardWriteCommit(
1278	            state,
1279	            terminator,
1280	        );
1281	
1282	        state.data(
1283	            self.alloc,
1284	            meta,
1285	            payload,
1286	        ) catch |err| switch (err) {
1287	            // Failing to spool matches kitty's EIO for a failed buffer write.
1288	            error.OutOfMemory => {
1289	                try self.kittyClipboardWriteFinish(
1290	                    state,
1291	                    .EIO,
1292	                    terminator,
1293	                );
1294	                return error.OutOfMemory;
1295	            },
1296	
1297	            // Data over the write limit aborts the transaction and is
1298	            // reported to the client.
1299	            error.TooLarge => try self.kittyClipboardWriteFinish(
1300	                state,
1301	                .EFBIG,
1302	                terminator,
1303	            ),
1304	
1305	            // An invalid base64 payload stream aborts the transaction.
1306	            error.Invalid => try self.kittyClipboardWriteFinish(
1307	                state,
1308	                .EINVAL,
1309	                terminator,
1310	            ),
1311	        };
1312	    }
1313	
1314	    /// Register aliases from a walias packet.
1315	    fn kittyClipboardWriteAlias(
1316	        self: *StreamHandler,
1317	        meta: *const terminal.kitty.clipboard.Metadata,
1318	        payload: []const u8,
1319	        terminator: terminal.osc.Terminator,
1320	    ) error{ OutOfMemory, WriteFailed }!void {
1321	        // Aliases without a transaction are silently ignored. Once a
1322	        // transaction exists, a missing target MIME type is invalid and
1323	        // aborts the transaction.
1324	        const state = self.kitty_clipboard_write orelse return;
1325	        if (meta.mime.len == 0) return self.kittyClipboardWriteFinish(
1326	            state,
1327	            .EINVAL,
1328	            terminator,
1329	        );
1330	
1331	        state.alias(
1332	            self.alloc,
1333	            meta,
1334	            payload,
1335	        ) catch |err| switch (err) {
1336	            error.OutOfMemory => {
1337	                try self.kittyClipboardWriteFinish(
1338	                    state,
1339	                    .EIO,
1340	                    terminator,
1341	                );
1342	                return error.OutOfMemory;
1343	            },
1344	
1345	            // An undecodable alias payload aborts the transaction.
1346	            error.Invalid => try self.kittyClipboardWriteFinish(
1347	                state,
1348	                .EINVAL,
1349	                terminator,
1350	            ),
1351	        };
1352	    }
1353	
1354	    /// Commit the transaction: resolve the final contents and forward
1355	    /// them to the surface thread, which owns policy, any permission
1356	    /// prompt, the clipboard write itself, and the final reply.
1357	    fn kittyClipboardWriteCommit(
1358	        self: *StreamHandler,
1359	        state: *terminal.kitty.clipboard.WriteState,
1360	        terminator: terminal.osc.Terminator,
1361	    ) error{ OutOfMemory, WriteFailed }!void {
1362	        self.kittyClipboardWriteSend(
1363	            state,
1364	            terminator,
1365	        ) catch |err| switch (err) {
1366	            error.OutOfMemory => {
1367	                try self.kittyClipboardWriteFinish(
1368	                    state,
1369	                    .EIO,
1370	                    terminator,
1371	                );
1372	                return error.OutOfMemory;
1373	            },
1374	
1375	            // The last MIME type's payload stream was not correctly
1376	            // padded, which aborts the transaction.
1377	            error.Invalid => return try self.kittyClipboardWriteFinish(
1378	                state,
1379	                .EINVAL,
1380	                terminator,
1381	            ),
1382	        };
1383	
1384	        // The transaction is complete; the surface owns the reply.
1385	        self.kittyClipboardWriteAbort();
1386	    }

src/termio/stream_handler.zig
1443	    fn kittyClipboardWriteFinish(
1444	        self: *StreamHandler,
1445	        state: *const terminal.kitty.clipboard.WriteState,
1446	        status: terminal.kitty.clipboard.Status,
1447	        terminator: terminal.osc.Terminator,
1448	    ) error{ OutOfMemory, WriteFailed }!void {
1449	        defer self.kittyClipboardWriteAbort();
1450	        try self.kittyClipboardWriteStatus(status, state.id, terminator);
1451	    }
1452	
1453	    /// Reply to a write transaction with a single status packet.
1454	    fn kittyClipboardWriteStatus(
1455	        self: *StreamHandler,
1456	        status: terminal.kitty.clipboard.Status,
1457	        id: []const u8,
1458	        terminator: terminal.osc.Terminator,
1459	    ) error{ OutOfMemory, WriteFailed }!void {
1460	        var stream: std.Io.Writer.Allocating = .init(self.alloc);
1461	        defer stream.deinit();
1462	        try (terminal.kitty.clipboard.Response{
1463	            .op = .write,
1464	            .status = status,
1465	            .id = id,
1466	            .terminator = terminator,
1467	        }).encode(&stream.writer);
1468	        self.messageWriter(.{ .write_alloc = .{
1469	            .alloc = self.alloc,
1470	            .data = try stream.toOwnedSlice(),
1471	        } });
1472	    }
1473	
1474	    /// Drop any in-flight write transaction without responding.
1475	    fn kittyClipboardWriteAbort(self: *StreamHandler) void {
1476	        if (self.kitty_clipboard_write) |state| {
1477	            state.deinit(self.alloc);
1478	            self.alloc.destroy(state);
1479	            self.kitty_clipboard_write = null;
1480	        }
1481	    }

