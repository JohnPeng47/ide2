src/terminal/apc.zig
214	    pub fn end(self: *Handler) ?Command {
215	        defer {
216	            self.state.deinit();
217	            self.state = .inactive;
218	        }
219	
220	        return switch (self.state) {
221	            .inactive => unreachable,
222	            .ignore, .identify => null,
223	            .unknown => |*unknown| .{ .unknown = unknown.toOwned() },
224	            .kitty => |*p| kitty: {
225	                if (comptime !build_options.kitty_graphics) unreachable;
226	
227	                // Use the same allocator that was used to create the parser.
228	                const alloc = p.alloc;
229	                const command = p.complete(alloc) catch |err| {
230	                    log.warn("kitty graphics protocol error: {}", .{err});
231	                    break :kitty null;
232	                };
233	
234	                break :kitty .{ .kitty = command };
235	            },
236	
237	            .glyph => |*p| glyph_cmd: {
238	                if (comptime !build_options.glyph_protocol) unreachable;
239	
240	                const command = p.complete(p.alloc) catch |err| {
241	                    log.warn("glyph protocol error: {}", .{err});
242	                    break :glyph_cmd null;
243	                };
244	
245	                break :glyph_cmd .{ .glyph = command };
246	            },
247	        };
248	    }
249	};

