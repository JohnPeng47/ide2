src/termio/Termio.zig
824	/// ThreadData is the data created and stored in the termio thread
825	/// when the thread is started and destroyed when the thread is
826	/// stopped.
827	///
828	/// All of the fields in this struct should only be read/written by
829	/// the termio thread. As such, a lock is not necessary.
830	pub const ThreadData = struct {
831	    /// Allocator used for the event data
832	    alloc: Allocator,
833	
834	    /// The event loop associated with this thread. This is owned by
835	    /// the Thread but we have a pointer so we can queue new work to it.
836	    loop: *xev.Loop,
837	
838	    /// The shared render state
839	    renderer_state: *renderer.State,
840	
841	    /// Mailboxes for different threads
842	    surface_mailbox: apprt.surface.Mailbox,
843	
844	    /// Data associated with the backend implementation (i.e. pty/exec state)
845	    backend: termio.backend.ThreadData,
846	    mailbox: *termio.Mailbox,
847	
848	    pub fn deinit(self: *ThreadData) void {
849	        self.backend.deinit(self.alloc);
850	        self.* = undefined;
851	    }
852	};

src/termio/Thread.zig
261	    var cb: CallbackData = .{ .self = self, .io = io };
262	
263	    // Run our thread start/end callbacks. This allows the implementation
264	    // to hook into the event loop as needed. The thread data is created
265	    // on the stack here so that it has a stable pointer throughout the
266	    // lifetime of the thread.
267	    try io.threadEnter(self, &cb.data);
268	    defer cb.data.deinit();
269	    defer io.threadExit(&cb.data);
270	
271	    // Start the async handlers.
272	    mailbox.wakeup.wait(&self.loop, &self.wakeup_c, CallbackData, &cb, wakeupCallback);
273	    self.stop.wait(&self.loop, &self.stop_c, CallbackData, &cb, stopCallback);
274	
275	    // Run
276	    log.debug("starting IO thread", .{});
277	    defer log.debug("starting IO thread shutdown", .{});
278	    try self.loop.run(.until_done);
279	}

