828	
829	    pub fn deviceAttributes(
830	        self: *StreamHandler,
831	        req: terminal.DeviceAttributeReq,
832	    ) !void {
833	        // For the below, we quack as a VT220. We don't quack as
834	        // a 420 because we don't support DCS sequences.
835	        switch (req) {
836	            .primary => self.messageWriter(.{
837	                // 62 = Level 2 conformance
838	                // 22 = Color text
839	                // 52 = Clipboard access
840	                .write_stable = if (self.clipboard_write != .deny)
841	                    "\x1B[?62;22;52c"
842	                else
843	                    "\x1B[?62;22c",
844	            }),
845	
846	            .secondary => self.messageWriter(.{
847	                .write_stable = "\x1B[>1;10;0c",
848	            }),
849	
850	            else => log.warn("unimplemented device attributes req: {}", .{req}),
851	        }
852	    }
853	
854	    /// The cursor position for a CPR/DECXCPR report, honoring origin mode
855	    /// (relative to the scrolling region when DECOM is set).
856	    fn cursorReportPos(self: *StreamHandler) struct { x: usize, y: usize } {
857	        return if (self.terminal.modes.get(.origin)) .{
858	            .x = self.terminal.screens.active.cursor.x -| self.terminal.scrolling_region.left,
859	            .y = self.terminal.screens.active.cursor.y -| self.terminal.scrolling_region.top,
860	        } else .{
861	            .x = self.terminal.screens.active.cursor.x,
862	            .y = self.terminal.screens.active.cursor.y,
863	        };
864	    }
865	
866	    pub fn deviceStatusReport(
867	        self: *StreamHandler,
868	        req: terminal.device_status.Request,
869	    ) !void {
870	        switch (req) {
871	            .operating_status => self.messageWriter(.{ .write_stable = "\x1B[0n" }),
872	
873	            .cursor_position => {
874	                const pos = self.cursorReportPos();
875	
876	                // Response always is at least 4 chars, so this leaves the
877	                // remainder for the row/column as base-10 numbers. This
878	                // will support a very large terminal.
879	                var msg: termio.Message = .{ .write_small = .{} };
880	                const resp = try std.mem.print(&msg.write_small.data, "\x1B[{};{}R", .{
881	                    pos.y + 1,
882	                    pos.x + 1,
883	                });
884	                msg.write_small.len = @intCast(resp.len);
885	
886	                self.messageWriter(msg);
887	            },
888	
889	            // DECXCPR: extended cursor position adds a page number. Ghostty has
890	            // no page memory, so the page is always 1.
891	            .cursor_position_extended => {
892	                const pos = self.cursorReportPos();
893	
894	                var msg: termio.Message = .{ .write_small = .{} };
895	                const resp = try std.fmt.bufPrint(&msg.write_small.data, "\x1B[?{};{};1R", .{
896	                    pos.y + 1,
897	                    pos.x + 1,
898	                });
899	                msg.write_small.len = @intCast(resp.len);
900	
901	                self.messageWriter(msg);
902	            },
903	
904	            .color_scheme => self.messageWriter(.{ .color_scheme_report = .{ .force = true } }),
905	
906	            .visibility => self.messageWriter(.{ .visibility_report = .{
907	                .visible = self.terminal.flags.visible,
908	                .force = true,
909	            } }),
910	        }
911	    }
