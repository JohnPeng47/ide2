src/termio/Options.zig
9	/// All size metrics for the terminal.
10	size: renderer.Size,
11	
12	/// The full app configuration. This is only available during initialization.
13	/// The memory it points to is NOT stable after the init call so any values
14	/// in here must be copied.
15	full_config: *const Config,
16	
17	/// The derived configuration for this termio implementation.
18	config: termio.Termio.DerivedConfig,
19	
20	/// The backend for termio that implements where reads/writes are sourced.
21	backend: termio.Backend,
22	
23	/// The mailbox for the terminal. This is how messages are delivered.
24	/// If you're using termio.Thread this MUST be "mailbox".
25	mailbox: termio.Mailbox,
26	
27	/// The render state. The IO implementation can modify anything here. The
28	/// surface thread will setup the initial "terminal" pointer but the IO impl
29	/// is free to change that if that is useful (i.e. doing some sort of dual
30	/// terminal implementation.)
31	renderer_state: *renderer.State,
32	
33	/// A handle to wake up the renderer. This hints to the renderer that
34	/// a repaint should happen.
35	renderer_wakeup: xev.Async,
36	
37	/// The mailbox for renderer messages.
38	renderer_mailbox: *renderer.Thread.Mailbox,
39	
40	/// The mailbox for sending the surface messages.
41	surface_mailbox: apprt.surface.Mailbox,

src/termio/Termio.zig
1	//! Primary terminal IO ("termio") state. This maintains the terminal state,
2	//! pty, subprocess, etc. This is flexible enough to be used in environments
3	//! that don't have a pty and simply provides the input/output using raw
4	//! bytes.
5	pub const Termio = @This();

src/termio/Termio.zig
31	/// Allocator
32	alloc: Allocator,
33	
34	/// This is the implementation responsible for io.
35	backend: termio.Backend,
36	
37	/// The derived configuration for this termio implementation.
38	config: DerivedConfig,
39	
40	/// The terminal emulator internal state. This is the abstract "terminal"
41	/// that manages input, grid updating, etc. and is renderer-agnostic. It
42	/// just stores internal state about a grid.
43	terminal: terminalpkg.Terminal,
44	
45	/// The shared render state
46	renderer_state: *renderer.State,
47	
48	/// A handle to wake up the renderer. This hints to the renderer that
49	/// a repaint should happen.
50	renderer_wakeup: xev.Async,
51	
52	/// The mailbox for notifying the renderer of things.
53	renderer_mailbox: *renderer.Thread.Mailbox,
54	
55	/// The mailbox for communicating with the surface.
