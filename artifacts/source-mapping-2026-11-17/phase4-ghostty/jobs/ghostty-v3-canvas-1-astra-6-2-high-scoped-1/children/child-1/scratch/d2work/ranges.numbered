732	        /// Process a string of characters.
733	        pub inline fn nextSlice(self: *Self, input: []const u8) void {
734	            self.nextSliceUntracked(input, false, {});
735	
736	            // Continuation tracking is opt-in and this branch predicts
737	            // perfectly, so disabled streams pay nothing else here.
738	            if (self.continuation != null) self.trackContinuation(input);
739	        }

src/terminal/stream.zig
831	        inline fn nextSliceUntracked(
832	            self: *Self,
833	            input: []const u8,
834	            comptime until: bool,
835	            u: Until.Arg(until),
836	        ) void {
837	            // Byte-at-a-time parsing in debug mode only. Even without
838	            // SIMD support (build_options.simd == false, e.g. wasm), the
839	            // batched path below is much faster than per-byte dispatch
840	            // because it decodes UTF-8 in bulk (via scalar fallbacks) and
841	            // hands printable runs to the handler as print_slice actions.
842	            if (comptime debug) {
843	                for (input, 0..) |c, i| {
844	                    self.nextUntracked(c, until, u);
845	                    if (comptime until) {
846	                        if (self.untilReached(u, input.ptr + i + 1)) return;
847	                    }
848	                }
849	                return;
850	            }
851	
852	            // This is the maximum number of codepoints we can decode
853	            // at one time for this function call. This is somewhat arbitrary
854	            // so if someone can demonstrate a better number then we can switch.
855	            var cp_buf: [4096]u32 = undefined;
856	
857	            // Split the input into chunks that fit into cp_buf.
858	            var i: usize = 0;
859	            while (true) {
860	                const len = @min(cp_buf.len, input.len - i);
861	                self.nextSliceCapped(input[i .. i + len], &cp_buf, until, u);
862	                if (comptime until) if (u.stop != null) return;
863	                i += len;
864	                if (i >= input.len) break;
865	            }
866	        }
867	
868	        inline fn nextSliceCapped(
869	            self: *Self,
870	            input: []const u8,
871	            cp_buf: []u32,
872	            comptime until: bool,
873	            u: Until.Arg(until),
874	        ) void {
875	            assert(input.len <= cp_buf.len);
876	
877	            var offset: usize = 0;
878	
879	            // If the scalar UTF-8 decoder was in the middle of processing
880	            // a code sequence, we continue until it's not.
881	            while (self.utf8decoder.state != 0) {
882	                if (offset >= input.len) return;
883	                self.nextUtf8(input[offset]);
884	                offset += 1;
885	            }
886	            // Completing the codepoint may have reached ground.
887	            if (comptime until) if (self.untilReached(u, input.ptr + offset)) return;
888	            if (offset >= input.len) return;
889	
890	            // If we're not in the ground state then we process until
891	            // we are. This can happen if the last chunk of input put us
892	            // in the middle of a control sequence.
893	            offset += self.consumeUntilGround(input[offset..], until, u);
894	            if (comptime until) if (self.untilReached(u, input.ptr + offset)) return;
895	            if (offset >= input.len) return;
896	            offset += self.consumeAllEscapes(input[offset..], until, u);
897	            if (comptime until) if (self.untilReached(u, input.ptr + offset)) return;
898	
899	            // If we're in the ground state then we can use SIMD to process
900	            // input until we see an ESC (0x1B), since all other characters
901	            // up to that point are just UTF-8.
902	            while (self.parser.state == .ground and offset < input.len) {
903	                const res = simd.vt.utf8DecodeUntilControlSeq(input[offset..], cp_buf);
904	
905	                // ASCII needs no decoding, so the decoder leaves it in
906	                // the input and we split it into runs there.
907	                if (res.ascii) {
908	                    self.printRuns(u8, input[offset..][0..res.consumed], cp_buf);
909	                } else {
910	                    self.printRuns(u32, cp_buf[0..res.decoded], cp_buf);
911	                }
912	
913	                // Consume the bytes we just processed.
914	                offset += res.consumed;
915	
916	                if (offset >= input.len) return;
917	
918	                // If our offset is NOT an escape then we must have a
919	                // partial UTF-8 sequence. In that case, we pass it off
920	                // to the scalar parser.
921	                if (input[offset] != 0x1B) {
922	                    const rem = input[offset..];
923	                    for (rem) |c| self.nextUtf8(c);
924	                    return;
925	                }
926	
927	                // Process control sequences until we run out.
928	                offset += self.consumeAllEscapes(input[offset..], until, u);
929	                if (comptime until) if (self.untilReached(u, input.ptr + offset)) return;
930	            }
931	        }
932	
933	        /// Hand the runs of printable codepoints in cps to the handler as

src/terminal/stream.zig
1002	                if (ascii) {
1003	                    self.printAscii(cps[i..end], buf);
1004	                } else {
1005	                    self.handler.vt(.print_slice, .{ .cps = cps[i..end] });
1006	                }
1007	                i = end;

