559	    inline fn horizontalTab(self: *StreamHandler, count: u16) void {
560	        for (0..count) |_| {
561	            const x = self.terminal.screens.active.cursor.x;
562	            self.terminal.horizontalTab();
563	            if (x == self.terminal.screens.active.cursor.x) break;
564	        }
565	    }
566	
567	    inline fn horizontalTabBack(self: *StreamHandler, count: u16) void {
568	        for (0..count) |_| {
569	            const x = self.terminal.screens.active.cursor.x;
570	            self.terminal.horizontalTabBack();
571	            if (x == self.terminal.screens.active.cursor.x) break;
572	        }
573	    }
