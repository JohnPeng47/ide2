1371	        pub inline fn next(self: *Self, c: u8) void {
1372	            self.nextUntracked(c, false, {});
1373	            if (self.continuation != null) self.trackContinuation(&.{c});
1374	        }
1375	
1376	        inline fn nextUntracked(
1377	            self: *Self,
1378	            c: u8,
1379	            comptime until: bool,
1380	            u: Until.Arg(until),
1381	        ) void {
1382	            // The scalar path can be responsible for decoding UTF-8.
1383	            if (self.parser.state == .ground) {
1384	                self.nextUtf8(c);
1385	                return;
1386	            }
1387	
1388	            self.nextNonUtf8(c, until, u);
1389	        }

