829	    pub fn deviceAttributes(
830	        self: *StreamHandler,
831	        req: terminal.DeviceAttributeReq,
832	    ) !void {
833	        // For the below, we quack as a VT220. We don't quack as
834	        // a 420 because we don't support DCS sequences.
835	        switch (req) {
836	            .primary => self.messageWriter(.{
837	                // 62 = Level 2 conformance
838	                // 22 = Color text
839	                // 52 = Clipboard access
840	                .write_stable = if (self.clipboard_write != .deny)
841	                    "\x1B[?62;22;52c"
842	                else
843	                    "\x1B[?62;22c",
844	            }),
845	
846	            .secondary => self.messageWriter(.{
847	                .write_stable = "\x1B[>1;10;0c",
848	            }),
849	
850	            else => log.warn("unimplemented device attributes req: {}", .{req}),
851	        }
852	    }

