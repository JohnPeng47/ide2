src/terminal/Parser.zig
257	pub fn next(self: *Parser, c: u8) [3]?Action {
258	    const effect = table[c][@backingInt(self.state)];
259	
260	    // log.info("next: {x}", .{c});
261	
262	    const next_state = effect.state;
263	    const action = effect.action;
264	
265	    // After generating the actions, we set our next state.
266	    defer self.state = next_state;
267	
268	    // When going from one state to another, the actions take place in this order:
269	    //
270	    // 1. exit action from old state
271	    // 2. transition action
272	    // 3. entry action to new state
273	    return [3]?Action{
274	        // Exit depends on current state
275	        if (self.state == next_state) null else switch (self.state) {
276	            .osc_string => if (self.osc_parser.end(c)) |cmd|
277	                Action{ .osc_dispatch = cmd.* }
278	            else
279	                null,
280	            .dcs_passthrough => Action{ .dcs_unhook = {} },
281	            .sos_pm_apc_string => Action{ .apc_end = {} },
282	            else => null,
283	        },
284	
285	        self.doAction(action, c),
286	
287	        // Entry depends on new state
288	        if (self.state == next_state) null else switch (next_state) {
289	            .escape, .dcs_entry, .csi_entry => clear: {
290	                self.clear();
291	                break :clear null;
292	            },
293	            .osc_string => osc_string: {
294	                self.osc_parser.reset();
295	                break :osc_string null;
296	            },
297	            .dcs_passthrough => dcs_hook: {
298	                // Ignore too many parameters
299	                if (self.params_idx >= MAX_PARAMS) break :dcs_hook null;
300	                // Finalize parameters
301	                if (self.param_acc_idx > 0) {
302	                    self.params[self.params_idx] = self.param_acc;
303	                    self.params_idx += 1;
304	                }
305	                break :dcs_hook .{
306	                    .dcs_hook = .{
307	                        .intermediates = self.intermediates[0..self.intermediates_idx],
308	                        .params = self.params[0..self.params_idx],
309	                        .final = c,
310	                    },
311	                };
312	            },
313	            .sos_pm_apc_string => Action{ .apc_start = {} },
314	            else => null,
315	        },
316	    };
317	}

