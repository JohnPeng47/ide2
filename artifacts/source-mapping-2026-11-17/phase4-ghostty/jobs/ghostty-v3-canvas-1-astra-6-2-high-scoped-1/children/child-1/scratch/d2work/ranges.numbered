955	    /// Record a Kitty clipboard protocol session grant so future
956	    /// requests with this password skip the permission prompt.
957	    pub fn kittyClipboardGrant(
958	        self: *StreamHandler,
959	        pw: []const u8,
960	        dir: terminal.kitty.clipboard.Grants.Direction,
961	    ) error{OutOfMemory}!void {
