610	    fn reportXtChecksum(self: *StreamHandler, req: terminal.xt_checksum.Request) void {
611	        if (!self.xt_checksum_report) return;
612	        var data: termio.Message.WriteReq.Small.Array = undefined;
613	        var writer: std.Io.Writer = .fixed(&data);
614	        terminal.xt_checksum.encode(
615	            &writer,
616	            req.id,
617	            self.terminal.rectXtChecksum(req),
618	        ) catch |err| {
619	            log.err("error encoding checksum report err={}", .{err});
620	            return;
621	        };
622	        self.messageWriter(.{ .write_small = .{
623	            .data = data,
624	            .len = @intCast(writer.buffered().len),
625	        } });
626	    }
627	
628	    fn sendModeReport(self: *StreamHandler, report: terminal.modes.Report) void {
629	        var data: termio.Message.WriteReq.Small.Array = undefined;
630	        var writer: std.Io.Writer = .fixed(&data);
631	        report.encode(&writer) catch |err| {
632	            log.err("error encoding mode report err={}", .{err});
633	            return;
634	        };
635	        self.messageWriter(.{ .write_small = .{
636	            .data = data,
637	            .len = @intCast(writer.buffered().len),
638	        } });
639	    }
640	
641	    pub fn setMode(self: *StreamHandler, mode: terminal.Mode, enabled: bool) !void {
642	        // Note: this function doesn't need to grab the render state or
643	        // terminal locks because it is only called from process() which
644	        // grabs the lock.
645	
646	        // If we are setting cursor blinking, we ignore it if we have
647	        // a default cursor blink setting set. This is a really weird
648	        // behavior so this comment will go deep into trying to explain it.
649	        //
650	        // There are two ways to set cursor blinks: DECSCUSR (CSI _ q)
651	        // and DEC mode 12. DECSCUSR is the modern approach and has a
652	        // way to revert to the "default" (as defined by the terminal)
653	        // cursor style and blink by doing "CSI 0 q". DEC mode 12 controls
654	        // blinking and is either on or off and has no way to set a
655	        // default. DEC mode 12 is also the more antiquated approach.
656	        //
657	        // The problem is that if the user specifies a desired default
658	        // cursor blink with `cursor-style-blink`, the moment a running
659	        // program uses DEC mode 12, the cursor blink can never be reset
660	        // to the default without an explicit DECSCUSR. But if a program
661	        // is using mode 12, it is by definition not using DECSCUSR.
662	        // This makes for somewhat annoying interactions where a poorly
663	        // (or legacy) behaved program will stop blinking, and it simply
664	        // never restarts.
665	        //
666	        // To get around this, we have a special case where if the user
667	        // specifies some explicit default cursor blink desire, we ignore
668	        // DEC mode 12. We allow DECSCUSR to still set the cursor blink
669	        // because programs using DECSCUSR usually are well behaved and
670	        // reset the cursor blink to the default when they exit.
671	        //
672	        // To be extra safe, users can also add a manual `CSI 0 q` to
673	        // their shell config when they render prompts to ensure the
674	        // cursor is exactly as they request.
675	        if (mode == .cursor_blinking and
676	            self.terminal.cursor.default_blink != null)
677	        {
678	            return;
679	        }
680	
681	        // We first always set the raw mode on our mode state.
682	        self.terminal.modes.set(mode, enabled);
683	
684	        // And then some modes require additional processing.
685	        switch (mode) {
686	            // Just noting here that autorepeat has no effect on
687	            // the terminal. xterm ignores this mode and so do we.
688	            // We know about just so that we don't log that it is
689	            // an unknown mode.
690	            .autorepeat => {},
691	
692	            // Schedule a render since we changed colors
693	            .reverse_colors => self.terminal.flags.dirty.reverse_colors = true,
694	
695	            // Origin resets cursor pos. This is called whether or not
696	            // we're enabling or disabling origin mode and whether or
697	            // not the value changed.
698	            .origin => self.terminal.setCursorPos(1, 1),
699	
700	            .enable_left_and_right_margin => if (!enabled) {
701	                // When we disable left/right margin mode we need to
702	                // reset the left/right margins.
703	                self.terminal.scrolling_region.left = 0;
704	                self.terminal.scrolling_region.right = self.terminal.cols - 1;
705	            },
706	
707	            .alt_screen_legacy => {
708	                try self.terminal.switchScreenMode(.@"47", enabled);
709	            },
710	
711	            .alt_screen => {
712	                try self.terminal.switchScreenMode(.@"1047", enabled);
713	            },
714	
715	            .alt_screen_save_cursor_clear_enter => {
716	                try self.terminal.switchScreenMode(.@"1049", enabled);
717	            },
718	
719	            // Mode 1048 is xterm's conditional save cursor depending
720	            // on if alt screen is enabled or not (at the terminal emulator
721	            // level). Alt screen is always enabled for us so this just
722	            // does a save/restore cursor.
723	            .save_cursor => {
724	                if (enabled) {
725	                    self.terminal.saveCursor();
726	                } else {
727	                    self.terminal.restoreCursor();
728	                }
729	            },
730	
731	            // Force resize back to the window size
732	            .enable_mode_3 => {
733	                const grid_size = self.size.grid();
734	                self.terminal.resize(
735	                    self.alloc,
736	                    .{
737	                        .cols = grid_size.columns,
738	                        .rows = grid_size.rows,
739	                    },
740	                ) catch |err| {
741	                    log.err("error updating terminal size: {}", .{err});
742	                };
743	            },
744	
745	            .@"132_column" => try self.terminal.deccolm(
746	                self.alloc,
747	                if (enabled) .@"132_cols" else .@"80_cols",
748	            ),
749	
750	            // We need to start a timer to prevent the emulator being hung
751	            // forever.
752	            .synchronized_output => {
753	                if (enabled) self.messageWriter(.{ .start_synchronized_output = {} });
754	            },
755	
756	            .linefeed => {
757	                self.messageWriter(.{ .linefeed_mode = enabled });
758	            },
759	
760	            .in_band_size_reports => if (enabled) self.messageWriter(.{
761	                .size_report = .mode_2048,
762	            }),
763	
764	            .report_visibility => if (enabled) self.messageWriter(.{
765	                .visibility_report = .{
766	                    .visible = self.terminal.flags.visible,
767	                    .force = true,
768	                },
769	            }),
770	
771	            .focus_event => if (enabled) self.messageWriter(.{
772	                .focused = self.terminal.flags.focused,
773	            }),
774	
775	            .mouse_event_x10 => {
776	                if (enabled) {
777	                    self.terminal.flags.mouse_event = .x10;
778	                    try self.setMouseShape(.default);
779	                } else {
780	                    self.terminal.flags.mouse_event = .none;
781	                    try self.setMouseShape(.text);
782	                }
783	            },
784	            .mouse_event_normal => {
785	                if (enabled) {
786	                    self.terminal.flags.mouse_event = .normal;
787	                    try self.setMouseShape(.default);
788	                } else {
789	                    self.terminal.flags.mouse_event = .none;
790	                    try self.setMouseShape(.text);
791	                }
792	            },
793	            .mouse_event_button => {
794	                if (enabled) {
795	                    self.terminal.flags.mouse_event = .button;
796	                    try self.setMouseShape(.default);
797	                } else {
798	                    self.terminal.flags.mouse_event = .none;
799	                    try self.setMouseShape(.text);
800	                }
801	            },
802	            .mouse_event_any => {
803	                if (enabled) {
804	                    self.terminal.flags.mouse_event = .any;
805	                    try self.setMouseShape(.default);
806	                } else {
807	                    self.terminal.flags.mouse_event = .none;
808	                    try self.setMouseShape(.text);
809	                }
810	            },
811	
812	            .mouse_format_utf8 => self.terminal.flags.mouse_format = if (enabled) .utf8 else .x10,
813	            .mouse_format_sgr => self.terminal.flags.mouse_format = if (enabled) .sgr else .x10,
814	            .mouse_format_urxvt => self.terminal.flags.mouse_format = if (enabled) .urxvt else .x10,
815	            .mouse_format_sgr_pixels => self.terminal.flags.mouse_format = if (enabled) .sgr_pixels else .x10,
816	
817	            else => {},
818	        }
819	    }
