965	    pub fn queryKittyKeyboard(self: *StreamHandler) !void {
966	        log.debug("querying kitty keyboard mode", .{});
967	        var data: termio.Message.WriteReq.Small.Array = undefined;
968	        const resp = try std.mem.print(&data, "\x1b[?{}u", .{
969	            self.terminal.screens.active.kitty_keyboard.current().int(),
970	        });
971	
972	        self.messageWriter(.{
973	            .write_small = .{
974	                .data = data,
975	                .len = @intCast(resp.len),
976	            },
977	        });
978	    }
979	
980	    pub fn reportXtversion(
981	        self: *StreamHandler,
982	    ) !void {
983	        log.debug("reporting XTVERSION: ghostty {s}", .{build_config.version_string});
984	        var buf: [288]u8 = undefined;
985	        const resp = try std.mem.print(
986	            &buf,
987	            "\x1BP>|{s} {s}\x1B\\",
988	            .{
989	                "ghostty",
990	                build_config.version_string,
991	            },
992	        );
993	        const msg = try termio.Message.writeReq(self.alloc, resp);
994	        self.messageWriter(msg);
995	    }
996	
997	    //-------------------------------------------------------------------------
998	    // OSC
999	
1000	    fn windowTitle(self: *StreamHandler, title: []const u8) !void {
1001	        var buf: [256]u8 = undefined;
1002	        if (title.len >= buf.len) {
1003	            log.warn("change title requested larger than our buffer size, ignoring", .{});
1004	            return;
1005	        }
1006	
1007	        // Set the title on the terminal state. We ignore any errors since
1008	        // we can continue to operate just fine without it.
1009	        self.terminal.setTitle(title) catch |err| {
1010	            log.warn("error setting title in terminal state: {}", .{err});
1011	        };
1012	
1013	        @memcpy(buf[0..title.len], title);
1014	        buf[title.len] = 0;
1015	
1016	        // Special handling for the empty title. We treat the empty title
1017	        // as resetting to as if we never saw a title. Other terminals
1018	        // behave this way too (e.g. iTerm2).
1019	        if (title.len == 0) {
1020	            // If we have a pwd then we set the title as the pwd else
1021	            // we just set it to blank.
1022	            if (self.terminal.getPwd()) |pwd| pwd: {
1023	                if (pwd.len >= buf.len) break :pwd;
1024	                @memcpy(buf[0..pwd.len], pwd);
1025	                buf[pwd.len] = 0;
1026	            }
1027	
1028	            self.surfaceMessageWriter(.{ .set_title = buf });
1029	            self.seen_title = false;
1030	            return;
1031	        }
1032	
1033	        self.seen_title = true;
1034	        self.surfaceMessageWriter(.{ .set_title = buf });
1035	    }
1036	
1037	    inline fn setMouseShape(
1038	        self: *StreamHandler,
1039	        shape: terminal.MouseShape,
1040	    ) !void {
1041	        // Avoid changing the shape if it is already set to avoid excess
1042	        // cross-thread messaging.
1043	        if (self.terminal.mouse_shape == shape) return;
1044	
1045	        self.terminal.mouse_shape = shape;
1046	        self.surfaceMessageWriter(.{ .set_mouse_shape = shape });
1047	    }
1048	
1049	    fn clipboardContents(self: *StreamHandler, kind: u8, data: []const u8) !void {
1050	        // Note: we ignore the "kind" field and always use the standard clipboard.
1051	        // iTerm also appears to do this but other terminals seem to only allow
1052	        // certain. Let's investigate more.
1053	
1054	        const clipboard_type: apprt.Clipboard = switch (kind) {
1055	            'c' => .standard,
1056	            's' => .selection,
1057	            'p' => .primary,
1058	            else => .standard,
1059	        };
1060	
1061	        // Get clipboard contents
1062	        if (data.len == 1 and data[0] == '?') {
1063	            self.surfaceMessageWriter(.{ .clipboard_read = clipboard_type });
1064	            return;
1065	        }
1066	
1067	        // Write clipboard contents
1068	        self.surfaceMessageWriter(.{
1069	            .clipboard_write = .{
1070	                .req = try apprt.surface.Message.WriteReq.init(
1071	                    self.alloc,
1072	                    data,
1073	                ),
1074	                .clipboard_type = clipboard_type,
1075	            },
1076	        });
1077	    }
1078	
1079	    /// Handle one Kitty clipboard protocol (OSC 5522) packet.
1080	    fn kittyClipboard(
1081	        self: *StreamHandler,
1082	        v: terminal.osc.Command.KittyClipboardProtocol,
1083	    ) error{ OutOfMemory, WriteFailed }!void {
1084	        const kitty_clipboard = terminal.kitty.clipboard;
1085	
1086	        // Decode and validate the metadata. Malformed structure drops
1087	        // the packet without a response. Invalid decoded text on a write
1088	        // data or alias packet aborts an in-flight transaction.
1089	        var arena: std.heap.ArenaAllocator = .init(self.alloc);
1090	        defer arena.deinit();
1091	        const meta = (kitty_clipboard.Metadata.parse(
1092	            arena.allocator(),
1093	            v.metadata,
1094	        ) catch |err| switch (err) {
1095	            error.OutOfMemory => return error.OutOfMemory,
1096	            error.InvalidValue => {
1097	                const state = self.kitty_clipboard_write orelse return;
1098	                switch (kitty_clipboard.Metadata.operation(v.metadata) orelse return) {
1099	                    .wdata, .walias => try self.kittyClipboardWriteFinish(
1100	                        state,
1101	                        .EINVAL,
1102	                        v.terminator,
1103	                    ),
1104	                    .read, .write => {},
1105	                }
1106	                return;
1107	            },
1108	        }) orelse return;
1109	
1110	        switch (meta.op) {
1111	            .read => try self.kittyClipboardRead(
1112	                &meta,
1113	                v.payload orelse "",
1114	                v.terminator,
1115	            ),
1116	
1117	            .write => try self.kittyClipboardWriteBegin(
1118	                &meta,
1119	                v.terminator,
1120	            ),
1121	
1122	            .wdata => try self.kittyClipboardWriteData(
1123	                &meta,
1124	                v.payload orelse "",
1125	                v.terminator,
1126	            ),
1127	
1128	            .walias => try self.kittyClipboardWriteAlias(
1129	                &meta,
1130	                v.payload orelse "",
1131	                v.terminator,
1132	            ),
1133	        }
1134	    }
1135	
1136	    fn kittyClipboardRead(
1137	        self: *StreamHandler,
1138	        meta: *const terminal.kitty.clipboard.Metadata,
1139	        payload: []const u8,
1140	        terminator: terminal.osc.Terminator,
1141	    ) !void {
1142	        const kitty_clipboard = terminal.kitty.clipboard;
1143	
1144	        // Everything about the request, including the request struct
1145	        // itself, lives in a single arena that crosses to the surface
1146	        // thread, which owns it from the moment the message is sent.
1147	        var arena: std.heap.ArenaAllocator = .init(self.alloc);
1148	        errdefer arena.deinit();
1149	        const alloc = arena.allocator();
1150	
1151	        // The payload is the requested MIME list. A read request with
1152	        // an undecodable payload is dropped without any response,
1153	        // matching kitty.
1154	        const decoded = kitty_clipboard.Payload.init(
1155	            alloc,
1156	            payload,
1157	        ) catch |err| switch (err) {
1158	            error.OutOfMemory => return error.OutOfMemory,
1159	            error.Invalid => {
1160	                arena.deinit();
1161	                return;
1162	            },
1163	        };
1164	        if (!decoded.isValidUtf8()) {
1165	            arena.deinit();
1166	            return;
1167	        }
1168	
1169	        // The targets type ('.') asks for the listing of available
1170	        // types rather than data. Requested types beyond the cap are
1171	        // dropped and simply never served, which is how the protocol
1172	        // reports an unavailable type anyway.
1173	        var mimes_buf: [kitty_clipboard.max_read_mimes][]const u8 = undefined;
1174	        var mimes_len: usize = 0;
1175	        var list = false;
1176	        var it = decoded.mimeIterator();
1177	        while (it.next()) |mime| {
1178	            if (std.mem.eql(u8, mime, kitty_clipboard.targets_mime)) {
1179	                list = true;
1180	                continue;
1181	            }
1182	            if (mimes_len == mimes_buf.len) continue;
1183	            mimes_buf[mimes_len] = mime;
1184	            mimes_len += 1;
1185	        }
1186	
1187	        // Per the spec a password without a name is no password. A
1188	        // stored session grant for it lets the surface skip its
1189	        // permission prompt.
1190	        const pw: []const u8 = if (meta.name.len > 0) meta.pw else "";
1191	        const granted = self.kittyClipboardReadGranted(pw, mimes_len);
1192	
1193	        const req = try alloc.create(apprt.ClipboardRequest.KittyRead);
1194	        const mimes = try alloc.alloc([:0]const u8, mimes_len);
1195	        for (mimes_buf[0..mimes_len], mimes) |src, *dst| {
1196	            dst.* = try alloc.dupeSentinel(u8, src, 0);
1197	        }
1198	        const id = try alloc.dupe(u8, meta.id);
1199	        const pw_owned = try alloc.dupe(u8, pw);
1200	        const name_owned = try alloc.dupeSentinel(u8, meta.name, 0);
1201	        req.* = .{
1202	            // The arena must be copied in last so it tracks every
1203	            // allocation above.
1204	            .arena = arena,
1205	            .location = switch (meta.loc) {
1206	                .primary => .primary,
1207	                else => .standard,
1208	            },
1209	            .mimes = mimes,
1210	            .list = list,
1211	            .id = id,
1212	            .pw = pw_owned,
1213	            .name = name_owned,
1214	            .granted = granted,
1215	            .terminator = terminator,
1216	        };
1217	
1218	        self.surfaceMessageWriter(.{ .kitty_clipboard_read = req });
1219	    }
1220	
1221	    /// Whether a session grant covers a read request, consuming
1222	    /// one-time grants. A prompt-exempt request never consults the
1223	    /// grants: consuming a one-time paste password on a listing would
1224	    /// burn the grant before the follow-up data read.
1225	    fn kittyClipboardReadGranted(
1226	        self: *StreamHandler,
1227	        pw: []const u8,
1228	        mimes_len: usize,
1229	    ) bool {
1230	        if (terminal.kitty.clipboard.readPromptExempt(mimes_len)) return false;
1231	        return self.kitty_clipboard_grants.use(self.alloc, pw, .read);
1232	    }
1233	
1234	    /// Begin a Kitty clipboard write transaction (type=write).
1235	    fn kittyClipboardWriteBegin(
1236	        self: *StreamHandler,
1237	        meta: *const terminal.kitty.clipboard.Metadata,
1238	        terminator: terminal.osc.Terminator,
1239	    ) error{ OutOfMemory, WriteFailed }!void {
1240	        // A new write silently replaces any in-flight transaction.
1241	        self.kittyClipboardWriteAbort();
1242	
1243	        // A write denied by policy can never succeed, so fail the
1244	        // transaction up front instead of spooling data we'd only
1245	        // throw away. Later wdata packets are ignored.
1246	        if (self.clipboard_write == .deny) {
1247	            log.info("application attempted to write clipboard, but 'clipboard-write' is set to deny", .{});
1248	            try self.kittyClipboardWriteStatus(
1249	                .EPERM,
1250	                meta.id,
1251	                terminator,
1252	            );
1253	            return;
1254	        }
1255	
1256	        const state = try self.alloc.create(terminal.kitty.clipboard.WriteState);
1257	        errdefer self.alloc.destroy(state);
1258	        state.* = try .init(self.alloc, meta, .{
1259	            .max_size = self.clipboard_write_limit,
1260	        });
1261	        self.kitty_clipboard_write = state;
1262	    }
1263	
1264	    /// Accumulate one wdata chunk, or commit the transaction when the
1265	    /// chunk carries no MIME type.
1266	    fn kittyClipboardWriteData(
1267	        self: *StreamHandler,
1268	        meta: *const terminal.kitty.clipboard.Metadata,
1269	        payload: []const u8,
1270	        terminator: terminal.osc.Terminator,
1271	    ) error{ OutOfMemory, WriteFailed }!void {
1272	        // Data without a transaction is silently ignored, matching
1273	        // kitty.
1274	        const state = self.kitty_clipboard_write orelse return;
1275	
1276	        // A wdata packet without a MIME type commits the transaction.
1277	        if (meta.mime.len == 0) return self.kittyClipboardWriteCommit(
1278	            state,
1279	            terminator,
1280	        );
1281	
1282	        state.data(
1283	            self.alloc,
1284	            meta,
1285	            payload,
1286	        ) catch |err| switch (err) {
1287	            // Failing to spool matches kitty's EIO for a failed buffer write.
1288	            error.OutOfMemory => {
1289	                try self.kittyClipboardWriteFinish(
1290	                    state,
1291	                    .EIO,
1292	                    terminator,
1293	                );
1294	                return error.OutOfMemory;
1295	            },
1296	
1297	            // Data over the write limit aborts the transaction and is
1298	            // reported to the client.
1299	            error.TooLarge => try self.kittyClipboardWriteFinish(
1300	                state,
1301	                .EFBIG,
1302	                terminator,
1303	            ),
1304	
1305	            // An invalid base64 payload stream aborts the transaction.
1306	            error.Invalid => try self.kittyClipboardWriteFinish(
1307	                state,
1308	                .EINVAL,
1309	                terminator,
1310	            ),
1311	        };
1312	    }
1313	
1314	    /// Register aliases from a walias packet.
1315	    fn kittyClipboardWriteAlias(
1316	        self: *StreamHandler,
1317	        meta: *const terminal.kitty.clipboard.Metadata,
1318	        payload: []const u8,
1319	        terminator: terminal.osc.Terminator,
1320	    ) error{ OutOfMemory, WriteFailed }!void {
1321	        // Aliases without a transaction are silently ignored. Once a
1322	        // transaction exists, a missing target MIME type is invalid and
1323	        // aborts the transaction.
1324	        const state = self.kitty_clipboard_write orelse return;
1325	        if (meta.mime.len == 0) return self.kittyClipboardWriteFinish(
1326	            state,
1327	            .EINVAL,
1328	            terminator,
1329	        );
1330	
1331	        state.alias(
1332	            self.alloc,
1333	            meta,
1334	            payload,
1335	        ) catch |err| switch (err) {
1336	            error.OutOfMemory => {
1337	                try self.kittyClipboardWriteFinish(
1338	                    state,
1339	                    .EIO,
1340	                    terminator,
1341	                );
1342	                return error.OutOfMemory;
1343	            },
1344	
1345	            // An undecodable alias payload aborts the transaction.
1346	            error.Invalid => try self.kittyClipboardWriteFinish(
1347	                state,
1348	                .EINVAL,
1349	                terminator,
1350	            ),
1351	        };
1352	    }
1353	
1354	    /// Commit the transaction: resolve the final contents and forward
1355	    /// them to the surface thread, which owns policy, any permission
1356	    /// prompt, the clipboard write itself, and the final reply.
1357	    fn kittyClipboardWriteCommit(
1358	        self: *StreamHandler,
1359	        state: *terminal.kitty.clipboard.WriteState,
1360	        terminator: terminal.osc.Terminator,
1361	    ) error{ OutOfMemory, WriteFailed }!void {
1362	        self.kittyClipboardWriteSend(
1363	            state,
1364	            terminator,
1365	        ) catch |err| switch (err) {
1366	            error.OutOfMemory => {
1367	                try self.kittyClipboardWriteFinish(
1368	                    state,
1369	                    .EIO,
1370	                    terminator,
1371	                );
1372	                return error.OutOfMemory;
1373	            },
1374	
1375	            // The last MIME type's payload stream was not correctly
1376	            // padded, which aborts the transaction.
1377	            error.Invalid => return try self.kittyClipboardWriteFinish(
1378	                state,
1379	                .EINVAL,
1380	                terminator,
1381	            ),
1382	        };
1383	
1384	        // The transaction is complete; the surface owns the reply.
1385	        self.kittyClipboardWriteAbort();
1386	    }
1387	
1388	    fn kittyClipboardWriteSend(
1389	        self: *StreamHandler,
1390	        state: *terminal.kitty.clipboard.WriteState,
1391	        terminator: terminal.osc.Terminator,
1392	    ) error{ OutOfMemory, Invalid }!void {
1393	        const committed = try state.commit(self.alloc);
1394	        defer committed.deinit(self.alloc);
1395	
1396	        // Per the spec a password without a name is no password. A
1397	        // stored session grant for it lets the surface skip its
1398	        // permission prompt.
1399	        const pw: []const u8 = if (committed.name.len > 0) committed.pw else "";
1400	        const granted = self.kitty_clipboard_grants.use(self.alloc, pw, .write);
1401	
1402	        // Everything about the request, including the request struct
1403	        // itself, lives in a single arena that crosses to the surface
1404	        // thread, which owns it from the moment the message is sent.
1405	        var arena: std.heap.ArenaAllocator = .init(self.alloc);
1406	        errdefer arena.deinit();
1407	        const alloc = arena.allocator();
1408	
1409	        const req = try alloc.create(apprt.ClipboardRequest.KittyWrite);
1410	        const contents = try alloc.alloc(
1411	            apprt.ClipboardContent,
1412	            committed.contents.len,
1413	        );
1414	        for (committed.contents, contents) |src, *dst| dst.* = .{
1415	            .mime = try alloc.dupeSentinel(u8, src.mime, 0),
1416	            .data = try alloc.dupeSentinel(u8, src.data, 0),
1417	        };
1418	        const id = try alloc.dupe(u8, committed.id);
1419	        const pw_owned = try alloc.dupe(u8, pw);
1420	        const name_owned = try alloc.dupeSentinel(u8, committed.name, 0);
1421	        req.* = .{
1422	            // The arena must be copied in last so it tracks every
1423	            // allocation above.
1424	            .arena = arena,
1425	            .location = switch (committed.loc) {
1426	                .primary => .primary,
1427	                else => .standard,
1428	            },
1429	            .contents = contents,
1430	            .id = id,
1431	            .pw = pw_owned,
1432	            .name = name_owned,
1433	            .granted = granted,
1434	            .terminator = terminator,
1435	        };
1436	
1437	        self.surfaceMessageWriter(.{ .kitty_clipboard_write = req });
1438	    }
1439	
1440	    /// Answer the write transaction with its final status and drop it.
1441	    /// The id echoed is the one from the transaction's opening write
1442	    /// packet, matching kitty.
1443	    fn kittyClipboardWriteFinish(
1444	        self: *StreamHandler,
1445	        state: *const terminal.kitty.clipboard.WriteState,
1446	        status: terminal.kitty.clipboard.Status,
1447	        terminator: terminal.osc.Terminator,
1448	    ) error{ OutOfMemory, WriteFailed }!void {
1449	        defer self.kittyClipboardWriteAbort();
1450	        try self.kittyClipboardWriteStatus(status, state.id, terminator);
1451	    }
1452	
1453	    /// Reply to a write transaction with a single status packet.
1454	    fn kittyClipboardWriteStatus(
1455	        self: *StreamHandler,
1456	        status: terminal.kitty.clipboard.Status,
1457	        id: []const u8,
1458	        terminator: terminal.osc.Terminator,
1459	    ) error{ OutOfMemory, WriteFailed }!void {
1460	        var stream: std.Io.Writer.Allocating = .init(self.alloc);
1461	        defer stream.deinit();
1462	        try (terminal.kitty.clipboard.Response{
1463	            .op = .write,
1464	            .status = status,
1465	            .id = id,
1466	            .terminator = terminator,
1467	        }).encode(&stream.writer);
1468	        self.messageWriter(.{ .write_alloc = .{
1469	            .alloc = self.alloc,
1470	            .data = try stream.toOwnedSlice(),
1471	        } });
1472	    }
1473	
1474	    /// Drop any in-flight write transaction without responding.
1475	    fn kittyClipboardWriteAbort(self: *StreamHandler) void {
1476	        if (self.kitty_clipboard_write) |state| {
1477	            state.deinit(self.alloc);
1478	            self.alloc.destroy(state);
1479	            self.kitty_clipboard_write = null;
1480	        }
1481	    }
1482	
1483	    fn semanticPrompt(
1484	        self: *StreamHandler,
1485	        cmd: Stream.Action.SemanticPrompt,
1486	    ) !void {
1487	        switch (cmd.action) {
1488	            .end_input_start_output => {
1489	                self.surfaceMessageWriter(.start_command);
1490	            },
1491	
1492	            .end_command => {
1493	                // The specification seems to not specify the type but
1494	                // other terminals accept 32-bits, but exit codes are really
1495	                // bytes, so we just do our best here.
1496	                const code: u8 = code: {
1497	                    const raw: i32 = cmd.readOption(.exit_code) orelse 0;
1498	                    break :code std.math.cast(u8, raw) orelse 1;
1499	                };
1500	
1501	                self.surfaceMessageWriter(.{ .stop_command = code });
1502	            },
1503	
1504	            // Handled by Terminal, no special handling by us
1505	            .end_prompt_start_input,
1506	            .end_prompt_start_input_terminate_eol,
1507	            .fresh_line,
1508	            .fresh_line_new_prompt,
1509	            .new_command,
1510	            .prompt_start,
1511	            => {},
1512	        }
1513	
1514	        // We do this last so failures are still processed correctly
1515	        // above.
1516	        try self.terminal.semanticPrompt(cmd);
1517	    }
1518	
1519	    fn reportPwd(self: *StreamHandler, url: []const u8) !void {
1520	        // Special handling for the empty URL. We treat the empty URL
1521	        // as resetting the pwd as if we never saw a pwd. I can't find any
1522	        // other terminal that does this but it seems like a reasonable
1523	        // behavior that enables some useful features. For example, the macOS
1524	        // proxy icon can be hidden when a program reports it doesn't know
1525	        // the pwd rather than showing a stale pwd.
1526	        if (url.len == 0) {
1527	            // Blank value can never fail because no allocs happen.
1528	            self.terminal.setPwd("") catch unreachable;
1529	
1530	            // If we haven't seen a title, we're using the pwd as our title.
1531	            // Set it to blank which will reset our title behavior.
1532	            if (!self.seen_title) {
1533	                try self.windowTitle("");
1534	                assert(!self.seen_title);
1535	            }
1536	
1537	            // Report the change.
1538	            self.surfaceMessageWriter(.{ .pwd_change = .{ .stable = "" } });
1539	            return;
1540	        }
1541	
1542	        if (builtin.target.os.tag == .windows) {
1543	            log.warn("reportPwd unimplemented on windows", .{});
1544	            return;
1545	        }
1546	
1547	        // Attempt to parse this file-style URI using options appropriate
1548	        // for this OSC 7 context (e.g. kitty-shell-cwd expects the full,
1549	        // unencoded path).
1550	        const uri: std.Uri = internal_os.uri.parse(url, .{
1551	            .mac_address = comptime builtin.target.os.tag != .macos,
1552	            .raw_path = std.mem.startsWith(u8, url, "kitty-shell-cwd://"),
1553	        }) catch |e| {
1554	            log.warn("invalid url in OSC 7: {}", .{e});
1555	            return;
1556	        };
1557	
1558	        if (!std.mem.eql(u8, "file", uri.scheme) and
1559	            !std.mem.eql(u8, "kitty-shell-cwd", uri.scheme))
1560	        {
1561	            log.warn("OSC 7 scheme must be file or kitty-shell-cwd, got: {s}", .{uri.scheme});
1562	            return;
1563	        }
1564	
1565	        var host_buffer: [std.Io.net.HostName.max_len]u8 = undefined;
1566	        const host = osc7Host(uri, &host_buffer) catch |err| switch (err) {
1567	            error.UriMissingHost => {
1568	                log.warn("OSC 7 uri must contain a hostname: {}", .{err});
1569	                return;
1570	            },
1571	            error.NameTooLong => {
1572	                log.warn("failed to get full hostname for OSC 7 validation: {}", .{err});
1573	                return;
1574	            },
1575	        };
1576	
1577	        // OSC 7 is a little sketchy because anyone can send any value from
1578	        // any host (such an SSH session). The best practice terminals follow
1579	        // is to valid the hostname to be local.
1580	        const host_valid = internal_os.hostname.isLocal(host) catch |err| switch (err) {
1581	            error.PermissionDenied,
1582	            error.Unexpected,
1583	            => {
1584	                log.warn("failed to get hostname for OSC 7 validation: {}", .{err});
1585	                return;
1586	            },
1587	        };
1588	        if (!host_valid) {
1589	            log.warn("OSC 7 host ({s}) must be local", .{host});
1590	            return;
1591	        }
1592	
1593	        // We need the raw path, which might require unescaping. We try to
1594	        // avoid making any heap allocations by using the stack first.
1595	        var arena_alloc: std.heap.ArenaAllocator = .init(self.alloc);
1596	        var stack_alloc_buf: [1024]u8 = undefined;
1597	        var stack_alloc: std.heap.BufferFirstAllocator = .init(&stack_alloc_buf, arena_alloc.allocator());
1598	        defer arena_alloc.deinit();
1599	        const path = try uri.path.toRawMaybeAlloc(stack_alloc.allocator());
1600	
1601	        log.debug("terminal pwd: {s}", .{path});
1602	        try self.terminal.setPwd(path);
1603	
1604	        // Report it to the surface. If creating our write request fails
1605	        // then we just ignore it.
1606	        if (apprt.surface.Message.WriteReq.init(self.alloc, path)) |req| {
1607	            self.surfaceMessageWriter(.{ .pwd_change = req });
1608	        } else |err| {
1609	            log.warn("error notifying surface of pwd change err={}", .{err});
1610	        }
1611	
1612	        // If we haven't seen a title, use our pwd as the title.
1613	        if (!self.seen_title) {
1614	            try self.windowTitle(path);
1615	            self.seen_title = false;
1616	        }
1617	    }
1618	
1619	    fn colorOperation(
1620	        self: *StreamHandler,
1621	        op: terminal.osc.color.Operation,
1622	        requests: *const terminal.osc.color.List,
1623	        terminator: terminal.osc.Terminator,
1624	    ) !void {
1625	        // We'll need op one day if we ever implement reporting special colors.
1626	        _ = op;
1627	
1628	        // return early if there is nothing to do
1629	        if (requests.count() == 0) return;
1630	
1631	        var buffer: [1024]u8 = undefined;
1632	        var fba: std.heap.FixedBufferAllocator = .init(&buffer);
1633	        const alloc = fba.allocator();
1634	
1635	        var response: std.Io.Writer.Allocating = .init(alloc);
1636	
1637	        var it = requests.constIterator(0);
1638	        while (it.next()) |req| {
1639	            switch (req.*) {
1640	                .set => |set| {
1641	                    switch (set.target) {
1642	                        .palette => |i| {
1643	                            self.terminal.flags.dirty.palette = true;
1644	                            self.terminal.colors.palette.set(i, set.color);
1645	                        },
1646	                        .dynamic => |dynamic| switch (dynamic) {
1647	                            .foreground => self.terminal.colors.foreground.set(set.color),
1648	                            .background => self.terminal.colors.background.set(set.color),
1649	                            .cursor => self.terminal.colors.cursor.set(set.color),
1650	                            .pointer_foreground,
1651	                            .pointer_background,
1652	                            .tektronix_foreground,
1653	                            .tektronix_background,
1654	                            .highlight_background,
1655	                            .tektronix_cursor,
1656	                            .highlight_foreground,
1657	                            => log.info("setting dynamic color {s} not implemented", .{
1658	                                @tagName(dynamic),
1659	                            }),
1660	                        },
1661	                        .special => log.info("setting special colors not implemented", .{}),
1662	                    }
1663	
1664	                    // Notify the surface of the color change
1665	                    self.surfaceMessageWriter(.{ .color_change = .{
1666	                        .target = set.target,
1667	                        .color = set.color,
1668	                    } });
1669	                },
1670	
1671	                .reset => |target| switch (target) {
1672	                    .palette => |i| {
1673	                        self.terminal.flags.dirty.palette = true;
1674	                        self.terminal.colors.palette.reset(i);
1675	
1676	                        self.surfaceMessageWriter(.{
1677	                            .color_change = .{
1678	                                .target = target,
1679	                                .color = self.terminal.colors.palette.current[i],
1680	                            },
1681	                        });
1682	                    },
1683	                    .dynamic => |dynamic| switch (dynamic) {
1684	                        .foreground => {
1685	                            self.terminal.colors.foreground.reset();
1686	
1687	                            if (self.terminal.colors.foreground.default) |c| {
1688	                                self.surfaceMessageWriter(.{ .color_change = .{
1689	                                    .target = target,
1690	                                    .color = c,
1691	                                } });
1692	                            }
1693	                        },
1694	                        .background => {
1695	                            self.terminal.colors.background.reset();
1696	
1697	                            if (self.terminal.colors.background.default) |c| {
1698	                                self.surfaceMessageWriter(.{ .color_change = .{
1699	                                    .target = target,
1700	                                    .color = c,
1701	                                } });
1702	                            }
1703	                        },
1704	                        .cursor => {
1705	                            self.terminal.colors.cursor.reset();
1706	
1707	                            if (self.terminal.colors.cursor.default) |c| {
1708	                                self.surfaceMessageWriter(.{ .color_change = .{
1709	                                    .target = target,
1710	                                    .color = c,
1711	                                } });
1712	                            }
1713	                        },
1714	                        .pointer_foreground,
1715	                        .pointer_background,
1716	                        .tektronix_foreground,
1717	                        .tektronix_background,
1718	                        .highlight_background,
1719	                        .tektronix_cursor,
1720	                        .highlight_foreground,
1721	                        => log.warn("resetting dynamic color {s} not implemented", .{
1722	                            @tagName(dynamic),
1723	                        }),
1724	                    },
1725	                    .special => log.info("resetting special colors not implemented", .{}),
1726	                },
1727	
1728	                .reset_palette => {
1729	                    const mask = &self.terminal.colors.palette.mask;
1730	                    var mask_it = mask.iterator(.{});
1731	                    while (mask_it.next()) |i| {
1732	                        self.terminal.flags.dirty.palette = true;
1733	                        self.terminal.colors.palette.reset(@intCast(i));
1734	                        self.surfaceMessageWriter(.{
1735	                            .color_change = .{
1736	                                .target = .{ .palette = @intCast(i) },
1737	                                .color = self.terminal.colors.palette.current[i],
1738	                            },
1739	                        });
1740	                    }
1741	                    mask.* = .empty;
1742	                },
1743	
1744	                .reset_special => log.warn(
1745	                    "resetting all special colors not implemented",
1746	                    .{},
1747	                ),
1748	
1749	                .query => |kind| report: {
1750	                    if (self.osc_color_report_format == .none) break :report;
1751	
1752	                    const color = switch (kind) {
1753	                        .palette => |i| self.terminal.colors.palette.current[i],
1754	                        .dynamic => |dynamic| switch (dynamic) {
1755	                            .foreground => self.terminal.colors.foreground.get().?,
1756	                            .background => self.terminal.colors.background.get().?,
1757	                            .cursor => self.terminal.colors.cursor.get() orelse
1758	                                self.terminal.colors.foreground.get().?,
1759	                            .pointer_foreground,
1760	                            .pointer_background,
1761	                            .tektronix_foreground,
1762	                            .tektronix_background,
1763	                            .highlight_background,
1764	                            .tektronix_cursor,
1765	                            .highlight_foreground,
1766	                            => {
1767	                                log.info(
1768	                                    "reporting dynamic color {s} not implemented",
1769	                                    .{@tagName(dynamic)},
1770	                                );
1771	                                break :report;
1772	                            },
1773	                        },
1774	                        .special => {
1775	                            log.info("reporting special colors not implemented", .{});
1776	                            break :report;
1777	                        },
1778	                    };
1779	
1780	                    switch (self.osc_color_report_format) {
1781	                        .@"16-bit" => switch (kind) {
1782	                            .palette => |i| try response.writer.print(
1783	                                "\x1b]4;{d};rgb:{x:0>4}/{x:0>4}/{x:0>4}",
1784	                                .{
1785	                                    i,
1786	                                    @as(u16, color.r) * 257,
1787	                                    @as(u16, color.g) * 257,
1788	                                    @as(u16, color.b) * 257,
1789	                                },
1790	                            ),
1791	                            .dynamic => |dynamic| try response.writer.print(
1792	                                "\x1b]{d};rgb:{x:0>4}/{x:0>4}/{x:0>4}",
1793	                                .{
1794	                                    @backingInt(dynamic),
1795	                                    @as(u16, color.r) * 257,
1796	                                    @as(u16, color.g) * 257,
1797	                                    @as(u16, color.b) * 257,
1798	                                },
1799	                            ),
1800	                            .special => unreachable,
1801	                        },
1802	
1803	                        .@"8-bit" => switch (kind) {
1804	                            .palette => |i| try response.writer.print(
1805	                                "\x1b]4;{d};rgb:{x:0>2}/{x:0>2}/{x:0>2}",
1806	                                .{
1807	                                    i,
1808	                                    @as(u16, color.r),
1809	                                    @as(u16, color.g),
1810	                                    @as(u16, color.b),
1811	                                },
1812	                            ),
1813	                            .dynamic => |dynamic| try response.writer.print(
1814	                                "\x1b]{d};rgb:{x:0>2}/{x:0>2}/{x:0>2}",
1815	                                .{
1816	                                    @backingInt(dynamic),
1817	                                    @as(u16, color.r),
1818	                                    @as(u16, color.g),
1819	                                    @as(u16, color.b),
1820	                                },
1821	                            ),
1822	                            .special => unreachable,
1823	                        },
1824	
1825	                        .none => unreachable,
1826	                    }
1827	
1828	                    try response.writer.writeAll(terminator.string());
1829	                },
1830	            }
1831	        }
1832	
1833	        if (response.writer.end > 0) {
1834	            // If any of the operations were reports, finalize the report
1835	            // string and send it to the terminal.
1836	            const msg = try termio.Message.writeReq(self.alloc, response.writer.buffered());
1837	            self.messageWriter(msg);
1838	        }
1839	    }
1840	
1841	    fn showDesktopNotification(
1842	        self: *StreamHandler,
1843	        title: []const u8,
1844	        body: []const u8,
1845	    ) !void {
1846	        self.surfaceMessageWriter(.{
1847	            .desktop_notification = .init(title, body),
1848	        });
1849	    }
1850	
1851	    /// Send a report to the pty.
1852	    pub fn sendSizeReport(self: *StreamHandler, style: terminal.SizeReportStyle) void {
1853	        switch (style) {
1854	            .csi_14_t => self.messageWriter(.{ .size_report = .csi_14_t }),
1855	            .csi_16_t => self.messageWriter(.{ .size_report = .csi_16_t }),
1856	            .csi_18_t => self.messageWriter(.{ .size_report = .csi_18_t }),
1857	            .csi_19_t => self.messageWriter(.{ .size_report = .csi_19_t }),
1858	            .csi_21_t => self.surfaceMessageWriter(.{ .report_title = .csi_21_t }),
1859	        }
1860	    }
1861	
1862	    fn kittyColorReport(
1863	        self: *StreamHandler,
1864	        request: terminal.kitty.color.OSC,
1865	    ) !void {
1866	        var stream: std.Io.Writer.Allocating = .init(self.alloc);
1867	        defer stream.deinit();
1868	        const writer = &stream.writer;
1869	
1870	        for (request.list.items) |item| {
1871	            switch (item) {
1872	                .query => |key| {
1873	                    // If the writer buffer is empty, we need to write our prefix
1874	                    if (stream.written().len == 0) try writer.writeAll("\x1b]21");
1875	
1876	                    const color: terminal.color.RGB = switch (key) {
1877	                        .palette => |palette| self.terminal.colors.palette.current[palette],
1878	                        .special => |special| switch (special) {
1879	                            .foreground => self.terminal.colors.foreground.get(),
1880	                            .background => self.terminal.colors.background.get(),
1881	                            .cursor => self.terminal.colors.cursor.get(),
1882	                            else => {
1883	                                log.warn("ignoring unsupported kitty color protocol key: {f}", .{key});
1884	                                continue;
1885	                            },
1886	                        },
1887	                    } orelse {
1888	                        try writer.print(";{f}=", .{key});
1889	                        continue;
1890	                    };
1891	
1892	                    try writer.print(
1893	                        ";{f}=rgb:{x:0>2}/{x:0>2}/{x:0>2}",
1894	                        .{ key, color.r, color.g, color.b },
1895	                    );
1896	                },
1897	                .set => |v| switch (v.key) {
1898	                    .palette => |palette| {
1899	                        self.terminal.flags.dirty.palette = true;
1900	                        self.terminal.colors.palette.set(palette, v.color);
1901	                    },
1902	
1903	                    .special => |special| switch (special) {
1904	                        .foreground => self.terminal.colors.foreground.set(v.color),
1905	                        .background => self.terminal.colors.background.set(v.color),
1906	                        .cursor => self.terminal.colors.cursor.set(v.color),
1907	                        else => {
1908	                            log.warn(
1909	                                "ignoring unsupported kitty color protocol key: {f}",
1910	                                .{v.key},
1911	                            );
1912	                            continue;
1913	                        },
1914	                    },
1915	                },
1916	                .reset => |key| switch (key) {
1917	                    .palette => |palette| {
1918	                        self.terminal.flags.dirty.palette = true;
1919	                        self.terminal.colors.palette.reset(palette);
1920	                    },
1921	
1922	                    .special => |special| switch (special) {
1923	                        .foreground => self.terminal.colors.foreground.reset(),
1924	                        .background => self.terminal.colors.background.reset(),
1925	                        .cursor => self.terminal.colors.cursor.reset(),
1926	                        else => {
1927	                            log.warn(
1928	                                "ignoring unsupported kitty color protocol key: {f}",
1929	                                .{key},
1930	                            );
1931	                            continue;
1932	                        },
1933	                    },
1934	                },
1935	            }
1936	        }
1937	
1938	        // If we had any writes to our buffer, we queue them now
1939	        if (stream.written().len > 0) {
1940	            try writer.writeAll(request.terminator.string());
1941	            self.messageWriter(.{
1942	                .write_alloc = .{
1943	                    .alloc = self.alloc,
1944	                    .data = try stream.toOwnedSlice(),
1945	                },
1946	            });
1947	        }
1948	
1949	        // Note: we don't have to do a queueRender here because every
1950	        // processed stream will queue a render once it is done processing
1951	        // the read() syscall.
1952	    }
1953	
1954	    /// Display a GUI progress report.
1955	    fn progressReport(self: *StreamHandler, report: terminal.osc.Command.ProgressReport) void {
1956	        self.surfaceMessageWriter(.{ .progress_report = report });
1957	    }
1958	};

