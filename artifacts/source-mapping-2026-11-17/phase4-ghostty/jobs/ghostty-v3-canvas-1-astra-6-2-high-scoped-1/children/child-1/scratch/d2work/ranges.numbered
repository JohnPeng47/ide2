src/termio/Exec.zig
403	pub fn queueWrite(
404	    self: *Exec,
405	    alloc: Allocator,
406	    td: *termio.Termio.ThreadData,
407	    data: []const u8,
408	    linefeed: bool,
409	) !void {
410	    _ = self;
411	    const exec = &td.backend.exec;
412	
413	    // If our process is exited then we don't send any more writes.
414	    if (exec.exited) return;
415	
416	    // We go through and chunk the data if necessary to fit into
417	    // our cached buffers that we can queue to the stream.
418	    var i: usize = 0;
419	    while (i < data.len) {
420	        const w = try exec.write_pool.create(alloc);
421	        w.td = exec;
422	        const buf = &w.buf;
423	        const slice = slice: {
424	            // The maximum end index is either the end of our data or
425	            // the end of our buffer, whichever is smaller.
426	            const max = @min(data.len, i + buf.len);
427	
428	            // Fast
429	            if (!linefeed) {
430	                fastmem.copy(u8, buf, data[i..max]);
431	                const len = max - i;
432	                i = max;
433	                break :slice buf[0..len];
434	            }
435	
436	            // Slow, have to replace \r with \r\n
437	            var buf_i: usize = 0;
438	            while (i < data.len and buf_i < buf.len - 1) {
439	                const ch = data[i];
440	                i += 1;
441	
442	                if (ch != '\r') {
443	                    buf[buf_i] = ch;
444	                    buf_i += 1;
445	                    continue;
446	                }
447	
448	                // CRLF
449	                buf[buf_i] = '\r';
450	                buf[buf_i + 1] = '\n';
451	                buf_i += 2;
452	            }
453	
454	            break :slice buf[0..buf_i];
455	        };
456	
457	        //for (slice) |b| log.warn("write: {x}", .{b});
458	
459	        exec.write_stream.queueWrite(
460	            td.loop,
461	            &exec.write_queue,
462	            &w.req,
463	            .{ .slice = slice },
464	            ThreadData.Write,
465	            w,
466	            ttyWrite,
467	        );
468	    }
469	}
470	
471	fn ttyWrite(
472	    w_: ?*ThreadData.Write,
473	    _: *xev.Loop,
474	    _: *xev.Completion,
475	    _: xev.Stream,
476	    _: xev.WriteBuffer,
477	    r: xev.WriteError!usize,
478	) xev.CallbackAction {
479	    const w = w_.?;
480	    w.td.write_pool.destroy(w);
481	
482	    const d = r catch |err| {
483	        log.err("write error: {}", .{err});
484	        return .disarm;
485	    };
486	    _ = d;
487	    //log.info("WROTE: {d}", .{d});
488	
489	    return .disarm;
490	}

src/termio/Exec.zig
492	/// The thread local data for the exec implementation.
493	pub const ThreadData = struct {
494	    /// The state for a single queued pty write. The write request and
495	    /// the buffer it writes from must both remain pointer-stable until
496	    /// the write completes, so they're pooled together and checked out
497	    /// per write.
498	    pub const Write = struct {
499	        /// Backpointer to the thread data so the write completion
500	        /// callback can put this back into the pool.
501	        td: *ThreadData,
502	
503	        /// The libxev write request.
504	        req: xev.WriteRequest,
505	
506	        /// The buffer for the data being written.
507	        buf: [64]u8,
508	    };
509	
510	    /// Process start time and boolean of whether its already exited.
511	    start: std.Io.Timestamp,
512	    exited: bool = false,
513	
514	    /// The data stream is the main IO for the pty.
515	    write_stream: xev.Stream,
516	
517	    /// The process watcher
518	    process: ?xev.Process,
519	
520	    /// This is the pool of available (unused) write states. If you grab
521	    /// one from the pool, you must put it back when you're done!
522	    write_pool: std.heap.MemoryPool(Write) = .empty,
523	
524	    /// The write queue for the data stream.
525	    write_queue: xev.WriteQueue = .{},
526	
527	    /// This is used for both waiting for the process to exit and then
528	    /// subsequently to wait for the data_stream to close.
529	    process_wait_c: xev.Completion = .{},
530	
531	    // The completion specific to Flatpak process waiting. If
532	    // we aren't compiling with Flatpak support this is zero-sized.
533	    flatpak_wait_c: FlatpakHostCommand.Completion = .{},
534	
535	    /// Reader thread state
536	    read_thread: std.Thread,
537	    read_thread_pipe: posix.fd_t,
538	    read_thread_fd: posix.fd_t,
539	
540	    /// The timer to detect termios state changes.
541	    termios_timer: xev.Timer,
542	    termios_timer_c: xev.Completion = .{},
543	    termios_timer_running: bool = true,
544	
545	    /// The last known termios mode. Used for change detection
546	    /// to prevent unnecessary locking of expensive mutexes.
547	    termios_mode: ptypkg.Mode = .{},
548	
549	    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
550	        _ = posix.system.close(self.read_thread_pipe);
551	
552	        // Clear our write pool. We know we aren't ever going to do
553	        // any more IO since we stop our data stream below so we can just
554	        // drop this.
555	        self.write_pool.deinit(alloc);
556	
557	        // Stop our process watcher
558	        if (self.process) |*p| p.deinit();
559	
560	        // Stop our write stream
561	        self.write_stream.deinit();
562	
563	        // Stop our termios timer
564	        self.termios_timer.deinit();
565	    }
566	};

