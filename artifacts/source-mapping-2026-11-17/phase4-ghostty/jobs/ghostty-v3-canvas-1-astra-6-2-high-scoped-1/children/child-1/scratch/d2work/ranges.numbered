1135	    /// Resize the pty subprocess. This is safe to call anytime.
1136	    pub fn resize(
1137	        self: *Subprocess,
1138	        grid_size: renderer.GridSize,
1139	        screen_size: renderer.ScreenSize,
1140	    ) !void {
1141	        self.grid_size = grid_size;
1142	        self.screen_size = screen_size;
1143	
1144	        if (self.pty) |*pty| {
1145	            // It is theoretically possible for the grid or screen size to
1146	            // exceed u16, although the terminal in that case isn't very
1147	            // usable. This should be protected upstream but we still clamp
1148	            // in case there is a bad caller which has happened before.
1149	            try pty.setSize(.{
1150	                .ws_row = std.math.cast(u16, grid_size.rows) orelse std.math.maxInt(u16),
1151	                .ws_col = std.math.cast(u16, grid_size.columns) orelse std.math.maxInt(u16),
1152	                .ws_xpixel = std.math.cast(u16, screen_size.width) orelse std.math.maxInt(u16),
1153	                .ws_ypixel = std.math.cast(u16, screen_size.height) orelse std.math.maxInt(u16),
1154	            });
1155	        }
1156	    }

