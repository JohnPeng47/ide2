324	        .clipboard_write = opts.config.clipboard_write,
325	        .clipboard_write_limit = opts.config.clipboard_write_limit,
326	        .enquiry_response = opts.config.enquiry_response,
327	        .xt_checksum_report = opts.config.xt_checksum_report,
328	    };

src/termio/Termio.zig
346	        .terminal_stream = .init(.{
347	            .allocator = alloc,
348	            .handler = handler,
349	        }),

src/termio/stream_handler.zig
19	/// This is used as the handler for the terminal.Stream type. This is
20	/// stateful and is expected to live for the entire lifetime of the terminal.
21	/// It is NOT VALID to stop a stream handler, create a new one, and use that
22	/// unless all of the member fields are copied.
23	pub const StreamHandler = struct {
24	    alloc: Allocator,
25	    size: *renderer.Size,
26	    terminal: *terminal.Terminal,
27	
28	    /// Mailbox for data to the termio thread.
29	    termio_mailbox: *termio.Mailbox,
30	
31	    /// Mailbox for the surface.
32	    surface_mailbox: apprt.surface.Mailbox,
33	
34	    /// The shared render state
35	    renderer_state: *renderer.State,
36	
37	    /// The mailbox for notifying the renderer of things.
38	    renderer_mailbox: *renderer.Thread.Mailbox,
39	
40	    /// A handle to wake up the renderer. This hints to the renderer that
41	    /// a repaint should happen.
42	    renderer_wakeup: xev.Async,
43	
44	    /// The response to use for ENQ requests. The memory is owned by
45	    /// whoever owns StreamHandler.
46	    enquiry_response: []const u8,
47	
48	    /// The color reporting format for OSC requests.
49	    osc_color_report_format: configpkg.Config.OSCColorReportFormat,
50	
51	    /// The clipboard write access configuration.
52	    clipboard_write: configpkg.ClipboardAccess,
53	
54	    /// Maximum total decoded bytes per Kitty clipboard protocol
55	    /// (OSC 5522) write transaction; exceeding it aborts with EFBIG.
56	    clipboard_write_limit: usize,
57	
58	    /// Whether DECRQCRA may report the checksum of an area of the screen,
59	    /// and XTCHECKSUM may change how it's calculated.
60	    xt_checksum_report: bool,
61	
62	    //---------------------------------------------------------------
63	    // Internal state
64	
65	    /// The APC command handler maintains the APC state. APC is like
66	    /// CSI or OSC, but it is a private escape sequence that is used
67	    /// to send commands to the terminal emulator. This is used by
68	    /// the kitty graphics protocol.
69	    apc: terminal.apc.Handler = .{},
70	
71	    /// The DCS handler maintains DCS state. DCS is like CSI or OSC,
72	    /// but requires more stateful parsing. This is used by functionality
73	    /// such as XTGETTCAP.
74	    dcs: terminal.dcs.Handler = .{},
75	
76	    /// The tmux control mode viewer state.
77	    tmux_viewer: if (tmux_enabled) ?*terminal.tmux.Viewer else void = if (tmux_enabled) null else {},
78	
79	    /// Session password grants for the Kitty clipboard protocol.
80	    /// Requests carrying a granted password skip the permission prompt.
81	    kitty_clipboard_grants: terminal.kitty.clipboard.Grants = .{},
82	
83	    /// The in-flight Kitty clipboard protocol (OSC 5522) write
84	    /// transaction, if any.
85	    kitty_clipboard_write: ?*terminal.kitty.clipboard.WriteState = null,
86	
87	    /// This is set to true when a message was written to the termio
88	    /// mailbox. This can be used by callers to determine if they need
89	    /// to wake up the termio thread.
90	    termio_messaged: bool = false,
91	
92	    /// This is set to true when we've seen a title escape sequence. We use
93	    /// this to determine if we need to default the window title.
94	    seen_title: bool = false,
95	
96	    pub const Stream = terminal.Stream(StreamHandler);
97	
98	    /// True if we have tmux control mode built in.
99	    pub const tmux_enabled = terminal.options.tmux_control_mode;
100	
101	    pub fn deinit(self: *StreamHandler) void {
102	        self.apc.deinit();
103	        self.dcs.deinit();
104	        self.kittyClipboardWriteAbort();
105	        self.kitty_clipboard_grants.deinit(self.alloc);
106	        if (comptime tmux_enabled) tmux: {
107	            const viewer = self.tmux_viewer orelse break :tmux;
108	            viewer.deinit();
109	            self.alloc.destroy(viewer);
110	            self.tmux_viewer = null;
111	        }
112	    }
113	
114	    /// This queues a render operation with the renderer thread. The render
115	    /// isn't guaranteed to happen immediately but it will happen as soon as
116	    /// practical.
117	    pub inline fn queueRender(self: *StreamHandler) !void {
118	        try self.renderer_wakeup.notify();
119	    }
120	
121	    /// Change the configuration for this handler.
122	    pub fn changeConfig(self: *StreamHandler, config: *termio.DerivedConfig) void {
123	        self.osc_color_report_format = config.osc_color_report_format;
124	        self.clipboard_write = config.clipboard_write;
125	        self.clipboard_write_limit = config.clipboard_write_limit;
126	        self.enquiry_response = config.enquiry_response;
127	        self.xt_checksum_report = config.xt_checksum_report;
128	        self.terminal.setDefaultCursorStyle(config.cursor_style);
129	        self.terminal.setDefaultCursorBlink(config.cursor_blink);
130	        self.terminal.setDefaultXtChecksum(config.xt_checksum_extension);
131	
132	        // The config could have changed any of our colors, but the mode
133	        // 2031 report is sent by Termio.changeConfig. This runs on the io
134	        // thread, which is the only reader of the termio mailbox, so
135	        // sending to it here would deadlock if the mailbox were full.
136	    }
137	
138	    inline fn surfaceMessageWriter(
139	        self: *StreamHandler,
140	        msg: apprt.surface.Message,
141	    ) void {
142	        // See messageWriter which has similar logic and explains why
143	        // we may have to do this.
144	        if (self.surface_mailbox.push(msg, .{ .instant = {} }) == 0) {
145	            self.renderer_state.mutex.unlock(global.io());
146	            defer self.renderer_state.mutex.lockUncancelable(global.io());
147	            _ = self.surface_mailbox.push(msg, .{ .forever = {} });
148	        }
149	    }
150	
151	    inline fn messageWriter(self: *StreamHandler, msg: termio.Message) void {
152	        self.termio_mailbox.send(msg, self.renderer_state.mutex);
153	        self.termio_messaged = true;
154	    }
155	
156	    /// Send a renderer message and unlock the renderer state mutex
157	    /// if necessary to ensure we don't deadlock.
158	    ///
159	    /// This assumes the renderer state mutex is locked.
160	    inline fn rendererMessageWriter(
161	        self: *StreamHandler,
162	        msg: renderer.Message,
163	    ) void {
164	        // See termio.Mailbox.send for more details on how this works.
165	
166	        // Try instant first. If it works then we can return.
167	        if (self.renderer_mailbox.push(msg, .{ .instant = {} }) > 0) {
168	            return;
169	        }
170	
171	        // Instant would have blocked. Release the renderer mutex,
172	        // wake up the renderer to allow it to process the message,
173	        // and then try again.
174	        self.renderer_state.mutex.unlock(global.io());
175	        defer self.renderer_state.mutex.lockUncancelable(global.io());
176	        self.renderer_wakeup.notify() catch |err| {
177	            // This is an EXTREMELY unlikely case. We still don't return
178	            // and attempt to send the message because its most likely
179	            // that everything is fine, but log in case a freeze happens.
180	            log.warn(
181	                "failed to notify renderer, may deadlock err={}",
182	                .{err},
183	            );
184	        };
185	        _ = self.renderer_mailbox.push(msg, .{ .forever = {} });
186	    }
187	
188	    pub fn vt(
189	        self: *StreamHandler,
190	        comptime action: Stream.Action.Tag,
191	        value: Stream.Action.Value(action),
192	    ) void {
193	        self.vtFallible(action, value) catch |err| vtFailed(action, err);
194	    }
195	
196	    /// The stream's hook for runs it knows are printable ASCII.
197	    pub fn vtPrintAscii(self: *StreamHandler, bytes: []const u8) void {
198	        self.terminal.printSliceAscii(bytes) catch |err| vtFailed(.print_slice, err);
199	    }
200	
201	    /// This is noinline to keep failure handling and logging out of the
202	    /// hot VT action path.
203	    noinline fn vtFailed(action: Stream.Action.Tag, err: anyerror) void {
204	        @branchHint(.cold);
205	        log.warn("error handling VT action action={} err={}", .{ action, err });
206	    }
207	
208	    inline fn vtFallible(
209	        self: *StreamHandler,
210	        comptime action: Stream.Action.Tag,
211	        value: Stream.Action.Value(action),
212	    ) !void {
213	        // The branch hints here are based on real world data
214	        // which indicates that the most common actions are:
215	        //
216	        // 1. print
217	        // 2. set_attributes
218	        // 3. carriage_return
219	        // 4. line_feed
220	        // 5. cursor_pos
221	        //
222	        // Together, these 5 actions make up nearly 98% of
223	        // all actions encountered in real world scenarios.
224	        //
225	        // ref: https://github.com/qwerasd205/asciinema-stats
226	        switch (action) {
227	            .print => {
228	                @branchHint(.likely);
229	                try self.terminal.print(value.cp);
230	            },
231	            .print_slice => {
232	                @branchHint(.likely);
233	                try self.terminal.printSlice(value.cps);
234	            },
235	            .print_repeat => try self.terminal.printRepeat(value),
236	            .bell => self.bell(),
237	            .backspace => self.terminal.backspace(),
238	            .horizontal_tab => self.horizontalTab(value),
239	            .horizontal_tab_back => self.horizontalTabBack(value),
240	            .linefeed => {
241	                @branchHint(.likely);
242	                try self.linefeed();
243	            },
244	            .carriage_return => {
245	                @branchHint(.likely);
246	                self.terminal.carriageReturn();
247	            },
248	            .enquiry => try self.enquiry(),
249	            .invoke_charset => self.terminal.invokeCharset(value.bank, value.charset, value.locking),
250	            .cursor_up => self.terminal.cursorUp(value.value),
251	            .cursor_down => self.terminal.cursorDown(value.value),
252	            .cursor_left => self.terminal.cursorLeft(value.value),
253	            .cursor_right => self.terminal.cursorRight(value.value),
254	            .cursor_pos => {
255	                @branchHint(.likely);
256	                self.terminal.setCursorPos(value.row, value.col);
257	            },
258	            .cursor_col => self.terminal.setCursorCol(value.value),
259	            .cursor_row => self.terminal.setCursorRow(value.value),
260	            .cursor_col_relative => self.terminal.cursorColRelative(value.value),
261	            .cursor_row_relative => self.terminal.cursorRowRelative(value.value),
262	            .cursor_style => self.terminal.setCursorStyle(value),
263	            .erase_display_below => self.terminal.eraseDisplay(.below, value),
264	            .erase_display_above => self.terminal.eraseDisplay(.above, value),
265	            .erase_display_complete => {
266	                self.terminal.scrollViewport(.{ .bottom = {} });
267	                self.terminal.eraseDisplay(.complete, value);
268	            },
269	            .erase_display_scrollback => self.terminal.eraseDisplay(.scrollback, value),
270	            .erase_display_scroll_complete => self.terminal.eraseDisplay(.scroll_complete, value),
271	            .erase_line_right => self.terminal.eraseLine(.right, value),
272	            .erase_line_left => self.terminal.eraseLine(.left, value),
273	            .erase_line_complete => self.terminal.eraseLine(.complete, value),
274	            .erase_line_right_unless_pending_wrap => self.terminal.eraseLine(.right_unless_pending_wrap, value),
275	            .delete_chars => self.terminal.deleteChars(value),
276	            .erase_chars => self.terminal.eraseChars(value),
277	            .insert_lines => self.terminal.insertLines(value),
278	            .insert_blanks => self.terminal.insertBlanks(value),
279	            .insert_columns => self.terminal.insertColumns(value),
280	            .delete_columns => self.terminal.deleteColumns(value),
281	            .delete_lines => self.terminal.deleteLines(value),
282	            .scroll_up => try self.terminal.scrollUp(value),
283	            .scroll_down => self.terminal.scrollDown(value),
284	            .tab_clear_current => self.terminal.tabClear(.current),
285	            .tab_clear_all => self.terminal.tabClear(.all),
286	            .tab_set => self.terminal.tabSet(),
287	            .tab_reset => self.terminal.tabReset(),
288	            .index => try self.index(),
289	            .next_line => try self.nextLine(),
290	            .reverse_index => try self.reverseIndex(),
291	            .back_index => self.terminal.backIndex(),
292	            .forward_index => self.terminal.forwardIndex(),
293	            .full_reset => try self.fullReset(),
294	            .soft_reset => self.terminal.softReset(),
295	            .set_mode => try self.setMode(value.mode, true),
296	            .reset_mode => try self.setMode(value.mode, false),
297	            .save_mode => self.terminal.modes.save(value.mode),
298	            .restore_mode => {
299	                // For restore mode we have to restore but if we set it, we
300	                // always have to call setMode because setting some modes have
301	                // side effects and we want to make sure we process those.
302	                const v = self.terminal.modes.restore(value.mode);
303	                try self.setMode(value.mode, v);
304	            },
305	            .request_mode => try self.requestMode(value.mode),
306	            .request_mode_unknown => try self.requestModeUnknown(value.mode, value.ansi),
307	            .top_and_bottom_margin => self.terminal.setTopAndBottomMargin(value.top_left, value.bottom_right),
308	            .left_and_right_margin => self.terminal.setLeftAndRightMargin(value.top_left, value.bottom_right),
309	            .left_and_right_margin_ambiguous => {
310	                if (self.terminal.modes.get(.enable_left_and_right_margin)) {
311	                    self.terminal.setLeftAndRightMargin(0, 0);
312	                } else {
313	                    self.terminal.saveCursor();
314	                }
315	            },
316	            .save_cursor => try self.saveCursor(),
317	            .restore_cursor => try self.restoreCursor(),
318	            .modify_key_format => try self.setModifyKeyFormat(value),
319	            .protected_mode_off => self.terminal.setProtectedMode(.off),
320	            .protected_mode_iso => self.terminal.setProtectedMode(.iso),
321	            .protected_mode_dec => self.terminal.setProtectedMode(.dec),
322	            .mouse_shift_capture => self.terminal.flags.mouse_shift_capture = if (value) .true else .false,
323	            .xt_checksum_extension => if (self.xt_checksum_report) {
324	                self.terminal.flags.xt_checksum = value.flags;
325	            },
326	            .request_xt_checksum => self.reportXtChecksum(value),
327	            .size_report => self.sendSizeReport(value),
328	            .resize_window => self.surfaceMessageWriter(.{ .resize_window = value }),
329	            .xtversion => try self.reportXtversion(),
330	            .device_attributes => try self.deviceAttributes(value),
331	            .device_status => try self.deviceStatusReport(value.request),
332	            .kitty_keyboard_query => try self.queryKittyKeyboard(),
333	            .kitty_keyboard_push => {
334	                log.debug("pushing kitty keyboard mode: {}", .{value.flags});
335	                self.terminal.screens.active.kitty_keyboard.push(value.flags);
336	            },
337	            .kitty_keyboard_pop => {
338	                log.debug("popping kitty keyboard mode n={}", .{value});
339	                self.terminal.screens.active.kitty_keyboard.pop(@intCast(value));
340	            },
341	            .kitty_keyboard_set => {
342	                log.debug("setting kitty keyboard mode: set {}", .{value.flags});
343	                self.terminal.screens.active.kitty_keyboard.set(.set, value.flags);
344	            },
345	            .kitty_keyboard_set_or => {
346	                log.debug("setting kitty keyboard mode: or {}", .{value.flags});
347	                self.terminal.screens.active.kitty_keyboard.set(.@"or", value.flags);
348	            },
349	            .kitty_keyboard_set_not => {
350	                log.debug("setting kitty keyboard mode: not {}", .{value.flags});
351	                self.terminal.screens.active.kitty_keyboard.set(.not, value.flags);
352	            },
353	            .kitty_color_report => try self.kittyColorReport(value),
354	            .color_operation => try self.colorOperation(value.op, &value.requests, value.terminator),
355	            .end_hyperlink => try self.endHyperlink(),
356	            .active_status_display => self.terminal.status_display = value,
357	            .decaln => try self.decaln(),
358	            .window_title => try self.windowTitle(value.title),
359	            .report_pwd => try self.reportPwd(value.url),
360	            .show_desktop_notification => try self.showDesktopNotification(value.title, value.body),
361	            .progress_report => self.progressReport(value),
362	            .start_hyperlink => try self.startHyperlink(value.uri, value.id),
363	            .clipboard_contents => try self.clipboardContents(value.kind, value.data),
364	            .semantic_prompt => try self.semanticPrompt(value),
365	            .mouse_shape => try self.setMouseShape(value),
366	            .mouse_shape_reset => try self.setMouseShape(
367	                if (self.terminal.flags.mouse_event != .none) .default else .text,
368	            ),
369	            .configure_charset => self.configureCharset(value.slot, value.charset),
370	            .set_attributes => {
371	                @branchHint(.likely);
372	                self.terminal.setAttributes(value.parser()) catch |err| {
373	                    @branchHint(.cold);
374	                    log.warn("error setting attributes: {}", .{err});
375	                };
376	            },
377	            .dcs_hook => try self.dcsHook(value),
378	            .dcs_put => try self.dcsPut(value),
379	            .dcs_unhook => try self.dcsUnhook(),
380	            .apc_start => self.apc.start(),
381	            .apc_end => try self.apcEnd(),
382	            .apc_put => self.apc.feed(self.alloc, value),
383	            .apc_put_slice => self.apc.feedSlice(self.alloc, value.bytes),
384	            .kitty_clipboard => try self.kittyClipboard(value),
385	
386	            // Unimplemented
387	            .title_push,
388	            .title_pop,
389	            .kitty_dnd,
390	            .osc_unknown,
391	            .program_status,
392	            => {},
393	        }
394	    }
395	
396	    pub inline fn dcsHook(self: *StreamHandler, dcs: terminal.DCS) !void {
397	        var cmd = self.dcs.hook(self.alloc, dcs) orelse return;
398	        defer cmd.deinit();
399	        try self.dcsCommand(&cmd);
400	    }
401	
402	    pub inline fn dcsPut(self: *StreamHandler, byte: u8) !void {
403	        var cmd = self.dcs.put(byte) orelse return;
404	        defer cmd.deinit();
405	        try self.dcsCommand(&cmd);
406	    }
407	
408	    pub inline fn dcsUnhook(self: *StreamHandler) !void {
409	        var cmd = self.dcs.unhook() orelse return;
410	        defer cmd.deinit();
411	        try self.dcsCommand(&cmd);
412	    }
413	
414	    fn dcsCommand(self: *StreamHandler, cmd: *terminal.dcs.Command) !void {
415	        // log.warn("DCS command: {}", .{cmd});
416	        switch (cmd.*) {
417	            .tmux => |tmux| tmux: {
418	                // If tmux control mode is disabled at the build level,
419	                // then this whole block shouldn't be analyzed.
420	                if (comptime !tmux_enabled) break :tmux;
421	                log.info("tmux control mode event cmd={f}", .{tmux});
422	
423	                switch (tmux) {
424	                    .enter => {
425	                        // Setup our viewer state
426	                        assert(self.tmux_viewer == null);
427	                        const viewer = try self.alloc.create(terminal.tmux.Viewer);
428	                        errdefer self.alloc.destroy(viewer);
429	                        viewer.* = try .init(global.io(), self.alloc);
430	                        errdefer viewer.deinit();
431	                        self.tmux_viewer = viewer;
432	                        break :tmux;
433	                    },
434	
435	                    .exit => {
436	                        // Free our viewer state if we have one
437	                        if (self.tmux_viewer) |viewer| {
438	                            viewer.deinit();
439	                            self.alloc.destroy(viewer);
440	                            self.tmux_viewer = null;
441	                        }
442	
443	                        // And always break since we assert below
444	                        // that we're not handling an exit command.
445	                        break :tmux;
446	                    },
447	
448	                    else => {},
449	                }
450	
451	                assert(tmux != .enter);
452	                assert(tmux != .exit);
453	
454	                const viewer = self.tmux_viewer orelse {
455	                    // This can only really happen if we failed to
456	                    // initialize the viewer on enter.
457	                    log.info(
458	                        "received tmux control mode command without viewer: {f}",
459	                        .{tmux},
460	                    );
461	
462	                    break :tmux;
463	                };
464	
465	                for (viewer.next(.{ .tmux = tmux })) |action| {
466	                    log.info("tmux viewer action={f}", .{action});
467	                    switch (action) {
468	                        .exit => {
469	                            // We ignore this because we will fully exit when
470	                            // our DCS connection ends. We may want to handle
471	                            // this in the future to notify our GUI we're
472	                            // disconnected though.
473	                        },
474	
475	                        .command => |command| {
476	                            assert(command.len > 0);
477	                            assert(command[command.len - 1] == '\n');
478	                            self.messageWriter(try termio.Message.writeReq(
479	                                self.alloc,
480	                                command,
481	                            ));
482	                        },
483	
484	                        .windows => {
485	                            // TODO
486	                        },
487	
488	                        .active_window => {
489	                            // TODO: notify the GUI that tmux's current
490	                            // window changed.
491	                        },
492	                    }
493	                }
494	            },
495	
496	            .xtgettcap => |*gettcap| {
497	                const map = comptime terminfo.ghostty.xtgettcapMap();
498	                while (gettcap.next()) |key| {
499	                    const response = map.get(key) orelse continue;
500	                    self.messageWriter(.{ .write_stable = response });
501	                }
502	            },
503	
504	            .decrqss => |decrqss| {
505	                var response: [terminal.dcs.Command.DECRQSS.max_response_bytes]u8 = undefined;
506	                const encoded = try decrqss.encode(self.terminal, &response);
507	                const msg = try termio.Message.writeReq(
508	                    self.alloc,
509	                    encoded,
510	                );
511	                self.messageWriter(msg);
512	            },
513	        }
514	    }
515	
516	    pub fn apcEnd(self: *StreamHandler) !void {
517	        var result = self.apc.end() orelse return;
518	        defer result.deinit(self.alloc);
519	
520	        // log.warn("APC command: {}", .{result});
521	        switch (result) {
522	            .unknown => return,
523	            .kitty => |*kitty_cmd| {
524	                if (self.terminal.kittyGraphics(global.io(), self.alloc, kitty_cmd)) |resp| {
525	                    var buf: [1024]u8 = undefined;
526	                    var writer: std.Io.Writer = .fixed(&buf);
527	                    try resp.encode(&writer);
528	                    const final = writer.buffered();
529	                    if (final.len > 2) {
530	                        log.debug("kitty graphics response: {x}", .{final});
531	                        self.messageWriter(try termio.Message.writeReq(self.alloc, final));
532	                    }
533	                }
534	            },
535	
536	            .glyph => |*glyph_req| {
537	                const resp = self.terminal.glyphProtocol(self.alloc, glyph_req);
538	                switch (glyph_req.*) {
539	                    .register, .clear => try self.queueRender(),
540	                    .support, .query => {},
541	                }
542	
543	                if (resp) |r| {
544	                    var buf: [terminal.apc.glyph.Response.max_wire_bytes]u8 = undefined;
545	                    var writer: std.Io.Writer = .fixed(&buf);
546	                    try r.formatWire(&writer);
547	                    const final = writer.buffered();
548	                    log.debug("glyph protocol response: {x}", .{final});
549	                    self.messageWriter(try termio.Message.writeReq(self.alloc, final));
550	                }
551	            },
552	        }
553	    }
554	
555	    inline fn bell(self: *StreamHandler) void {
556	        self.surfaceMessageWriter(.ring_bell);
557	    }
