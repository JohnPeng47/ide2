n10 src/terminal/Screen.zig
  936 pub fn cursorReload(self: *Screen) void {
  937     defer self.assertIntegrity();
  938 
  939     // Our tracked pin is ALWAYS accurate, so we derive the active
  940     // point from the pin. If this returns null it means our pin
  941     // points outside the active area. In that case, we update the
  942     // pin to be the top-left.
  943     const pt: point.Point = self.pages.pointFromPin(
  944         .active,
  945         self.cursor.page_pin.*,
  946     ) orelse reset: {
  947         // Our cached row/cell pointers may be invalid (that is often
  948         // the reason cursorReload is being called), so refresh them
  949         // from the pin first since cursorChangePin below marks the
  950         // old cursor row as dirty.
  951         const old_rac = self.cursor.page_pin.rowAndCell();
  952         self.cursor.page_row = old_rac.row;
  953         self.cursor.page_cell = old_rac.cell;
  954 
  955         // The cursor style and hyperlink IDs are only valid within the
  956         // page that the pin points at, so the pin change must go through
  957         // cursorChangePin, which migrates them when the active top-left
  958         // is on a different page. Writing the pin directly here would
  959         // leave the cursor holding IDs that are dead or alias unrelated
  960         // entries on the new page.
  961         const pin = self.pages.pin(.{ .active = .{} }).?;
  962         self.cursor.x = 0; // Must be set before cursorChangePin
  963         self.cursor.y = 0;
  964         self.cursorChangePin(pin);
  965 
  966         // cursorChangePin can trigger a page capacity adjustment which
  967         // moves the pin again, so we re-read it to derive our point.
  968         break :reset self.pages.pointFromPin(
  969             .active,
  970             self.cursor.page_pin.*,
  971         ).?;
  972     };
  973 
  974     self.cursor.x = @intCast(pt.active.x);
  975     self.cursor.y = @intCast(pt.active.y);
  976     const page_rac = self.cursor.page_pin.rowAndCell();
  977     self.cursor.page_row = page_rac.row;
  978     self.cursor.page_cell = page_rac.cell;
  979 }
n10 src/terminal/Terminal.zig
 2700 /// The primary and alternate screen have distinct save state. One saved state
 2701 /// is kept per screen (main / alternative). If for the current screen state
 2702 /// was already saved it is overwritten.
 2703 pub fn saveCursor(self: *Terminal) void {
 2704     self.screens.active.saved_cursor = .{
 2705         .x = self.screens.active.cursor.x,
 2706         .y = self.screens.active.cursor.y,
 2707         .style = self.screens.active.cursor.style,
 2708         .protected = self.screens.active.cursor.protected,
 2709         .pending_wrap = self.screens.active.cursor.pending_wrap,
 2710         .origin = self.modes.get(.origin),
 2711         .charset = self.screens.active.charset,
 2712     };
 2713 }
n10 src/terminal/Terminal.zig
 2719 pub fn restoreCursor(self: *Terminal) void {
 2720     const saved: Screen.SavedCursor = self.screens.active.saved_cursor orelse .{
 2721         .x = 0,
 2722         .y = 0,
 2723         .style = .{},
 2724         .protected = false,
 2725         .pending_wrap = false,
 2726         .origin = false,
 2727         .charset = .{},
 2728     };
 2729 
 2730     // Set the style first because it can fail
 2731     self.screens.active.cursor.style = saved.style;
 2732     self.screens.active.manualStyleUpdate() catch |err| {
 2733         // Regardless of the error here, we revert back to an unstyled
 2734         // cursor. It is more important that the restore succeeds in
 2735         // other attributes because terminals have no way to communicate
 2736         // failure back.
 2737         log.warn("restoreCursor error updating style err={}", .{err});
 2738         const screen: *Screen = self.screens.active;
 2739         screen.cursor.style = .{};
 2740         self.screens.active.manualStyleUpdate() catch unreachable;
 2741     };
 2742 
 2743     self.screens.active.charset = saved.charset;
 2744     self.modes.set(.origin, saved.origin);
 2745     self.screens.active.cursor.pending_wrap = saved.pending_wrap;
 2746     self.screens.active.cursor.protected = saved.protected;
 2747     self.screens.active.cursorAbsolute(
 2748         @min(saved.x, self.cols - 1),
 2749         @min(saved.y, self.rows - 1),
 2750     );
 2751 
 2752     // Ensure our screen is consistent
 2753     self.screens.active.assertIntegrity();
 2754 }
