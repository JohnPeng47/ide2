   39 /// Allocate page-aligned, zeroed backing memory using mmap with
   40 /// MAP_PRIVATE | MAP_ANONYMOUS which guarantees zeroed pages.
   41 const AllocPosix = struct {
   42     pub fn alloc(n: usize) ![]align(std.heap.page_size_min) u8 {
   43         return try posix.mmap(
   44             null,
   45             n,
   46             .{ .READ = true, .WRITE = true },
   47             .{ .TYPE = .PRIVATE, .ANONYMOUS = true },
   48             -1,
   49             0,
   50         );
   51     }
   52 
   53     pub fn free(mem: []align(std.heap.page_size_min) u8) void {
   54         posix.munmap(mem);
   55     }
