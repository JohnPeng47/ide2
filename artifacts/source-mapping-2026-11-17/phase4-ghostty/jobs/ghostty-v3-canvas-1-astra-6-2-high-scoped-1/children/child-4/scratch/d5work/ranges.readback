n9 src/terminal/Selection.zig
   32 /// The bounds of the selection. A selection bounds can be either tracked
   33 /// or untracked. Untracked bounds are unsafe beyond the point the terminal
   34 /// screen may be modified, since they may point to invalid memory. Tracked
   35 /// bounds are always valid and will be updated as the screen changes, but
   36 /// are more expensive to exist.
   37 ///
   38 /// In all cases, start and end can be in any order. There is no guarantee that
   39 /// start is before end or vice versa. If a user selects backwards,
   40 /// start will be after end, and vice versa. Use the struct functions
   41 /// to not have to worry about this.
   42 pub const Bounds = union(enum) {
   43     untracked: struct {
   44         start: Pin,
   45         end: Pin,
   46     },
   47 
   48     tracked: struct {
   49         start: *Pin,
   50         end: *Pin,
   51     },
   52 };
n9 src/terminal/Selection.zig
   70 pub fn deinit(
   71     self: Selection,
   72     s: *Screen,
   73 ) void {
   74     switch (self.bounds) {
   75         .tracked => |v| {
   76             s.pages.untrackPin(v.start);
   77             s.pages.untrackPin(v.end);
   78         },
   79 
   80         .untracked => {},
   81     }
   82 }
n9 src/terminal/Selection.zig
  129 /// Convert this selection a tracked selection. It is asserted this is
  130 /// an untracked selection. The tracked selection is returned.
  131 pub fn track(self: *const Selection, s: *Screen) Allocator.Error!Selection {
  132     assert(!self.tracked());
  133 
  134     // Track our pins
  135     const start_pin = self.bounds.untracked.start;
  136     const end_pin = self.bounds.untracked.end;
  137     const tracked_start = try s.pages.trackPin(start_pin);
  138     errdefer s.pages.untrackPin(tracked_start);
  139     const tracked_end = try s.pages.trackPin(end_pin);
  140     errdefer s.pages.untrackPin(tracked_end);
  141 
  142     return .{
  143         .bounds = .{ .tracked = .{
  144             .start = tracked_start,
  145             .end = tracked_end,
  146         } },
  147         .rectangle = self.rectangle,
  148     };
  149 }
n9 src/datastruct/intrusive_linked_list.zig
    4 /// An intrusive doubly-linked list. The type T must have a "next" and "prev"
    5 /// field pointing to itself.
    6 ///
    7 /// This is an adaptation of the DoublyLinkedList from the Zig standard
    8 /// library, which is MIT licensed. I've removed functionality that I don't
    9 /// need.
   10 pub fn DoublyLinkedList(comptime T: type) type {
   11     return struct {
   12         const Self = @This();
   13 
   14         /// The type of the node in the list. This makes it easy to get the
   15         /// node type from the list type.
   16         pub const Node = T;
   17 
   18         first: ?*Node = null,
   19         last: ?*Node = null,
   20 
   21         /// Insert a new node after an existing one.
   22         ///
   23         /// Arguments:
   24         ///     node: Pointer to a node in the list.
   25         ///     new_node: Pointer to the new node to insert.
   26         pub inline fn insertAfter(list: *Self, node: *Node, new_node: *Node) void {
   27             new_node.prev = node;
   28             if (node.next) |next_node| {
   29                 // Intermediate node.
   30                 new_node.next = next_node;
   31                 next_node.prev = new_node;
   32             } else {
   33                 // Last element of the list.
   34                 new_node.next = null;
   35                 list.last = new_node;
   36             }
   37             node.next = new_node;
   38         }
n9 src/datastruct/intrusive_linked_list.zig
   63         pub inline fn append(list: *Self, new_node: *Node) void {
   64             if (list.last) |last| {
   65                 // Insert after last.
   66                 list.insertAfter(last, new_node);
   67             } else {
   68                 // Empty list.
   69                 list.prepend(new_node);
   70             }
   71         }
   72 
   73         /// Insert a new node at the beginning of the list.
   74         ///
   75         /// Arguments:
   76         ///     new_node: Pointer to the new node to insert.
   77         pub inline fn prepend(list: *Self, new_node: *Node) void {
   78             if (list.first) |first| {
   79                 // Insert before first.
   80                 list.insertBefore(first, new_node);
   81             } else {
   82                 // Empty list.
   83                 list.first = new_node;
   84                 list.last = new_node;
   85                 new_node.prev = null;
   86                 new_node.next = null;
   87             }
   88         }
