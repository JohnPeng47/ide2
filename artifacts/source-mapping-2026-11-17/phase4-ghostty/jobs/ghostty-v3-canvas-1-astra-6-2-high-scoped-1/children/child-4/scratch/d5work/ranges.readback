 5620         self.title.clearRetainingCapacity();
 5621         return;
 5622     }
 5623 
 5624     const capacity = std.math.add(usize, t.len, 1) catch
 5625         return error.OutOfMemory;
 5626     try self.title.ensureTotalCapacity(self.gpa(), capacity);
 5627 
 5628     self.title.items.len = capacity;
 5629     std.mem.copyForwards(u8, self.title.items[0..t.len], t);
 5630     self.title.items[t.len] = 0;
 5631 }
