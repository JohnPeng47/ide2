 1107     /// Get the cells for a row.
 1108     pub inline fn getCells(self: *const Page, row: *Row) []Cell {
 1109         if (build_options.slow_runtime_safety) {
 1110             const rows = self.rows.ptr(self.memory);
 1111             const cells = self.cells.ptr(self.memory);
 1112             assert(@intFromPtr(row) >= @intFromPtr(rows));
 1113             assert(@intFromPtr(row) < @intFromPtr(cells));
 1114         }
 1115 
 1116         const cells = row.cells.ptr(self.memory);
 1117         return cells[0..self.size.cols];
