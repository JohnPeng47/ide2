   23     /// Return the PageList that owns this tracked ref's pin, or null if the
   24     /// owning screen has been removed/reinitialized since the ref was created.
   25     fn pageList(ref: *const TrackedGridRef) ?*PageList {
   26         const wrapper = ref.terminal orelse return null;
   27         const t = wrapper.terminal;
   28         if (t.screens.generation(ref.screen_key) != ref.screen_generation) return null;
   29         const screen = t.screens.get(ref.screen_key) orelse return null;
   30         return &screen.pages;
   31     }
