  151     /// encouraged to set their own default.
  152     cursor_style: CursorStyle = .block,
  153 
  154     /// The "last column flag (LCF)" as its called. If this is set then the
  155     /// next character print will force a soft-wrap.
  156     pending_wrap: bool = false,
  157 
  158     /// The protected mode state of the cursor. If this is true then
  159     /// all new characters printed will have the protected state set.
  160     protected: bool = false,
  161 
  162     /// The currently active style. This is the concrete style value
  163     /// that should be kept up to date. The style ID to use for cell writing
  164     /// is below.
  165     style: style.Style = .{},
  166 
  167     /// The currently active style ID. The style is page-specific so when
