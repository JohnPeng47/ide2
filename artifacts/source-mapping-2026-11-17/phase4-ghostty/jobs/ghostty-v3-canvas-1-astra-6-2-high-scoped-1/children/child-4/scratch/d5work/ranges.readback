 5570 pub fn setPwd(self: *Terminal, pwd: []const u8) !void {
 5571     if (pwd.len == 0) {
 5572         self.pwd.clearRetainingCapacity();
 5573         return;
 5574     }
 5575 
 5576     const capacity = std.math.add(usize, pwd.len, 1) catch
 5577         return error.OutOfMemory;
 5578     try self.pwd.ensureTotalCapacity(self.gpa(), capacity);
 5579 
 5580     self.pwd.items.len = capacity;
 5581     std.mem.copyForwards(u8, self.pwd.items[0..pwd.len], pwd);
 5582     self.pwd.items[pwd.len] = 0;
 5583 }
