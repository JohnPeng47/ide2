 7800 pub const Pin = struct {
 7801     node: *List.Node,
 7802     y: size.CellCountInt = 0,
 7803     x: size.CellCountInt = 0,
 7804 
 7805     /// This is flipped to true for tracked pins that were tracking
 7806     /// a page that got pruned for any reason and where the tracked pin
 7807     /// couldn't be moved to a sensical location. Users of the tracked
 7808     /// pin could use this data and make their own determination of
 7809     /// semantics.
 7810     garbage: bool = false,
 7811 
 7812     pub inline fn rowAndCell(self: Pin) struct {
 7813         row: *pagepkg.Row,
 7814         cell: *pagepkg.Cell,
 7815     } {
 7816         const rac = self.node.page().getRowAndCell(self.x, self.y);
 7817         return .{ .row = rac.row, .cell = rac.cell };
 7818     }
n10 src/terminal/page.zig
 1120     /// Get the row and cell for the given X/Y within this page.
 1121     pub inline fn getRowAndCell(self: *const Page, x: usize, y: usize) struct {
 1122         row: *Row,
 1123         cell: *Cell,
 1124     } {
 1125         assert(y < self.size.rows);
 1126         assert(x < self.size.cols);
 1127 
 1128         const rows = self.rows.ptr(self.memory);
 1129         const row = &rows[y];
 1130         const cell = &row.cells.ptr(self.memory)[x];
 1131 
 1132         return .{ .row = row, .cell = cell };
 1133     }
