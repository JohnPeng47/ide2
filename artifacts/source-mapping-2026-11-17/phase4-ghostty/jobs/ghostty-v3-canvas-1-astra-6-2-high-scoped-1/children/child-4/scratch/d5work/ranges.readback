n12 src/terminal/Screen.zig
   58 /// The selection for this screen (if any). This MUST be a tracked selection
   59 /// otherwise the selection will become invalid. Instead of accessing this
   60 /// directly to set it, use the `select` function which will assert and
   61 /// automatically setup tracking.
   62 selection: ?Selection = null,
n12 src/terminal/Screen.zig
 3063 pub fn select(self: *Screen, sel_: ?Selection) Allocator.Error!void {
 3064     const sel = sel_ orelse {
 3065         self.clearSelection();
 3066         return;
 3067     };
 3068 
 3069     // If this selection is untracked then we track it.
 3070     const tracked_sel = if (sel.tracked()) sel else try sel.track(self);
 3071     errdefer if (!sel.tracked()) tracked_sel.deinit(self);
 3072 
 3073     // Untrack prior selection pins that aren't also owned by the replacement.
 3074     // A caller may pass our current tracked selection back to us by value, so
 3075     // releasing both old pins unconditionally would leave the replacement
 3076     // pointing at freed pool entries.
 3077     if (self.selection) |old| {
 3078         const new_bounds = tracked_sel.bounds.tracked;
 3079         switch (old.bounds) {
 3080             .untracked => old.deinit(self),
 3081             .tracked => |old_bounds| {
 3082                 if (old_bounds.start != new_bounds.start and
 3083                     old_bounds.start != new_bounds.end)
 3084                 {
 3085                     self.pages.untrackPin(old_bounds.start);
 3086                 }
 3087                 if (old_bounds.end != new_bounds.start and
 3088                     old_bounds.end != new_bounds.end)
 3089                 {
 3090                     self.pages.untrackPin(old_bounds.end);
 3091                 }
 3092             },
 3093         }
 3094     }
 3095     self.selection = tracked_sel;
 3096     self.dirty.selection = true;
 3097 }
 3098 
 3099 /// Same as select(null) but can't fail.
 3100 pub fn clearSelection(self: *Screen) void {
 3101     if (self.selection) |*sel| {
 3102         sel.deinit(self);
 3103         self.dirty.selection = true;
 3104     }
 3105     self.selection = null;
 3106 }
n12 src/terminal/Selection.zig
   24 /// The bounds of the selection.
   25 bounds: Bounds,
n12 src/terminal/Selection.zig
   32 /// The bounds of the selection. A selection bounds can be either tracked
   33 /// or untracked. Untracked bounds are unsafe beyond the point the terminal
   34 /// screen may be modified, since they may point to invalid memory. Tracked
   35 /// bounds are always valid and will be updated as the screen changes, but
   36 /// are more expensive to exist.
   37 ///
   38 /// In all cases, start and end can be in any order. There is no guarantee that
   39 /// start is before end or vice versa. If a user selects backwards,
   40 /// start will be after end, and vice versa. Use the struct functions
   41 /// to not have to worry about this.
   42 pub const Bounds = union(enum) {
   43     untracked: struct {
   44         start: Pin,
   45         end: Pin,
   46     },
   47 
   48     tracked: struct {
   49         start: *Pin,
   50         end: *Pin,
   51     },
   52 };
n12 src/terminal/Selection.zig
   70 pub fn deinit(
   71     self: Selection,
   72     s: *Screen,
   73 ) void {
   74     switch (self.bounds) {
   75         .tracked => |v| {
   76             s.pages.untrackPin(v.start);
   77             s.pages.untrackPin(v.end);
   78         },
   79 
   80         .untracked => {},
   81     }
   82 }
n12 src/terminal/Selection.zig
  129 /// Convert this selection a tracked selection. It is asserted this is
  130 /// an untracked selection. The tracked selection is returned.
  131 pub fn track(self: *const Selection, s: *Screen) Allocator.Error!Selection {
  132     assert(!self.tracked());
  133 
  134     // Track our pins
  135     const start_pin = self.bounds.untracked.start;
  136     const end_pin = self.bounds.untracked.end;
  137     const tracked_start = try s.pages.trackPin(start_pin);
  138     errdefer s.pages.untrackPin(tracked_start);
  139     const tracked_end = try s.pages.trackPin(end_pin);
  140     errdefer s.pages.untrackPin(tracked_end);
  141 
  142     return .{
  143         .bounds = .{ .tracked = .{
  144             .start = tracked_start,
  145             .end = tracked_end,
  146         } },
  147         .rectangle = self.rectangle,
  148     };
  149 }
n12 src/terminal/PageList.zig
  354 /// List of pins, known as "tracked" pins. These are pins that are kept
  355 /// up to date automatically through page-modifying operations.
  356 const PinSet = std.AutoArrayHashMapUnmanaged(*Pin, void);
  357 const PinPool = std.heap.MemoryPool(Pin);
n12 src/terminal/PageList.zig
  472 /// The list of tracked pins. These are kept up to date automatically.
  473 tracked_pins: PinSet,
n12 src/terminal/PageList.zig
 6309 /// Convert the given pin to a tracked pin. A tracked pin will always be
 6310 /// automatically updated as the pagelist is modified. If the point the
 6311 /// pin points to is removed completely, the tracked pin will be updated
 6312 /// to the top-left of the screen.
 6313 pub fn trackPin(self: *PageList, p: Pin) Allocator.Error!*Pin {
 6314     if (build_options.slow_runtime_safety) assert(self.pinIsValid(p));
 6315 
 6316     // Create our tracked pin
 6317     const tracked = try self.pool.pins.create(self.pool.alloc);
 6318     errdefer self.pool.pins.destroy(tracked);
 6319     tracked.* = p;
 6320 
 6321     // Add it to the tracked list
 6322     try self.tracked_pins.putNoClobber(self.pool.alloc, tracked, {});
 6323     errdefer _ = self.tracked_pins.remove(tracked);
 6324 
 6325     return tracked;
 6326 }
 6327 
 6328 /// Untrack a previously tracked pin. This will deallocate the pin.
 6329 pub fn untrackPin(self: *PageList, p: *Pin) void {
 6330     assert(p != self.viewport_pin);
 6331     if (self.tracked_pins.swapRemove(p)) {
 6332         self.pool.pins.destroy(p);
 6333     }
 6334 }
