n15 src/terminal/PageList.zig
 5800     // In order to move the following rows up we rotate the rows array by 1.
 5801     // The rotate operation turns e.g. [ 0 1 2 3 ] in to [ 1 2 3 0 ], which
 5802     // works perfectly to move all of our elements where they belong.
 5803     // Rotating rows changes which logical row cached coordinates identify.
 5804     self.invalidateNodeLayout(node);
 5805     fastmem.rotateOnce(Row, rows[pn.y..node.rows()]);
 5806 
 5807     // We adjust the tracked pins in this page, moving up any that were below
 5808     // the removed row.
 5809     {
 5810         const pin_keys = self.tracked_pins.keys();
 5811         for (pin_keys) |p| {
 5812             if (p.node == node and p.y > pn.y) p.y -= 1;
 5813         }
 5814     }
 5815 
 5816     // If we have a pinned viewport, we need to adjust for active area.
 5817     self.fixupViewport(1);
n15 src/terminal/PageList.zig
 5863         // Rotating this page moves every cached row coordinate up by one.
 5864         self.invalidateNodeLayout(node);
 5865         fastmem.rotateOnce(Row, rows[0..node.rows()]);
 5866 
 5867         // Mark the whole page as dirty.
 5868         page.dirty = true;
 5869 
 5870         // Our tracked pins for this page need to be updated.
 5871         // If the pin is in row 0 that means the corresponding row has
 5872         // been moved to the previous page. Otherwise, move it up by 1.
 5873         const pin_keys = self.tracked_pins.keys();
 5874         for (pin_keys) |p| {
 5875             if (p.node != node) continue;
 5876             if (p.y == 0) {
 5877                 p.node = node.prev.?;
 5878                 p.y = p.node.rows() - 1;
 5879                 continue;
 5880             }
 5881             p.y -= 1;
 5882         }
 5883     }
