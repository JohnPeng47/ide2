  143 /// The cursor position and style.
  144 pub const Cursor = struct {
  145     // The x/y position within the active area.
  146     x: size.CellCountInt = 0,
  147     y: size.CellCountInt = 0,
  148 
  149     /// The visual style of the cursor. This defaults to block because
