 1603     pub inline fn setGraphemes(
 1604         self: *Page,
 1605         row: *Row,
 1606         cell: *Cell,
 1607         cps: []const u21,
 1608     ) GraphemeError!void {
 1609         defer self.assertIntegrity();
 1610 
 1611         assert(cell.codepoint() > 0);
 1612         assert(cell.content_tag == .codepoint);
 1613 
 1614         const cell_offset = getOffset(Cell, self.memory, cell);
 1615         var map = self.grapheme_map.map(self.memory);
 1616         const stored_cps = cps[0..@min(cps.len, grapheme_max_len)];
 1617 
 1618         const slice = self.grapheme_alloc.alloc(u21, self.memory, stored_cps.len) catch |e| {
 1619             comptime assert(@TypeOf(e) == error{OutOfMemory});
 1620             // The grapheme alloc capacity needs to be increased.
 1621             return error.GraphemeAllocOutOfMemory;
 1622         };
 1623         errdefer self.grapheme_alloc.free(self.memory, slice);
 1624         @memcpy(slice, stored_cps);
 1625 
 1626         map.putNoClobber(cell_offset, .{
 1627             .offset = getOffset(u21, self.memory, @ptrCast(slice.ptr)),
 1628             .len = slice.len,
 1629         }) catch |e| {
 1630             comptime assert(@TypeOf(e) == error{OutOfMemory});
 1631             // The grapheme map capacity needs to be increased.
 1632             return error.GraphemeMapOutOfMemory;
 1633         };
 1634         errdefer map.remove(cell_offset);
 1635 
 1636         cell.content_tag = .codepoint_grapheme;
 1637         row.grapheme = true;
 1638 
 1639         return;
 1640     }
