   34 const PageAlloc = switch (builtin.target.os.tag) {
   35     .windows => AllocWindows,
   36     else => AllocPosix,
   37 };
   38 
   39 /// Allocate page-aligned, zeroed backing memory using mmap with
   40 /// MAP_PRIVATE | MAP_ANONYMOUS which guarantees zeroed pages.
   41 const AllocPosix = struct {
   42     pub fn alloc(n: usize) ![]align(std.heap.page_size_min) u8 {
   43         return try posix.mmap(
   44             null,
   45             n,
   46             .{ .READ = true, .WRITE = true },
   47             .{ .TYPE = .PRIVATE, .ANONYMOUS = true },
   48             -1,
   49             0,
   50         );
   51     }
   52 
   53     pub fn free(mem: []align(std.heap.page_size_min) u8) void {
   54         posix.munmap(mem);
   55     }
   56 };
n9 src/terminal/page.zig
   58 /// Allocate page-aligned, zeroed backing memory using VirtualAlloc with
   59 /// MEM_COMMIT | MEM_RESERVE which guarantees zeroed pages.
   60 const AllocWindows = struct {
   61     pub fn alloc(n: usize) error{OutOfMemory}![]align(std.heap.page_size_min) u8 {
   62         const addr = windows.exp.kernel32.VirtualAlloc(
   63             null,
   64             n,
   65             windows.MEM_COMMIT | windows.MEM_RESERVE,
   66             windows.PAGE_READWRITE,
   67         ) orelse return error.OutOfMemory;
   68 
   69         return @as(
   70             [*]align(std.heap.page_size_min) u8,
   71             @ptrCast(@alignCast(addr)),
   72         )[0..n];
   73     }
   74 
   75     pub fn free(mem: []align(std.heap.page_size_min) u8) void {
   76         _ = windows.exp.kernel32.VirtualFree(
   77             @ptrCast(@alignCast(mem.ptr)),
   78             0,
   79             windows.MEM_RELEASE,
   80         );
   81     }
   82 };
