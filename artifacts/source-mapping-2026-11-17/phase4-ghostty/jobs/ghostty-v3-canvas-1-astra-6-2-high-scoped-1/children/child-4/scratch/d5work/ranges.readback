 2077     /// unique hyperlinks on many cells or many hyperlinks on a few.
 2078     hyperlink_cells: size.HyperlinkCountInt = hyperlink_cells_default,
 2079 
 2080     /// Number of bytes to allocate for grapheme data.
 2081     grapheme_bytes: size.GraphemeBytesInt = grapheme_bytes_default,
 2082 
 2083     /// Number of bytes to allocate for strings.
 2084     string_bytes: size.StringBytesInt = string_bytes_default,
