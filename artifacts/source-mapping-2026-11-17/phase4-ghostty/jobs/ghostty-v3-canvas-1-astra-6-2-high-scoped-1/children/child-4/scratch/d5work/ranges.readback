 2700 /// The primary and alternate screen have distinct save state. One saved state
 2701 /// is kept per screen (main / alternative). If for the current screen state
 2702 /// was already saved it is overwritten.
 2703 pub fn saveCursor(self: *Terminal) void {
 2704     self.screens.active.saved_cursor = .{
 2705         .x = self.screens.active.cursor.x,
 2706         .y = self.screens.active.cursor.y,
 2707         .style = self.screens.active.cursor.style,
 2708         .protected = self.screens.active.cursor.protected,
 2709         .pending_wrap = self.screens.active.cursor.pending_wrap,
 2710         .origin = self.modes.get(.origin),
 2711         .charset = self.screens.active.charset,
 2712     };
 2713 }
n1 src/terminal/Terminal.zig
 2719 pub fn restoreCursor(self: *Terminal) void {
 2720     const saved: Screen.SavedCursor = self.screens.active.saved_cursor orelse .{
 2721         .x = 0,
 2722         .y = 0,
 2723         .style = .{},
 2724         .protected = false,
 2725         .pending_wrap = false,
 2726         .origin = false,
 2727         .charset = .{},
 2728     };
 2729 
 2730     // Set the style first because it can fail
 2731     self.screens.active.cursor.style = saved.style;
 2732     self.screens.active.manualStyleUpdate() catch |err| {
 2733         // Regardless of the error here, we revert back to an unstyled
 2734         // cursor. It is more important that the restore succeeds in
 2735         // other attributes because terminals have no way to communicate
 2736         // failure back.
 2737         log.warn("restoreCursor error updating style err={}", .{err});
 2738         const screen: *Screen = self.screens.active;
 2739         screen.cursor.style = .{};
 2740         self.screens.active.manualStyleUpdate() catch unreachable;
 2741     };
 2742 
 2743     self.screens.active.charset = saved.charset;
 2744     self.modes.set(.origin, saved.origin);
 2745     self.screens.active.cursor.pending_wrap = saved.pending_wrap;
 2746     self.screens.active.cursor.protected = saved.protected;
 2747     self.screens.active.cursorAbsolute(
 2748         @min(saved.x, self.cols - 1),
 2749         @min(saved.y, self.rows - 1),
 2750     );
 2751 
 2752     // Ensure our screen is consistent
 2753     self.screens.active.assertIntegrity();
 2754 }
