  100 pub const SemanticPrompt = struct {
  101     /// Whether this screen has ever had semantic prompt content (OSC 133)
  102     /// that can mark rows as prompts.
  103     ///
  104     /// This starts as false and becomes true the first time the cursor
  105     /// enters prompt or input content. That happens through
  106     /// `cursorSetSemanticContent`, or through `cursorCopy` when the copied
  107     /// cursor is already in prompt or input content. Resetting the screen
  108     /// sets it back to false.
  109     ///
  110     /// Rows are only marked as prompts while the cursor is in prompt or
  111     /// input content. So when this is false, no row on the screen is a
  112     /// prompt, and code that searches for prompt rows can skip the search.
  113     /// For example, `Terminal.eraseDisplay` uses this to avoid scanning
  114     /// the screen for a prompt on every full-screen erase.
  115     ///
  116     /// Code that marks rows as prompts in some new way must also set this
  117     /// to true. Otherwise, code that relies on this flag, such as
  118     /// `Terminal.eraseDisplay`, will not notice those rows.
  119     seen: bool,
  120 
  121     /// This is set on any `cl` or `click_events` option set on the
  122     /// most recent OSC 133 commands to specify how click handling in a
  123     /// prompt is handling.
  124     click: SemanticClick,
  125 
  126     pub const disabled: SemanticPrompt = .{
  127         .seen = false,
  128         .click = .none,
  129     };
