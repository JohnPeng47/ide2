  361 pub const MemoryPool = struct {
  362     alloc: Allocator,
  363     nodes: NodePool,
  364     pages: PagePool,
  365     pins: PinPool,
n9 src/terminal/PageList.zig
  401 /// The memory pool we get page nodes, pages from.
  402 pool: MemoryPool,
n9 src/terminal/PageList.zig
