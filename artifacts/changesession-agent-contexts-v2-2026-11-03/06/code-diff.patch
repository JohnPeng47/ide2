+  </span>;
+}
+
+function CarriedGhost({ coordinator, reference, revisions }: { coordinator: PromptComposerCoordinator; reference: PromptReference; revisions: PromptRevisionSource }) {
+  const [point, setPoint] = useState<{ x: number; y: number }>();
