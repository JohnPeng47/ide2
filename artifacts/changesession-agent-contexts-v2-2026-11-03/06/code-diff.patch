+    const carried = coordinator.store.getState().carried;
+    if (!carried) return false;
+    if (cursor) coordinator.setCursor(entryKey, cursor);
+    coordinator.insertReference(carried.reference, entryKey);
+    coordinator.carry();
+    return true;
+  };
