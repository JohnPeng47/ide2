index 00000000..6d1058e8
--- /dev/null
+++ b/src/features/mapping/canvas-views/CanvasViewDiffPreview.tsx
@@ -0,0 +1,34 @@
+import { useMemo, useRef } from 'react';
+import type { CanvasTransform } from '../../../../domain/core/diagrams/diagramCanvas';
+import { restoreMappingCamera } from '../tldraw/cameraCompatibility';
+import type { MappingDocumentController } from '../../../../domain/mapping/workspace/mappingDocumentController';
+import { canvasViewDiff } from '../../../../domain/mapping/changes/canvasViewDiff';
+import { DiagramDiffCanvas } from '../changes/ChangeSessionPreview';
+import { changeMigrationPreview } from '../changes/changeMigrationPreview';
+
+export function CanvasViewDiffPreview({ controller, viewId, onClose, camera }: {
+  controller: MappingDocumentController; viewId: string; onClose: () => void; camera?: CanvasTransform;
+}) {
+  // The old canvas wire format includes a legacy stage margin. This preview's
+  // stage starts at (0, 0), just like the native canvas, so convert once on open.
+  const nativeCamera = camera ? restoreMappingCamera(camera) : { x: 360, y: 100, z: 1 };
+  const viewport = useRef<CanvasTransform>({ offset: { x: nativeCamera.x * nativeCamera.z, y: nativeCamera.y * nativeCamera.z }, scale: nativeCamera.z });
+  const result = useMemo(() => {
+    try {
+      const preview = canvasViewDiff(controller.canvasViewComparison(viewId));
+      return { preview, migrations: changeMigrationPreview(preview.doc, []) };
+    } catch (error) { return { error: error instanceof Error ? error.message : String(error) }; }
+  }, [controller, viewId]);
+  const { preview } = result;
+  return <div className="change-session-preview canvas-view-diff-preview" data-canvas-view-diff={viewId}>
+    <div className="change-session-actions">
+      <span>{preview?.doc.name ?? 'CanvasView'} · Recorded diagram changes</span>
+      {preview && <small>{preview.diff.counts.added} added · {preview.diff.counts.removed} removed · {preview.diff.counts.modified} modified · {preview.diff.counts.moved} moved</small>}
+      <button type="button" onClick={onClose}>Close diff</button>
+    </div>
+    {result.error && <p className="change-preview-message" role="alert">{result.error}</p>}
+    {preview && <DiagramDiffCanvas key={preview.doc.id} {...preview} highlightAdded
+      initialTransform={viewport.current} onTransformChange={value => { viewport.current = value; }}
+      migrations={result.migrations!} serial={0} onJump={() => {}} />}
+  </div>;
+}
diff --git a/src/features/mapping/canvas-views/canvasViewReceiver.ts b/src/features/mapping/canvas-views/canvasViewReceiver.ts
new file mode 100644
index 00000000..b0598fd7
--- /dev/null
+++ b/src/features/mapping/canvas-views/canvasViewReceiver.ts
@@ -0,0 +1,35 @@
+import { canvasViewCommandSchema } from '../../../../domain/core/diagrams/canvasView';
+import type { MappingDocumentController } from '../../../../domain/mapping/workspace/mappingDocumentController';
+import { z } from 'zod';
+
+export const canvasViewRequestSchema = canvasViewCommandSchema.extend({ requestId: z.string().min(1).max(200),
+  expectedVersion: z.number().int().nonnegative().optional(), sessionId: z.string().optional() }).strict();
+export type CanvasViewRequest = z.infer<typeof canvasViewRequestSchema>;
+type Result = ReturnType<MappingDocumentController['canvasView']>;
+/** Retain the mutation receipt before flushing so a failed save never applies a view twice. */
+export class CanvasViewReceiver {
+  private receipts = new Map<string, { signature: string; result: Result; pending?: Promise<Result> }>();
+  async apply(documentId: string, raw: unknown, controller: MappingDocumentController, persist: () => Promise<void>) {
+    const { requestId, expectedVersion, sessionId: _, ...input } = canvasViewRequestSchema.parse(raw);
+    if (input.operation === 'list' || input.operation === 'read') {
+      const result = controller.canvasView(controller.getSnapshot().version, input);
+      return input.operation === 'read' ? { version: result.version, view: result.saved[input.viewId!] } : result;
+    }
+    if (expectedVersion === undefined) throw Error('expectedVersion is required for CanvasView changes');
+    const key = JSON.stringify([documentId, requestId]), signature = JSON.stringify({ input, expectedVersion });
+    let receipt = this.receipts.get(key);
+    if (receipt && receipt.signature !== signature) throw Error('REQUEST_ID_CONFLICT: CanvasView arguments differ');
+    if (!receipt) {
+      if (this.receipts.size >= 2000) throw Error('CanvasView receipt capacity reached; reload the workspace');
+      receipt = { signature, result: controller.canvasView(expectedVersion, input) };
+      this.receipts.set(key, receipt);
+    }
+    if (!receipt.pending) {
+      const current = receipt;
+      current.pending = Promise.resolve().then(persist).then(() => current.result).catch(error => {
+        throw Error(`PERSISTENCE_PENDING: CanvasView changed; retry the same request to save: ${String(error)}`);
+      }).finally(() => { current.pending = undefined; });
+    }
+    return receipt.pending;
+  }
+}
