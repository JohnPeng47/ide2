diff --git a/src/features/mapping/source-pane/SourceWindowPanel.tsx b/src/features/mapping/source-pane/SourceWindowPanel.tsx
new file mode 100644
index 00000000..afa3a22c
--- /dev/null
+++ b/src/features/mapping/source-pane/SourceWindowPanel.tsx
@@ -0,0 +1,59 @@
+import { useCallback, useContext, useEffect, useMemo } from 'react';
+import { useStore } from 'zustand';
+import { diagramSource } from '../../../../domain/core/diagrams/diagram';
+import { sha256 } from '../../../../domain/core/sha256';
+import { setExpansion, visibleProjectionIds, type ProjectedPane } from '../../../../domain/mapping/workspace/displayModel';
+import type { CanvasSession } from '../workspace/canvasSession';
+import { useMappingServices } from '../services/MappingServices';
+import { WindowPanel } from '../window-panel/WindowPanel';
+import { useSaveWindowPanelState, useWindowPanelState } from '../window-panel/windowPanelState';
+import { SourcePaneDocumentContext } from './SourcePaneViewStateContext';
+import { SessionCodePanel } from '../code-panel/SessionCodePanel';
+import { SourceCodePane } from './SourceCodePane';
+import { updateSourceCodePane, type SourceCodePaneView } from './sourceCodePane';
+import './sourceWindowPanel.css';
+
+export function SourceWindowPanel({ session, projectId, active }: { session: CanvasSession; projectId?: string; active: boolean }) {
+  const { codeRepo } = useMappingServices();
+  const documentId = useContext(SourcePaneDocumentContext);
+  const contents = useStore(session.document, state => state.document.scene.contents);
+  const display = useStore(session.presentation, state => state.display);
+  const focus = useStore(session.controls, state => state.selectionFocusId);
+  const storageKey = `mapped-source:${documentId}`;
+  const [state, setState] = useWindowPanelState(storageKey);
+  useSaveWindowPanelState(storageKey, state);
+  const files = useMemo(() => {
+    const files = new Map<string, { repo: { projectId: string; sourceId: string }; path: string; ranges: Set<string> }>();
+    if (!projectId) return [];
+    for (const diagram of Object.values(contents)) for (const { entity, range, binding } of diagramSource(diagram).entries()) {
+      if (!range) continue;
+      const repo = { projectId, sourceId: entity?.sourceId ?? binding?.sourceId ?? '' };
+      const key = JSON.stringify([repo.sourceId, range.path]);
+      const file = files.get(key) ?? { repo, path: range.path, ranges: new Set<string>() };
+      file.ranges.add(JSON.stringify([range.startLine, range.endLine, range.originalLines])); files.set(key, file);
+    }
+    return [...files.values()].map(({ repo, path, ranges }) => ({ repo, path, version: sha256([...ranges].sort().join('\n')) }));
+  }, [contents, projectId]);
+  useEffect(() => { if (active) codeRepo.preloadFiles?.(files); }, [codeRepo, files, active]);
+  const visible = new Set(Object.values(display.nodes).flatMap(node => node.kind === 'selection' ? visibleProjectionIds(display, node.id, node.displayMode) : []));
+  const panes = Object.values(display.nodes).filter((node): node is ProjectedPane => visible.has(node.id) && node.kind === 'projection'
+    && ['source-code', 'code-panel'].includes(node.content.kind) && node.expansion === 'expanded');
+  const pane = panes.find(node => node.content.kind === 'code-panel' && node.content.selectionId === focus) ?? panes.at(-1);
+  const changeSource = useCallback((id: string, patch: Partial<SourceCodePaneView>) => session.controller.updateCanvas(current => ({
+    ...current, display: updateSourceCodePane(current.display, id, patch)
+  }), true), [session]);
+  const close = () => session.controller.updateCanvas(current => {
+    let next = current.display;
+    for (const node of panes) next = setExpansion(next, node.id, 'collapsed');
+    return { ...current, display: next };
+  }, true);
+  if (!active || !pane) return null;
+  return <div className="source-window-host" data-mapping-static-ui data-diagram-canvas-static-ui
+    data-display-node={pane.id} data-pane-content={pane.content.kind}>
+    <WindowPanel title={pane.content.kind === 'source-code' ? pane.content.sourceFile : 'Mapped source'} canvasId={documentId} sizeStorageKey={storageKey}
+      state={{ ...state, mode: 'full-single', pane: 'tree', focusedPane: 'tree', minimized: false, expandedWidth: state.expandedWidth ?? .45 }}
+      onChange={patch => setState(previous => ({ ...previous, ...patch }))} onClose={close} canvas={null}
+      panes={[{ id: 'tree', title: 'Source', content: pane.content.kind === 'code-panel' ? <SessionCodePanel key={pane.id} session={session} id={pane.id} />
+        : pane.content.kind === 'source-code' ? <SourceCodePane key={pane.id} id={pane.id} content={pane.content} onChange={changeSource} /> : null }]} />
+  </div>;
+}
diff --git a/src/features/mapping/tldraw/DiagramAlternativeControls.tsx b/src/features/mapping/tldraw/DiagramAlternativeControls.tsx
new file mode 100644
index 00000000..1442de6b
--- /dev/null
+++ b/src/features/mapping/tldraw/DiagramAlternativeControls.tsx
@@ -0,0 +1,48 @@
+import { mappingShapeId } from './shapeProjection';
+import { useContext, useState } from 'react';
+import { useValue } from 'tldraw';
+import { CanvasRuntimeContext, type GridModel } from './CanvasRuntimeContext';
+import { getDiagramRevision } from '../../../../domain/core/diagrams/diagramRevisionStore';
+import { resolveRevisionLines } from '../../../../domain/core/diagrams/diagramRevisionSelection';
+import { alternativeSelections, scopeOwner } from '../../../../domain/core/presentation/diagramAlternative';
+import type { AlternativeOperation } from '../../../../domain/mapping/workspace/diagramAlternatives';
+
+export function DiagramAlternativeControls({ model, disabled }: { model: GridModel; disabled: boolean }) {
+  const runtime = useContext(CanvasRuntimeContext)!;
+  const state = useValue('promoted alternatives', () => runtime.alternativeState.get(), [runtime]);
+  const [menu, setMenu] = useState<string>(), [error, setError] = useState('');
+  const snapshot = runtime.controller.getSnapshot(), base = getDiagramRevision(model.diagram!.revisionId);
+  const folded = new Set([...(model.view?.collapsedNodeRefs ?? []), ...(model.view?.collapsedContentNodeIds ?? []).flatMap(id => base.nodeRefs[id] ? [base.nodeRefs[id]] : [])]);
+  const lines = resolveRevisionLines(base, alternativeSelections(snapshot.document, model.id, model.diagram!.id, base), getDiagramRevision, folded);
+  const groups = new Map<string, { id: string; name: string; partIndex: number }[]>();
+  for (const item of Object.values(state?.items ?? {})) if (item.presentationId === model.id && (!item.parentAlternativeId || state?.selected[model.id]?.includes(item.parentAlternativeId)))
+    item.parts.forEach((part, partIndex) => { const owner = scopeOwner(part.target); groups.set(owner, [...(groups.get(owner) ?? []), { id: item.id, name: item.name, partIndex }]); });
+  const run = (op: AlternativeOperation) => {
+    try { runtime.controller.applyUpdate(runtime.controller.getSnapshot().version, [op]); setError(''); setMenu(undefined); }
+    catch (error) { setError(error instanceof Error ? error.message : String(error)); }
+  };
+  return <div className="diagram-alternative-controls" data-mapping-static-ui data-diagram-canvas-static-ui onPointerDown={e => e.stopPropagation()} onDoubleClick={e => e.stopPropagation()}>
+    {[...groups].map(([owner, alternatives]) => {
+      const row = owner === 'root' ? 0 : lines.findIndex(line => line.nodeRef === owner || line.ownerNodeId === owner);
+      if (row < 0 || model.frame.collapsed && row > 0) return null;
+      const active = alternatives.find(item => state?.selected[model.id]?.includes(item.id)) ?? alternatives[0];
+      const select = (id: string) => run({ method: 'alternative-select', nodeId: model.id, alternativeId: id, selected: !state?.selected[model.id]?.includes(id), replace: true });
+      const open = (item: typeof active) => {
+        const panelId = `panel:${item.id}:${item.partIndex}`;
+        const bounds = state?.panels[panelId] && runtime.editor?.getShapePageBounds(mappingShapeId(panelId));
+        if (bounds) { runtime.editor?.zoomToBounds(bounds.clone().expandBy(80), { animation: { duration: 150 } }); setMenu(undefined); }
+        else run({ method: 'side-panel', nodeId: model.id, alternativeId: item.id, partIndex: item.partIndex });
+      };
+      return <div key={owner} data-alternative-node={owner} style={{ position: 'absolute', top: row * model.cell.height, right: -48, display: 'flex', zIndex: 8, pointerEvents: 'auto' }}>
+        <button style={{ height: model.cell.height, width: 23, padding: 0, fontSize: 13 }} disabled={disabled} aria-label={`Swap alternative ${active.name}`} title="Swap alternative inline" aria-pressed={state?.selected[model.id]?.includes(active.id) ?? false}
+          onClick={() => alternatives.length === 1 ? select(active.id) : setMenu(menu === `swap:${owner}` ? undefined : `swap:${owner}`)}>⇄</button>
+        <button style={{ height: model.cell.height, width: 23, padding: 0, fontSize: 13 }} disabled={disabled} aria-label={`Open alternative panel ${active.name}`} title="Open alternative SidePanel"
+          onClick={() => alternatives.length === 1 ? open(active) : setMenu(menu === `panel:${owner}` ? undefined : `panel:${owner}`)}>▥</button>
+        {(menu === `swap:${owner}` || menu === `panel:${owner}`) && <div role="menu" style={{ position: 'absolute', left: 0, top: '100%', background: 'var(--surface-raised)', padding: 4, minWidth: 180 }}>
+          {alternatives.map(item => <button role="menuitem" key={item.id} onClick={() => menu.startsWith('swap:') ? select(item.id) : open(item)}>{item.name}{state?.selected[model.id]?.includes(item.id) ? ' ✓' : ''}</button>)}
+        </div>}
+      </div>;
+    })}
+    {error && <div role="alert" style={{ position: 'absolute', top: '100%', color: 'var(--diff-deleted-text)', background: 'var(--surface-raised)' }}>{error}</div>}
+  </div>;
+}
diff --git a/src/features/mapping/tldraw/DiagramSidePanelContent.tsx b/src/features/mapping/tldraw/DiagramSidePanelContent.tsx
