+    </div>
+    {definition.parameters.length > 0 && <div className="prompt-template-options">
+      {definition.parameters.map(parameter => <TemplateParameter key={parameter.key} parameter={parameter} value={template.options[parameter.key] ?? parameter.default}
+        disabled={locked} onChange={value => update(draft => setTemplateOption(draft, parameter.key, value))} />)}
+    </div>}
+    {editing && <TemplateEditor template={template} instruction={instruction} referenceCount={referenceCount} onClose={() => setEditing(false)}
+      onSave={markdown => update(draft => setTemplateMarkdown(draft, markdown))} />}
+  </div>;
+}
+
+function TemplateParameter({ parameter, value, disabled, onChange }: { parameter: PromptTemplateParameter; value: string | number; disabled: boolean; onChange: (value: string | number) => void }) {
+  if (parameter.kind === 'enum') return <label>{parameter.label}
+    <select value={value} disabled={disabled} onChange={event => onChange(event.target.value)}>
+      {parameter.options.map(option => <option key={option.value} value={option.value}>{option.label}</option>)}
+    </select></label>;
+  return <label><span className="prompt-option-label">{parameter.label}<output>{value}{parameter.unit ? ` ${parameter.unit}` : ''}</output></span>
+    <input type="range" min={parameter.min} max={parameter.max} step={parameter.step} value={value} disabled={disabled}
+      onChange={event => onChange(Number(event.target.value))} /></label>;
+}
+
+function PromptBody({ coordinator, entryKey, entry, locked, revisions, carrying, placeholder }: { coordinator: PromptComposerCoordinator; entryKey: string;
+  entry: PromptComposerEntry; locked: boolean; revisions: PromptRevisionSource; carrying: boolean; placeholder: string }) {
+  const body = useRef<HTMLDivElement>(null), focusNext = useRef<{ blockId: string; offset: number }>(undefined);
+  const update = (change: Parameters<PromptComposerCoordinator['updateDraft']>[1]) => coordinator.updateDraft(entryKey, change);
+  const blocks = entry.draft.body;
+  const focusEnd = () => {
+    const areas = body.current?.querySelectorAll<HTMLTextAreaElement>('textarea');
+    const last = areas?.[areas.length - 1];
+    if (last && !last.disabled) { last.focus(); last.setSelectionRange(last.value.length, last.value.length); }
+  };
+  // Opening a prompt puts the caret at the end of its text, ready to type.
+  useEffect(focusEnd, []);
+  useLayoutEffect(() => {
+    const next = focusNext.current; if (!next) return;
+    focusNext.current = undefined;
+    const area = body.current?.querySelector<HTMLTextAreaElement>(`[data-block-id="${next.blockId}"]`);
+    area?.focus(); area?.setSelectionRange(next.offset, next.offset);
+  });
+  const dropCarried = (cursor?: { blockId: string; offset: number }) => {
+    const carried = coordinator.store.getState().carried;
+    if (!carried) return false;
+    if (cursor) coordinator.setCursor(entryKey, cursor);
+    coordinator.insertReference(carried.reference, entryKey);
+    coordinator.carry();
+    return true;
+  };
+  return <div ref={body} className="prompt-body" aria-label="Prompt body" data-drop-target={carrying && !locked}
+    onClick={event => {
+      if (event.target !== event.currentTarget || locked) return;
+      if (dropCarried()) event.preventDefault();
+      else focusEnd();
+    }}>
+    {blocks.map((block, index) => block.kind === 'reference'
+      ? <ReferenceChip key={block.id} reference={block.reference} revisions={revisions} onRemove={locked ? undefined : () => {
+          const previous = blocks[index - 1];
+          if (previous?.kind === 'text') focusNext.current = { blockId: previous.id, offset: previous.text.length };
+          update(draft => removeBlock(draft, block.id));
+        }} />
+      : <PromptText key={block.id} block={block} disabled={locked} placeholder={index === 0 && blocks.length === 1 ? placeholder : undefined}
+          last={index === blocks.length - 1}
+          onCursor={offset => { coordinator.setCursor(entryKey, { blockId: block.id, offset }); }}
+          onDrop={offset => dropCarried({ blockId: block.id, offset })}
+          onChange={text => update(draft => setBlockText(draft, block.id, text))}
+          onRemoveAdjacent={direction => {
+            const neighbour = blocks[index + direction];
+            if (neighbour?.kind !== 'reference') return false;
+            // Removing a chip merges its neighbours; keep the caret where the user was typing.
+            const before = direction < 0 ? blocks[index - 2] : block;
+            if (before?.kind === 'text') focusNext.current = { blockId: before.id, offset: before.text.length };
+            update(draft => removeBlock(draft, neighbour.id));
+            return true;
+          }}
+          onPasteReferences={(references, offset) => {
+            update(draft => references.reduceRight((next, reference) => insertReference(next, reference, { blockId: block.id, offset }), draft));
+          }} />)}
+  </div>;
+}
+
+function PromptText({ block, disabled, placeholder, last, onCursor, onDrop, onChange, onRemoveAdjacent, onPasteReferences }: {
+  block: Extract<PromptBlock, { kind: 'text' }>; disabled: boolean; placeholder?: string; last: boolean; onCursor: (offset: number) => void;
+  onDrop: (offset: number) => boolean; onChange: (text: string) => void; onRemoveAdjacent: (direction: -1 | 1) => boolean;
+  onPasteReferences: (references: PromptReference[], offset: number) => void }) {
+  const area = useRef<HTMLTextAreaElement>(null);
+  useLayoutEffect(() => {
+    const element = area.current; if (!element) return;
+    // Text between references sizes to its content so chips flow inline with it; the last block fills the line.
+    if (!last) {
+      const style = getComputedStyle(element), context = measure.getContext('2d')!;
+      context.font = `${style.fontSize} ${style.fontFamily}`;
+      const widest = Math.max(0, ...(block.text || ' ').split('\n').map(line => context.measureText(line).width));
+      element.style.width = `${Math.ceil(widest) + 14}px`;
+    } else element.style.width = '';
+    element.style.height = '0'; element.style.height = `${element.scrollHeight}px`;
+  }, [block.text, last]);
+  const cursor = () => onCursor(area.current?.selectionStart ?? block.text.length);
+  return <textarea ref={area} data-block-id={block.id} className="prompt-body-text" data-last={last} rows={1} value={block.text}
+    disabled={disabled} placeholder={placeholder} aria-label="Prompt text" maxLength={promptLimit}
+    onChange={event => { onChange(event.target.value); onCursor(event.target.selectionStart); }}
+    onSelect={cursor} onFocus={cursor}
+    onClick={event => { if (onDrop(event.currentTarget.selectionStart)) event.preventDefault(); }}
+    onKeyDown={event => {
+      const { selectionStart, selectionEnd, value } = event.currentTarget;
+      if (selectionStart !== selectionEnd) return;
+      if (event.key === 'Backspace' && selectionStart === 0 && onRemoveAdjacent(-1)) event.preventDefault();
+      if (event.key === 'Delete' && selectionStart === value.length && onRemoveAdjacent(1)) event.preventDefault();
+    }}
+    onPaste={event => {
+      const references = pastedPromptReferences(event.clipboardData.getData('text/html'));
+      if (!references?.length) return;
+      event.preventDefault(); onPasteReferences(references, event.currentTarget.selectionStart);
+    }} />;
+}
+
+function ReferenceIcon({ kind }: { kind: PromptReference['kind'] }) {
+  return kind === 'diagram'
+    ? <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>
+    : <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true"><rect x="3" y="3" width="8" height="7" rx="1" /><rect x="13" y="14" width="8" height="7" rx="1" /><path d="M7 10v4h6" /></svg>;
+}
+/** Shared reference presentation: whole diagrams are solid cyan, selected nodes dashed purple. */
+export function ReferenceChip({ reference, revisions, onRemove, children }: { reference: PromptReference; revisions: PromptRevisionSource; onRemove?: () => void; children?: ReactNode }) {
+  const tag = useRevisionTag(revisions)(reference.revisionId);
+  const summary = referenceSummary(reference);
+  return <span className="prompt-reference" data-kind={reference.kind}
+    title={`${reference.kind === 'diagram' ? 'Whole diagram' : 'Selected nodes'} · ${summary} · pinned to ${tag}`}>
+    <ReferenceIcon kind={reference.kind} /><span className="prompt-reference-label">{reference.label}</span>
+    <small>{tag}{reference.kind === 'nodes' ? ` · ${reference.nodeIds.length || 'region'}${reference.nodeIds.length === 1 ? ' node' : reference.nodeIds.length ? ' nodes' : ''}` : ''}</small>
+    {children}
+    {onRemove && <button type="button" className="prompt-reference-remove" aria-label={`Remove reference ${summary}`} onClick={onRemove}>×</button>}
+  </span>;
+}
+
+function CarriedGhost({ coordinator, reference, revisions }: { coordinator: PromptComposerCoordinator; reference: PromptReference; revisions: PromptRevisionSource }) {
+  const [point, setPoint] = useState<{ x: number; y: number }>();
+  useEffect(() => {
+    const move = (event: PointerEvent) => setPoint({ x: event.clientX, y: event.clientY });
+    const key = (event: KeyboardEvent) => { if (event.key === 'Escape') { event.preventDefault(); coordinator.carry(); } };
+    window.addEventListener('pointermove', move); window.addEventListener('keydown', key, true);
+    document.body.classList.add('is-placing-prompt-reference');
+    return () => { window.removeEventListener('pointermove', move); window.removeEventListener('keydown', key, true); document.body.classList.remove('is-placing-prompt-reference'); };
+  }, [coordinator]);
+  return point ? createPortal(<div className="prompt-reference-ghost" aria-hidden="true" style={{ left: point.x + 14, top: point.y + 10 }}>
+    <ReferenceChip reference={reference} revisions={revisions} /></div>, document.body) : null;
+}
+
+function RevisionRail({ id, coordinator, list }: { id: string; coordinator: PromptComposerCoordinator; list: PromptRevision[] }) {
+  const carried = useStore(coordinator.store, state => state.carried);
+  const names = useStore(revisionNames, state => state.names);
+  return <aside id={id} className="prompt-revision-rail" aria-label="Diagram revisions">
+    <header><span className="eyebrow">Revisions</span><small>{list.length}</small></header>
+    {carried && <div className="prompt-carry-status" role="status">
+      <span>Click the prompt box or the canvas to place {names[carried.reference.revisionId] ?? carried.reference.label}</span>
+      <button type="button" onClick={() => coordinator.carry()}>Cancel</button>
+    </div>}
+    <ul>{list.map(revision => {
+      const active = carried?.reference.revisionId === revision.id && carried.reference.kind === 'diagram';
+      return <li key={revision.id} data-active={active}>
+        <span className="prompt-revision-tag">r{revision.sequence}</span>
+        <span className="prompt-revision-name"><span data-named={!!names[revision.id]}>{names[revision.id] ?? 'Untitled revision'}</span>
+          <small>{revision.current ? 'current' : `${revision.ascii.split('\n').length} lines`}</small></span>
+        <button type="button" aria-pressed={active} aria-label={`Pick up r${revision.sequence} to place in the prompt or on the canvas`}
+          onClick={() => coordinator.carry(active ? undefined : revisionReference(revision))}>+</button>
+      </li>;
+    })}</ul>
+  </aside>;
+}
diff --git a/src/features/mapping/prompt-composer/VariantReview.tsx b/src/features/mapping/prompt-composer/VariantReview.tsx
new file mode 100644
index 00000000..a3021593
--- /dev/null
+++ b/src/features/mapping/prompt-composer/VariantReview.tsx
@@ -0,0 +1,51 @@
+import { useState } from 'react';
+import type { DiagramRevisionReview, RevisionDecision, RevisionChange } from '../../../../domain/core/diagrams/diagramRevisionReview';
+import type { PromptComposerCoordinator, PromptComposerTarget } from './promptComposerCoordinator';
+export interface VariantReviewSource {
+  list(target: PromptComposerTarget): { variant: DiagramRevisionReview; changes: RevisionChange[]; ascii: string; scopeLabel: string; error?: string }[];
+  update(target: PromptComposerTarget, id: string, change: { decisions?: Record<string, RevisionDecision>; name?: string; remove?: boolean; apply?: boolean }): Promise<void>;
+}
+export function VariantReview({ source, target, coordinator, entryKey, locked }: {
+  source: VariantReviewSource; target: PromptComposerTarget; coordinator: PromptComposerCoordinator; entryKey: string; locked: boolean;
+}) {
+  const list = source.list(target), [selected, setSelected] = useState(''), [error, setError] = useState(''), [busy, setBusy] = useState(false);
+  const item = list.find(item => item.variant.id === selected) ?? list.at(-1);
+  if (!item) return null;
+  const { variant, changes } = item;
+  const update = async (change: Parameters<VariantReviewSource['update']>[2]) => {
+    setBusy(true); setError('');
+    try { await source.update(target, variant.id, change); } catch (e) { setError(String(e instanceof Error ? e.message : e)); }
+    finally { setBusy(false); }
+  };
+  const disabled = busy || locked;
+  return <section className="variant-review" aria-label="Variant review">
+    <h3>Variants</h3>
+    <label>Review variant <select aria-label="Review variant" value={variant.id} disabled={disabled} onChange={e => { setSelected(e.target.value); setError(''); }}>
+      {list.map(({ variant }) => <option key={variant.id} value={variant.id}>{variant.name}</option>)}
+    </select></label>
+    <label>Name <input aria-label="Rename variant" key={variant.id + variant.name} defaultValue={variant.name} maxLength={120} disabled={disabled}
+      onBlur={e => { if (e.target.value.trim() && e.target.value.trim() !== variant.name) void update({ name: e.target.value }); }} /></label>
+    <p>{variant.replacementScope ? variant.replacementScope.mode === 'multi-contiguous' ? 'Adjacent subtrees' : 'Separate subtrees' : variant.ownerNodeId === 'root' ? 'Whole diagram' : `Subtree: ${item.scopeLabel}`} · {variant.revisionIds.length} generated revision(s)</p>
+    <details><summary>Generated candidate</summary><pre>{item.ascii}</pre></details>
+    <div className="variant-review-actions">
+      <button disabled={disabled} onClick={() => void update({ decisions: Object.fromEntries(changes.map(c => [c.id, 'accept'])) })}>Accept all</button>
+      <button disabled={disabled} onClick={() => void update({ decisions: Object.fromEntries(changes.map(c => [c.id, 'reject'])) })}>Reject all</button>
+      <button disabled={disabled} onClick={() => coordinator.setTarget(entryKey, { operation: 'edit-diagram', generateVariants: true, replaceMode: variant.replacementScope?.mode ?? (variant.ownerNodeId === 'root' ? 'diagram' : 'subnode-single'), variantId: variant.id, variantName: variant.name, variantCount: 1 })}>Refine this variant</button>
+    </div>
+    <ul>{changes.map(change => <li key={change.id} data-variant-change={change.id}>
+      <strong>{change.label}</strong> <small>{change.kind}</small>
+      {change.before && change.after && change.before.label !== change.after.label && <div><del>{change.before.label}</del> → {change.after.label}</div>}
+      {change.before && change.after && (change.before.parentId !== change.after.parentId || JSON.stringify(change.before.childIds) !== JSON.stringify(change.after.childIds)) && <small>Parent or child order changed; related structural changes must agree.</small>}
+      <div><span>{variant.decisions[change.id] ?? 'Pending'}</span>
+        <button aria-label={`Accept ${change.label}`} disabled={disabled} aria-pressed={variant.decisions[change.id] === 'accept'} onClick={() => void update({ decisions: { [change.id]: 'accept' } })}>Accept</button>
+        <button aria-label={`Reject ${change.label}`} disabled={disabled} aria-pressed={variant.decisions[change.id] === 'reject'} onClick={() => void update({ decisions: { [change.id]: 'reject' } })}>Reject</button>
+      </div>
+    </li>)}</ul>
+    {!changes.length && <p>No content changes in this variant.</p>}
+    {item.error && <p role="alert">{item.error}</p>}
+    {error && <p role="alert">{error}</p>}
+    <p>Pending and rejected changes keep the base content. After applying, change decisions and apply again to roll back selected updates.</p>
+    <button className="prompt-primary" disabled={disabled || !!item.error || !changes.length} onClick={() => void update({ apply: true })}>Apply reviewed changes</button>
+    <button disabled={disabled} onClick={() => void update({ remove: true })}>Remove variant</button>
+  </section>;
+}
diff --git a/src/features/mapping/prompt-composer/promptComposerCoordinator.ts b/src/features/mapping/prompt-composer/promptComposerCoordinator.ts
new file mode 100644
index 00000000..1306b3d3
--- /dev/null
+++ b/src/features/mapping/prompt-composer/promptComposerCoordinator.ts
@@ -0,0 +1,210 @@
+import type { AgentContextSnapshot } from '../../../../domain/core/agents/agentContext';
+import { createStore } from 'zustand/vanilla';
+import type { CreateDiagramInput, DiagramEditRun, PromptReference } from '../../../../domain/mapping/agent/diagramEdit';
+import { defaultTemplateSelection, type PromptOperation } from '../../../../domain/mapping/agent/promptTemplates';
+import type { DiagramEditClient } from './diagramEditClient';
+import { createPromptDraft, insertReferenceWithCursor, removeBlock, serializePromptDraft, type PromptCursor, type PromptDraft } from './promptDraft';
+
+/** The fixed destination: the diagram to revise, or the anchor new diagrams are created beside. */
+export interface PromptComposerTarget { replaceMode?: import('../../../../domain/mapping/agent/diagramEdit').EditDiagramInput['replace-mode']; generateVariants?: boolean; variantName?: string; variantCount?: number; variantId?: string; operation: PromptOperation; canvasId: string; documentId: string; nodeId: string; label: string; subtreeLabel?: string; subtree?: CreateDiagramInput['subtree']; sources?: CreateDiagramInput['sources']; origin?: CreateDiagramInput['origin'] }
+export interface PromptComposerEntry {
+  llmSessionId: string;
+  agentContext?: AgentContextSnapshot;
+  agentSessionId?: string;
+  target: PromptComposerTarget;
+  draft: PromptDraft;
+  pending: boolean;
+  /** Selection identity -> automatic reference block; manual references have no binding. */
+  selectionReferences?: Record<string, string>;
+  /** The exact request sent; retries resend it unchanged. */
+  request?: CreateDiagramInput;
+  run?: DiagramEditRun;
+  error?: string;
+}
+/** An unavailable snapshot keeps its existing pinned chip until explicitly deselected. */
+export interface SelectionReference { id: string; reference?: PromptReference }
+/** A reference picked up from the revision list, waiting for a click in a prompt or on a canvas. */
+export interface CarriedReference { reference: PromptReference }
+export const composerKey = (target: Pick<PromptComposerTarget, 'operation' | 'documentId' | 'nodeId'>) =>
+  JSON.stringify([target.operation, target.documentId, target.nodeId]);
+export const composerUnsettled = (entry: PromptComposerEntry) => entry.pending || !!entry.request && (!entry.run
+  || ['generating', 'applying', 'awaiting-acknowledgement'].includes(entry.run.status));
+
+/** UI lifetime is independent of selection, panels and undo. Only the backend applies revisions. */
+export class PromptComposerCoordinator {
+  readonly store = createStore<{ entries: Record<string, PromptComposerEntry>; activeKey?: string; carried?: CarriedReference }>(() => ({ entries: {} }));
+  private timers = new Map<string, ReturnType<typeof setTimeout>>();
+  private polling = new Set<string>();
+  private cursors = new Map<string, PromptCursor>();
+  private stopped = false;
+  constructor(private readonly client: DiagramEditClient, private readonly pollMs = 750) {}
+  private entry(key: string) { return this.store.getState().entries[key]; }
+  private patch(key: string, patch: Partial<PromptComposerEntry>) {
+    if (this.stopped || !this.entry(key)) return;
+    this.store.setState(state => ({ entries: { ...state.entries, [key]: { ...state.entries[key], ...patch } } }));
+  }
+  open(target: PromptComposerTarget, fresh = false) {
+    const key = fresh ? crypto.randomUUID() : composerKey(target);
+    this.store.setState(state => ({ activeKey: key, entries: { ...state.entries,
+      [key]: state.entries[key] ?? { llmSessionId: crypto.randomUUID(), target: { ...target }, draft: createPromptDraft(target.operation), pending: false } } }));
+    return key;
+  }
+  setTarget(key: string, patch: Partial<PromptComposerTarget>) {
+    const entry = this.entry(key); if (!entry || composerUnsettled(entry)) return;
+    this.patch(key, { target: { ...entry.target, ...patch }, error: undefined,
+      ...(patch.operation && patch.operation !== entry.target.operation ? { run: undefined, request: undefined,
+        draft: { ...entry.draft, count: 1, template: defaultTemplateSelection(patch.operation) } } : {}) });
+  }
+  syncSelections(documentId: string, selections: readonly SelectionReference[], key = this.store.getState().activeKey) {
+    const entry = key && this.entry(key);
+    if (!key || !entry || entry.target.documentId !== documentId || composerUnsettled(entry)) return;
+    const desired = new Map(selections.map(selection => [selection.id, selection.reference]));
+    const bindings = { ...entry.selectionReferences };
+    let draft = entry.draft, cursor = this.cursors.get(key), changed = false, error: string | undefined;
+    for (const [selectionId, blockId] of Object.entries(bindings)) {
+      const reference = desired.get(selectionId);
+      const index = draft.body.findIndex(block => block.id === blockId);
+      if (!desired.has(selectionId)) {
+        if (index >= 0) {
+          const before = draft.body[index - 1], after = draft.body[index + 1];
+          if (cursor?.blockId === after?.id && before?.kind === 'text')
+            cursor = { blockId: before.id, offset: before.text.length + cursor.offset };
+          draft = removeBlock(draft, blockId);
+        }
+        delete bindings[selectionId]; changed = true;
+      } else {
+        const block = draft.body[index];
+        // A user-removed automatic chip stays removed until the selection is removed and re-added.
+        if (reference && block?.kind === 'reference' && JSON.stringify(block.reference) !== JSON.stringify(reference)) {
+          draft = { ...draft, body: draft.body.map(current => current.id === blockId
+            ? { ...block, reference: structuredClone(reference) } : current) };
+          changed = true;
+        }
+      }
+    }
+    try {
+      for (const [selectionId, reference] of desired) {
+        if (bindings[selectionId] || !reference) continue;
+        const inserted = insertReferenceWithCursor(draft, reference, cursor);
+        const trailing = inserted.draft.body.findIndex(block => block.id === inserted.cursor.blockId);
+        bindings[selectionId] = inserted.draft.body[trailing - 1].id;
+        draft = inserted.draft; cursor = inserted.cursor; changed = true;
+      }
+    } catch (cause) { error = cause instanceof Error ? cause.message : String(cause); }
+    if (changed || error) {
+      this.patch(key, { draft, selectionReferences: bindings, error });
+      if (cursor) this.cursors.set(key, cursor);
+    }
+  }
+  show(key: string) { this.store.setState({ activeKey: key }); }
+  close() { this.store.setState({ carried: undefined, activeKey: undefined }); }
+  dismiss(key: string) {
+    const entry = this.entry(key);
+    if (!entry || composerUnsettled(entry)) return;
+    clearTimeout(this.timers.get(key)); this.timers.delete(key); this.cursors.delete(key);
+    this.store.setState(state => {
+      const entries = { ...state.entries }; delete entries[key];
+      return { entries, activeKey: state.activeKey === key ? undefined : state.activeKey };
+    });
+  }
+  /** Drafts lock while a request is unsettled, so a retry always matches what the user sees. */
+  updateDraft(key: string, update: (draft: PromptDraft) => PromptDraft) {
+    const entry = this.entry(key);
+    if (!entry || composerUnsettled(entry)) return;
+    try { this.patch(key, { draft: update(entry.draft), error: undefined }); }
+    catch (error) { this.patch(key, { error: error instanceof Error ? error.message : String(error) }); }
+  }
+  setCursor(key: string, cursor: PromptCursor) { this.cursors.set(key, cursor); }
+  /** Inserts into the active composer at its last cursor. Returns false when no composer can take it. */
+  insertReference(reference: PromptReference, key = this.store.getState().activeKey) {
+    const entry = key && this.entry(key);
+    if (!key || !entry || composerUnsettled(entry)) return false;
+    let cursor: PromptCursor | undefined;
+    this.updateDraft(key, draft => {
+      const inserted = insertReferenceWithCursor(draft, reference, this.cursors.get(key));
+      cursor = inserted.cursor;
+      return inserted.draft;
+    });
+    if (cursor) this.cursors.set(key, cursor);
+    return !!cursor;
+  }
+  carry(reference?: PromptReference) { this.store.setState({ carried: reference && { reference: structuredClone(reference) } }); }
+  private accept(key: string, run: DiagramEditRun) {
+    this.patch(key, { run, error: undefined,
+      ...(run.agentSessionId ? { agentSessionId: run.agentSessionId } : {}),
+      ...(run.status === 'completed' && run.agentContext ? { agentContext: structuredClone(run.agentContext) } : {}) });
+    this.schedule(key);
+  }
+  private schedule(key: string) {
+    clearTimeout(this.timers.get(key)); this.timers.delete(key);
+    if (this.stopped || !['generating', 'applying'].includes(this.entry(key)?.run?.status ?? '')) return;
+    this.timers.set(key, setTimeout(() => { this.timers.delete(key); void this.refresh(key); }, this.pollMs));
+  }
+  async submit(key: string) {
+    const entry = this.entry(key);
+    if (!entry || composerUnsettled(entry) || this.stopped) return;
+    const { prompt, references } = serializePromptDraft(entry.draft);
+    if (!prompt) return;
+    if (entry.target.operation === 'extend-diagram' && (!entry.target.sources?.length || !entry.target.origin)) {
+      this.patch(key, { error: 'Select nodes, click the green circle, then click empty canvas to place the origin.' }); return;
+    }
+    if (entry.target.operation === 'edit-diagram' && !entry.target.subtree && !entry.target.generateVariants) {
+      this.patch(key, { error: 'Select a tree node to choose the subtree to update.' }); return;
+    }
+    this.patch(key, { pending: true, error: undefined, run: undefined, request: undefined });
+    try {
+      const { target, draft } = entry;
+      const capture = await this.client.capture(target.canvasId, target.documentId, target.nodeId);
+      if (this.stopped) return;
+      const request: CreateDiagramInput = { ...capture, llmSessionId: entry.llmSessionId,
+        ...(entry.agentContext ? { agentContext: structuredClone(entry.agentContext) } : {}), nodeId: target.nodeId, prompt, requestId: crypto.randomUUID(),
+        template: structuredClone(draft.template),
+        ...(target.operation === 'edit-diagram' ? { 'edit-mode': target.generateVariants ? 'variant' as const : 'in-place' as const,
+          'replace-mode': target.variantId ? target.replaceMode ?? (target.subtree ? 'subnode-single' as const : 'diagram' as const) : target.subtree ? 'subnode-single' as const : 'diagram' as const, subtree: target.variantId ? undefined : target.subtree,
+          ...(target.generateVariants ? { variant: { name: target.variantName?.trim() || 'Alternative', count: target.variantId ? 1 : target.variantCount ?? 1, variantId: target.variantId } } : {}) } : {}),
+        ...(target.operation === 'extend-diagram' ? { origin: target.origin, sources: target.sources } : {}), ...(references.length ? { references } : {}),
+        ...(target.operation === 'create-diagram' ? { count: draft.count } : {}) };
+      // Retain the exact request before sending: a lost response must never start a second generation.
+      this.patch(key, { request });
+      this.accept(key, await this.client.start(request, target.operation));
+    } catch (error) { this.patch(key, { error: String(error) }); }
+    finally { this.patch(key, { pending: false }); }
+  }
+  async retry(key: string) {
+    const entry = this.entry(key);
+    if (!entry || entry.pending || this.stopped) return;
+    if (!entry.request) return this.submit(key);
+    if (entry.run && entry.run.status !== 'awaiting-acknowledgement') return this.refresh(key);
+    this.patch(key, { pending: true, error: undefined });
+    try { this.accept(key, await this.client.start(entry.request, entry.target.operation)); }
+    catch (error) { this.patch(key, { error: String(error) }); }
+    finally { this.patch(key, { pending: false }); }
+  }
+  async refresh(key: string) {
+    const run = this.entry(key)?.run;
+    if (!run || this.polling.has(key) || this.stopped) return;
+    this.polling.add(key);
+    try {
+      const next = await this.client.status(run.runId);
+      // A cancel/retry response may already have moved this run forward while the read was in flight.
+      if (this.entry(key)?.run === run) this.accept(key, next);
+    } catch (error) { if (this.entry(key)?.run === run) this.patch(key, { error: `Could not refresh progress: ${String(error)}` }); }
+    finally {
+      this.polling.delete(key);
+      if (this.entry(key)?.run !== run && !this.timers.has(key)) this.schedule(key);
+    }
+  }
+  async cancel(key: string) {
+    const entry = this.entry(key);
+    if (!entry || entry.pending || entry.run?.status !== 'generating' || this.stopped) return;
+    this.patch(key, { pending: true });
+    try { this.accept(key, await this.client.cancel(entry.run.runId)); }
+    catch (error) { this.patch(key, { error: String(error) }); }
+    finally { this.patch(key, { pending: false }); }
+  }
+  dispose() {
+    this.stopped = true;
+    for (const timer of this.timers.values()) clearTimeout(timer);
+    this.timers.clear();
+  }
+}
