+      const ref = current.nodeRefs[node.id];
+      if (!merged[ref]) continue;
+      const index = node.line - range.startLine;
+      lines[index] = lines[index].slice(0, node.startColumn - 1) + merged[ref].label + lines[index].slice(node.endColumn);
+      refs[ref] = node.line;
+    }
