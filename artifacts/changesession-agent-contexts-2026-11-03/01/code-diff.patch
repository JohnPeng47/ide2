+          ...(parent ? { parentAlternativeId: parent.id } : {}), parts: [{ target: ownerScope(choice.ownerNodeId),
+            source: { revisionId: choice.revisionId, scope: ownerScope(choice.sourceOwnerNodeId ?? choice.ownerNodeId) },
