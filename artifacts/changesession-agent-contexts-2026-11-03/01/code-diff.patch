@@ -0,0 +1,173 @@
+import { useTheme } from '../../../shared/theme/theme';
+import { mappingTools, selectionTools } from './SelectionTools';
+import { createContext, useContext, useEffect, useLayoutEffect, useMemo, useRef, useState, type ReactNode } from 'react';
+import { Tldraw, useEditor, useQuickReactor, useValue, type Editor, type TLComponents } from 'tldraw';
+import type { CanvasTransform, DiagramFocus } from '../../../../domain/core/diagrams/diagramCanvas';
+import type { CanvasSession } from '../workspace/canvasSession';
+import { restoreMappingCamera, saveMappingCamera } from './cameraCompatibility';
+import { MappingShapeUtil } from './MappingShapeUtil';
+import { MappingEditorRuntime } from './MappingEditorRuntime';
+import { CanvasRuntime, CanvasRuntimeContext } from './CanvasRuntimeContext';
+import { mappingShapeId } from './shapeProjection';
+import { ConnectionFocus } from './ConnectionFocus';
+import 'tldraw/tldraw.css';
+import './mappingEditor.css';
+
+const ContentContext = createContext<ReactNode>(null);
+const shapeUtils = [MappingShapeUtil];
+/** Existing application overlays share the editor's page coordinate system.
+ * Camera updates touch this transform only, never application React state. */
+function ApplicationOverlay() {
+  const editor = useEditor(), ref = useRef<HTMLDivElement>(null);
+  const children = useContext(ContentContext);
+  useQuickReactor('mapping overlay camera', () => {
+    const { x, y, z } = editor.getCamera();
+    if (ref.current) ref.current.style.transform = `scale(${z}) translate(${x}px, ${y}px)`;
+  }, [editor]);
+  return <div ref={ref} className="mapping-editor-overlay diagram-canvas__surface">{children}</div>;
+}
+const components: TLComponents = { InFrontOfTheCanvas: ApplicationOverlay };
+export function MappingEditorCanvas(props: {
+  session: CanvasSession; children: ReactNode; enabled: boolean; className?: string;
+  focusBox?: DiagramFocus; initialTransform?: CanvasTransform; onTransformChange?: (value: CanvasTransform) => void;
+}) {
+  const canvasRuntime = useMemo(() => new CanvasRuntime(props.session), [props.session]);
+  useLayoutEffect(() => canvasRuntime.connect(), [canvasRuntime]);
+  const theme = useTheme();
+  const [editor, setEditor] = useState<Editor>();
+  const [tool, setTool] = useState('select');
+  const canUndo = useValue('canvas undo available', () => canvasRuntime.canUndo.get(), [canvasRuntime]);
+  const canEscape = useValue('canvas escape available', () => canvasRuntime.canEscape.get(), [canvasRuntime]);
+  const transformCallback = useRef(props.onTransformChange); transformCallback.current = props.onTransformChange;
+  const initial = useRef(props.initialTransform);
+  const root = useRef<HTMLDivElement>(null);
+  useLayoutEffect(() => {
+    if (!editor) return;
+    canvasRuntime.editor = editor;
+    const fontsChanged = () => canvasRuntime.anchors.invalidate();
+    document.fonts.addEventListener('loadingdone', fontsChanged);
+    editor.setCameraOptions({ zoomSteps: [.25, .5, 1, 2, 4] });
+    selectionTools.set(editor, canvasRuntime.gestures);
+    const runtime = new MappingEditorRuntime(editor, props.session.controller, canvasRuntime.gestures.ownership);
+    // Existing application interactions own buttons, text inputs and pane bodies.
+    const stopUiPointer = (event: PointerEvent) => {
+      const target = event.target as Element;
+      const directLabel = event.pointerType !== 'mouse' && target.closest('[data-diagram-jump-id]');
+      if (!directLabel && !target.closest('[data-diagram-move-handle]') && target.closest('button,input,textarea,select,a,[contenteditable=true],[data-display-node],.window-panel')) editor.markEventAsHandled(event);
+      else editor.focus();
+    };
+    const element = root.current!;
+    element.addEventListener('pointerdown', stopUiPointer, true);
+    const saved = initial.current;
+    if (saved) editor.setCamera(restoreMappingCamera(saved));
+    else {
+      editor.setCamera({ x: 360, y: 100, z: 1 });
+    }
+    let last = '';
+    let checkpoint = props.session.controller.getSnapshot().canvasRevisionId;
+    const unsubscribeCamera = props.session.controller.subscribe(() => {
+      const state = props.session.controller.getSnapshot();
+      if (state.canvasRevisionId === checkpoint) return;
+      checkpoint = state.canvasRevisionId;
+      if (state.canvas.viewport) {
+        props.session.controller.captureViewCamera(state.canvas.viewport);
+        editor.setCamera(restoreMappingCamera(state.canvas.viewport));
+      }
+    });
+    const publishCamera = () => {
+      setTool(editor.getCurrentToolId());
+      const { x, y, z } = editor.getCamera(), key = `${x}:${y}:${z}`;
+      if (last === key) return;
+      last = key;
+      const camera = saveMappingCamera({ x, y, z });
+      props.session.controller.captureViewCamera(camera);
+      transformCallback.current?.(camera);
+    };
+    editor.on('tick', publishCamera);
+    return () => { unsubscribeCamera(); document.fonts.removeEventListener('loadingdone', fontsChanged); element.removeEventListener('pointerdown', stopUiPointer, true); runtime.dispose(); selectionTools.delete(editor); editor.off('tick', publishCamera); canvasRuntime.editor = undefined; };
+  }, [editor, props.session, canvasRuntime]);
+  useEffect(() => {
+    if (editor && !props.enabled) editor.blur({ blurContainer: false });
+  }, [editor, props.enabled]);
+  useEffect(() => {
+    if (!editor || !props.enabled || !props.focusBox) return;
+    let inner = 0;
+    const frame = requestAnimationFrame(() => { inner = requestAnimationFrame(() => {
+      const focus = props.focusBox!;
+      root.current?.querySelectorAll('[data-jump-focus]').forEach(element => element.removeAttribute('data-jump-focus'));
+      const targetIds = new Set(focus.contentNodeIds ?? (focus.contentNodeId ? [focus.contentNodeId] : []));
+      const labels = [...root.current!.querySelectorAll<HTMLElement>('[data-content-node-id]')]
+        .filter(element => targetIds.has(element.dataset.contentNodeId!) && element.dataset.displayNodeId === `grid:${focus.id}`);
+      labels.forEach(label => label.setAttribute('data-jump-focus', ''));
+      const search = focus.search && [...root.current!.querySelectorAll<HTMLElement>('[data-search-focus]')]
+        .find(element => element.dataset.searchBox === focus.id && element.dataset.searchFocus === String(focus.serial));
+      const rects = (search ? [search] : labels).map(element => element.getBoundingClientRect()).filter(rect => rect.width && rect.height);
+      const rect = rects.length ? {
+        x: Math.min(...rects.map(rect => rect.left)), y: Math.min(...rects.map(rect => rect.top)),
+        right: Math.max(...rects.map(rect => rect.right)), bottom: Math.max(...rects.map(rect => rect.bottom))
+      } : undefined;
+      const bounds = editor.getShapePageBounds(mappingShapeId(`grid:${focus.id}`));
+      const point = rect ? editor.screenToPage({ x: (rect.x + rect.right) / 2, y: (rect.y + rect.bottom) / 2 })
+        : bounds?.center;
+      if (point) {
+        const viewport = root.current!.getBoundingClientRect();
+        const tools = [...root.current?.closest('.mapping-viewport')?.querySelectorAll('.window-panel-tabbed, .canvas-treemap-window') ?? []]
+          .map(element => element.getBoundingClientRect()).filter(rect => rect.width > 0).sort((a, b) => a.left - b.left)[0];
+        // Center in the canvas space beside the visible tools; keep the explorer margin otherwise.
+        const explorer = root.current?.closest('.mapping-viewport')?.querySelector('.mapping-floating-pane')?.getBoundingClientRect();
+        const offset = tools?.width ? ((explorer?.right ?? viewport.left) + tools.left) / 2 - (viewport.left + viewport.width / 2) : 170;
+        editor.centerOnPoint({ x: point.x - offset / editor.getZoomLevel(), y: point.y });
+      }
+    }); });
+    return () => { cancelAnimationFrame(frame); cancelAnimationFrame(inner); };
+  }, [editor, props.enabled, props.focusBox]);
+  return <div ref={root} className={`${props.className ?? ''} mapping-editor-canvas`} data-diagram-canvas data-canvas-engine="tldraw"
+    onWheelCapture={event => {
+      if (!props.enabled || !editor) return;
+      const target = event.target as Element;
+      if (!target.closest('.tl-canvas') || target.closest('button,input,textarea,select,[contenteditable=true],.mapping-native-projection,.mapping-native-conversation,.mapping-native-detail')) return;
+      // The SDK ignores wheels until focused. Activate before its bubble listener
+      // handles this first scroll, keeping keyboard focus and panel scrolling intact.
+      editor.focus({ focusContainer: false });
+    }}
+    onPasteCapture={event => {
+      // Diagram insertion uses the application's ASCII/source-aware paste command.
+      if (!(event.target as Element).closest('input,textarea,[contenteditable=true]')) event.stopPropagation();
+    }}
+    onDropCapture={event => {
+      if (!(event.target as Element).closest('input,textarea,[contenteditable=true]')) { event.preventDefault(); event.stopPropagation(); }
+    }}
+    onKeyDownCapture={event => {
+      const target = event.target as HTMLElement;
+      if (target.closest('input,textarea,select,[contenteditable=true]')) return;
+      // Let application Escape handling remove one selection instead of the SDK clearing every shape.
+      if (event.key === 'Escape' && editor?.getPath().endsWith('.idle')
+        && props.session.controller.getSnapshot().canvas.selection.items.length) {
+        editor.markEventAsHandled(event.nativeEvent);
+      }
+      if ((event.ctrlKey || event.metaKey) && ['z', 'y'].includes(event.key.toLowerCase())) return;
+      // Keep semantic delete cleanup and workspace transfer undo in application commands.
+      if (event.key === 'Delete' || event.key === 'Backspace') {
+        const nodeIds = props.session.controller.getSnapshot().canvas.selection.items.filter(item => !item.region).map(item => item.displayNodeId);
+        if (nodeIds.length) {
+          event.preventDefault(); event.stopPropagation();
+          props.session.controller.applyUpdate(props.session.controller.getSnapshot().version, [{ method: 'delete-diagrams', nodeIds }]);
+        }
+      }
+    }}>
+    <CanvasRuntimeContext.Provider value={canvasRuntime}><ContentContext.Provider value={props.children}>
+      <Tldraw colorScheme={theme} licenseKey={import.meta.env.VITE_TLDRAW_LICENSE_KEY} shapeUtils={shapeUtils} tools={mappingTools} components={components} hideUi onMount={setEditor} overrides={{ tools: (_editor, tools) => ({ select: tools.select, hand: tools.hand }), actions: () => ({}) }}
+        options={{ maxShapesPerPage: 10000, createTextOnCanvasDoubleClick: false }} autoFocus={false} />
+    </ContentContext.Provider></CanvasRuntimeContext.Provider>
+    <ConnectionFocus runtime={canvasRuntime} editor={editor} enabled={props.enabled} root={root} />
+    <div className="diagram-canvas__controls" data-diagram-canvas-static-ui>
+      <button type="button" aria-pressed={tool === 'select'} onClick={() => { canvasRuntime.gestures.cancel?.(); editor?.setCurrentTool('select'); setTool('select'); }}>Select</button>
+      <button type="button" aria-pressed={tool === 'hand'} onClick={() => { canvasRuntime.gestures.cancel?.(); editor?.setCurrentTool('hand'); setTool('hand'); }}>Pan</button>
+      <button type="button" disabled={!props.enabled || !canUndo} title="Undo (Ctrl+Z)" aria-keyshortcuts="Control+Z"
+        onClick={() => { canvasRuntime.gestures.cancel?.(); canvasRuntime.actions?.undo(); }}>Undo</button>
+      <button type="button" disabled={!props.enabled || !canEscape} title="Cancel or deselect (Esc)" aria-keyshortcuts="Escape"
+        onClick={() => canvasRuntime.actions?.escape()}>Esc</button>
+      <button type="button" title="Reset zoom and center diagram" onClick={() => { const bounds = editor?.getCurrentPageBounds(); if (bounds) editor?.zoomToBounds(bounds.clone().expandBy(100), { animation: { duration: 150 } }); }}>Fit canvas</button>
+    </div>
+  </div>;
+}
diff --git a/src/features/mapping/tldraw/MappingEditorRuntime.ts b/src/features/mapping/tldraw/MappingEditorRuntime.ts
new file mode 100644
index 00000000..c7fc7c54
--- /dev/null
+++ b/src/features/mapping/tldraw/MappingEditorRuntime.ts
@@ -0,0 +1,207 @@
+import { NativeSelectionOwnership } from '../../../../domain/mapping/selection/selectionGesture';
+import { type Editor, type TLShapePartial } from 'tldraw';
+import { flattenGrid, resolveScene } from '../../../../domain/core/diagrams/lineGrid';
+import { selectedDiagramIds } from '../../../../domain/mapping/selection/selectionState';
+import { updateDisplayGeometry } from '../../../../domain/mapping/workspace/displayModel';
+import type { MappingDocumentController, DiagramOperation } from '../../../../domain/mapping/workspace/mappingDocumentController';
+import { DEFAULT_CELL, mappingShapeId, projectMappingShapes } from './shapeProjection';
+import type { MappingShape } from './MappingShapeUtil';
+
+/** The Editor owns live geometry and undo. The domain controller supplies semantic
+ * commands and an immutable checkpoint archive for persistence/headless proposals.
+ * No controller writes occur on camera or pointer-move frames. */
+export class MappingEditorRuntime {
+  private disposed = false;
+  private syncing = false;
+  private settling = false;
+  private navigating = false;
+  private dirty = false;
+  private pendingProjection = false;
+  private checkpoint = '';
+  private unsubscribes: (() => void)[] = [];
+  private projected = new Map<string, TLShapePartial<MappingShape>>();
+  constructor(readonly editor: Editor, readonly controller: MappingDocumentController, readonly selectionOwnership = new NativeSelectionOwnership()) {
+    this.hydrate();
+    this.unsubscribes.push(controller.attachEditorDriver({ settle: () => { if (!this.settling) { this.editor.complete(); this.settle(true, false); } }, undo: redo => this.undo(redo) }));
+    let previous = controller.getSnapshot();
+    this.unsubscribes.push(controller.subscribe(() => {
+      const next = controller.getSnapshot();
+      if (next.canvas.selection !== previous.canvas.selection && !this.settling && !this.navigating)
+        this.selectionOwnership.claim('application');
+      const relevant = next.canvasRevisionId !== previous.canvasRevisionId || next.document !== previous.document
+        || next.canvas.display !== previous.canvas.display || next.canvas.diagramViews !== previous.canvas.diagramViews
+        || next.canvas.selection !== previous.canvas.selection || next.cell !== previous.cell;
+      previous = next;
+      if (relevant) this.publish();
+    }));
+    // This synchronous observer distinguishes history navigation from an ordinary
+    // shape edit before another API request can observe the old checkpoint.
+    this.unsubscribes.push(editor.sideEffects.registerAfterChangeHandler('document', (_before, after) => {
+      const id = after.meta.mappingCheckpoint;
+      if (this.syncing || typeof id !== 'string' || id === controller.getSnapshot().canvasRevisionId) return;
+      this.navigating = true;
+      try { controller.restoreEditorCheckpoint(id); this.checkpoint = id; this.publish(false); }
+      finally { this.navigating = false; }
+    }));
+    this.unsubscribes.push(editor.store.listen(({ changes }) => {
+      if (this.syncing) return;
+      if (Object.values(changes.added).some(record => record.typeName === 'shape')
+        || Object.values(changes.removed).some(record => record.typeName === 'shape')
+        || Object.values(changes.updated).some(([before, after]) => after.typeName === 'shape'
+          || after.typeName === 'instance_page_state' && before.typeName === 'instance_page_state'
+            && after.selectedShapeIds.join() !== before.selectedShapeIds.join())) this.dirty = true;
+    }, { scope: 'all' }));
+    const tick = () => {
+      if (editor.inputs.getIsPointing() || editor.inputs.getIsDragging() || editor.inputs.getIsPinching()) return;
+      // Finish native geometry first, but never overwrite a pending domain selection.
+      if (this.dirty) this.settle(false, !this.pendingProjection && this.selectionOwnership.captureSelection);
+      if (this.pendingProjection) this.publish();
+    };
+    editor.on('tick', tick);
+    this.unsubscribes.push(() => { editor.off('tick', tick); });
+  }
+  private setCheckpoint(id: string) {
+    const document = this.editor.getDocumentSettings();
+    // updateDocumentSettings intentionally ignores history in the SDK. This
+    // application checkpoint is document data and must share the shape diff.
+    this.editor.store.put([{ ...document, meta: { ...document.meta, mappingCheckpoint: id } }]);
+  }
+  /** Replay only checkpoint references. Old shape geometry is materialized lazily
+   * on navigation, so startup does not reparse every historical ASCII document. */
+  private hydrate() {
+    this.syncing = true;
+    try {
+      const record = this.controller.editorHistory();
+      const sequence = [...record.past, record.headId, ...[...record.future].reverse()];
+      this.editor.run(() => this.setCheckpoint(sequence[0]), { history: 'ignore' });
+      this.editor.clearHistory();
+      for (const id of sequence.slice(1)) {
+        this.editor.markHistoryStoppingPoint('mapping checkpoint');
+        this.setCheckpoint(id);
+      }
+      for (let i = 0; i < record.future.length; i++) this.editor.undo();
+      this.checkpoint = record.headId;
+      this.writeShapes(false);
+    } finally { this.syncing = false; }
+  }
+  private writeShapes(record: boolean) {
+    const shapes = projectMappingShapes(this.controller.getSnapshot()).map(shape => ({ ...shape, parentId: shape.parentId ?? this.editor.getCurrentPageId() }));
+    const ids = new Set(shapes.map(shape => shape.id));
+    this.editor.run(() => {
+      const removed = this.editor.getCurrentPageShapes().filter(shape => shape.type === 'mapping-box' && !ids.has(shape.id));
+      this.editor.deleteShapes(removed.map(shape => shape.id));
+      const create: TLShapePartial<MappingShape>[] = [], update: TLShapePartial<MappingShape>[] = [];
+      for (const shape of shapes) {
+        const current = this.editor.getShape<MappingShape>(shape.id);
+        if (!current) create.push(shape);
+        else if (current.parentId !== (shape.parentId ?? this.editor.getCurrentPageId()) || current.x !== shape.x || current.y !== shape.y || current.isLocked !== shape.isLocked
+          || JSON.stringify(current.props) !== JSON.stringify(shape.props)) update.push(shape);
+      }
+      if (create.length) this.editor.createShapes(create);
+      if (update.length) this.editor.updateShapes(update);
+      // Edges stay above diagram shapes, including after creation and history replay.
+      const edgeIds = shapes.filter(shape => shape.props?.kind === 'arrow').map(shape => shape.id);
+      this.editor.run(() => this.editor.bringToFront([...edgeIds, ...this.editor.getCurrentPageShapes().filter(shape => shape.type === 'mapping-box' && (shape as MappingShape).props.kind === 'diagram-side-panel').map(shape => shape.id)]), { ignoreShapeLock: true });
+      this.projected = new Map(shapes.map(shape => [shape.props!.nodeId!, shape]));
+      const selected = this.selectedShapeIds();
+      const native = this.editor.getSelectedShapeIds();
+      if (native.length !== selected.length || selected.some(id => !native.includes(id))) this.editor.setSelectedShapes(selected);
+    }, { history: record ? 'record' : 'ignore' });
+  }
+  private selectedShapeIds() {
+    this.selectionOwnership.dragDiagramIds = this.selectionOwnership.dragDiagramIds.filter(id => this.editor.getShape(mappingShapeId(id)));
+    return [...new Set([...selectedDiagramIds(this.controller.getSnapshot().canvas.selection), ...this.selectionOwnership.dragDiagramIds])]
+      .map(mappingShapeId).filter(id => this.editor.getShape(id));
+  }
+  private publish(record = true) {
+    if (this.syncing || this.disposed) return;
+    this.syncing = true;
+    try {
+      const id = this.controller.getSnapshot().canvasRevisionId;
+      const changed = id !== this.checkpoint;
+      if (!changed && this.editor.inputs.getIsPointing()) { this.pendingProjection = true; return; }
+      this.pendingProjection = false;
+      if (changed && record && !this.settling && !this.navigating) this.editor.markHistoryStoppingPoint('mapping command');
+      this.editor.run(() => {
+        this.writeShapes(changed && record && !this.navigating);
+        this.setCheckpoint(id);
+      }, { history: changed && record && !this.navigating ? 'record' : 'ignore' });
+      this.checkpoint = id;
+    } finally { this.syncing = false; }
+  }
+  settle(force = false, captureSelection = this.selectionOwnership.captureSelection) {
+    if (this.syncing || this.settling || this.navigating || this.disposed) return;
+    if (!force && this.editor.inputs.getIsPointing()) return;
+    this.dirty = false;
+    this.settling = true;
+    try {
+      let selected = this.editor.getSelectedShapes().filter(shape => shape.type === 'mapping-box' && shape.props.kind === 'diagram')
+        .map(shape => (shape as MappingShape).props.nodeId);
+      const snapshot = this.controller.getSnapshot();
+      const cell = snapshot.cell?.width ? snapshot.cell : DEFAULT_CELL;
+      const boxes = flattenGrid(resolveScene(snapshot.document.scene));
+      const nativeShapes = this.editor.getCurrentPageShapes();
+      const clones = nativeShapes.filter(shape => shape.type === 'mapping-box' && shape.id !== mappingShapeId(shape.props.nodeId));
+      const unsupportedClone = clones.some(shape => shape.type === 'mapping-box' && (shape.props.kind !== 'diagram'
+        || !boxes.some(box => box.children.some(child => `grid:${child.box.id}` === shape.props.nodeId))));
+      if (unsupportedClone) { this.editor.deleteShapes(clones.map(shape => shape.id)); selected = []; }
+      const moves: DiagramOperation[] = [];
+      let display = snapshot.canvas.display;
+      for (const shape of this.editor.getCurrentPageShapes()) {
+        if (shape.type !== 'mapping-box') continue;
+        const previous = this.projected.get(shape.props.nodeId);
+        if (!previous) continue;
+        if (shape.id !== mappingShapeId(shape.props.nodeId)) {
+          if (shape.props.kind === 'diagram') {
+            const id = `copy-${crypto.randomUUID()}`, point = this.editor.getShapePageBounds(shape)!;
+            moves.push({ method: 'duplicate-instance', sourceNodeId: shape.props.nodeId, id,
+              position: { column: Math.max(0, Math.round(point.x / cell.width)), row: Math.max(0, Math.round(point.y / cell.height)) } });
+            if (this.editor.getSelectedShapeIds().includes(shape.id)) selected = selected.map(nodeId => nodeId === shape.props.nodeId ? `grid:${id}` : nodeId);
+          } else {
+            // Pane and group copies need semantic ownership remapping. Until such
+            // a command exists, cancel these temporary native clones.
+            this.editor.deleteShapes([shape.id]);
+          }
+          continue;
+        }
+        if (shape.props.nodeId.startsWith('grid:')) {
+          if (shape.x === previous.x && shape.y === previous.y) continue;
+          const id = shape.props.nodeId.slice(5), parent = boxes.find(box => box.children.some(child => child.box.id === id));
+          if (!parent && shape.props.kind !== 'diagram') continue;
+          const point = this.editor.getShapePageBounds(shape)!;
+          moves.push({ method: 'move', nodeId: shape.props.nodeId, position: {
+            column: Math.max(0, Math.round(point.x / cell.width)),
+            row: Math.max(0, Math.round(point.y / cell.height)) } });
+        } else {
+          const node = display.nodes[shape.props.nodeId.slice(9)];
+          if (!node) continue;
+          if (shape.x === previous.x && shape.y === previous.y && shape.props.w === previous.props?.w && shape.props.h === previous.props?.h) continue;
+          display = updateDisplayGeometry(display, node.id, { position: { x: shape.x, y: shape.y }, bounds: { width: shape.props.w, height: shape.props.h } });
+          display = { ...display, nodes: { ...display.nodes, [node.id]: { ...display.nodes[node.id],
+            geometryPolicy: { placement: 'manual', sizing: shape.props.w !== previous.props?.w || shape.props.h !== previous.props?.h ? 'fixed' : node.geometryPolicy.sizing },
+            ...(node.kind === 'conversation' && node.expansion === 'collapsed' ? { canvasAnchor: { x: shape.x, y: shape.y } } : {}) } } };
+        }
+      }
+      const canvas = display === snapshot.canvas.display ? snapshot.canvas : { ...snapshot.canvas, display };
+      // Native selection only enables dragging. Content membership changes through
+      // explicit application gestures (node selection, marquee, whole-diagram double-click).
+      if (captureSelection) this.selectionOwnership.dragDiagramIds = selected.filter(id => !selectedDiagramIds(canvas.selection).includes(id));
+      if (moves.length || canvas !== snapshot.canvas) this.controller.commitEditorGesture(moves, canvas);
+      if (!captureSelection) {
+        const ids = this.selectedShapeIds();
+        this.editor.run(() => this.editor.setSelectedShapes(ids), { history: 'ignore' });
+      }
+    } finally { this.settling = false; }
+  }
+  undo(redo = false) {
+    this.editor.complete(); this.settle();
+    const history = this.controller.editorHistory();
+    if ((redo ? history.redoTransactionId : history.undoTransactionId))
+      throw new Error('Use workspace undo/redo for a canvas transfer.');
+    if (redo) this.editor.redo(); else this.editor.undo();
+  }
+  dispose() {
+    this.editor.complete(); this.settle(); this.disposed = true;
+    this.unsubscribes.splice(0).reverse().forEach(dispose => dispose());
+  }
+}
diff --git a/src/features/mapping/tldraw/NativeRoutingStore.ts b/src/features/mapping/tldraw/NativeRoutingStore.ts
new file mode 100644
index 00000000..72953342
--- /dev/null
+++ b/src/features/mapping/tldraw/NativeRoutingStore.ts
@@ -0,0 +1,75 @@
+import { atom, computed, type Computed, type Editor } from 'tldraw';
+import { diagramRoutingObstacles, connectionObstacles, type RoutingObstacle } from '../../../../domain/mapping/workspace/routingObstacles';
+import type { EndpointIdentity, EndpointRect } from '../../../../domain/mapping/workspace/endpointGeometry';
+import { overlapsRoute } from '../../../../domain/mapping/workspace/edgeRouting';
+import { drawResolvedEdge, spaceEdgeArrows, type FloatingBoxArrow } from '../../../../domain/mapping/workspace/connectionLayout';
+import type { DiagramConnection } from '../../../../domain/core/diagrams/diagramConnection';
+import type { Diagram } from '../../../../domain/core/diagrams/diagram';
+import type { DiagramViewState } from '../../../../domain/mapping/workspace/diagramViewState';
+import { mappingShapeId } from './shapeProjection';
+
+interface Owner { id: string; layoutKey: string; world: Computed<RoutingObstacle[]> }
+interface CachedRoute { key: string; region?: EndpointRect; obstacles: string; result: FloatingBoxArrow }
+interface RoutingDiagram { layoutKey: string; diagram?: Diagram; view?: DiagramViewState; cell: { width: number; height: number } }
+
+/** Transient routing geometry. No DOM reads or document writes; camera changes are not dependencies. */
+export class NativeRoutingStore {
+  private readonly owners = atom<Owner[]>('routing obstacle owners', []);
+  private laneCache?: { key: string; arrows: Map<string, FloatingBoxArrow> };
+  private readonly routes = new Map<string, CachedRoute>();
+  readonly obstacles = computed('canvas routing obstacles', () => this.owners.get().flatMap(owner => owner.world.get()));
+  constructor(private readonly editor: () => Editor | undefined) {}
+
+  sync(grids: ReadonlyMap<string, RoutingDiagram>, edges: readonly DiagramConnection[]) {
+    const prior = this.owners.get(), byId = new Map(prior.map(owner => [owner.id, owner]));
+    const owners: Owner[] = [];
+    for (const [id, model] of grids) {
+      if (!model.diagram) continue;
+      const old = byId.get(id);
+      if (old?.layoutKey === model.layoutKey) { owners.push(old); continue; }
+      const local = diagramRoutingObstacles(id, model.diagram.content, model.view, model.cell);
+      owners.push({ id, layoutKey: model.layoutKey, world: computed(`routing obstacles ${id}`, () => {
+        const editor = this.editor(), shapeId = mappingShapeId(id);
+        if (!editor?.getShape(shapeId)) return [];
+        const transform = editor.getShapePageTransform(shapeId);
+        return local.map(rect => {
+          const corners = transform.applyToPoints([{ x: rect.x, y: rect.y }, { x: rect.x + rect.width, y: rect.y },
+            { x: rect.x, y: rect.y + rect.height }, { x: rect.x + rect.width, y: rect.y + rect.height }]);
+          const xs = corners.map(p => p.x), ys = corners.map(p => p.y);
+          return { ...rect, x: Math.min(...xs), y: Math.min(...ys), width: Math.max(...xs) - Math.min(...xs), height: Math.max(...ys) - Math.min(...ys) };
+        });
+      }) });
+    }
+    if (owners.length !== prior.length || owners.some((owner, index) => owner !== prior[index])) this.owners.set(owners);
+    const live = new Set(edges.map(edge => edge.id));
+    for (const id of this.routes.keys()) if (!live.has(id)) this.routes.delete(id);
+  }
+
+  drawAll(inputs: readonly Readonly<Parameters<NativeRoutingStore['draw']>>[]) {
+    const obstacles = this.obstacles.get();
+    const entries = inputs.map(input => ({ arrow: this.draw(...input),
+      obstacles: [...connectionObstacles(obstacles, input[3], input[4]), ...[input[1], input[2]].filter(rect => !!rect)] }));
+    const key = JSON.stringify([entries.map(entry => entry.arrow), inputs.map(input => input.slice(1, 5)), obstacles]);
+    if (this.laneCache?.key === key) return this.laneCache.arrows;
+    const arrows = new Map(spaceEdgeArrows(entries).map(arrow => {
+      const previous = this.laneCache?.arrows.get(arrow.edgeId);
+      return [arrow.edgeId, previous && JSON.stringify(previous) === JSON.stringify(arrow) ? previous : arrow];
+    }));
+    this.laneCache = { key, arrows };
+    return arrows;
+  }
+
+  draw(edge: DiagramConnection, source: Parameters<typeof drawResolvedEdge>[1], target: Parameters<typeof drawResolvedEdge>[2],
+    sourceIdentity: EndpointIdentity | undefined, targetIdentity: EndpointIdentity | undefined, geometrySource: FloatingBoxArrow['geometrySource']) {
+    const obstacles = connectionObstacles(this.obstacles.get(), sourceIdentity, targetIdentity);
+    const key = JSON.stringify([edge, source, target, geometrySource]), previous = this.routes.get(edge.id);
+    const nearby = (region?: EndpointRect) => JSON.stringify((region ? obstacles.filter(rect => overlapsRoute(rect, region)) : obstacles)
+      .map(rect => [rect.x, rect.y, rect.width, rect.height, rect.kind]));
+    // A moved obstacle outside the existing route's bounding rectangle cannot intersect that route.
+    if (previous?.key === key && previous.obstacles === nearby(previous.region)) return previous.result;
+    const result = drawResolvedEdge(edge, source, target, geometrySource, undefined, obstacles);
+    const region = result.path ? { x: result.position.x, y: result.position.y, ...result.bounds } : undefined;
+    this.routes.set(edge.id, { key, region, obstacles: nearby(region), result });
+    return result;
+  }
+}
diff --git a/src/features/mapping/tldraw/SelectionTools.ts b/src/features/mapping/tldraw/SelectionTools.ts
new file mode 100644
index 00000000..25b117e1
--- /dev/null
+++ b/src/features/mapping/tldraw/SelectionTools.ts
@@ -0,0 +1,49 @@
+import { HandTool, SelectTool, type Editor, type StateNode } from 'tldraw';
+import { NativeSelectionOwnership } from '../../../../domain/mapping/selection/selectionGesture';
+import { mappingShapeId } from './shapeProjection';
+
+export class SelectionToolBridge {
+  readonly ownership = new NativeSelectionOwnership();
+  suppress = false;
+  pointerType = 'mouse';
+  moveDiagram?: string;
+  cancel?: () => void;
+  escape?: () => boolean;
+}
+export const selectionTools = new WeakMap<Editor, SelectionToolBridge>();
+type ToolEvent = Parameters<StateNode['handleEvent']>[0];
+function claimed(editor: Editor, info: ToolEvent) {
+  const bridge = selectionTools.get(editor);
+  if (!bridge) return false;
+  // These delayed phases also arrive after pointer-up. Never let HandTool's
+  // double-tap zoom or one-finger zoom reinterpret an application touch sequence.
+  if (info.name === 'double_click')
+    return bridge.pointerType !== 'mouse' || bridge.suppress;
+  if (info.name === 'interrupt' || info.name === 'cancel') bridge.cancel?.();
+  return bridge.suppress && info.type === 'pointer';
+}
+export class MappingSelectTool extends SelectTool {
+  override onExit() { selectionTools.get(this.editor)?.cancel?.(); super.onExit(); }
+  override handleEvent(info: ToolEvent) {
+    if (claimed(this.editor, info)) return;
+    const bridge = selectionTools.get(this.editor);
+    if (info.name === 'pointer_down' && bridge?.moveDiagram) {
+      const shape = this.editor.getShape(mappingShapeId(bridge.moveDiagram));
+      if (shape) {
+        // Native translation handles geometry/history. Application membership is
+        // deliberately retained even if a selected region isn't a native shape.
+        this.editor.setSelectedShapes([shape.id]);
+        this.transition('pointing_shape', { ...info, target: 'shape', shape });
+        return;
+      }
+    }
+    super.handleEvent(info);
+  }
+}
+export class MappingHandTool extends HandTool {
+  override onExit() { selectionTools.get(this.editor)?.cancel?.(); }
+  override handleEvent(info: ToolEvent) {
+    if (!claimed(this.editor, info)) super.handleEvent(info);
+  }
+}
+export const mappingTools = [MappingSelectTool, MappingHandTool];
diff --git a/src/features/mapping/tldraw/shapeProjection.ts b/src/features/mapping/tldraw/shapeProjection.ts
new file mode 100644
index 00000000..49ceafb4
--- /dev/null
+++ b/src/features/mapping/tldraw/shapeProjection.ts
@@ -0,0 +1,54 @@
+import { projectSidePanels } from '../../../../domain/mapping/workspace/diagramSidePanelLayout';
+import { createShapeId, type TLShapePartial } from 'tldraw';
+import { flattenGrid } from '../../../../domain/core/diagrams/lineGrid';
+import { presentationScene, resolveDiagramView } from '../../../../domain/mapping/workspace/diagramViewState';
+import { visibleProjectionIds } from '../../../../domain/mapping/workspace/displayModel';
+import type { ControllerSnapshot } from '../../../../domain/mapping/workspace/mappingDocumentController';
+import type { MappingShape } from './MappingShapeUtil';
+
+export const mappingShapeId = (nodeId: string) => createShapeId(`mapping:${nodeId}`);
+export const DEFAULT_CELL = { width: 8.4, height: 18 };
+/** Import/command projection. Pointer movement never runs the legacy layout renderer. */
+export function projectMappingShapes(snapshot: ControllerSnapshot): TLShapePartial<MappingShape>[] {
+  const { document, canvas } = snapshot;
+  const cell = snapshot.cell?.width ? snapshot.cell : DEFAULT_CELL;
+  const boxes = flattenGrid(resolveDiagramView(presentationScene(document), canvas.diagramViews));
+  const shapes: TLShapePartial<MappingShape>[] = boxes.map(box => {
+    const parent = boxes.find(parent => parent.box.id !== document.scene.root.id && parent.children.some(child => child.box.id === box.box.id));
+    return ({
+    id: mappingShapeId(`grid:${box.box.id}`), type: 'mapping-box',
+    x: (box.bounds.column - (parent?.bounds.column ?? 0)) * cell.width, y: (box.bounds.row - (parent?.bounds.row ?? 0)) * cell.height,
+    ...(parent ? { parentId: mappingShapeId(`grid:${parent.box.id}`) } : {}),
+    isLocked: box.box.kind === 'container' && box.box.id === document.scene.root.id,
+    props: { nodeId: `grid:${box.box.id}`, kind: box.box.kind, revisionId: box.contentId ? document.scene.contents[box.contentId].revisionId : '',
+      w: Math.max(1, box.bounds.columns * cell.width), h: Math.max(1, box.bounds.rows * cell.height) },
+  }); });
+  const visible = new Set<string>();
+  for (const node of Object.values(canvas.display.nodes)) {
+    if (node.kind === 'detail' || node.kind === 'conversation') visible.add(node.id);
+    if (node.kind === 'selection') {
+      const source = boxes.find(box => box.box.id === node.sourceBoxId);
+      if (source?.box.collapsed) continue;
+      if (node.childIds.length || canvas.selection.items.some(item => item.id === node.id)) visible.add(node.id);
+      visibleProjectionIds(canvas.display, node.id, node.displayMode).forEach(id => visible.add(id));
+    }
+  }
+  for (const node of Object.values(canvas.display.nodes)) {
+    if (!visible.has(node.id) || node.coordinateSpace === 'viewport' && node.kind !== 'conversation') continue;
+    if (node.kind === 'projection' && (node.content.kind === 'code-panel' || node.content.kind === 'source-code')) continue;
+    const bubble = node.kind === 'conversation' && (node.expansion === 'collapsed' || node.presentation === 'docked');
+    shapes.push({ id: mappingShapeId(`floating:${node.id}`), type: 'mapping-box', isLocked: node.kind === 'selection', x: bubble ? node.canvasAnchor.x : node.position.x,
+      y: bubble ? node.canvasAnchor.y : node.position.y,
+      props: { nodeId: `floating:${node.id}`, kind: node.kind, revisionId: '',
+        w: bubble ? 36 : Math.max(1, node.bounds.width), h: bubble ? 36 : Math.max(1, node.bounds.height) } });
+  }
+  for (const edge of document.edges) shapes.push({ id: mappingShapeId(`floating:edge:${edge.id}`), type: 'mapping-box', x: 0, y: 0, isLocked: true,
+    props: { nodeId: `floating:edge:${edge.id}`, kind: 'arrow', revisionId: '', w: 1, h: 1 } });
+  for (const panel of projectSidePanels(document, resolveDiagramView(presentationScene(document), canvas.diagramViews), canvas.diagramViews)) {
+    shapes.push({ id: mappingShapeId(panel.panel.id), type: 'mapping-box', isLocked: true,
+      x: panel.bounds.column * cell.width, y: panel.bounds.row * cell.height,
+      props: { nodeId: panel.panel.id, kind: 'diagram-side-panel', revisionId: document.alternatives!.items[panel.panel.alternativeId].parts[panel.panel.partIndex].source.revisionId,
+        w: panel.bounds.columns * cell.width, h: panel.bounds.rows * cell.height } });
+  }
+  return shapes;
+}
diff --git a/src/features/mapping/treemap/CanvasTreemapContent.tsx b/src/features/mapping/treemap/CanvasTreemapContent.tsx
