{"path": "projection-3d/index.html", "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"theme-color\" content=\"#0f1115\" />\n  <link rel=\"icon\" href=\"data:,\" />\n  <title>VS Code · 3D projections</title>\n</head>\n<body>\n  <div class=\"shell\">\n    <header class=\"studio-header\">\n      <div class=\"brand\"><span class=\"brand-mark\">3D</span><div><h1>DIAGRAM PROJECTIONS</h1><p>vscode / shared elements</p></div></div>\n      <a class=\"header-badge\" href=\"./boxes.html\">INK &amp; PAPER · NODE BOXES ↗</a>\n    </header>\n    <main>\n      <aside aria-label=\"Projection controls\">\n        <section class=\"saved-controls\">\n          <div class=\"section-heading\"><h2>VISUALIZATIONS</h2><span>Saved views</span></div>\n          <label for=\"saved-views\">Saved visualization</label>\n          <div class=\"saved-row\"><select id=\"saved-views\"></select><button id=\"load-visualization\">Load</button></div>\n          <label for=\"visualization-name\">Save current view as</label>\n          <input id=\"visualization-name\" value=\"Upright — original\" maxlength=\"100\" />\n          <div class=\"saved-actions\"><button id=\"save-visualization\">Save copy</button><button id=\"export-visualization\">Export JSON</button><button id=\"import-visualization\">Import JSON</button></div>\n          <input id=\"visualization-file\" type=\"file\" accept=\".json,application/json\" hidden />\n          <p id=\"save-status\" role=\"status\">Save copies here or export a file to share.</p>\n        </section>\n        <section>\n          <div class=\"section-heading\"><h2>DIAGRAMS</h2><span>2 layers</span></div>\n          <button class=\"layer-card\" data-view=\"D2\"><span class=\"layer-id\">D2 <small id=\"layer-d2\">Z = 0</small></span><strong>Document opening,<br />sharing, and saving</strong><span class=\"card-action\">Read diagram <span aria-hidden=\"true\">↗</span></span></button>\n          <button class=\"layer-card\" data-view=\"D5\"><span class=\"layer-id purple\">D5 <small id=\"layer-z\">Z = 1000</small></span><strong>Source Control and Git</strong><span class=\"card-action\">Read diagram <span aria-hidden=\"true\">↗</span></span></button>\n        </section>\n        <section>\n          <div class=\"section-heading\"><h2>CORRESPONDENCES</h2><span id=\"edge-count\">6 edges</span></div>\n          <p class=\"section-help\">Hover to trace. Click a name to pin.</p>\n          <div id=\"correspondences\"></div>\n          <button id=\"clear-selection\" class=\"text-button\" disabled>Clear selection</button>\n        </section>\n        <section class=\"controls\">\n          <div class=\"section-heading\"><h2>DISPLAY</h2><button id=\"reset\" class=\"text-button\">Reset</button></div>\n          <label for=\"orientation\">Plane orientation</label>\n          <select id=\"orientation\"><option value=\"upright\">Upright</option><option value=\"flat\">Flat · D2 above D5</option></select>\n          <label for=\"separation\">Layer separation <output id=\"separation-value\">1000</output></label>\n          <input id=\"separation\" type=\"range\" min=\"100\" max=\"2000\" step=\"25\" value=\"1000\" />\n          <label for=\"opacity\">Plane opacity <output id=\"opacity-value\">90%</output></label>\n          <input id=\"opacity\" type=\"range\" min=\"10\" max=\"100\" value=\"90\" />\n          <label for=\"azimuth\">Orbit <output id=\"azimuth-value\">35°</output></label>\n          <input id=\"azimuth\" type=\"range\" min=\"-75\" max=\"75\" value=\"35\" />\n          <label for=\"tilt\">Tilt <output id=\"tilt-value\">35°</output></label>\n          <input id=\"tilt\" type=\"range\" min=\"-70\" max=\"70\" value=\"35\" />\n        </section>\n        <section class=\"selection-details\" aria-live=\"polite\"><h2 id=\"detail-title\">SHARED DOCUMENT MODEL</h2><p id=\"detail-body\">TextModel connects to both the original and modified document in D5.</p></section>\n      </aside>\n      <div class=\"workspace\">\n        <div class=\"toolbar\">\n          <div class=\"view-tabs\" aria-label=\"View\"><button data-view=\"all\" aria-pressed=\"true\">Oblique</button><button data-view=\"D2\" aria-pressed=\"false\">D2</button><button data-view=\"D5\" aria-pressed=\"false\">D5</button></div>\n          <div class=\"zoom-tools\"><button id=\"zoom-out\" aria-label=\"Zoom out\">−</button><output id=\"zoom-value\" aria-label=\"Diagram zoom\">100%</output><button id=\"zoom-in\" aria-label=\"Zoom in\">+</button><button id=\"fit\">Fit</button></div>\n        </div>\n        <div id=\"viewport\" tabindex=\"0\" aria-label=\"3D diagram canvas. Drag to orbit. Shift drag to pan. Scroll to zoom. Arrow keys orbit; Shift and arrows pan; plus and minus zoom; F fits the view.\">\n          <svg id=\"scene\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"Two diagram planes and their correspondence edges\"><g id=\"planes\"></g><g id=\"edges\"></g><g id=\"endpoints\"></g></svg>\n          <div class=\"canvas-label\"><span class=\"live-dot\"></span><span id=\"view-label\">D2 ↔ D5</span><span class=\"muted\">/ original layouts</span></div>\n          <svg id=\"axes\" width=\"100\" height=\"100\" aria-label=\"World axes\"></svg>\n          <div class=\"canvas-help\">Drag to orbit <span>·</span> Shift drag to pan <span>·</span> Scroll to zoom</div>\n          <div id=\"error\" role=\"alert\" hidden></div>\n        </div>\n        <footer><span id=\"status\">5 shared components · 6 correspondences</span><span>Dashed edges pass behind a plane</span></footer>\n      </div>\n    </main>\n  </div>\n  <script type=\"module\" src=\"./main.js\"></script>\n</body>\n</html>\n"}