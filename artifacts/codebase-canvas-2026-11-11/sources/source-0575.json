{"path": "scripts/analysis/report-viewer.html", "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Architecture Observatory · Repository analysis</title>\n<style>\n:root{color-scheme:dark;--bg:#0b1118;--panel:#111c27;--line:#293644;--text:#e5edf4;--muted:#9cafc1;--cyan:#61dbc6;--amber:#f5bb70;--blue:#7db9ff;--violet:#b8a0fa}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.6 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}a{color:var(--blue);text-underline-offset:3px}button,input,select{font:inherit}button,select{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--cyan);outline-offset:4px}aside{position:fixed;inset:0 auto 0 0;width:226px;padding:32px 24px;border-right:1px solid var(--line);display:flex;flex-direction:column;background:#0e1720}.brand{font-size:13px;letter-spacing:.16em;text-transform:uppercase;font-weight:750}.brand b{display:block;color:var(--cyan);font-size:29px;letter-spacing:-.04em;margin-bottom:4px}nav{display:grid;gap:12px;margin:46px 0}nav a{color:var(--muted);text-decoration:none;padding:8px 0}nav a:hover{color:var(--cyan)}.side-note{margin-top:auto;color:var(--muted);font-size:12px}.mono,code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace}main{margin-left:226px;max-width:1500px;padding:48px 48px 70px}.eyebrow{color:var(--cyan);font-size:12px;letter-spacing:.15em;text-transform:uppercase;font-weight:700}h1{font-size:clamp(32px,4vw,51px);font-weight:650;letter-spacing:-.045em;line-height:1.1;margin:12px 0 18px}h2{font-size:25px;font-weight:620;letter-spacing:-.03em;margin:0}h3{font-size:16px;font-weight:600;margin:0}p{margin:10px 0}.muted,.help{color:var(--muted)}.intro{max-width:760px;font-size:17px}.notice{border:1px solid #665039;background:#251f19;border-radius:10px;padding:13px 18px;font-size:13px;color:#eac79e;margin:26px 0}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.card,.panel{border:1px solid var(--line);border-radius:12px;background:var(--panel)}.card{padding:20px}.number{font-size:32px;font-weight:620;letter-spacing:-.035em;line-height:1.3;font-variant-numeric:tabular-nums}.label{font-size:12px;color:var(--muted);margin-top:8px}.section{margin-top:44px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:8px}.section>p{max-width:880px;margin-bottom:22px}.panel{padding:24px}.views{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.view{padding:18px;min-width:0}.view h3{text-transform:capitalize}.badge{display:inline-block;font-size:11px;padding:2px 8px;border-radius:20px;border:1px solid #35625a;color:var(--cyan);margin:10px 0}.badge.partial{border-color:#735c40;color:var(--amber)}.view .number{font-size:25px}.bar{height:7px;background:#59412d;border-radius:9px;overflow:hidden;margin:16px 0 8px}.bar span{display:block;background:var(--cyan);height:100%}.tiny{font-size:12px;color:var(--muted)}.controls{display:flex;gap:8px;flex-wrap:wrap}button,select,input{border:1px solid #405364;border-radius:7px;background:#121f2b;color:var(--text);padding:8px 13px}button[aria-pressed=true]{color:#071b17;background:var(--cyan);border-color:var(--cyan)}button:hover{border-color:var(--cyan)}.metric-top{display:flex;gap:16px;justify-content:space-between;align-items:flex-start;flex-wrap:wrap}.meta{display:flex;gap:24px;flex-wrap:wrap;margin:24px 0}.meta strong{display:block;font-size:20px;color:var(--text)}.legend{display:flex;gap:20px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin:18px 0}.dot{display:inline-block;width:9px;height:9px;border-radius:2px;background:var(--cyan);margin-right:6px}.dot.baseline{background:var(--violet)}.cohesion-row{display:grid;grid-template-columns:90px 1fr 85px;gap:18px;align-items:center;padding:18px 0;border-top:1px solid var(--line)}.chart-track{position:relative;height:34px;border-left:1px solid #52677a;background:repeating-linear-gradient(to right,transparent 0,transparent calc(25% - 1px),#243443 calc(25% - 1px),#243443 25%)}.observed,.baseline-bar{position:absolute;left:0;height:10px;min-width:1px;border-radius:0 3px 3px 0}.observed{top:4px;background:var(--cyan)}.baseline-bar{top:20px;background:var(--violet)}.metric-value{text-align:right;font-variant-numeric:tabular-nums}.metric-value strong{font-size:20px}.axis{display:flex;justify-content:space-between;margin:0 103px 0 108px;font-size:11px;color:var(--muted)}.chart-note{border-top:1px solid var(--line);padding-top:16px;margin-top:20px;font-size:13px;color:var(--muted)}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:12px 8px;text-align:left;border-bottom:1px solid var(--line)}th{color:var(--muted);font-size:12px;font-weight:500}td:last-child,th:last-child{text-align:right}.toolbar{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0 12px}.toolbar input{flex:1;min-width:190px}.finding{border-top:1px solid var(--line);padding:18px 0}.finding summary{cursor:pointer;list-style:none;display:flex;gap:18px;align-items:flex-start}.finding summary::before{content:'+';color:var(--cyan);font-size:22px;line-height:1.2}.finding[open] summary::before{content:'−'}.finding-title{font-size:14px}.category{font-size:10px;text-transform:uppercase;letter-spacing:.09em;color:var(--cyan);margin-bottom:6px}.finding-body{padding:10px 0 4px 32px;font-size:13px}.finding-body code{display:block;color:var(--muted);font-size:11px;overflow-wrap:anywhere;margin-top:12px}.finding-body a{display:inline-block}.count-line{font-size:12px;color:var(--muted);margin-bottom:12px}.empty{padding:32px;text-align:center;color:var(--muted)}.full-report{margin-top:24px}.full-report>summary{cursor:pointer;font-size:16px}.report-body{margin-top:24px;overflow-wrap:anywhere}.report-body h1{font-size:29px}.report-body h2{margin-top:32px;font-size:21px}.report-body h3{margin-top:25px}.report-body ul{padding-left:22px}.report-body li{margin-bottom:14px}.report-body table{display:block;overflow:auto}.report-body code{font-size:12px}.footer{border-top:1px solid var(--line);padding-top:22px;margin-top:35px;color:var(--muted);font-size:12px}.foot-links{display:flex;gap:20px;flex-wrap:wrap}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}\n@media(min-width:1600px){main{margin-right:auto;margin-left:calc(226px + (100vw - 1600px)/2)}}@media(max-width:1150px){aside{width:180px;padding:24px 18px}main{margin-left:180px;padding:32px 26px}.views{grid-template-columns:repeat(3,1fr)}.stats{gap:10px}.card{padding:16px}.number{font-size:27px}}@media(max-width:760px){aside{position:static;width:auto;padding:16px 22px;border-right:0;border-bottom:1px solid var(--line)}.brand b{display:inline;font-size:19px;margin-right:12px}.brand{font-size:11px}nav{display:flex;gap:18px;margin:12px 0 0;overflow:auto;font-size:12px}nav a{white-space:nowrap}.side-note{display:none}main{margin:0;padding:28px 20px}.stats,.two-col{grid-template-columns:repeat(2,1fr)}.views{grid-template-columns:repeat(2,1fr)}.two-col{grid-template-columns:1fr}.section-head{align-items:flex-start;flex-direction:column}.cohesion-row{grid-template-columns:65px 1fr 65px;gap:10px}.metric-value strong{font-size:16px}.axis{margin-left:75px;margin-right:75px}.panel{padding:18px}.intro{font-size:15px}h2{font-size:23px}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}@media print{body{background:white;color:black}aside,.toolbar,.controls,.foot-links{display:none}main{margin:0;padding:0}.panel,.card{background:white;break-inside:avoid}details:not([open]){display:none}.muted,.tiny,.label,.help{color:#444}a{color:#176354}.notice{color:#704619;background:white}}\n</style>\n</head>\n<body>\n<aside><div class=\"brand\"><b>◈</b>Architecture<br>Observatory</div><nav aria-label=\"Report sections\"><a href=\"#overview\">01 · Overview</a><a href=\"#views\">02 · Five views</a><a href=\"#cohesion\">03 · Cohesion</a><a href=\"#findings\">04 · Boundary evidence</a><a href=\"#limits\">05 · Cycles & limits</a><a href=\"#source\">06 · Source report</a></nav><div class=\"side-note\">STATIC ANALYSIS<br>Possibilities, not execution.<br><br>Snapshot commit<br><span id=\"side-commit\" class=\"mono\"></span></div></aside>\n<main>\n<header id=\"overview\"><div class=\"eyebrow\">Repository intelligence / 4 + 1 model</div><h1>How the code holds together.</h1><p class=\"intro muted\">Explore containment, lexical scope, calls, ownership and data dependencies. See where boundaries agree—and where to investigate.</p><div class=\"notice\"><strong>Earlier snapshot.</strong> This viewer uses the existing generated report at commit <span id=\"commit\" class=\"mono\"></span>. It predates the latest analyzer fixes. Source links point to working files; line positions may have changed. The report’s dirty-input count is not reliable for this older run.</div></header>\n<div id=\"stats\" class=\"stats\"></div>\n<section id=\"views\" class=\"section\"><div class=\"section-head\"><h2>Five lenses. One source snapshot.</h2><span class=\"tiny\">Shared identities · distinct relations</span></div><p class=\"muted\">Each bar shows resolved versus unresolved extraction sites. “Complete” is the extractor’s reported status, not proof that every dependency was found.</p><div id=\"view-cards\" class=\"views\"></div></section>\n<section id=\"cohesion\" class=\"section\"><div class=\"section-head\"><h2>Do dependencies stay together?</h2><span class=\"tiny\">Observed cohesion vs shuffled labels</span></div><p class=\"muted\">Compare groupings on the same entity universe. A single group scores 100% cohesion, but gains nothing over its baseline.</p><div class=\"panel\"><div class=\"metric-top\"><div><h3 id=\"partition-title\"></h3><div class=\"tiny\" id=\"partition-description\"></div></div><div class=\"controls\" role=\"group\" aria-label=\"Partition\"><button data-partition=\"directory\" aria-pressed=\"true\">Directories</button><button data-partition=\"layer\" aria-pressed=\"false\">Layers</button><button data-partition=\"custom\" aria-pressed=\"false\">One group</button></div></div><div id=\"partition-meta\" class=\"meta\"></div><div class=\"legend\"><span><i class=\"dot\"></i>Observed</span><span><i class=\"dot baseline\"></i>Shuffled mean</span><span>Right column: excess in percentage points</span></div><div id=\"cohesion-chart\" aria-live=\"polite\"></div><div class=\"axis\"><span>0%</span><span>25%</span><span>50%</span><span>75%</span><span>100%</span></div><div class=\"chart-note\">Cohesion = internal / (internal + between) edges. VI is variation of information in bits; lower means closer agreement with directory containment. Data, state and reactive edge layers overlap and must not be summed. High static cohesion does not establish runtime near-decomposability.</div></div></section>\n<section id=\"findings\" class=\"section\"><div class=\"section-head\"><h2>Investigate the boundaries.</h2><span class=\"tiny\">Evidence candidates, not confirmed defects</span></div><p class=\"muted\">Search the examples included in the report by symbol, path or evidence ID. Expand a finding for source references. Only the report’s displayed examples are embedded here.</p><div id=\"finding-totals\" class=\"stats\"></div><div class=\"panel\" style=\"margin-top:20px\"><div class=\"toolbar\"><label class=\"sr-only\" for=\"search\">Search finding examples</label><input id=\"search\" type=\"search\" placeholder=\"Search symbols, paths, evidence IDs…\"><label class=\"sr-only\" for=\"category\">Finding category</label><select id=\"category\"><option value=\"all\">All categories</option></select></div><div id=\"result-count\" class=\"count-line\" role=\"status\"></div><div id=\"finding-list\"></div></div></section>\n<section id=\"limits\" class=\"section\"><h2>Cycles & uncertainty</h2><p class=\"muted\">Cycles are retained in the graph. Strongly connected components (SCCs) describe structural reachability, not runtime loops or their frequency.</p><div class=\"two-col\"><div class=\"panel\"><h3>Nontrivial components</h3><div class=\"table-wrap\"><table><thead><tr><th>Edge layer</th><th>Components</th><th>Largest size</th></tr></thead><tbody id=\"cycles\"></tbody></table></div><p class=\"tiny\">A largest size of 1 can coexist with zero nontrivial components.</p></div><div class=\"panel\"><h3>Uncertainty by reason</h3><div class=\"table-wrap\"><table><thead><tr><th>View / reason</th><th>Records</th></tr></thead><tbody id=\"uncertainty\"></tbody></table></div><p class=\"tiny\">Escaped references are classified separately from unresolved/unsupported records. These counts are not interchangeable with extraction-site counts.</p></div></div></section>\n<section id=\"source\" class=\"section\"><h2>Keep the evidence close.</h2><p class=\"muted\">The complete Markdown report is embedded below, including methodology, limitations and source links. This page needs no server, network connection or external libraries.</p><details class=\"panel full-report\"><summary>Read the full generated report</summary><article class=\"report-body\"><!-- REPORT_HTML --></article></details></section>\n<footer class=\"footer\"><div class=\"foot-links\"><a href=\"architecture-whole-repository.md\">Original Markdown</a><a href=\"architecture-notes.md\">Architectural interpretation</a><a href=\"artifacts/whole-repository.json.gz\">Full graph · gzip JSON</a><button id=\"print\" type=\"button\">Print / save PDF</button></div><p id=\"snapshot\" class=\"mono\" style=\"overflow-wrap:anywhere\"></p><p>All figures come from the embedded report. Source and graph links require the accompanying repository files.</p></footer>\n<noscript><p>Enable JavaScript for interactive charts and search. The full source report above remains readable without it.</p></noscript>\n</main>\n<script>\n'use strict';\nconst data = /* REPORT_DATA */null;\nconst $ = id => document.getElementById(id);\nconst fmt = value => Number(value).toLocaleString('en-US');\nconst escape = value => String(value).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n$('commit').textContent = $('side-commit').textContent = data.commit.slice(0,8);\n$('snapshot').textContent = data.snapshot;\n$('stats').innerHTML = [[data.counts[0],'Analyzed files'],[data.counts[2],'Source & synthetic entities'],[data.counts[3],'Relations across five views'],[data.counts[1],'Resolution-only files']].map(([n,label])=>`<div class=\"card\"><div class=\"number\">${fmt(n)}</div><div class=\"label\">${label}</div></div>`).join('');\n$('view-cards').innerHTML = data.views.map(([view,status,relations,resolved,unresolved])=>{const rate=100*Number(resolved)/(Number(resolved)+Number(unresolved));return `<div class=\"card view\"><h3>${escape(view)}</h3><span class=\"badge ${status==='partial'?'partial':''}\">${escape(status)}</span><div class=\"number\">${fmt(relations)}</div><div class=\"tiny\">relations</div><div class=\"bar\" role=\"img\" aria-label=\"${rate.toFixed(1)} percent of recorded sites resolved\"><span style=\"width:${rate}%\"></span></div><div class=\"tiny\">${fmt(resolved)} resolved<br>${fmt(unresolved)} unresolved</div></div>`}).join('');\nconst titles = {directory:['Directory boundaries','Immediate source-directory groups'],layer:['Architectural layers','Eight architectural groupings'],custom:['Everything in one group','A control: maximum cohesion, zero excess']};\nfunction partition(id){\n  const p=data.partitions.find(p=>p.id===id), rows=data.metrics.filter(row=>row[0]===id);\n  $('partition-title').textContent=titles[id][0];$('partition-description').textContent=titles[id][1];\n  document.querySelectorAll('[data-partition]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.partition===id)));\n  $('partition-meta').innerHTML=[[p.groups,'Groups'],[p.coverage+'%','Line coverage'],[p.overlap.toFixed(2)+'%','Line overlap'],[rows[0][6]+' bits','VI vs directories']].map(([v,label])=>`<div class=\"tiny\"><strong>${escape(v)}</strong>${label}</div>`).join('');\n  $('cohesion-chart').innerHTML=rows.map(([,layer,edges,observed,baseline,excess])=>`<div class=\"cohesion-row\"><div><strong>${escape(layer)}</strong><div class=\"tiny\">${fmt(edges)} edges</div></div><div class=\"chart-track\" role=\"img\" aria-label=\"${escape(layer)}: observed ${observed}, shuffled mean ${baseline}, excess ${excess} points\"><div class=\"observed\" style=\"width:${parseFloat(observed)}%\" title=\"Observed: ${observed}\"></div><div class=\"baseline-bar\" style=\"width:${parseFloat(baseline)}%\" title=\"Shuffled: ${baseline}\"></div></div><div class=\"metric-value\"><strong>+${parseFloat(excess).toFixed(2)}</strong><div class=\"tiny\">${observed} obs.</div></div></div>`).join('');\n}\ndocument.querySelectorAll('[data-partition]').forEach(b=>b.addEventListener('click',()=>partition(b.dataset.partition)));partition('directory');\nconst categoryLabels=['Layer-local crossings','Cross-directory writes','Mutable captures','Widely shared state'];\n$('finding-totals').innerHTML=data.groups.map((g,i)=>`<div class=\"card\"><div class=\"number\">${fmt(g.total)}</div><div class=\"label\">${categoryLabels[i]}</div><div class=\"tiny\">${g.findings.length} examples embedded</div></div>`).join('');\nfor(const [i,g] of data.groups.entries()){const option=document.createElement('option');option.value=g.id;option.textContent=categoryLabels[i];$('category').append(option)}\nfunction findings(){\n  const q=$('search').value.trim().toLowerCase(), category=$('category').value;\n  const all=data.groups.flatMap((g,i)=>g.findings.map(f=>({...f,category:g.id,label:categoryLabels[i]})));\n  const shown=all.filter(f=>(category==='all'||f.category===category)&&f.text.toLowerCase().includes(q));\n  $('result-count').textContent=`${shown.length} of ${all.length} embedded examples · ${fmt(data.groups.reduce((n,g)=>n+g.total,0))} total findings in the report`;\n  $('finding-list').innerHTML=shown.length?shown.map(f=>`<details class=\"finding\"><summary><div><div class=\"category\">${escape(f.label)}</div><div class=\"finding-title\">${escape(f.text.split('. [')[0])}</div></div></summary><div class=\"finding-body\">${f.html}<code>${escape(f.evidence)}</code></div></details>`).join(''):'<div class=\"empty\">No examples match. Try another symbol or clear the filters.</div>';\n}\n$('search').addEventListener('input',findings);$('category').addEventListener('change',findings);findings();\n$('cycles').innerHTML=data.cycles.map(([layer,count,size])=>`<tr><td>${escape(layer.replace('layer:',''))}</td><td>${fmt(count)}</td><td>${fmt(size)}</td></tr>`).join('');\n$('uncertainty').innerHTML=data.uncertainty.map(([reason,count])=>`<tr><td>${escape(reason)}</td><td>${fmt(count)}</td></tr>`).join('');\n$('print').addEventListener('click',()=>window.print());\n</script>\n</body>\n</html>\n"}