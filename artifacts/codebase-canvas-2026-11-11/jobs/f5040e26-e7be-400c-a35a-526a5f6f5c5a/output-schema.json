{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        },
        "required": [
          "evidence",
          "impact",
          "recommendation"
        ],
        "additionalProperties": false
      }
    },
    "regenerationInstructions": {
      "type": "string"
    }
  },
  "required": [
    "summary",
    "strengths",
    "issues",
    "regenerationInstructions"
  ],
  "additionalProperties": false
}