          "originalLines": [
            "The diagram should place these three nodes in the center:",
            "",
            "- `CORPUS`",
            "- `EVIDENCE`",
            "- `REPRESENTATION`",
            "",
            "Required core interactions:",
            "",
            "- `Corpus -> Evidence`: collect, validate anchors, snapshot source.",
            "- `Evidence -> Corpus`: resolve anchors and read source.",
            "- `Evidence -> Representation`: select, generate, and ground.",
            "- `Representation -> Evidence`: resolve mapped element and reveal evidence."
          ]
        }
