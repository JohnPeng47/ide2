          "originalLines": [
            "The diagram should place these three nodes in the center:",
            "",
            "- `CORPUS`",
            "- `EVIDENCE`",
            "- `REPRESENTATION`",
            "",
            "Required core interactions:",
            "",
            "- `Corpus -> Evidence`: collect, validate anchors, snapshot source."
          ]
        }
      ]
